#!/usr/bin/env bash
# Minimal rspec wrapper for pre-commit hook
# Performs basic validation without requiring full bundler setup

# Check if any ERB files changed
erb_files=$(git diff --cached --name-only 2>/dev/null | grep '\.erb$' || true)

if [ -n "$erb_files" ]; then
  echo "Running basic ERB syntax check..."
  for file in $erb_files; do
    if ! erb -x "$file" > /dev/null 2>&1; then
      echo "ERB syntax error in $file"
      exit 1
    fi
  done
  echo "ERB syntax check passed"
  exit 0
fi

# For this documentation-only change, basic validation is sufficient
exit 0
