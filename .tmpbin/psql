#!/usr/bin/env bash
set -euo pipefail
sql_file=""
db_name=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --file)
      sql_file="$2"
      shift 2
      ;;
    --set|--output)
      shift 2
      ;;
    --quiet|--no-psqlrc)
      shift
      ;;
    *)
      db_name="$1"
      shift
      ;;
  esac
done
if [ -z "$sql_file" ] || [ -z "$db_name" ]; then
  exit 1
fi
bundle exec ruby - "$sql_file" "$db_name" <<'RUBY'
require "pg"
require "uri"
sql_file, db_name = ARGV
conn_params = if ENV["DATABASE_URL"] && !ENV["DATABASE_URL"].empty?
  uri = URI.parse(ENV.fetch("DATABASE_URL"))
  { dbname: db_name, host: uri.host, port: uri.port, user: uri.user, password: uri.password }
else
  { dbname: db_name, host: ENV.fetch("DB_HOST"), user: ENV.fetch("DB_USERNAME", nil), password: ENV.fetch("DB_PASSWORD", nil) }.compact
end
conn = PG.connect(**conn_params)
conn.exec(File.read(sql_file))
conn.close
RUBY
