#!/usr/bin/env bash
set -euo pipefail

file=""
args=("$@")
index=0

while [ $index -lt ${#args[@]} ]; do
  arg="${args[$index]}"
  case "$arg" in
    --file)
      index=$((index + 1))
      file="${args[$index]}"
      ;;
    --file=*)
      file="${arg#--file=}"
      ;;
  esac
  index=$((index + 1))
done

if [ -n "$file" ] && [ ! -f "$file" ]; then
  : >"$file"
fi
