# Copy to .devcontainer/.env to override devcontainer port bindings locally.
PAID_WEB_PORT=3000
PAID_TEMPORAL_UI_PORT=8080
# Absolute host path to the Docker daemon's data root. The Linux default is
# /var/lib/docker; set this to the daemon's actual accessible backing-store
# path when the host uses a different location.
PAID_DOCKER_BACKING_STORE_HOST_PATH=/var/lib/docker
