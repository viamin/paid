# Copy to .devcontainer/.env to override devcontainer port bindings locally.
PAID_WEB_PORT=3000
PAID_TEMPORAL_UI_PORT=8080
# Absolute DockerRootDir returned by the selected Unix-socket Docker daemon.
# Create its empty .paid-capacity-probe child before starting the devcontainer.
# There is intentionally no guessed default: LocalDocker verifies this value
# against Docker info before treating the measurement as daemon capacity.
PAID_DOCKER_BACKING_STORE_DAEMON_ROOT=
