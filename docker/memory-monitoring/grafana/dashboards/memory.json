{
  "uid": "paid-development-memory",
  "title": "Paid development memory",
  "schemaVersion": 39,
  "version": 1,
  "description": "Docker-host/container/process memory investigation. cAdvisor per-container OOM attribution is unavailable on the validated OrbStack host; use host OOM counters, memory history, starts and logs.",
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "PgHero query history (app port 3000)",
      "url": "http://localhost:3000/pghero/queries",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Docker-host OOM counter increase",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "memory-prometheus"
        },
        "expr": "idelta(node_vmstat_oom_kill[45s]) > 0",
        "step": "15s",
        "titleFormat": "Docker-host OOM counter increased",
        "textFormat": "Check memory, starts and PostgreSQL logs; this does not identify the cause."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to investigate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Use a UTC incident interval. Host figures describe the **Docker Linux VM**, not macOS physical RAM. Process groups aggregate matching Paid processes across this Docker host. RSS contains shared pages; do not sum it as physical usage. **OrbStack validation: host OOM kills are observable; cAdvisor per-container OOM counts did not change during a controlled kill, so container OOM attribution is unavailable.** Correlate host OOM changes with container memory/start timestamps, PostgreSQL logs, and PgHero query history. Missing data is not a healthy zero."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scrape coverage",
      "description": "Zero means a scrape failed; absent means no series. Inspect Prometheus Targets for the error.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "memory-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Docker-host available memory",
      "description": "Linux VM available memory, not macOS host memory.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "memory-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Docker-host swap in use",
      "description": "Allocated swap can remain high after pressure subsides.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "memory-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
          "legendFormat": "Swap used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container working set",
      "description": "Working set excludes reclaimable inactive file cache; compare with RSS/cache.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
