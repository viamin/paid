# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config and vendored gems.
/.bundle
/.bundle-install
/vendor/bundle

# Ignore vendored gems
/vendor/bundle

# Ignore all environment files except the example.
/.env*
!/.env.example
*.local.json

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.playwright-mcp

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Ignore code coverage reports
/coverage/

# RSpec example status persistence (for --only-failures)
spec/.examples.txt

# Ignore agent workspace directory (used for Docker container testing)
/agent-workspace/

# Session-specific working memory (ephemeral, per-developer)
WORKLOG.md

# Build artifacts (PostgreSQL, libyaml, ruby-build, etc.)
/.build
/.tmp-*/
/.*-build/
/.*_build/
config.log
config.status

# PostgreSQL source build outputs (generated by ./configure && make)
/Makefile
/GNUmakefile
/src/
/contrib/
/doc/Makefile
/doc/src/
/config/Makefile

# npm cache
/.npm-cache

# mise/asdf version files
.tool-versions

# Ignore downloaded packages
*.deb
*.txz

# Node corepack cache (created by corepack enable / yarn install)
/.corepack/

# Yarn offline mirror cache (created by yarn install with enableGlobalCache: false)
/.yarn-cache/

# PostgreSQL installation directory (created by bin/setup on some hosts)
/.pg-install/
/.pg-local/
/.pg-src/
/.pg.jar

# APT cache and cached package extracts (created during container setup)
/.apt-cache/
/.cache-pkg/

# XDG cache (redirected into workspace by some container setups)
/.xdg-cache/

# Vendored gems (created by bundle install --path vendor/bundle or vendor/gems)
/vendor/bundle/
/vendor/gems/

# Ignore vendored gems, mise tool data, and build artifacts
/.gem/
/.gems/
/.gem-home/
/.gem-spec-cache/
/.gem_cache/
/.gem-cache/
/.gem_home/
/.mise-cache/
/.mise-data/
/.mise-home/
/.bundle-install/
/.bundle_path/
/.cache/
/.tmp/
/.pg/
/.pg-bin/
/.pg-data/
/.pg-lib/
/.pg-share/
/.pgbuild/
/.pgdata/
/pgdata/
/.postgres/
/.rubocop-cache/
/.local/
/.local-include/
/.local-deps/
/.libyaml-build/
/.libyaml-src/
/.libyaml_build/
/.libyaml_src/
/.pg_build/
/.pg_data/
/.pg_src/
/.rubies/
/.ruby_env.sh
/.tmp_pg.tar.bz2
/.tmp_ruby.tar.gz
/.tmp_yaml.tar.gz

# Python virtual environments and caches
/.venv/
__pycache__/
