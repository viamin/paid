# Paid Development Environment Variables
#
# NOTE: The default dev runner (bin/dev) disables automatic .env loading, and
# when using docker compose, DATABASE_URL, the Temporal address (TEMPORAL_HOST
# / TEMPORAL_ADDRESS), and RAILS_ENV are configured directly in
# docker-compose.yml. Treat this file primarily as documentation and for
# workflows where you explicitly load .env.

# =============================================================================
# Required
# =============================================================================

# Database connection
# Avoid setting DATABASE_URL in development unless you intentionally want to pin
# this checkout to one specific database name and bypass worktree isolation.
DB_HOST=localhost
DB_USERNAME=paid
DB_PASSWORD=paid

# Anthropic API key - required for agent execution via secrets proxy
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Optional
# =============================================================================

# Rails environment
RAILS_ENV=development

# Temporal server address
TEMPORAL_HOST=localhost:7233
# TEMPORAL_ADDRESS=localhost:7233    # Alternative to TEMPORAL_HOST

# Temporal namespace
# TEMPORAL_NAMESPACE=default

# Temporal task queue names (poll and agent workloads are isolated)
# TEMPORAL_POLL_TASK_QUEUE=paid-poll-tasks
# TEMPORAL_AGENT_TASK_QUEUE=paid-agent-tasks

# Temporal UI base URL (used for workflow monitoring links in the UI)
TEMPORAL_UI_URL=http://localhost:8080

# Redis URL used by rails_performance in development
REDIS_URL=redis://localhost:6379/0

# OpenAI API key (for agents that use OpenAI models)
# OPENAI_API_KEY=sk-...

# Qdrant vector database URL
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Agent execution timeout in seconds (default: 3600)
# AGENT_TIMEOUT=3600

# In-container git clone timeout in seconds (default: 600)
# CONTAINER_GIT_CLONE_TIMEOUT_SECONDS=600

# =============================================================================
# Service Containers
# =============================================================================

# Service container image allowlist is configured per-user in the admin UI
# (User Settings → Allowed Service Images). The default allowlist includes:
#   postgres:16, redis:7-alpine, selenium/standalone-chromium:latest
#
# To add custom images, update the comma-separated list in user settings.
# Only admin/owner users' allowlists are consulted during validation.

# Production database password
# PAID_DATABASE_PASSWORD=

# =============================================================================
# Production Configuration
# =============================================================================
# Paid validates its configuration at boot in production (see
# Config::ProductionValidator and docs/PRODUCTION_CONFIG.md). A missing REQUIRED
# variable fails boot with a message naming it; a value left at a development
# default (localhost service addresses) logs a warning. These defaults below are
# for local development only -- production must override them.
#
# REQUIRED in production (boot fails fast if unset):
#   PAID_DATABASE_PASSWORD   # or set DATABASE_URL with the full connection string
#   QDRANT_API_KEY           # or qdrant.api_key in Rails credentials
#
# WARNED in production (dev defaults logged, not fatal):
#   TEMPORAL_ADDRESS / TEMPORAL_HOST  # defaults to localhost:7233
#   REDIS_URL                         # defaults to localhost
#   QDRANT_URL                        # defaults to http://localhost:6333
#   CONTAINER_BACKEND                 # defaults to local (needs a Docker socket)
#   WORKSPACE_ROOT                    # defaults to /var/paid/workspaces
#   SCREENSHOTS_S3_*                  # screenshots disabled when unconfigured

# Production database connection (alternative to PAID_DATABASE_PASSWORD):
# DATABASE_URL=postgres://paid:secret@db.internal:5432/paid_production

# Production Temporal address (NOT localhost):
# TEMPORAL_ADDRESS=temporal.internal:7233

# Production Redis URL (NOT localhost):
# REDIS_URL=redis://redis.internal:6379/0

# Production Qdrant URL and key (NOT localhost; key is REQUIRED):
# QDRANT_URL=http://qdrant.internal:6333
# QDRANT_API_KEY=

# Container/runner backend (default local needs a mounted Docker socket):
# CONTAINER_BACKEND=local

# Workspace root for host bind-mount worktrees (named-volume clones are default):
# WORKSPACE_ROOT=/var/paid/workspaces

# =============================================================================
# Object / Artifact Storage
# =============================================================================
# Paid keeps hosts disposable: durable application state lives in PostgreSQL
# and durable *binary* artifacts (screenshots, Playwright traces, trace-viewer
# assets, and future artifact types) live in S3-compatible object storage via
# the shared `ArtifactStorage` module. See docs/ARTIFACT_STORAGE.md for the full
# artifact inventory and the stateless-host invariant.
#
# These variables configure the single bucket shared by all durable artifacts.
# They are optional: when unconfigured, screenshot/trace capture is disabled and
# callers degrade gracefully. Existing deployments need no changes — the shared
# module defaults to the same bucket/credentials historically used by
# Screenshots::Storage.

# Screenshots / trace / artifact object storage:
# SCREENSHOTS_S3_BUCKET=
# SCREENSHOTS_S3_REGION=us-east-1
# SCREENSHOTS_S3_ACCESS_KEY_ID=
# SCREENSHOTS_S3_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint (MinIO, Cloudflare R2, etc.). When set,
# path-style addressing is used automatically.
# SCREENSHOTS_S3_ENDPOINT=
# Optional presigned URL lifetime in seconds (max one week; defaults to the max):
# SCREENSHOTS_S3_URL_TTL=

# =============================================================================
# Observability
# =============================================================================

# Optional bearer token for the /api/metrics endpoint. When set, the Rails app
# requires `Authorization: Bearer ${METRICS_TOKEN}` on Prometheus scrape
# requests. docker-compose.observability.yml propagates the same value to the
# web/bootstrap setup path and bin/setup materializes it into
# ./tmp/prometheus/metrics_token (a gitignored path so the live token never
# lands in the tracked working tree). Leave unset for VPC-internal scrapes.
# METRICS_TOKEN=
