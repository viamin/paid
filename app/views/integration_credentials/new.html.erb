<% content_for(:title) { "Add Credential - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div>
    <%= link_to integration_credentials_path(category: @category_filter, service_key: @service_key_filter), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <span aria-hidden="true" class="mr-1">&larr;</span>
      Back to credentials
    <% end %>
  </div>

  <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
    <div class="px-6 py-5">
      <h1 class="text-xl font-semibold text-gray-900">Add Credential</h1>
      <p class="mt-1 text-sm text-gray-500">Store an encrypted credential for a provider or integration. The secret is encrypted at rest and the raw value is not shown after save.</p>

      <% if @category_filter == "llm_provider" || @integration_credential.category == "llm_provider" %>
        <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
          Provider credentials saved here are not yet used automatically by agent runs or provider tests.
        </div>
      <% end %>

      <%= form_with model: @integration_credential, url: integration_credentials_path, class: "mt-6 space-y-6" do |form| %>
        <% if @integration_credential.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <h2 class="text-sm font-medium text-red-800">Please fix the following:</h2>
            <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
              <% @integration_credential.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :name, class: "block text-sm font-medium text-gray-900" %>
          <%= form.text_field :name, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :service_key, "Service", class: "block text-sm font-medium text-gray-900" %>
          <%= form.select :service_key, options_for_select(@service_options, @integration_credential.service_key), {}, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :auth_kind, "Auth method", class: "block text-sm font-medium text-gray-900" %>
          <%= form.select :auth_kind, options_for_select(@auth_kind_options, @integration_credential.auth_kind), {}, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :secret, class: "block text-sm font-medium text-gray-900" %>
          <%= form.password_field :secret, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", autocomplete: "off" %>
          <p class="mt-2 text-xs text-gray-500">Use the raw API key, OAuth access token, or signing token value.</p>
        </div>

        <div>
          <%= form.label :expires_at, "Expires at", class: "block text-sm font-medium text-gray-900" %>
          <%= form.datetime_local_field :expires_at, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <%= form.hidden_field :category %>

        <div class="flex items-center gap-3">
          <%= form.submit "Save Credential", class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <%= link_to "Cancel", integration_credentials_path(category: @category_filter, service_key: @service_key_filter), class: "text-sm font-semibold text-gray-900 hover:text-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
