<% content_for(:title) { "Style Guides - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Style Guides</h1>
      <p class="mt-1 text-sm text-gray-500">Manage coding conventions for your projects. Style guides are compressed into LLM-friendly format and injected into agent prompts.</p>
    </div>
    <% if policy(StyleGuide.new(account: current_account)).create? %>
      <div class="mt-4 flex gap-3 sm:mt-0">
        <% projects = policy_scope(Project).order(:name) %>
        <% if projects.any? %>
          <%= form_with url: extract_style_guides_path, method: :post, class: "flex items-center gap-2" do |f| %>
            <%= f.select :project_id, options_from_collection_for_select(projects, :id, :name), { prompt: "Select project..." }, class: "rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            <%= f.submit "Extract from Code", class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" %>
          <% end %>
        <% end %>
        <%= link_to new_style_guide_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
          </svg>
          New Style Guide
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @style_guides.any? %>
    <div class="mt-6 overflow-hidden bg-white shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">
              <%= sort_link_to "Name", :name, @q %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              <%= sort_link_to "Language", :language, @q %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Scope
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Compressed
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              <%= sort_link_to "Status", :active, @q %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              <%= sort_link_to "Updated", :updated_at, @q %>
            </th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
              <span class="sr-only">View</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @style_guides.each do |style_guide| %>
            <tr>
              <td class="whitespace-nowrap py-4 pl-4 pr-3 sm:pl-6">
                <div class="text-sm font-medium text-gray-900">
                  <%= link_to style_guide.name, style_guide_path(style_guide), class: "hover:text-indigo-600" %>
                </div>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <%= style_guide_language_badge(style_guide.language) %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <%= style_guide_scope_badge(style_guide) %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <% if style_guide.compressed? %>
                  <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700">Yes</span>
                <% else %>
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">No</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <% if style_guide.active? %>
                  <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700">Active</span>
                <% else %>
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">Inactive</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <%= local_time(style_guide.updated_at, format: :date) %>
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                <%= link_to "View", style_guide_path(style_guide), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <%== pagy_nav(@pagy) %>
    </div>
  <% else %>
    <div class="mt-8 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No style guides</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by creating a style guide for your projects.</p>
      <% if policy(StyleGuide.new(account: current_account)).create? %>
        <div class="mt-6">
          <%= link_to new_style_guide_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" do %>
            <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
            </svg>
            New Style Guide
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
