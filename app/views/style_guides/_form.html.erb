<%= form_with model: style_guide, url: url, method: method, class: "mt-6" do |form| %>
  <% if style_guide.errors.any? %>
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(style_guide.errors.count, "error") %> prevented this style guide from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% style_guide.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.text_field :name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", required: true, placeholder: "e.g. Ruby Style Guide" %>
      </div>
    </div>

    <div>
      <%= form.label :language, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.select :language,
          options_for_select(StyleGuide::LANGUAGES.map { |l| [StyleGuidesHelper::LANGUAGE_DISPLAY_NAMES.fetch(l, l.capitalize), l] }, style_guide.language),
          { include_blank: "Auto-detect" },
          class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>
      <p class="mt-1 text-xs text-gray-500">Leave blank to auto-detect from content.</p>
    </div>

    <div>
      <%= form.label :project_id, "Scope", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.select :project_id,
          options_from_collection_for_select(projects, :id, :name, style_guide.project_id),
          { include_blank: "Account-level (applies to all projects)" },
          class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>
      <p class="mt-1 text-xs text-gray-500">Assign to a specific project or leave blank for account-wide use.</p>
    </div>

    <div class="flex items-center">
      <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
      <%= form.label :active, class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
    </div>

    <div>
      <%= form.label :raw_content, "Content", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <p class="mt-1 text-xs text-gray-500">
        Paste your style guide content here. Markdown format is recommended.
        After saving, use the "Compress" button to generate an LLM-friendly version.
      </p>
      <div class="mt-2">
        <%= form.text_area :raw_content,
          rows: 20,
          class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 font-mono",
          required: true,
          placeholder: "# Ruby Style Guide\n\n## Naming Conventions\n- Use snake_case for methods and variables\n- Use CamelCase for classes and modules\n..." %>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-x-4">
    <% if style_guide.persisted? %>
      <%= link_to "Cancel", style_guide_path(style_guide), class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
    <% else %>
      <%= link_to "Cancel", style_guides_path, class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
    <% end %>
    <%= form.submit style_guide.persisted? ? "Save Style Guide" : "Create Style Guide", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
  </div>
<% end %>
