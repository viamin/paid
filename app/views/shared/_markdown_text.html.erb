<%# locals: content (String, required), tag (Symbol, optional, default :span), class (String, optional), block (Boolean, optional, default false) %>
<%# Renders markdown via the `markdown-text` Stimulus controller. The
    controller replaces the element's innerHTML with the parsed markdown,
    falling back to the escaped raw text if parsing fails. Defaults to inline
    markdown (bold/italic, inline code, links) for single-line content such as
    headings. Pass `block: true` to switch to block-level rendering so
    paragraphs and lists (e.g. the clarifying-questions context panel) render
    with proper structure instead of being collapsed into one line. %>
<%= content_tag(local_assigns.fetch(:tag, :span).to_sym, content,
      class: local_assigns[:class],
      data: {
        controller: "markdown-text",
        "markdown-text-content-value": content,
        "markdown-text-block-value": local_assigns.fetch(:block, false)
      }) %>
