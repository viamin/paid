<%# Multi-select table for review goal %>
<div data-goal-toggle-target="prTable" class="hidden">
  <p class="block text-sm font-medium text-gray-700 mb-2">Select PRs to review:</p>
  <div class="overflow-hidden rounded-md border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="w-10 px-3 py-2"></th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-gray-500">PR</th>
          <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Priority</th>
          <th scope="col" class="px-3 py-2 text-right text-xs font-medium uppercase tracking-wide text-gray-500">Review Rounds</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @pull_requests.each do |pr| %>
          <% has_active_run = @prs_with_active_runs.include?(pr.github_number) %>
          <% priority_tier = @pr_priority_tiers[pr.id] %>
          <tr class="<%= 'opacity-50' if has_active_run %>">
            <td class="px-3 py-2 text-center">
              <input type="checkbox"
                     name="pull_request_ids[]"
                     value="<%= pr.id %>"
                     <%= "disabled" if has_active_run %>
                     <%= 'data-permanently-disabled="true"' if has_active_run %>
                     class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 disabled:cursor-not-allowed">
            </td>
            <td class="px-3 py-2 text-sm text-gray-900">
              #<%= pr.github_number %> - <%= truncate(pr.title, length: 50) %>
              <% if has_active_run %>
                <span class="ml-1 inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">In Progress</span>
              <% end %>
            </td>
            <td class="px-3 py-2 text-sm text-gray-500">
              <%= priority_tier || "-" %>
            </td>
            <td class="px-3 py-2 text-right text-sm text-gray-500">
              <%= pr.review_rounds_count %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
