<% content_for(:title) { "#{@flow_definition.title} - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="overflow-hidden rounded-lg bg-white shadow">
    <div class="px-6 py-5">
      <h1 class="text-xl font-semibold text-gray-900"><%= @flow_definition.title %></h1>
      <p class="mt-1 text-sm text-gray-500"><%= @flow_definition.summary %> Paid will start the official <code>claude auth login</code> in an isolated container, show you the OAuth URL, and feed your pasted code back into that same live process.</p>

      <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        This flow only exposes the constrained Claude login session. It does not provide a general shell or terminal.
      </div>

      <% if @active_runner_credential %>
        <div class="mt-4 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800">
          <p>
            Active <%= Runner.display_name_for(@active_runner_key) %> credential: <strong><%= @active_runner_credential.name %></strong>
            (<%= @active_runner_credential.expiry_label %>).
          </p>
          <p class="mt-1">
            Starting another login under a different credential name creates a second concurrent active credential. Revoke this one first if you want a replacement.
          </p>
          <div class="mt-2 flex items-center gap-4">
            <% if @credential_runner %>
              <%= link_to "View credential", runner_runner_credential_path(@credential_runner, @active_runner_credential), class: "font-semibold text-green-900 underline hover:no-underline" %>
            <% end %>
            <%= link_to "Manage credentials", integration_credentials_path(category: "llm_provider", service_key: @flow_definition.manage_service_key), class: "font-semibold text-green-900 underline hover:no-underline" %>
          </div>
        </div>
      <% end %>

      <%= form_with model: @claude_login_session, class: "mt-6 space-y-6" do |form| %>
        <% if @claude_login_session.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <h2 class="text-sm font-medium text-red-800">Please fix the following:</h2>
            <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
              <% @claude_login_session.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :credential_name, "Credential name", class: "block text-sm font-medium text-gray-900" %>
          <%= form.text_field :credential_name, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          <p class="mt-2 text-xs text-gray-500">The captured managed credential will be stored under this name.</p>
        </div>

        <%= hidden_field_tag "claude_login_session[metadata][return_to]", @return_to_path %>
        <%= hidden_field_tag "claude_login_session[metadata][target_runner_key]", @flow_definition.runner_key %>

        <div class="flex items-center gap-3">
          <%= form.submit "Start Login", class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <%= link_to "Cancel", safe_return_path_or(@return_to_path, integration_credentials_path(category: "llm_provider", service_key: @flow_definition.manage_service_key)), class: "text-sm font-semibold text-gray-900 hover:text-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
