<% content_for(:title) { "Integrations - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Integrations</h1>
      <p class="mt-1 text-sm text-gray-500">Connect external services to enable automated development workflows.</p>
    </div>
  </div>

  <% Integrations::Provider::CATEGORIES.each do |category_key, category_info| %>
    <% providers = @providers_by_category[category_key] || [] %>
    <% next if providers.empty? %>

    <div class="mt-10">
      <h2 class="text-lg font-semibold text-gray-900"><%= category_info[:label] %></h2>
      <p class="mt-1 text-sm text-gray-500"><%= category_info[:description] %></p>

      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% providers.each do |provider| %>
          <div class="relative rounded-lg border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center">
              <div class="flex-shrink-0 text-gray-700">
                <%= raw provider.icon_svg %>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-semibold text-gray-900"><%= provider.provider_name %></h3>
                <% count = @token_counts[provider.key] || 0 %>
                <% if count > 0 %>
                  <p class="text-xs text-green-600"><%= pluralize(count, "connection") %> configured</p>
                <% else %>
                  <p class="text-xs text-gray-500">Not configured</p>
                <% end %>
              </div>
            </div>
            <p class="mt-3 text-sm text-gray-500"><%= provider.description %></p>
            <div class="mt-4 flex items-center gap-3">
              <% if count > 0 %>
                <%= link_to "Manage", provider.index_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <% end %>
              <%= link_to "Add", provider.new_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
