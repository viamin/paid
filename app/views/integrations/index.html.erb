<% content_for(:title) { "Integrations - Paid" } %>

<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Integrations</h1>
      <p class="mt-1 text-sm text-gray-500">Manage repository access tokens, issue tracker keys, and LLM provider API keys.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "Add Integration", new_integration_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  </div>

  <% if @sections.any? %>
    <% @sections.each do |section| %>
      <div class="mt-10">
        <h2 class="text-lg font-semibold text-gray-900"><%= section.label %></h2>
        <p class="mt-1 text-sm text-gray-500"><%= section.description %></p>

        <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="py-3 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500 sm:pl-6">Name</th>
                <% if section.key == :llm_provider %>
                  <th class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Service</th>
                <% end %>
                <th class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Status</th>
                <th class="px-3 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Created</th>
                <th class="relative py-3 pl-3 pr-4 sm:pr-6"><span class="sr-only">View</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% section.records.each do |record| %>
                <tr>
                  <td class="whitespace-nowrap py-3 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6"><%= record.name %></td>
                  <% if section.key == :llm_provider %>
                    <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500"><%= record.display_api_service_type %></td>
                  <% end %>
                  <td class="whitespace-nowrap px-3 py-3 text-sm">
                    <%= render_integration_status(record) %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-3 text-sm text-gray-500">
                    <%= local_time(record.created_at, format: :date) %>
                  </td>
                  <td class="whitespace-nowrap py-3 pl-3 pr-4 text-right text-sm sm:pr-6">
                    <%= link_to "View", integration_show_path(record, section.key), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="mt-10 rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center">
      <h2 class="text-lg font-semibold text-gray-900">No integrations configured</h2>
      <p class="mt-2 text-sm text-gray-500">Get started by adding your first integration.</p>
      <div class="mt-4">
        <%= link_to "Add Integration", new_integration_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
    </div>
  <% end %>
</div>
