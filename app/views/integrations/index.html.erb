<% content_for(:title) { "Integrations - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Integrations</h1>
      <p class="mt-1 text-sm text-gray-500">Manage repository access, issue tracker keys, provider credentials, and future automation secrets in one place.</p>
    </div>
  </div>

  <% @integration_sections.each do |section| %>
    <div class="mt-10">
      <h2 class="text-lg font-semibold text-gray-900"><%= section[:label] %></h2>
      <p class="mt-1 text-sm text-gray-500"><%= section[:description] %></p>

      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% section[:cards].each do |card| %>
          <div class="relative rounded-lg border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center">
              <div class="flex-shrink-0 text-gray-700">
                <%= raw card[:icon_svg] %>
              </div>
              <div class="ml-4">
                <h3 class="text-sm font-semibold text-gray-900"><%= card[:name] %></h3>
                <% count = card[:count] || 0 %>
                <% if count > 0 %>
                  <p class="text-xs text-green-600"><%= pluralize(count, "connection") %> configured</p>
                <% else %>
                  <p class="text-xs text-gray-500">Not configured</p>
                <% end %>
              </div>
            </div>
            <p class="mt-3 text-sm text-gray-500"><%= card[:description] %></p>
            <div class="mt-4 flex items-center gap-3">
              <% if count > 0 %>
                <%= link_to "Manage", card[:index_path], class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <% end %>
              <%= link_to "Add", card[:new_path], class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
