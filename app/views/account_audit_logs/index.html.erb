<% content_for :title, "Audit Log" %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-700 dark:text-amber-300">Account Administration</p>
      <h1 class="mt-2 text-3xl font-semibold text-gray-900 dark:text-white">Audit Log</h1>
      <p class="mt-2 max-w-3xl text-sm text-gray-600 dark:text-gray-300">
        Complete history of sensitive actions across your account — who changed what, when, and why.
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Export JSON", export_account_audit_logs_path(format: :json, q: params.dig(:q) || {}), class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-900" %>
      <%= link_to "Export CSV", export_account_audit_logs_path(format: :csv, q: params.dig(:q) || {}), class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-900" %>
    </div>
  </div>

  <div class="mt-8">
    <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <%= search_form_for @q, url: account_audit_logs_path, class: "grid gap-4 md:grid-cols-4" do |f| %>
        <div>
          <%= f.label :action_cont, "Action", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
          <%= f.select :action_eq,
            AccountActivityEvent::ACTION_CATEGORIES.keys.map { |k| [k, k] },
            { include_blank: "All actions" },
            class: "mt-1 block w-full rounded-xl border-gray-300 text-sm shadow-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
        </div>
        <div>
          <%= f.label :created_at_gteq, "From", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
          <%= f.date_field :created_at_gteq, class: "mt-1 block w-full rounded-xl border-gray-300 text-sm shadow-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
        </div>
        <div>
          <%= f.label :created_at_lteq, "To", class: "block text-sm font-medium text-gray-700 dark:text-gray-200" %>
          <%= f.date_field :created_at_lteq, class: "mt-1 block w-full rounded-xl border-gray-300 text-sm shadow-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white" %>
        </div>
        <div class="flex items-end">
          <%= f.submit "Filter", class: "rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-700 dark:bg-amber-500 dark:text-gray-900 dark:hover:bg-amber-400" %>
          <% if params[:q].present? %>
            <%= link_to "Clear", account_audit_logs_path, class: "ml-2 rounded-full border border-gray-300 px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-900" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 space-y-4">
    <% if @events.any? %>
      <% @events.each do |event| %>
        <article class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600 dark:bg-gray-900 dark:text-gray-300"><%= event.category %></span>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500 dark:bg-gray-900 dark:text-gray-400 font-mono"><%= event.action %></span>
              </div>
              <p class="mt-2 font-medium text-gray-900 dark:text-white"><%= event.description %></p>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= event.actor_label %> &middot; <%= time_ago_in_words(event.created_at) %> ago &middot; <%= event.created_at.strftime("%Y-%m-%d %H:%M UTC") %></p>
            </div>
          </div>
          <% if event.detail_lines.any? %>
            <div class="mt-3 space-y-1 text-sm text-gray-600 dark:text-gray-300">
              <% event.detail_lines.each do |line| %>
                <p><%= line %></p>
              <% end %>
            </div>
          <% end %>
          <% if event.subject_type.present? %>
            <div class="mt-2 text-xs text-gray-400 dark:text-gray-500">
              Subject: <%= event.subject_type %> #<%= event.subject_id %>
            </div>
          <% end %>
        </article>
      <% end %>

      <% if @pagy.pages > 1 %>
        <div class="flex justify-center pt-4">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-4 py-12 text-center text-sm text-gray-500 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
        No audit events found matching your filters.
      </div>
    <% end %>
  </div>
</div>
