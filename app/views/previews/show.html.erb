<%# Preview wrapper: embeds the authorized proxied app in a same-origin iframe. %>
<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900">Live preview</h1>
      <dl class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
        <% if @preview_session.branch_name.present? %>
          <div><dt class="inline font-medium text-gray-700">Branch:</dt> <dd class="inline"><%= @preview_session.branch_name %></dd></div>
        <% end %>
        <div><dt class="inline font-medium text-gray-700">Status:</dt> <dd class="inline"><%= @preview_session.status %></dd></div>
        <% if @preview_session.expires_at.present? %>
          <div><dt class="inline font-medium text-gray-700">Expires:</dt> <dd class="inline"><%= time_ago_in_words(@preview_session.expires_at) %> from now</dd></div>
        <% end %>
      </dl>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Back to project", @preview_session.project, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <%= button_to "Stop preview",
            stop_project_preview_session_path(@preview_session.project, @preview_session),
            method: :post,
            data: { turbo_confirm: "Stop this preview and tear down its tunnel?" },
            class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
    <iframe
      src="<%= @preview_session.proxy_prefix %>/"
      title="Preview of <%= @preview_session.branch_name.presence || @preview_session.project.name %>"
      class="h-[80vh] w-full"
      allow="clipboard-read; clipboard-write; fullscreen"
      referrerpolicy="no-referrer"
      loading="eager"></iframe>
  </div>
</div>
