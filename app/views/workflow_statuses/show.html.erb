<%= turbo_frame_tag "workflow-status" do %>
  <div class="border rounded-lg p-4">
    <div class="flex items-start justify-between">
      <div class="flex items-start space-x-3">
        <div class="mt-0.5">
          <% case @health[:status] %>
          <% when :healthy %>
            <span class="flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-3 w-3 rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
          <% when :stale %>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-yellow-500"></span>
          <% when :unhealthy %>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
          <% when :inactive %>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-gray-400"></span>
          <% end %>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900"><%= @health[:label] %></p>
          <p class="mt-1 text-sm text-gray-600"><%= @health[:description] %></p>

          <% if @project.active? %>
            <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 text-sm text-gray-500">
              <% if @project.last_polled_at %>
                <dt>Last checked</dt>
                <dd class="text-gray-900"><%= time_ago_in_words(@project.last_polled_at) %> ago</dd>
              <% end %>
              <dt>Check interval</dt>
              <dd class="text-gray-900">Every <%= pluralize(@project.poll_interval_seconds, "second") %></dd>
            </dl>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
