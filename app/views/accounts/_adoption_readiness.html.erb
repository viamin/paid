<section class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Adoption &amp; Operational Readiness</h2>
      <p class="mt-1 max-w-3xl text-sm text-gray-600 dark:text-gray-300">
        Package rollout playbooks, role onboarding, and expansion signals so teams can move from pilot to production with less bespoke support.
      </p>
    </div>

    <div class="rounded-2xl bg-amber-50 px-4 py-3 dark:bg-amber-950/20">
      <p class="text-xs uppercase tracking-wide text-amber-700 dark:text-amber-300">Rollout stage</p>
      <p class="mt-1 text-lg font-semibold text-gray-900 dark:text-white"><%= adoption_dashboard.dig(:rollout_stage, :label) %></p>
      <p class="text-sm text-gray-600 dark:text-gray-300"><%= adoption_dashboard.dig(:rollout_stage, :summary) %></p>
    </div>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-900/60">
      <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Active repositories</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-white"><%= adoption_dashboard.dig(:metrics, :active_repositories) %></p>
      <p class="text-sm text-gray-500 dark:text-gray-400">Repositories with Paid runs in the last 30 days.</p>
    </div>
    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-900/60">
      <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Usage depth</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-white"><%= adoption_dashboard.dig(:metrics, :usage_depth, :percentage) %>%</p>
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= adoption_dashboard.dig(:metrics, :usage_depth, :enabled) %> of <%= adoption_dashboard.dig(:metrics, :usage_depth, :total) %> rollout capabilities enabled.</p>
    </div>
    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-900/60">
      <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Automation acceptance</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-white"><%= adoption_dashboard.dig(:metrics, :automation_acceptance_rate) || "N/A" %><%= "%" if adoption_dashboard.dig(:metrics, :automation_acceptance_rate) %></p>
      <p class="text-sm text-gray-500 dark:text-gray-400">Share of recent automatic runs that finished completed.</p>
    </div>
    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-900/60">
      <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Manual override rate</p>
      <p class="mt-2 text-3xl font-semibold text-gray-900 dark:text-white"><%= adoption_dashboard.dig(:metrics, :manual_override_rate) || "N/A" %><%= "%" if adoption_dashboard.dig(:metrics, :manual_override_rate) %></p>
      <p class="text-sm text-gray-500 dark:text-gray-400">Share of recent runs started through manual intervention.</p>
    </div>
  </div>

  <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <div>
      <div class="flex items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Recommendations</h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Surface rollout blockers and underused capabilities before they become consulting escalations.</p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <% if adoption_dashboard[:recommendations].any? %>
          <% adoption_dashboard[:recommendations].each do |recommendation| %>
            <% tone_classes = case recommendation[:severity]
              when :blocker then "border-rose-200 bg-rose-50 dark:border-rose-900 dark:bg-rose-950/20"
              when :watch then "border-amber-200 bg-amber-50 dark:border-amber-900 dark:bg-amber-950/20"
              else "border-sky-200 bg-sky-50 dark:border-sky-900 dark:bg-sky-950/20"
              end %>
            <article class="rounded-2xl border p-4 <%= tone_classes %>">
              <div class="flex items-center justify-between gap-3">
                <h4 class="font-semibold text-gray-900 dark:text-white"><%= recommendation[:title] %></h4>
                <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-gray-700 dark:bg-gray-900/70 dark:text-gray-200"><%= recommendation[:severity].to_s.humanize %></span>
              </div>
              <p class="mt-2 text-sm text-gray-700 dark:text-gray-200"><%= recommendation[:detail] %></p>
              <p class="mt-2 text-sm font-medium text-gray-900 dark:text-white">Next action: <span class="font-normal text-gray-700 dark:text-gray-200"><%= recommendation[:action] %></span></p>
            </article>
          <% end %>
        <% else %>
          <div class="rounded-2xl border border-dashed border-emerald-300 bg-emerald-50 px-4 py-6 text-sm text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-100">
            No immediate rollout blockers detected. Use the playbooks below to keep expansion repeatable as more repositories adopt Paid.
          </div>
        <% end %>
      </div>
    </div>

    <div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Role-based training &amp; onboarding</h3>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Standard tracks for developers, reviewers, managers, and platform admins.</p>

      <div class="mt-4 space-y-3">
        <% adoption_dashboard[:training_tracks].each do |track| %>
          <article class="rounded-2xl border border-gray-200 p-4 dark:border-gray-700">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white"><%= track[:title] %></h4>
                <p class="text-sm text-gray-500 dark:text-gray-400"><%= track[:duration] %> • <%= track[:status] %></p>
              </div>
            </div>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-200"><%= track[:outcome] %></p>
            <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
              <% track[:modules].each do |mod| %>
                <li>- <%= mod %></li>
              <% end %>
            </ul>
          </article>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-8 grid gap-8 xl:grid-cols-2">
    <div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Admin playbooks</h3>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Repeatable motions for pilot rollout, guardrail tuning, and operating-model design.</p>

      <div class="mt-4 space-y-4">
        <% adoption_dashboard[:playbooks].each do |playbook| %>
          <article class="rounded-2xl border border-gray-200 p-4 dark:border-gray-700">
            <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= playbook[:audience] %></p>
            <h4 class="mt-1 font-semibold text-gray-900 dark:text-white"><%= playbook[:title] %></h4>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-200"><%= playbook[:summary] %></p>
            <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
              <% playbook[:steps].each do |step| %>
                <li>- <%= step %></li>
              <% end %>
            </ul>
          </article>
        <% end %>
      </div>
    </div>

    <div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Reference operating models</h3>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Choose between centralized platform ownership and team-owned deployments with clear tradeoffs.</p>

      <div class="mt-4 space-y-4">
        <% adoption_dashboard[:operating_models].each do |model| %>
          <article class="rounded-2xl border border-gray-200 p-4 dark:border-gray-700">
            <h4 class="font-semibold text-gray-900 dark:text-white"><%= model[:title] %></h4>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-200"><span class="font-medium">Best for:</span> <%= model[:best_for] %></p>
            <ul class="mt-3 space-y-2 text-sm text-gray-600 dark:text-gray-300">
              <% model[:strengths].each do |strength| %>
                <li>- <%= strength %></li>
              <% end %>
            </ul>
          </article>
        <% end %>
      </div>
    </div>
  </div>
</section>
