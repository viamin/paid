<% content_for :title, "Docker Hosts" %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-amber-700">Operations</p>
      <h1 class="mt-2 text-3xl font-semibold text-gray-900">Docker Hosts</h1>
      <p class="mt-2 max-w-3xl text-sm text-gray-600">
        Manage persisted Docker placement targets, readiness state, and host-level concurrency separately from account, user, and project guardrails.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Back to account", account_path, class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
      <%= link_to "Operations dashboard", account_operations_dashboard_path, class: "rounded-full bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-500" %>
    </div>
  </div>

  <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.4fr)_minmax(340px,0.9fr)]">
    <div class="space-y-8">
      <section class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-900">Host inventory</h2>
            <p class="mt-1 text-sm text-gray-600">Readiness failures, active run pressure, callback routing, and setup drift for each host.</p>
          </div>
        </div>

        <% if @docker_hosts.empty? %>
          <div class="mt-6 rounded-2xl border border-dashed border-gray-300 px-4 py-6 text-sm text-gray-500">
            No Docker hosts are configured yet.
          </div>
        <% else %>
          <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left font-medium text-gray-700">Host</th>
                  <th class="px-4 py-3 text-left font-medium text-gray-700">Readiness</th>
                  <th class="px-4 py-3 text-left font-medium text-gray-700">Endpoint</th>
                  <th class="px-4 py-3 text-left font-medium text-gray-700">Capacity</th>
                  <th class="px-4 py-3 text-left font-medium text-gray-700">Image / network</th>
                  <th class="px-4 py-3 text-left font-medium text-gray-700">Last check</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                <% @docker_hosts.each do |host| %>
                  <% active_runs = @active_runs_by_host.fetch(host.identifier, 0) %>
                  <% capacity_snapshot = @capacity_snapshots_by_host[host.identifier] %>
                  <tr id="<%= dom_id(host) %>">
                    <td class="px-4 py-4 align-top">
                      <div class="font-medium text-gray-900"><%= link_to host.display_name, docker_host_path(host), class: "hover:text-amber-700" %></div>
                      <div class="text-gray-500"><code><%= host.identifier %></code> • <%= host.backend_type.humanize %></div>
                      <div class="mt-2 text-xs text-gray-500">
                        <%= host.enabled? ? "Enabled" : "Disabled" %>
                        <% if host.fallback_eligible? %>• Fallback eligible<% end %>
                      </div>
                      <div class="mt-2 text-xs text-gray-500">Proxy: <%= host.callback_url %></div>
                      <% if host.daemon_architecture.present? || host.daemon_summary.present? %>
                        <div class="mt-2 text-xs text-gray-500"><%= [ host.daemon_architecture, host.daemon_summary ].compact.join(" • ") %></div>
                      <% end %>
                    </td>
                    <td class="px-4 py-4 align-top text-gray-700">
                      <div><%= host.readiness_status.humanize %></div>
                      <div class="mt-2 text-xs text-red-700"><%= host.failing_check.presence || "No failing check recorded" %></div>
                      <% if host.last_error.present? %>
                        <div class="mt-2 text-xs text-gray-500"><%= truncate(host.last_error, length: 90) %></div>
                      <% end %>
                    </td>
                    <td class="px-4 py-4 align-top text-gray-700">
                      <div><%= host.endpoint_label %></div>
                    </td>
                    <td class="px-4 py-4 align-top text-gray-700">
                      <div>Active runs: <%= active_runs %></div>
                      <div class="mt-2 text-xs text-gray-500">Limit: <%= host.manual_concurrency_limit %></div>
                      <div class="text-xs text-gray-500">Available slots: <%= host.available_slots(active_run_count: active_runs) %></div>
                      <% if capacity_snapshot %>
                        <div class="mt-2 text-xs text-gray-500">
                          Docker free: <%= capacity_snapshot.degraded? ? "Unavailable" : number_to_human_size(capacity_snapshot.available_memory_bytes) %>
                        </div>
                        <div class="text-xs text-gray-500">
                          Snapshot: <%= capacity_snapshot.degraded? ? capacity_snapshot.degraded_reasons.to_sentence : "Healthy" %>
                        </div>
                      <% end %>
                    </td>
                    <td class="px-4 py-4 align-top text-gray-700">
                      <div>Image: <%= host.image_status.humanize %></div>
                      <div class="mt-2 text-xs text-gray-500">Network: <%= host.required_network_status.humanize %></div>
                      <div class="text-xs text-gray-500"><%= host.image_tag %></div>
                    </td>
                    <td class="px-4 py-4 align-top text-gray-700">
                      <div><%= capacity_snapshot&.snapshot_at&.to_fs(:db) || host.last_checked_at&.to_fs(:db) || "Never" %></div>
                      <% if capacity_snapshot %>
                        <div class="mt-2 text-xs text-gray-500">Confidence: <%= capacity_snapshot.confidence %></div>
                      <% end %>
                      <div class="mt-2 text-xs text-gray-500">Ready: <%= host.last_ready_at&.to_fs(:db) || "Never" %></div>
                      <div class="mt-3 flex gap-2">
                        <%= link_to "Edit", edit_docker_host_path(host), class: "text-xs font-semibold text-amber-700 hover:text-amber-600" %>
                        <% if host.enabled? %>
                          <%= button_to "Disable", disable_docker_host_path(host), method: :patch, class: "text-xs font-semibold text-red-700", form: { data: { turbo_confirm: "Disable #{host.display_name} for new placements?" } } %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </section>

      <section class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">Placement preferences</h2>
          <p class="mt-1 text-sm text-gray-600">Preferred hosts must stay enabled. Host concurrency caps are enforced independently from the account, user, and project guardrails that already govern total run admission.</p>
        </div>

        <% if @tenant_setting.errors.any? %>
          <div class="mt-4 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-800">
            <%= @tenant_setting.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <%= form_with model: @tenant_setting, url: account_docker_host_preferences_path, method: :patch, class: "mt-6 grid gap-4 md:grid-cols-2" do |form| %>
          <div>
            <%= form.label :preferred_docker_host_identifier, "Account preferred host", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :preferred_docker_host_identifier,
              options_for_select([["No preference", ""]] + @enabled_docker_host_options, @tenant_setting.preferred_docker_host_identifier),
              {},
              class: "mt-1 block w-full rounded-xl border-gray-300 text-sm shadow-sm" %>
          </div>

          <div>
            <%= form.label :docker_host_fallback_behavior, "Fallback behavior", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :docker_host_fallback_behavior,
              options_for_select(TenantSetting::DOCKER_HOST_FALLBACK_BEHAVIORS.map { |value| [ value.humanize, value ] }, @tenant_setting.docker_host_fallback_behavior),
              {},
              class: "mt-1 block w-full rounded-xl border-gray-300 text-sm shadow-sm" %>
          </div>

          <div class="md:col-span-2 flex justify-end">
            <%= form.submit "Save account placement", class: "rounded-full bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-amber-500" %>
          </div>
        <% end %>

        <div class="mt-8 overflow-hidden rounded-2xl border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Project</th>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Preferred host</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @projects.each do |project| %>
                <tr id="<%= dom_id(project, :placement) %>">
                  <td class="px-4 py-4 align-top">
                    <div class="font-medium text-gray-900"><%= project.name %></div>
                    <div class="text-gray-500"><%= project.full_name %></div>
                    <% if project.errors.any? %>
                      <div class="mt-2 text-xs text-red-700"><%= project.errors.full_messages.to_sentence %></div>
                    <% end %>
                  </td>
                  <td class="px-4 py-4 align-top">
                    <%= form_with model: project, url: project_docker_host_preference_path(project), method: :patch, class: "flex items-center gap-3" do |form| %>
                      <%= form.label :preferred_docker_host_identifier, "Preferred host", class: "sr-only" %>
                      <%= form.select :preferred_docker_host_identifier,
                        options_for_select([["Inherit account preference", ""]] + @enabled_docker_host_options, project.preferred_docker_host_identifier),
                        {},
                        class: "block w-full rounded-xl border-gray-300 text-sm shadow-sm" %>
                      <%= form.submit "Save", class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="space-y-8">
      <section class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">Add host</h2>
          <p class="mt-1 text-sm text-gray-600">Persist host configuration here instead of editing environment variables for the common managed path.</p>
        </div>

        <div class="mt-6">
          <%= render "form", docker_host: @docker_host %>
        </div>
      </section>

      <section class="rounded-3xl border border-gray-200 bg-white p-6 text-sm text-gray-600 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900">Operator notes</h2>
        <ul class="mt-4 space-y-2">
          <li>Disabling a host preserves historical ownership because past runs keep their saved <code>container_host</code>.</li>
          <li>Host concurrency limits cap placements on a single Docker backend and do not replace account, user, or project guardrails.</li>
          <li>Fallback only considers hosts marked eligible for fallback.</li>
        </ul>
      </section>
    </div>
  </div>
</div>
