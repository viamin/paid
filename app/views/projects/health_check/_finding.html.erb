<div class="flex items-start gap-3 py-3">
  <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full <%= severity_circle_class(finding.severity) %>">
    <svg class="h-3 w-3 <%= severity_icon_class(finding.severity) %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <% if finding.severity == :error %>
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
      <% elsif finding.severity == :warning %>
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
      <% else %>
        <path fill-rule="evenodd" d="M18 10a8 8 0 1 0-16 0 8 8 0 0 0 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .177.428l-1.5 1.5A.75.75 0 0 0 8.25 14H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.177-.428l1.5-1.5A.75.75 0 0 0 11.75 9H9Z" clip-rule="evenodd" />
      <% end %>
    </svg>
  </span>
  <div class="min-w-0 flex-1">
    <p class="text-sm font-medium text-gray-900"><%= finding.check.demodulize.titleize %></p>
    <p class="mt-1 text-sm text-gray-500"><%= finding.message %></p>
  </div>
</div>
