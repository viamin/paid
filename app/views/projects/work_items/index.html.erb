<% content_for(:title) { "Work Items - #{@project.name} - Paid" } %>

<%= turbo_frame_tag dom_id(@project, :work_items) do %>
  <div class="mt-8 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-medium text-gray-900">Tracker Work Items</h2>
      <p class="mt-1 text-sm text-gray-500">Unified tracker tickets assigned to this project. Start runs or choose the default execution project.</p>
    </div>
    <%= link_to "Browse all work items", work_items_path, class: "text-sm font-semibold text-indigo-600 hover:underline" %>
  </div>

  <% if @work_items.any? %>
    <div class="mt-4 overflow-hidden bg-white shadow sm:rounded-lg">
      <ul role="list" class="divide-y divide-gray-200">
        <% @work_items.each do |work_item| %>
          <% default_assignment = work_item.work_item_assignments.default_execution.first %>
          <li class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600"><%= work_item.provider %></span>
                  <% if work_item.needs_review? %>
                    <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Needs review</span>
                  <% end %>
                </div>
                <p class="mt-1 truncate text-sm font-medium text-gray-900">
                  <%= link_to work_item.title, work_item_path(work_item) %>
                </p>
                <p class="mt-0.5 text-xs text-gray-500">
                  <%= work_item.raw_payload["identifier"].presence || work_item.external_id %>
                  <% if work_item.native_project_name.present? %> · <%= work_item.native_project_name %><% end %>
                </p>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <% if policy(work_item).override? %>
                  <% if default_assignment&.project_id == @project.id %>
                    <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Default execution</span>
                  <% else %>
                    <%= button_to "Make default execution", set_default_execution_project_work_item_path(@project, work_item), method: :post, params: { target_project_id: @project.id }, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
                  <% end %>
                <% end %>
                <%= link_to "Start run", new_project_agent_run_path(@project, goal: "create_pr", work_item_id: work_item.id), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="mt-4 text-center rounded-lg border-2 border-dashed border-gray-300 p-8">
      <h3 class="text-sm font-semibold text-gray-900">No tracker work items assigned</h3>
      <p class="mt-1 text-sm text-gray-500">Assign unified tickets to this project from the <%= link_to "work-item browser", work_items_path, class: "text-indigo-600 hover:underline" %>.</p>
    </div>
  <% end %>
<% end %>
