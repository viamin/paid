            <div class="flex items-center justify-between">
              <legend class="text-sm font-semibold leading-6 text-gray-900">Labels</legend>
              <%= link_to "Sync Labels to GitHub", ensure_labels_project_path(@project), data: { turbo_method: :post }, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" %>
            </div>

            <div>
              <%= form.label :generated_label_name, "Generated Label", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.text_field :generated_label_name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Label added to PRs and issues created by Paid.</p>
            </div>

            <div>
              <%= form.label :automation_label_name, "Automation Label", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.text_field :automation_label_name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Label that triggers automatic agent runs when added to issues or PRs.</p>
            </div>

            <div>
              <%= form.label :enhance_issue_needs_input_label_name, "Enhance Issue Needs Input Label", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.text_field :enhance_issue_needs_input_label_name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Label added when issue enhancement needs answers before re-evaluation.</p>
            </div>

            <div>
              <%= form.label :enhance_issue_enhanced_label_name, "Enhanced Issue Label", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.text_field :enhance_issue_enhanced_label_name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Label added when issue enhancement has enough implementation context.</p>
            </div>

            <div>
              <%= form.label :max_enhance_issue_reevaluation_rounds, "Max Enhance Issue Re-evaluation Rounds", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :max_enhance_issue_reevaluation_rounds, min: 0, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Maximum automatic re-evaluation rounds after users answer clarifying questions.</p>
            </div>

            <% %w[P1 P2 P3].each do |tier| %>
              <div>
                <%= form.label "priority_labels_#{tier}", "Priority Label (#{tier})", class: "block text-sm font-medium leading-6 text-gray-900" %>
                <div class="mt-2">
                  <input type="text" name="project[priority_labels][<%= tier %>]" id="project_priority_labels_<%= tier %>"
                    value="<%= @project.effective_priority_labels[tier] %>"
                    autocomplete="off"
                    class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
                <p class="mt-1 text-xs text-gray-500">GitHub label name for <%= tier %> priority issues.</p>
              </div>
            <% end %>
            <% if @project.errors[:priority_labels].any? %>
              <% @project.errors[:priority_labels].each do |msg| %>
                <p class="mt-1 text-xs text-red-600"><%= msg %></p>
              <% end %>
            <% end %>
          </fieldset>

          <fieldset id="automation" class="space-y-4">
            <legend class="text-sm font-semibold leading-6 text-gray-900">Automation</legend>

            <% Project::AUTOMATION_SETTINGS.each do |setting| %>
              <div>
                <div class="flex items-center">
                  <%= form.check_box setting[:attribute], class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                  <%= form.label setting[:attribute], setting[:label], class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
                </div>
                <p class="mt-1 ml-7 text-xs text-gray-500"><%= setting[:description] %></p>
              </div>
            <% end %>

            <div>
              <div class="flex items-center">
                <%= form.check_box :auto_scan_security,
                  class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                <%= form.label :auto_scan_security, "Auto-Scan Security Alerts",
                  class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
              </div>
              <p class="mt-1 ml-7 text-xs text-gray-500">
                Periodically scan GitHub CodeQL alerts and create synthetic issues for all open alerts. Issues are labeled with a priority tier matching severity (critical/high &rarr; P1, medium &rarr; P2, low &rarr; P3).
              </p>
            </div>

            <div>
              <label class="flex items-center gap-2 text-sm font-medium leading-6 text-gray-900">
                <%= hidden_field_tag "project[auto_pick_skip_labels_override]", "0" %>
                <%= check_box_tag "project[auto_pick_skip_labels_override]", "1", @project.auto_pick_skip_labels_configured?, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                Override Auto-Pick Skip Labels
              </label>
              <div class="mt-2">
                <%= text_field_tag "project[auto_pick_skip_labels_csv]", @project.auto_pick_skip_labels_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "planning, research" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Comma-separated labels that prevent auto-pick for this project. When override is off, Paid falls back to the creator's user setting, then the tenant setting, then built-in defaults. When override is on and this field is blank, no labels are skipped.</p>
            </div>
          </fieldset>

          <fieldset id="auto-release" class="space-y-4">
            <legend class="text-sm font-semibold leading-6 text-gray-900">Auto-Merge &amp; Auto-Release</legend>

            <div>
              <%= form.label :auto_merge_mode, "Auto-Merge", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2 max-w-xs">
                <%= form.select :auto_merge_mode,
                  Project::AUTO_MERGE_MODE_OPTIONS,
                  {},
                  class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">
                Automatically merge PRs when CI passes and all checks are green.
                In "Dependabot Only" and "All PRs" modes, Paid may run agents on Dependabot PRs when CI or merge conflicts need fixes.
                Dependabot PRs use a dependency-update merge path; GitHub branch protection rules still apply.
                "All PRs" merges any paid-ready PR, including Paid-generated and Dependabot PRs.
              </p>
              <% if @project.errors[:auto_merge_mode].any? %>
                <% @project.errors[:auto_merge_mode].each do |msg| %>
                  <p class="mt-1 text-xs text-red-600"><%= msg %></p>
                <% end %>
              <% end %>
            </div>

            <div class="flex items-start gap-3">
              <%= form.check_box :allow_bot_authored_pr_auto_merge, class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
              <div>
                <%= form.label :allow_bot_authored_pr_auto_merge, "Allow agent bot auto-merge without owner approval", class: "block text-sm font-medium leading-6 text-gray-900" %>
                <p class="text-xs text-gray-500">
                  When enabled, PRs authored by this project's GitHub App agent bot may auto-merge without an explicit owner approval review,
                  as long as CI is green and all other gates pass. Only applies to this project's own agent bot — third-party bots (Dependabot, Renovate) are unaffected.
                </p>
              </div>
            </div>

            <div>
              <%= form.label :auto_release_granularity, "Release PR Auto-Merge", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2 max-w-xs">
                <%= form.select :auto_release_granularity,
                  Project::AUTO_RELEASE_GRANULARITY_OPTIONS,
                  {},
                  class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">
                Controls which semver bump levels are auto-merged for release-please PRs.
                "Minor and below" includes both minor and patch bumps. "Major and below" includes all bump types.
                Note: 0.x versioning uses literal semver positions (0.22.0 → 0.23.0 is a minor bump).
              </p>
              <% if @project.errors[:auto_release_granularity].any? %>
                <% @project.errors[:auto_release_granularity].each do |msg| %>
                  <p class="mt-1 text-xs text-red-600"><%= msg %></p>
                <% end %>
              <% end %>
            </div>
          </fieldset>

          <%= render "screenshot_settings", form: form,
                screenshot_settings: @screenshot_settings,
                screenshot_service_options: @screenshot_service_options,
                screenshot_status: @screenshot_status,
                screenshot_repo_config_result: @screenshot_repo_config_result,
                screenshot_preview_config: @screenshot_preview_config,
                screenshot_conflicts: @screenshot_conflicts %>

          <fieldset id="pre-commit-requirements" class="space-y-3 rounded-md border border-gray-200 p-4">
            <legend class="px-1 text-sm font-semibold text-gray-900">Pre-Commit Requirements</legend>
            <p class="text-sm text-gray-600">
              Configure checks that run before Paid commits agent changes, including mutation testing.
            </p>
            <%= link_to "Manage pre-commit requirements", project_pre_commit_requirements_path(@project), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
          </fieldset>

          <fieldset id="egress-allowlist" class="space-y-3 rounded-md border border-gray-200 p-4">
            <legend class="px-1 text-sm font-semibold text-gray-900">Egress Allowlist</legend>
            <p class="text-sm text-gray-600">
              Allow additional outbound destinations that agent containers for this project can reach beyond Paid's secrets proxy and GitHub proxy.
            </p>
            <%= link_to "Manage egress allowlist", project_egress_allowlist_entries_path(@project), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
          </fieldset>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", project_path(@project), class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
          <%= form.submit "Save Changes",
            class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer",
            data: { project_settings_form_target: "saveButton" } %>
        </div>
      <% end %>
    </div>
  </div>
  <%# MCP Servers section %>
  <div id="mcp-servers" class="mt-6 bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">MCP Servers</h2>
          <p class="mt-1 text-sm text-gray-500">
            Associate MCP server definitions with this project. Agents will use these definitions during runs.
          </p>
        </div>
      </div>

      <% project_mcp_servers = @project_mcp_servers %>
      <% if project_mcp_servers.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Install Type</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Transport</th>
                <th scope="col" class="relative px-4 py-2"><span class="sr-only">Remove</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% project_mcp_servers.each do |pms| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-2 text-sm font-medium text-gray-900">
                    <%= link_to pms.mcp_server_definition.name, mcp_server_definition_path(pms.mcp_server_definition), class: "text-indigo-600 hover:text-indigo-900" %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-500"><%= pms.mcp_server_definition.install_type %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-500"><%= pms.mcp_server_definition.transport %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-right text-sm">
                    <%= button_to "Remove", project_project_mcp_server_path(@project, pms), method: :delete, class: "text-red-600 hover:text-red-900 text-sm font-medium", data: { turbo_confirm: "Remove this MCP server from the project?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @available_mcp_server_definitions.any? %>
        <%= form_with url: project_project_mcp_servers_path(@project), method: :post, class: "mt-4 flex items-end gap-x-3" do |f| %>
          <div>
            <%= f.label :mcp_server_definition_id, "Add MCP Server", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-1">
              <%= f.select :mcp_server_definition_id, @available_mcp_server_definitions.map { |m| ["#{m.name} (#{m.install_type})", m.id] }, {}, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
          </div>
          <%= f.submit "Add", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
        <% end %>
      <% elsif project_mcp_servers.empty? %>
        <div class="mt-4 text-sm text-gray-500">
          No MCP server definitions available. <%= link_to "Create one", new_mcp_server_definition_path, class: "text-indigo-600 hover:text-indigo-900" %> first.
        </div>
      <% end %>
    </div>
  </div>
  <%# Service Containers section %>
  <div class="mt-6 bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Service Containers</h2>
          <p class="mt-1 text-sm text-gray-500">
            Associate service containers with this project. Agents will receive connection environment variables (e.g. <code class="rounded bg-gray-100 px-1 py-0.5 text-xs">DATABASE_URL</code>) during runs.
          </p>
        </div>
        <%= button_to "Detect from Repo", detect_services_project_path(@project), method: :post, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" %>
      </div>

      <% project_service_containers = @project.project_service_containers.includes(:service_container).to_a %>
      <% if project_service_containers.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Image</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Port</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                <th scope="col" class="relative px-4 py-2"><span class="sr-only">Remove</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% project_service_containers.each do |psc| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-2 text-sm font-medium text-gray-900">
                    <%= link_to psc.service_container.name, service_container_path(psc.service_container), class: "text-indigo-600 hover:text-indigo-900" %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-500">
                    <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs"><%= psc.service_container.image %></code>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-500"><%= psc.service_container.port %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm">
                    <%= service_container_status_badge(psc.service_container.status) %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-right text-sm">
                    <%= button_to "Remove", project_project_service_container_path(@project, psc), method: :delete, class: "text-red-600 hover:text-red-900 text-sm font-medium", data: { turbo_confirm: "Remove this service container from the project?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @available_service_containers.any? %>
        <%= form_with url: project_project_service_containers_path(@project), method: :post, class: "mt-4 flex items-end gap-x-3" do |f| %>
          <div>
            <%= f.label :service_container_id, "Add Service Container", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-1">
              <%= f.select :service_container_id, @available_service_containers.map { |sc| ["#{sc.name} (#{sc.image})", sc.id] }, {}, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
          </div>
          <%= f.submit "Add", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
        <% end %>
      <% elsif project_service_containers.empty? %>
        <div class="mt-4 text-sm text-gray-500">
          No service containers available. <%= link_to "Create one", new_service_container_path, class: "text-indigo-600 hover:text-indigo-900" %> first.
        </div>
      <% end %>
    </div>
  </div>

  <% if policy(@project).destroy? %>
    <div class="mt-6 bg-white shadow sm:rounded-lg border border-red-200">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-lg font-semibold text-red-600">Danger Zone</h2>
        <p class="mt-1 text-sm text-gray-500">
          Permanently remove this project and all associated agent runs. This action cannot be undone.
        </p>

        <% persisted_name = @project.name_in_database %>
        <div class="mt-4" data-controller="confirm-delete" data-confirm-delete-name-value="<%= persisted_name %>">
          <label for="delete_confirmation" class="block text-sm font-medium leading-6 text-gray-900">
            Type <strong><%= persisted_name %></strong> to confirm deletion
          </label>
          <div class="mt-2 flex items-center gap-x-3">
            <input type="text" id="delete_confirmation" name="name_confirmation"
              form="delete-project-form"
              data-confirm-delete-target="input"
              data-action="input->confirm-delete#validate"
              class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6"
              placeholder="<%= persisted_name %>"
              autocomplete="off">
          </div>

          <%= button_to "Delete Project", project_path(@project),
            method: :delete,
            form: { id: "delete-project-form" },
            class: "mt-3 inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 disabled:opacity-50 disabled:cursor-not-allowed",
            data: { confirm_delete_target: "button" } %>
        </div>
      </div>
    </div>
  <% end %>
</div>
