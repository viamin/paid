<% content_for(:title) { "Edit #{@project.name} - Projects - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to project_path(@project), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to Project
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900">Edit Project</h1>
      <p class="mt-1 text-sm text-gray-500">
        Update settings for <%= @project.full_name %>.
      </p>

      <%= form_with model: @project, url: project_path(@project), method: :patch, class: "mt-6" do |form| %>
        <% if @project.errors.any? %>
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@project.errors.count, "error") %> prevented this project from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @project.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="space-y-6">
          <div class="rounded-md bg-gray-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-gray-700">
                  Repository: <strong><%= @project.full_name %></strong>
                </p>
                <p class="mt-1 text-xs text-gray-500">
                  Repository owner and name cannot be changed. Delete this project and add a new one to connect to a different repository.
                </p>
              </div>
            </div>
          </div>

          <div>
            <%= form.label :github_token_id, "GitHub Token", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.select :github_token_id,
                  options_from_collection_for_select(@github_tokens, :id, :name, @project.github_token_id),
                  {},
                  class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Select the token that has access to this repository.</p>
          </div>

          <div>
            <%= form.label :name, "Display Name", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", required: true %>
            </div>
            <p class="mt-1 text-xs text-gray-500">A friendly name for this project.</p>
          </div>

          <div>
            <%= form.label :poll_interval_seconds, "Poll Interval (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :poll_interval_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">How often to check for new issues (minimum 60 seconds).</p>
          </div>

          <div>
            <%= form.label :allowed_github_usernames, "Trusted GitHub Usernames", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <input type="text" name="project[allowed_github_usernames_csv]" id="project_allowed_github_usernames_csv"
                value="<%= @project.allowed_github_usernames.join(', ') %>"
                class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                placeholder="viamin, other-user" />
            </div>
            <p class="mt-1 text-xs text-gray-500">Comma-separated list of GitHub usernames whose issues are trusted. Issues from other users will never be sent to an LLM.</p>
            <div class="mt-2 rounded-md bg-yellow-50 p-3">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-xs text-yellow-700">
                    <strong>Security:</strong> Only add usernames you fully trust. Issue content from these users will be sent directly to AI agents. Untrusted users' issue bodies are never stored or sent to any LLM.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <%= form.label :owner_reviewer_login, "Owner Reviewer Login", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :owner_reviewer_login, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "github-username" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">GitHub username to request review from when the PR is ready. Must be in trusted usernames above.</p>
          </div>

          <div>
            <%= form.label :merge_method, "Merge Method", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.select :merge_method,
                  options_for_select(Project::MERGE_METHODS.map { |m| [m.capitalize, m] }, @project.merge_method),
                  {},
                  class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">How to merge pull requests when auto-merging on owner approval.</p>
          </div>

          <div>
            <%= form.label :max_draft_review_rounds, "Max Draft Review Rounds", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :max_draft_review_rounds, min: 0, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Maximum Copilot review rounds before escalating to the owner (0 to skip draft review phase).</p>
          </div>

          <div class="flex items-center">
            <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
            <%= form.label :active, "Active", class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
          </div>
          <p class="-mt-4 ml-7 text-xs text-gray-500">When inactive, the project will not be polled for new issues.</p>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", project_path(@project), class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
          <%= form.submit "Save Changes", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Service Containers section %>
  <div class="mt-6 bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900">Service Containers</h2>
      <p class="mt-1 text-sm text-gray-500">
        Associate service containers with this project. Agents will receive connection environment variables (e.g. <code class="rounded bg-gray-100 px-1 py-0.5 text-xs">DATABASE_URL</code>) during runs.
      </p>

      <% if @project.service_containers.any? %>
        <div class="mt-4">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Image</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Port</th>
                <th scope="col" class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                <th scope="col" class="relative px-4 py-2"><span class="sr-only">Remove</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @project.project_service_containers.includes(:service_container).each do |psc| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-2 text-sm font-medium text-gray-900">
                    <%= link_to psc.service_container.name, service_container_path(psc.service_container), class: "text-indigo-600 hover:text-indigo-900" %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-500">
                    <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs"><%= psc.service_container.image %></code>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-500"><%= psc.service_container.port %></td>
                  <td class="whitespace-nowrap px-4 py-2 text-sm">
                    <%= render_service_container_status(psc.service_container.status) %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2 text-right text-sm">
                    <%= button_to "Remove", project_project_service_container_path(@project, psc), method: :delete, class: "text-red-600 hover:text-red-900 text-sm font-medium", data: { turbo_confirm: "Remove this service container from the project?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if @available_service_containers.any? %>
        <div class="mt-4 flex items-end gap-x-3">
          <%= form_with url: project_project_service_containers_path(@project), method: :post, class: "flex items-end gap-x-3" do |f| %>
            <div>
              <%= f.label :service_container_id, "Add Service Container", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-1">
                <%= f.select :service_container_id, @available_service_containers.map { |sc| ["#{sc.name} (#{sc.image})", sc.id] }, {}, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
            </div>
            <%= f.submit "Add", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
          <% end %>
        </div>
      <% elsif @project.service_containers.empty? %>
        <div class="mt-4 text-sm text-gray-500">
          No service containers available. <%= link_to "Create one", new_service_container_path, class: "text-indigo-600 hover:text-indigo-900" %> first.
        </div>
      <% end %>
    </div>
  </div>
</div>
