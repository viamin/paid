<%# @spec INTENT-CONFORMANCE-ROLLOUT-006 @spec INTENT-CONFORMANCE-ROLLOUT-012 @spec INTENT-CONFORMANCE-ROLLOUT-013 %>
<% remaining = progress[:total] - progress[:labeled] - progress[:skipped] %>
<% finish_blocked = remaining.positive? || progress[:skipped].positive? %>
<% if case_view && case_view.exists? %>
  <% current = case_view.blinded_payload %>
  <%= turbo_frame_tag "review_context_#{evaluation.id}_#{current['id']}", src: evidence_project_shadow_evaluation_path(project, evaluation, case_id: current["id"], kind: "review_context", **inbox_context) do %>
    <div role="status" aria-live="polite" class="flex min-h-64 items-center justify-center rounded-xl border-2 border-violet-500 bg-white p-8">
      <div class="max-w-md text-center">
        <svg aria-hidden="true" class="mx-auto size-8 text-violet-600 motion-safe:animate-spin dark:text-violet-400" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0A12 12 0 0 0 0 12h4Z"></path>
        </svg>
        <h2 class="mt-4 text-lg font-semibold text-gray-900">Loading your review…</h2>
        <p class="mt-2 text-base text-gray-700">Fetching the change summary, approved requirements, and code changes. This may take a few seconds.</p>
      </div>
    </div>
  <% end %>
<% elsif progress[:skipped].positive? %>
  <div class="rounded-xl border border-gray-200 bg-white p-6 text-sm text-gray-700">
    <h2 class="font-semibold text-gray-900">Changes left for later</h2>
    <p class="mt-2">Return to these changes after their evidence is ready.</p>
    <% evaluation.labels.where(state: "skipped").pluck(:case_id).each_with_index do |case_id, index| %>
      <%= link_to "Review remaining change #{index + 1}", project_shadow_evaluation_path(project, evaluation, case_id:, **inbox_context), data: { turbo_frame: "_top" }, class: "mt-3 mr-3 inline-block text-violet-700 underline" %>
    <% end %>
  </div>
<% end %>

<div class="rounded-xl border border-gray-200 bg-white p-4" data-labeling-progress>
  <h2 class="font-semibold text-gray-900">Your review: <%= progress[:labeled] %> of <%= progress[:total] %> reviewed · <%= progress[:skipped] %> left for later</h2>
  <progress class="mt-3 h-2 w-full accent-violet-600" value="<%= progress[:labeled] %>" max="<%= [progress[:total], 1].max %>" aria-label="Changes reviewed"></progress>
  <p class="mt-2 text-sm text-gray-600">AI results stay hidden until you finish your review, so your decisions remain independent. You can save your progress and return later.</p>
</div>
<div class="rounded-xl border border-gray-200 bg-white p-6">
  <h2 class="font-semibold text-gray-900">Finish your review</h2>
  <p id="finish-review-help" class="mt-2 text-sm text-gray-600">Finishing locks your original decisions for comparison with the AI reviewer. You can record corrections afterward; the originals stay in the history. Running the AI comparison is a separate action. Finishing does not approve pull requests or enable enforcement.</p>
  <% if finish_blocked %>
    <p class="mt-2 text-sm text-amber-900">Review all <%= progress[:total] %> changes before finishing. Cases with missing evidence need preparing first.</p>
  <% end %>
  <%= button_to "Finish my review", freeze_project_shadow_evaluation_path(project, evaluation, **inbox_context), disabled: finish_blocked, aria: { describedby: "finish-review-help" }, form: { data: { turbo_frame: "_top", turbo_confirm: "Finish your review and lock your original decisions? This will not run the AI reviewer or approve pull requests." } }, class: "mt-4 inline-flex items-center rounded-md bg-violet-600 px-4 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-50" %>
</div>
