<%# Post-freeze surface: answers (strata, reviewer outputs) are visible here.
    Disagreements surface for maintainer review; revisions append without
    overwriting originals. @spec INTENT-CONFORMANCE-ROLLOUT-007 @spec INTENT-CONFORMANCE-ROLLOUT-008 %>
<% cases = evaluation.corpus.cases %>
<% labels = evaluation.labels.index_by(&:case_id) %>
<% runs = evaluation.runs.index_by(&:case_id) %>

<div class="rounded-xl border border-gray-200 bg-white p-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-gray-900">Your review is complete</h2>
      <p class="text-xs text-gray-500">
        Original decisions locked on <%= evaluation.labels_frozen_at&.strftime("%Y-%m-%d %H:%M UTC") %>.
        AI comparison: <span data-evaluation-execution><%= evaluation.status %></span>
        · progress <%= runs.values.count(&:evaluated?) %>/<%= cases.length %> evaluated
        · cost <%= number_to_currency(runs.values.sum(&:cost_cents) / 100.0) %><% if evaluation.cancellation_requested? %> · cancellation requested<% end %><% if evaluation.last_failure_reason.present? %> — <%= evaluation.last_failure_reason %><% end %>.
      </p>
    </div>
    <% if evaluation.queued? || evaluation.running? %>
      <%= button_to "Stop AI comparison", cancel_project_shadow_evaluation_path(project, evaluation, **inbox_context),
            form: { data: { turbo_frame: "_top", turbo_confirm: "Stop after the current case? Collected evidence will be retained." } },
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-300 hover:bg-red-50" %>
    <% elsif !evaluation.completed? && (evaluation.frozen? || evaluation.failed? || evaluation.partial? || evaluation.cancelled?) %>
      <%= button_to evaluation.runs.exists? ? "Retry unfinished AI reviews" : "Run AI comparison", execute_project_shadow_evaluation_path(project, evaluation, **inbox_context),
            form: { data: { turbo_frame: "_top", turbo_confirm: "Ask the AI reviewer to assess these changes? This uses your configured model and incurs usage costs. It does not enable enforcement." } },
            class: "inline-flex items-center rounded-md bg-violet-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-500" %>
    <% end %>
  </div>
  <p class="mt-2 text-sm text-gray-600">Running the comparison asks the AI to review the same changes and compares its answers with yours. It does not enable merge enforcement or change your original decisions.</p>
</div>

<% if evaluation.report_markdown.present? %>
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h2 class="text-sm font-semibold text-gray-900">Comparison report</h2>
    <pre class="mt-3 overflow-x-auto whitespace-pre-wrap text-xs text-gray-700"><%= operator_report_markdown(evaluation.report_markdown) %></pre>
  </div>
<% elsif evaluation.runs.exists? %>
  <p class="text-sm text-gray-600">Reviewer runs are recorded; the report compiles after execution completes.</p>
<% end %>

<div class="space-y-3 rounded-xl border border-gray-200 bg-white p-6">
  <h2 class="text-sm font-semibold text-gray-900">Your decisions and the AI results</h2>
  <table class="w-full text-left text-sm">
    <thead>
      <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
        <th class="py-2 pr-3">Case</th>
        <th class="py-2 pr-3">Sample category</th>
        <th class="py-2 pr-3">Your decision</th>
        <th class="py-2 pr-3">AI decision</th>
        <th class="py-2 pr-3">Revision</th>
      </tr>
    </thead>
    <tbody>
      <% cases.each do |corpus_case| %>
        <% case_id = corpus_case.fetch("id") %>
        <% label = labels[case_id] %>
        <% run = runs[case_id] %>
        <% disagreement = label&.labeled? && run.present? && !run.not_evaluated? && label.outcome != run.verdict %>
        <%= content_tag :tr,
              class: class_names("border-b border-gray-100", "bg-amber-50": disagreement),
              data: { case: case_id, disagreement: (true if disagreement) } do %>
          <td class="py-2 pr-3 font-medium text-gray-900"><%= case_id %></td>
          <td class="py-2 pr-3 text-gray-600"><%= corpus_case["stratum"].to_s.humanize %></td>
          <td class="py-2 pr-3"><%= review_decision_text(label&.outcome) %></td>
          <td class="py-2 pr-3"><%= review_decision_text(run&.verdict) %><% if run&.failure_reason.present? %> <span class="text-xs text-red-700"><%= run.failure_reason %></span><% end %></td>
          <td class="py-2 pr-3 text-xs text-gray-600">
            <% if label&.revised? %>
              <%= review_decision_text(label.revised_outcome) %> (original: <%= review_decision_text(label.outcome) %>)
            <% elsif disagreement %>
              <%# Revision form: appends a reasoned revision; the original label is preserved. %>
              <%= form_with url: revise_project_shadow_evaluation_path(project, evaluation, **inbox_context), method: :post, class: "flex flex-wrap items-center gap-2" do |form| %>
                <%= form.hidden_field :case_id, value: case_id %>
                <%= form.select :revised_outcome, options_for_select(%w[within_scope material_drift uncertain].map { |outcome| [review_decision_text(outcome), outcome] }, run.verdict), { }, aria: { label: "Corrected decision" }, class: "rounded-md border-gray-300 text-xs shadow-sm" %>
                <%= form.text_field :reason, placeholder: "Why are you correcting your decision?", required: true, aria: { label: "Reason for correction" }, class: "w-48 rounded-md border-gray-300 text-xs shadow-sm" %>
                <%= form.submit "Save correction", class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
              <% end %>
            <% end %>
          </td>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <p class="text-xs text-gray-500">
    Highlighted rows show where you and the AI disagree. You can record a correction and explain why;
    your original decision remains saved and is still used for the original comparison.
  </p>
</div>
