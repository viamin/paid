<%# Post-freeze surface: answers (strata, reviewer outputs) are visible here.
    Disagreements surface for maintainer review; revisions append without
    overwriting originals. @spec INTENT-CONFORMANCE-ROLLOUT-007 @spec INTENT-CONFORMANCE-ROLLOUT-008 %>
<% cases = evaluation.corpus.cases %>
<% labels = evaluation.labels.index_by(&:case_id) %>
<% runs = evaluation.runs.index_by(&:case_id) %>

<div class="rounded-xl border border-gray-200 bg-white p-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-gray-900">Reference set frozen</h2>
      <p class="text-xs text-gray-500">
        Frozen <%= evaluation.labels_frozen_at&.strftime("%Y-%m-%d %H:%M UTC") %> · answers visible from here on.
        Execution state: <span data-evaluation-execution><%= evaluation.status %></span> ·
        <%= evaluation.execution_progress[:completed] %>/<%= evaluation.execution_progress[:total] %> evaluated ·
        <%= number_to_currency(evaluation.execution_progress[:cost_cents] / 100.0) %> recorded cost<% if evaluation.last_failure_reason.present? %> — <%= evaluation.last_failure_reason %><% end %>.
      </p>
    </div>
    <% if evaluation.frozen? || evaluation.failed? || evaluation.partial? || evaluation.cancelled? %>
      <%= button_to "Queue reviewer execution", execute_project_shadow_evaluation_path(project, evaluation, **inbox_context),
            form: { data: { turbo_frame: "_top", turbo_confirm: "Run the real conformance reviewer for every case through agent_harness? Costs apply." } },
            class: "inline-flex items-center rounded-md bg-violet-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-500" %>
    <% end %>
    <% if evaluation.execution_active? %>
      <%= button_to "Cancel execution", cancel_project_shadow_evaluation_path(project, evaluation, **inbox_context),
            form: { data: { turbo_frame: "_top", turbo_confirm: "Stop after the current case? Collected evidence will be preserved." } },
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <% end %>
  </div>
  <p class="mt-2 text-xs text-gray-500">
    Execution is queued and may be cancelled between cases. Retry resumes only cases without an evaluated verdict.
    Prerequisite validation alone is never execution.
  </p>
</div>

<% if evaluation.report_markdown.present? %>
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h2 class="text-sm font-semibold text-gray-900">Reproducible report</h2>
    <pre class="mt-3 overflow-x-auto whitespace-pre-wrap text-xs text-gray-700"><%= evaluation.report_markdown %></pre>
  </div>
<% elsif evaluation.runs.exists? %>
  <p class="text-sm text-gray-600">Reviewer runs are recorded; the report compiles after execution completes.</p>
<% end %>

<div class="space-y-3 rounded-xl border border-gray-200 bg-white p-6">
  <h2 class="text-sm font-semibold text-gray-900">Cases: reference labels vs reviewer verdicts</h2>
  <table class="w-full text-left text-sm">
    <thead>
      <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
        <th class="py-2 pr-3">Case</th>
        <th class="py-2 pr-3">Stratum</th>
        <th class="py-2 pr-3">Reference</th>
        <th class="py-2 pr-3">Reviewer</th>
        <th class="py-2 pr-3">Revision</th>
      </tr>
    </thead>
    <tbody>
      <% cases.each do |corpus_case| %>
        <% case_id = corpus_case.fetch("id") %>
        <% label = labels[case_id] %>
        <% run = runs[case_id] %>
        <% disagreement = label&.labeled? && run.present? && !run.not_evaluated? && label.outcome != run.verdict %>
        <%= content_tag :tr,
              class: class_names("border-b border-gray-100", "bg-amber-50": disagreement),
              data: { case: case_id, disagreement: (true if disagreement) } do %>
          <td class="py-2 pr-3 font-medium text-gray-900"><%= case_id %></td>
          <td class="py-2 pr-3 text-gray-600"><%= corpus_case["stratum"] %></td>
          <td class="py-2 pr-3"><code><%= label&.outcome %></code></td>
          <td class="py-2 pr-3"><code><%= run&.verdict %></code><% if run&.failure_reason.present? %> <span class="text-xs text-red-700"><%= run.failure_reason %></span><% end %></td>
          <td class="py-2 pr-3 text-xs text-gray-600">
            <% if label&.revised? %>
              <%= label.revised_outcome %> (was <%= label.outcome %>)
            <% elsif disagreement %>
              <%# Revision form: appends a reasoned revision; the original label is preserved. %>
              <%= form_with url: revise_project_shadow_evaluation_path(project, evaluation, **inbox_context), method: :post, class: "flex flex-wrap items-center gap-2" do |form| %>
                <%= form.hidden_field :case_id, value: case_id %>
                <%= form.select :revised_outcome, options_for_select(%w[within_scope material_drift uncertain], run.verdict), {}, class: "rounded-md border-gray-300 text-xs shadow-sm" %>
                <%= form.text_field :reason, placeholder: "reason", required: true, class: "w-48 rounded-md border-gray-300 text-xs shadow-sm" %>
                <%= form.submit "Append revision", class: "rounded-md bg-white px-2 py-1 text-xs font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
              <% end %>
            <% end %>
          </td>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <p class="text-xs text-gray-500">
    Highlighted rows are disagreements for maintainer review. A revision is appended with its own reason; the original
    blinded label and every score derived from it are preserved.
  </p>
</div>
