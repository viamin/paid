<%# @spec AUTOMATION-PHASES-002 @spec AUTOMATION-PHASES-015 @spec AUTOMATION-PHASES-016 %>
<% content_for(:title) { "Automation phases - #{@project.full_name}" } %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">Automation phases</h1>
    <p class="mt-1 text-sm text-gray-500">
      Choose which responsibility phases Paid may automate for
      <strong><%= @project.full_name %></strong>. Disabling a phase keeps every capability value you configured for it.
    </p>
    <% unless @rollout_enabled %>
      <p class="mt-2 rounded-md bg-gray-100 p-3 text-sm text-gray-700">
        The phase model is not enabled for this project yet. These settings are stored but have no runtime effect
        until the <code>automation_phases</code> rollout is enabled for it.
      </p>
    <% end %>
  </div>

  <%= form_with url: project_automation_phases_path(@project), method: :patch,
        scope: :project, class: "space-y-6" do %>
    <div class="space-y-4">
      <% @phases.each do |phase| %>
        <section class="rounded-lg border border-gray-200 bg-white p-4">
          <label class="flex items-start gap-3">
            <%= check_box_tag "project[phases][#{phase}]", "1", @phase_settings.phase_enabled?(phase),
                  class: "mt-1 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            <span>
              <span class="block text-sm font-semibold text-gray-900"><%= Automation::Phases.label(phase) %></span>
              <span class="block text-xs text-gray-500"><%= Automation::Phases::RESPONSIBILITIES.fetch(phase) %></span>
            </span>
          </label>

          <% if phase == Automation::Phases::RELEASE_DEPLOYMENT %>
            <div class="mt-3 space-y-2 border-l-2 border-gray-100 pl-4">
              <label class="flex items-center gap-2 text-sm text-gray-700">
                <%= hidden_field_tag "project[release]", "0" %>
                <%= check_box_tag "project[release]", "1", @phase_settings.release_enabled?,
                      class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
                Allow automatic releases
              </label>
              <label class="flex items-center gap-2 text-sm text-gray-700">
                <%= hidden_field_tag "project[deployment]", "0" %>
                <%= check_box_tag "project[deployment]", "1", @phase_settings.deployment_enabled?,
                      class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
                Allow automatic deployments
              </label>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>

    <div class="flex justify-end">
      <%= submit_tag "Save phases", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
    </div>
  <% end %>

  <section class="mt-8 rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-gray-900">Migration preview</h2>
    <p class="mt-1 text-sm text-gray-500">
      Derived from this project's current capabilities. Nothing here is applied until you enable the rollout.
    </p>
    <dl class="mt-3 grid gap-2 text-sm text-gray-700 sm:grid-cols-2">
      <% @migration_preview.derived_settings[Automation::PhaseSettings::PHASES_KEY].each do |phase, enabled| %>
        <div class="flex items-center justify-between rounded border border-gray-100 px-3 py-2">
          <dt><%= Automation::Phases.label(phase) %></dt>
          <dd class="font-medium"><%= enabled ? "enabled" : "disabled" %></dd>
        </div>
      <% end %>
    </dl>
    <p class="mt-3 text-sm text-gray-700">
      Inbox requests that would leave the default list: <strong><%= @migration_preview.inbox_changes_count %></strong>.
      Active continuation grants: <strong><%= @migration_preview.active_grants %></strong>.
    </p>
  </section>

  <section class="mt-8">
    <h2 class="text-sm font-semibold text-gray-900">Continuation grants</h2>
    <% if @active_grants.empty? %>
      <p class="mt-2 text-sm text-gray-500">No active continuation grants for this project.</p>
    <% else %>
      <ul class="mt-2 divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white">
        <% @active_grants.each do |grant| %>
          <li class="flex items-center justify-between gap-4 p-3 text-sm">
            <div>
              <div class="font-medium text-gray-900">
                <%= grant.issue&.title.presence || "Issue ##{grant.issue_id}" %>
              </div>
              <div class="text-xs text-gray-500">
                <%= Automation::Phases.label(grant.start_phase) %> → <%= Automation::Phases.label(grant.endpoint) %>
                · granted <%= grant.created_at.to_date %>
              </div>
            </div>
            <%= button_to "Revoke",
                  project_automation_phases_continuation_grant_path(@project, grant),
                  method: :delete,
                  class: "rounded-md border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50",
                  form: { data: { turbo_confirm: "Revoke this continuation grant? Project settings may still permit this work." } } %>
            <% endpoints = Automation::Phases.endpoints_for(grant.start_phase) - grant.covered_phases %>
            <% if endpoints.any? %>
              <%= form_with url: extend_continuation_grant_project_automation_phases_path(@project, grant), method: :patch, class: "flex items-center gap-2" do %>
                <%= select_tag :endpoint, options_for_select(endpoints.map { |endpoint| [ Automation::Phases.label(endpoint), endpoint ] }), class: "rounded border-gray-300 px-2 py-1 text-xs" %>
                <%= submit_tag "Extend", class: "rounded-md border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50" %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%# @spec PROJECT-DELEGATION-001 %>
  <% if @delegation_posture %>
  <section class="mt-8 rounded-lg border border-gray-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-gray-900">Delegation posture</h2>
    <p class="mt-1 text-sm text-gray-500">
      How far Paid may take downstream delivery decisions on its own after intent is settled.
      The effective posture never grants execution authority; phase settings and bounded
      authorizations still govern every run.
    </p>
    <dl class="mt-3 grid gap-2 text-sm text-gray-700 sm:grid-cols-2">
      <div class="flex items-center justify-between rounded border border-gray-100 px-3 py-2">
        <dt>Effective posture</dt>
        <dd class="font-medium"><%= @delegation_posture.level %> (<%= @delegation_posture.source %>)</dd>
      </div>
      <div class="flex items-center justify-between rounded border border-gray-100 px-3 py-2">
        <dt>Revision</dt>
        <dd class="font-medium"><%= @delegation_posture.revision %></dd>
      </div>
      <div class="flex items-center justify-between rounded border border-gray-100 px-3 py-2 sm:col-span-2">
        <dt>Enabled action classes</dt>
        <dd class="font-medium">
          <% if @delegation_posture.enabled_action_classes.any? %>
            <%= @delegation_posture.enabled_action_classes.map(&:humanize).to_sentence %>
          <% else %>
            None — Paid keeps surfacing every downstream decision
          <% end %>
        </dd>
      </div>
    </dl>

    <div class="mt-3 rounded border border-gray-100 p-3">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">Remaining human reviews</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-700">
        <% @delegation_posture.remaining_reviews.each do |review| %>
          <li><%= review[:description] %></li>
        <% end %>
      </ul>
    </div>

    <% if @delegation_posture.source == "guard_disabled" %>
      <p class="mt-3 rounded-md bg-gray-100 p-3 text-sm text-gray-700">
        A broader posture was selected, but delegation is not enabled for this project right now,
        so the effective posture stays conservative.
      </p>
    <% end %>

    <%= form_with url: project_delegation_posture_path(@project), method: :patch,
          scope: :project_delegation_posture, class: "mt-4 space-y-3" do %>
      <div class="space-y-2">
        <label class="flex items-start gap-3 text-sm text-gray-700">
          <%= radio_button_tag "project_delegation_posture[level]", "conservative",
                @delegation_posture.level == "conservative",
                class: "mt-1 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          <span>
            <span class="block font-semibold text-gray-900">Conservative (default)</span>
            <span class="block text-xs text-gray-500">
              <%= ProjectDelegation::PostureDisplay::SUMMARIES.fetch("conservative") %>
            </span>
          </span>
        </label>
        <label class="flex items-start gap-3 text-sm <%= @delegation_guards_enabled ? "text-gray-700" : "text-gray-400" %>">
          <%= radio_button_tag "project_delegation_posture[level]", "bounded_delivery",
                @delegation_posture.level == "bounded_delivery" && @delegation_posture.source == "selected",
                disabled: !@delegation_guards_enabled,
                class: "mt-1 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          <span>
            <span class="block font-semibold text-gray-900">Bounded delivery</span>
            <span class="block text-xs text-gray-500">
              <%= ProjectDelegation::PostureDisplay::SUMMARIES.fetch("bounded_delivery") %>
              <% unless @delegation_guards_enabled %>
                Requires the automation_phases rollout and the project_delegation capability to be enabled.
              <% end %>
            </span>
          </span>
        </label>
      </div>
      <div class="flex justify-end">
        <%= submit_tag "Save posture", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      </div>
    <% end %>
  </section>
  <% end %>

  <%# @spec PROJECT-DELEGATION-005 %>
  <% if @delegation_projection %>
  <section class="mt-8">
    <h2 class="text-sm font-semibold text-gray-900">Delegated delivery actions</h2>
    <p class="mt-1 text-sm text-gray-500">
      Read from the shared delegation projection: each work item's newest bounded authorization, its lifecycle,
      and the current effective policy for its phase. No surface infers this from labels or queue state.
    </p>
    <% if @delegation_projection.authorizations.empty? %>
      <p class="mt-2 text-sm text-gray-500">No delegated delivery actions for this project.</p>
    <% else %>
      <ul class="mt-2 divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white">
        <% @delegation_projection.authorizations.each do |state| %>
          <% work_item = @delegation_work_items[state.work_item_id] %>
          <li class="p-3 text-sm">
            <div class="font-medium text-gray-900">
              <%= work_item&.title.presence || "Issue ##{state.work_item_id}" %>
            </div>
            <div class="mt-1 text-xs text-gray-500">
              <%= state.action %> in <%= Automation::Phases.label(state.phase) %>
              · stops before <%= Automation::Phases.label(state.stop_before_phase) %>
              · <%= state.in_force? ? "in force" : state.expired? ? "expired" : state.status %>
              <% if state.expires_at %>
                · expires <%= state.expires_at.to_date %>
              <% end %>
              · <%= Automation::Phases.label(state.phase) %> currently
              <%= state.authority.permitted? ? "permitted" : "not permitted" %>
              <% if state.authority.source %>
                through <%= state.authority.source.to_s.humanize(capitalize: false) %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
  <% end %>
</div>
