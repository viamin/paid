<div id="<%= dom_id(project, :knowledge) %>" class="mt-8">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <h2 class="text-lg font-medium text-gray-900">Knowledge Base</h2>
      <% status = project.knowledge_status.to_s %>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
        <%= case status
            when 'ready' then 'bg-green-100 text-green-700'
            when 'collecting' then 'bg-blue-100 text-blue-700'
            when 'failed' then 'bg-red-100 text-red-700'
            when 'stale' then 'bg-yellow-100 text-yellow-700'
            when 'pending' then 'bg-gray-100 text-gray-600'
            else 'bg-gray-100 text-gray-500'
            end %>">
        <%= case status
            when 'ready' then 'Ready'
            when 'collecting' then 'Collecting'
            when 'failed' then 'Failed'
            when 'stale' then 'Stale'
            when 'pending' then 'Pending'
            else 'Unknown'
            end %>
      </span>
    </div>
    <%= link_to "Search", knowledge_search_path(project_id: project.id), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>

  <% if collector_runs.any? %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Type</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Version</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Duration</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Artifacts</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">When</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% collector_runs.each do |run| %>
            <tr>
              <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900">
                <%= run.collector_type %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500">
                <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs"><%= run.project_version.commit_sha.first(7) %></code>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                  <%= case run.status.to_s
                      when 'completed' then 'bg-green-100 text-green-700'
                      when 'failed' then 'bg-red-100 text-red-700'
                      when 'running' then 'bg-blue-100 text-blue-700'
                      when 'pending' then 'bg-gray-100 text-gray-600'
                      when 'stale' then 'bg-yellow-100 text-yellow-700'
                      else 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= run.status&.capitalize || "Unknown" %>
                </span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <% if run.duration_ms %>
                  <%= format("%.1fs", run.duration_ms / 1000.0) %>
                <% else %>
                  --
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <%= run.artifacts_count || 0 %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <% if run.completed_at %>
                  <%= time_ago_in_words(run.completed_at) %> ago
                <% elsif run.created_at %>
                  <%= time_ago_in_words(run.created_at) %> ago
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 text-sm text-gray-500">No collector runs yet.</div>
    </div>
  <% end %>
</div>
