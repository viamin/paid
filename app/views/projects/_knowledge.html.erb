<div id="<%= dom_id(project, :knowledge) %>" class="mt-8">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <h2 class="text-lg font-medium text-gray-900">Knowledge Base</h2>
      <% status = project.knowledge_status.to_s %>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
        <%= case status
            when 'ready' then 'bg-green-100 text-green-700'
            when 'collecting' then 'bg-blue-100 text-blue-700'
            when 'failed' then 'bg-red-100 text-red-700'
            when 'stale' then 'bg-yellow-100 text-yellow-700'
            when 'pending' then 'bg-gray-100 text-gray-600'
            else 'bg-gray-100 text-gray-500'
            end %>">
        <%= case status
            when 'ready' then 'Ready'
            when 'collecting' then 'Collecting'
            when 'failed' then 'Failed'
            when 'stale' then 'Stale'
            when 'pending' then 'Pending'
            else 'Unknown'
            end %>
      </span>
    </div>
    <%= link_to "Search", knowledge_search_path(project_id: project.id), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>

  <% if status == 'failed' %>
    <% latest_project_version = project.project_versions.by_recency.first %>
    <% latest_version_id = latest_project_version&.id %>
    <% failed_runs = collector_runs.select { |r| r.status == "failed" && r.project_version_id == latest_version_id } %>
    <div class="mt-3 rounded-md bg-red-50 px-4 py-3" role="alert">
      <div class="flex">
        <svg class="h-5 w-5 flex-shrink-0 text-red-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Knowledge collection failed</h3>
          <% if failed_runs.any? %>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc space-y-1 pl-5">
                <% failed_runs.each do |run| %>
                  <li>
                    <span class="font-medium"><%= run.collector_type %></span><% if run.error_message.present? %>: <%= truncate(run.error_message, length: 200) %><% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% else %>
            <p class="mt-1 text-sm text-red-700">The collection job failed before collectors could run. Check the application logs for details.</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% openai_key_record = project.openai_provider_api_key_record %>
  <% if project.semantic_search_available? %>
    <div class="mt-3 flex items-center rounded-md bg-green-50 px-3 py-2">
      <svg class="h-4 w-4 flex-shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
      </svg>
      <p class="ml-2 text-sm text-green-700">
        Embeddings and semantic search are configured
        <% if openai_key_record %>
          using key "<%= openai_key_record.name %>".
        <% else %>
          via platform configuration.
        <% end %>
      </p>
    </div>
  <% else %>
    <div class="mt-3 flex items-start rounded-md bg-yellow-50 px-3 py-2">
      <svg class="h-4 w-4 flex-shrink-0 text-yellow-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
      </svg>
      <div class="ml-2">
        <p class="text-sm text-yellow-700">Embeddings and semantic search are not currently available. An OpenAI API key is required to enable them.</p>
        <p class="mt-1 text-sm">
          <%= link_to "Add an API key", provider_api_keys_path, class: "font-medium text-yellow-700 underline hover:text-yellow-600" %>
        </p>
      </div>
    </div>
  <% end %>

  <% if collector_runs.any? %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Type</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Version</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Duration</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Artifacts</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">When</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% collector_runs.each do |run| %>
            <tr>
              <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900">
                <%= run.collector_type %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500">
                <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs"><%= run.project_version.commit_sha.first(7) %></code>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                  <%= case run.status.to_s
                      when 'completed' then 'bg-green-100 text-green-700'
                      when 'failed' then 'bg-red-100 text-red-700'
                      when 'running' then 'bg-blue-100 text-blue-700'
                      when 'pending' then 'bg-gray-100 text-gray-600'
                      when 'stale' then 'bg-yellow-100 text-yellow-700'
                      else 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= run.status&.capitalize || "Unknown" %>
                </span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <% if run.duration_ms %>
                  <%= format("%.1fs", run.duration_ms / 1000.0) %>
                <% else %>
                  --
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <%= run.artifacts_count || 0 %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <% if run.completed_at %>
                  <%= time_ago_in_words(run.completed_at) %> ago
                <% elsif run.created_at %>
                  <%= time_ago_in_words(run.created_at) %> ago
                <% end %>
              </td>
            </tr>
            <% if run.status == "failed" && run.error_message.present? %>
              <tr class="bg-red-50">
                <td colspan="6" class="px-4 py-2 text-xs text-red-700">
                  <span class="font-medium">Error:</span> <%= truncate(run.error_message, length: 300) %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 text-sm text-gray-500">No collector runs yet.</div>
    </div>
  <% end %>
</div>
