<%# Setup guidance for blank-origin projects (issue #3954).
    Chat is the default recommendation because the most bootstrap context
    can be captured interactively. @spec PROJECT-CREATION-007 %>
<% return unless project.setup_pending? %>

<div id="setup" class="mb-4 rounded-md bg-indigo-50 p-4 ring-1 ring-inset ring-indigo-200" data-testid="project-setup-banner">
  <div class="flex">
    <div class="flex-shrink-0">
      <svg class="h-5 w-5 text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd" />
      </svg>
    </div>
    <div class="ml-3 w-full">
      <h3 class="text-sm font-medium text-indigo-800">Finish setting up your new project</h3>
      <p class="mt-1 text-sm text-indigo-700">
        <code class="rounded bg-indigo-100 px-1"><%= project.full_name %></code> was created as a blank repository.
        Agent runs start from a blank slate and need the initial tooling choices — language/framework,
        dependencies, CI, testing, and repo conventions — before they can build anything meaningful.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <% if policy(ChatSession.new(account: project.account, project: project)).create? %>
          <%= button_to "Set up in chat (recommended)", start_setup_chat_project_path(project), method: :post,
            class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
        <% end %>
        <%= link_to "Fill out the setup questionnaire", project_context_intake_path(project),
          class: "text-sm font-medium text-indigo-700 underline hover:text-indigo-900" %>
        <%= link_to "Answer the GitHub bootstrap issue", "#{project.github_url}/issues", target: "_blank", rel: "noopener",
          class: "text-sm font-medium text-indigo-700 underline hover:text-indigo-900" %>
      </div>
      <% if policy(project).update? %>
        <div class="mt-2">
          <%= button_to "Skip — mark setup complete", finish_setup_project_path(project), method: :post,
            form: { class: "inline" },
            class: "text-xs font-medium text-indigo-500 underline hover:text-indigo-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
