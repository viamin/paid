<details class="relative" data-testid="layered-verification-audit-request">
  <summary class="inline-flex cursor-pointer items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
    Request audit
  </summary>
  <div class="absolute right-0 z-10 mt-2 w-full max-w-xl rounded-md border border-gray-200 bg-white p-4 shadow-lg sm:w-[36rem]">
    <h2 class="text-sm font-semibold text-gray-900">Layered verification audit</h2>
    <p class="mt-1 text-sm text-gray-600">Review the selected scope, revision, and budget before dispatch. Audits record findings only and never start repair.</p>
    <% if obligations.any? %>
      <%= form_with url: request_layered_verification_audit_project_agent_runs_path(project), method: :post, local: true, class: "mt-4 space-y-4" do |form| %>
        <fieldset>
          <legend class="text-sm font-medium text-gray-700">Scope</legend>
          <div class="mt-2 max-h-40 space-y-2 overflow-y-auto">
            <% obligations.each do |obligation| %>
              <div class="rounded-md border border-gray-200 p-2">
                <label class="flex gap-2 text-sm text-gray-700">
                  <%= check_box_tag "obligation_ids[]", obligation.id, false, id: dom_id(obligation, :audit) %>
                  <span><%= obligation.scope_description %> <span class="text-gray-500">(<%= obligation.external_identity %>)</span></span>
                </label>
                <label class="ml-6 mt-2 flex gap-2 text-xs text-gray-600">
                  <%= check_box_tag "selections[#{obligation.id}][selected_checks][]", "semantic_audit", true, id: dom_id(obligation, :semantic_audit) %>
                  <span>Semantic audit</span>
                </label>
              </div>
            <% end %>
          </div>
        </fieldset>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :target_revision, "Revision", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :target_revision, value: project.default_branch, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
          </div>
          <div>
            <%= label_tag "budget_max_minutes", "Budget (minutes)", class: "block text-sm font-medium text-gray-700" %>
            <%= number_field_tag "budget[max_minutes]", 15, id: "budget_max_minutes", min: 1, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
          </div>
        </div>
        <%= form.submit "Preview audit", class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% end %>
    <% else %>
      <p class="mt-3 text-sm text-gray-600">No verification obligations are available to audit.</p>
    <% end %>
  </div>
</details>
