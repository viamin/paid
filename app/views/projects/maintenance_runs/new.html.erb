<% content_for(:title) { "Start maintenance run - #{@project.name} - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to project_agent_runs_path(@project), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to <%= @project.name %> runs
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg dark:bg-gray-800">
    <div class="border-b border-gray-200 px-4 py-5 sm:px-6 dark:border-gray-700">
      <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Maintenance run</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Report-only investigation of this repository. No issue or pull request is required, and the scan never changes source files.
      </p>
    </div>

    <%= form_with url: project_maintenance_runs_path(@project), method: :post, local: true, class: "px-4 py-5 sm:px-6" do %>
      <div class="space-y-6">
        <div>
          <%= label_tag :objective, "Objective", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Optional recipe objective. Leave unselected to ask a free-text maintenance question below.</p>
          <%= select_tag :objective, options_for_select([["(free-text question)", nil]] + MaintenanceRuns::Recipes::ALL.values.map { |recipe| [recipe.name, recipe.key] }), class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100" %>
        </div>

        <div>
          <%= label_tag :guidance, "Maintenance question / guidance", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">What should the investigation establish? Required unless a recipe objective is selected. Captured verbatim for the report.</p>
          <%= text_area_tag :guidance, params[:guidance], rows: 4, required: false, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100", placeholder: "Audit parallel workflows A and B for potential shared code extraction; preserve their independent retry and failure policies." %>
        </div>

        <div>
          <%= label_tag :scope, "Scope (optional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Paths, symbols, or a free-form target description. Ambiguous or missing named targets produce a clarification outcome instead of a whole-repository scan. Leave blank for an explicit broad-scope audit.</p>
          <%= text_area_tag :scope, params[:scope], rows: 2, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-900 dark:text-gray-100", placeholder: "app/workflows/a.rb, app/workflows/b.rb" %>
        </div>

        <div class="flex justify-end">
          <%= submit_tag "Start maintenance run", class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
