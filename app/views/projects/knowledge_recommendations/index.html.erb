<% content_for(:title) { "Knowledge Recommendations - #{@project.name} - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to project_path(@project), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to <%= @project.name %>
    <% end %>
  </div>

  <h1 class="text-xl font-semibold text-gray-900">Knowledge Recommendations</h1>

  <% if @pending.any? %>
    <div class="mt-6">
      <h2 class="text-lg font-medium text-gray-900">Pending (<%= @pending.size %>)</h2>
      <div class="mt-3 overflow-hidden overflow-x-auto rounded-lg bg-white shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Type</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Collector</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Description</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
            </tr>
          </thead>
          <tbody id="pending_recommendations" class="divide-y divide-gray-200 bg-white">
            <% @pending.each do |recommendation| %>
              <%= render "projects/knowledge_recommendations/recommendation_row", recommendation: recommendation, project: @project %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="mt-6 rounded-lg bg-white px-4 py-5 text-center text-sm text-gray-500 shadow">
      No pending recommendations.
    </div>
  <% end %>

  <% if @resolved.any? %>
    <div class="mt-8">
      <h2 class="text-lg font-medium text-gray-900">Resolved (<%= @resolved.size %>)</h2>
      <div class="mt-3 overflow-hidden overflow-x-auto rounded-lg bg-white shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Type</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Collector</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Priority</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Description</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @resolved.each do |recommendation| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-sm">
                  <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                    <%= recommendation.recommendation_type.humanize %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500">
                  <%= recommendation.collector_type || "--" %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm">
                  <%= render "projects/knowledge_recommendations/priority_badge", priority: recommendation.priority %>
                </td>
                <td class="px-4 py-3 text-sm text-gray-900"><%= recommendation.description %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm">
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                    <%= case recommendation.status
                        when 'accepted' then 'bg-green-100 text-green-700'
                        when 'dismissed' then 'bg-gray-100 text-gray-600'
                        when 'implemented' then 'bg-blue-100 text-blue-700'
                        end %>">
                    <%= recommendation.status.capitalize %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
