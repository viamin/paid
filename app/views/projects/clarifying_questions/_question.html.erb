<%# locals: question (ClarifyingQuestions::Question, required), index (Integer, required), field_id (String, required), pending_answer (String, optional), field_class (String, optional), answer_data (Hash, optional) %>
<%# @spec OPERATOR-INBOX-026 @spec ISSUE-ENHANCEMENT-020 @spec ISSUE-ENHANCEMENT-021
    One clarification, rendered the same way on every answer surface (the
    inbox detail pane and the standalone clarifying_questions#show wizard):
    the question label, Paid's grounded recommendation when the question
    carries one, the answer control, and the supporting detail (rationale,
    examples, evidence references) inside a native disclosure that is closed
    by default.

    The question label and its answer control stay in one block on every
    viewport, so the operator reads the question and the offered choices
    before any supporting prose. The disclosure is a native <details>
    element, so the detail is hidden by default without losing keyboard or
    screen-reader access. A recommendation is never pre-selected: it is
    Paid's suggestion, and the operator's answer is the decision of record. %>
<div class="rounded-lg bg-gray-50 px-4 py-3" data-testid="inbox-question-<%= index %>">
  <label for="<%= field_id %>" class="block text-sm font-medium text-gray-700">
    <span class="mr-2 font-semibold text-gray-500"><%= index + 1 %>.</span>
    <%= render "shared/markdown_text", content: question.question,
          tag: :span, class: "text-sm font-medium text-gray-700" %>
  </label>

  <% if question.recommendation? %>
    <div class="mt-2 rounded-md border border-indigo-200 bg-indigo-50 px-3 py-2"
         data-testid="inbox-recommendation-<%= index %>">
      <p class="text-xs font-semibold uppercase tracking-wide text-indigo-800">Paid's recommendation</p>
      <p class="mt-1 text-sm text-indigo-900">
        <span class="font-semibold"><%= question.recommendation[:label] %></span>
        <% if question.recommendation[:text].present? %>
          <span class="text-indigo-800"><%= question.recommendation[:text] %></span>
        <% end %>
      </p>
      <p class="mt-1 text-xs text-indigo-700">
        A suggestion from Paid, not a confirmed decision. Your answer is what counts.
      </p>
    </div>
  <% end %>

  <%= render "projects/clarifying_questions/answer_field",
        question: question.question,
        choices: question.choices,
        field_id: field_id,
        label: nil,
        pending_answer: pending_answer,
        field_class: local_assigns.fetch(:field_class, "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"),
        answer_data: local_assigns.fetch(:answer_data, {}) %>

  <% if question.supporting_details? %>
    <details class="mt-3 rounded-md border border-gray-200 bg-white px-3 py-2"
             data-testid="inbox-question-details-<%= index %>">
      <summary class="cursor-pointer text-sm font-medium text-gray-700">
        Background, examples, and references
      </summary>
      <div class="mt-2 space-y-3 text-sm text-gray-700">
        <% if question.rationale.present? %>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Why Paid is asking</p>
            <p class="mt-1"><%= question.rationale %></p>
          </div>
        <% end %>
        <% if question.examples.present? %>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Examples</p>
            <ul class="mt-1 list-disc pl-5">
              <% question.examples.each do |example| %>
                <li><%= example %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if question.evidence.present? %>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">References</p>
            <ul class="mt-1 list-disc pl-5">
              <% question.evidence.each do |reference| %>
                <li><%= reference %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
