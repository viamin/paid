<% content_for(:title) { "Scaling Dashboard - #{@project.name} - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to back_link_path(project_path(@project)), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to <%= @project.name %>
    <% end %>
  </div>

  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Scaling Experiments</h1>
      <p class="mt-1 text-sm text-gray-500">Confidence reporting, experiment recommendations, and recent orchestration observations for <%= @project.name %>.</p>
    </div>
  </div>

  <% if @stats[:sparse] %>
    <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 text-sm text-gray-500">
        No scaling observations or experiments have been recorded yet. Once feature orchestration records scaling data, this dashboard will report confidence intervals, recommendations, and sample-threshold gaps.
      </div>
    </div>
  <% else %>
    <% summary = @stats[:summary] %>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Experiments</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= summary[:experiment_count] %></dd>
        <p class="mt-2 text-xs text-gray-500"><%= summary[:active_experiment_count] %> active · <%= summary[:completed_experiment_count] %> completed</p>
      </div>
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Observations</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= summary[:observation_count] %></dd>
        <p class="mt-2 text-xs text-gray-500">Feature orchestration runs with recorded scaling metrics.</p>
      </div>
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Recommendations</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= summary[:ready_recommendation_count] %></dd>
        <p class="mt-2 text-xs text-gray-500"><%= summary[:actionable_recommendation_count] %> marked actionable</p>
      </div>
      <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">RDR Sample Target</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= summary[:rdr_ready_experiment_count] %></dd>
        <p class="mt-2 text-xs text-gray-500">Experiments configured at or above the 30-sample target.</p>
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Allocator Recommendations</h2>
      <p class="mt-1 text-sm text-gray-500">Current scaling recommendations from cached experiment summaries, with confidence and sample-threshold context.</p>
      <% if @stats[:recommendations].any? %>
        <div class="mt-4 overflow-hidden overflow-x-auto rounded-lg bg-white shadow">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Dimension</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Recommended</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Confidence</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Efficiency Gain</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Exponent CI</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @stats[:recommendations].each do |row| %>
                <% exponent_ci = row[:scaling_exponent_confidence_interval] || {} %>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= row[:dimension].to_s.humanize %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= row[:recommended_value] %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= row[:sample_count] %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= row[:actionable] ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700" %>">
                      <%= row[:confidence].to_s.humanize %><%= row[:actionable] ? " actionable" : "" %>
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500">
                    <%= row[:efficiency_gain_vs_control] ? number_to_percentage(row[:efficiency_gain_vs_control] * 100, precision: 1) : "--" %>
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500">
                    <% if exponent_ci["estimate"] %>
                      <%= number_with_precision(exponent_ci["estimate"], precision: 3, strip_insignificant_zeros: true) %>
                      (<%= number_with_precision(exponent_ci["lower_bound"], precision: 3, strip_insignificant_zeros: true) %> to
                      <%= number_with_precision(exponent_ci["upper_bound"], precision: 3, strip_insignificant_zeros: true) %>)
                    <% else %>
                      --
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-500">
                    <div><%= row[:reason].to_s.humanize %></div>
                    <% unless row.dig(:sample_threshold_review, "meets_rdr_target") %>
                      <div class="mt-1 text-xs text-yellow-700">Configured below the 30-sample RDR target.</div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
          <div class="px-4 py-5 text-sm text-gray-500">No allocator recommendation is available yet.</div>
        </div>
      <% end %>
    </div>

    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Experiment Detail</h2>
      <p class="mt-1 text-sm text-gray-500">Each experiment reports confidence intervals for the recorded outcomes, the configured sample threshold, and any intentional departures from the full RDR regression plan.</p>
      <div class="mt-4 space-y-6">
        <% @stats[:experiments].each do |row| %>
          <% summary_data = row[:summary] %>
          <% threshold_review = row[:sample_threshold_review] || {} %>
          <div class="overflow-hidden rounded-lg bg-white shadow">
            <div class="px-4 py-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <h3 class="text-sm font-semibold text-gray-900"><%= row[:experiment].name %></h3>
                  <p class="mt-1 text-sm text-gray-500">
                    <%= row[:dimension].to_s.humanize %> · primary metric <%= row[:primary_metric].to_s.humanize.downcase %> ·
                    status <%= row[:experiment].status.humanize.downcase %>
                  </p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <% if row[:actionable] %>
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-700">Actionable</span>
                  <% elsif row[:recommendation_ready] %>
                    <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-700">Recommendation available</span>
                  <% end %>
                  <% unless threshold_review["meets_rdr_target"] %>
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Below 30-sample RDR target</span>
                  <% end %>
                </div>
              </div>

              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div class="rounded-lg bg-gray-50 px-4 py-3">
                  <div class="text-xs font-medium uppercase tracking-wider text-gray-500">Configured Min Samples</div>
                  <div class="mt-1 text-lg font-semibold text-gray-900"><%= threshold_review["configured_min_samples_per_value"] || "--" %></div>
                </div>
                <div class="rounded-lg bg-gray-50 px-4 py-3">
                  <div class="text-xs font-medium uppercase tracking-wider text-gray-500">Leading Value</div>
                  <div class="mt-1 text-lg font-semibold text-gray-900"><%= row[:leading_value] || "--" %></div>
                </div>
                <div class="rounded-lg bg-gray-50 px-4 py-3">
                  <div class="text-xs font-medium uppercase tracking-wider text-gray-500">Summary Samples</div>
                  <div class="mt-1 text-lg font-semibold text-gray-900"><%= summary_data["sample_count"] || 0 %></div>
                </div>
              </div>

              <% if row[:values].any? %>
                <div class="mt-4 overflow-hidden overflow-x-auto rounded-lg ring-1 ring-gray-200">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Value</th>
                        <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
                        <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Success CI</th>
                        <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Primary Metric CI</th>
                        <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Avg Duration CI</th>
                        <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Signals</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                      <% row[:values].each do |value| %>
                        <% primary_ci = value["primary_metric_confidence_interval"] || value["success_rate_confidence_interval"] %>
                        <% duration_ci = value["avg_duration_seconds_confidence_interval"] || {} %>
                        <% success_ci = value["success_rate_confidence_interval"] || {} %>
                        <tr>
                          <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= value["assigned_value"] %></td>
                          <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= value["sample_count"] %></td>
                          <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500">
                            <% if success_ci["lower_bound"] %>
                              <%= number_to_percentage(success_ci["mean"] * 100, precision: 1) %>
                              (<%= number_to_percentage(success_ci["lower_bound"] * 100, precision: 1) %> to
                              <%= number_to_percentage(success_ci["upper_bound"] * 100, precision: 1) %>)
                            <% else %>
                              --
                            <% end %>
                          </td>
                          <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500">
                            <% if primary_ci && primary_ci["lower_bound"] %>
                              <%= number_with_precision(primary_ci["mean"], precision: 3, strip_insignificant_zeros: true) %>
                              (<%= number_with_precision(primary_ci["lower_bound"], precision: 3, strip_insignificant_zeros: true) %> to
                              <%= number_with_precision(primary_ci["upper_bound"], precision: 3, strip_insignificant_zeros: true) %>)
                            <% else %>
                              --
                            <% end %>
                          </td>
                          <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500">
                            <% if duration_ci["lower_bound"] %>
                              <%= number_with_precision(duration_ci["mean"], precision: 1, strip_insignificant_zeros: true) %>
                              (<%= number_with_precision(duration_ci["lower_bound"], precision: 1, strip_insignificant_zeros: true) %> to
                              <%= number_with_precision(duration_ci["upper_bound"], precision: 1, strip_insignificant_zeros: true) %>)
                            <% else %>
                              --
                            <% end %>
                          </td>
                          <td class="px-4 py-3 text-sm text-gray-500">
                            <%= Array(value["signals"]).presence&.map { |signal| signal.to_s.humanize.downcase }&.join(", ") || "None" %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>

              <% if row[:simplifications].any? %>
                <div class="mt-4 rounded-lg bg-amber-50 p-4 ring-1 ring-inset ring-amber-200">
                  <h4 class="text-sm font-semibold text-amber-900">Intentional Simplifications</h4>
                  <ul class="mt-2 space-y-1 text-sm text-amber-800">
                    <% row[:simplifications].each do |note| %>
                      <li><%= note %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Recent Observations</h2>
      <p class="mt-1 text-sm text-gray-500">Most recent orchestration observations recorded for scaling analysis.</p>
      <div class="mt-4 overflow-hidden overflow-x-auto rounded-lg bg-white shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Recorded</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Tasks</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Planned Agents</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Observed Parallelism</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Duration</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Cost</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Success</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @stats[:recent_observations].each do |observation| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500"><%= local_time(observation.created_at) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= observation.task_count %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= observation.agent_count_planned %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= observation.parallelism_observed %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= observation.duration_seconds || "--" %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= observation.total_cost_cents || "--" %></td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm text-gray-500"><%= observation.success? ? "Yes" : "No" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
