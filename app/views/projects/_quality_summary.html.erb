<% if quality_summary[:total_metrics] > 0 %>
  <div class="mt-6">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-medium text-gray-900">Quality</h2>
      <div class="flex items-center gap-3">
        <%= link_to "Bundle Analysis", project_bundle_performance_dashboard_path(project), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
        <%= link_to "View Dashboard", project_quality_dashboard_path(project), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      </div>
    </div>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-4 sm:px-6">
        <% avg = quality_summary[:average_score].to_f.round(4) %>
        <div class="flex items-center justify-between">
          <div>
            <span class="text-sm font-medium text-gray-500">Average Quality Score</span>
            <div class="mt-1 flex items-center gap-3">
              <span class="text-2xl font-semibold <%= quality_score_color(avg) %>"><%= format_quality_score(avg) %></span>
              <span class="text-sm text-gray-400">from <%= pluralize(quality_summary[:total_metrics], "metric") %></span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-sm text-gray-500">Score Distribution</span>
            <% distribution = quality_summary[:score_distribution] %>
            <% max_count = distribution.map { |b| b[:count] }.max %>
            <div class="mt-1 flex items-end gap-px" style="height: 32px;">
              <% distribution.each do |band| %>
                <% bar_height = max_count > 0 ? (band[:count].to_f / max_count * 100).round : 0 %>
                <div class="w-5 rounded-t <%= band[:count] > 0 ? quality_score_bar_color(band[:min]) : 'bg-gray-200' %>"
                     style="height: <%= [bar_height, 4].max %>%;"
                     title="<%= band[:label] %>%: <%= pluralize(band[:count], 'score') %>"></div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-gray-200">
          <div class="h-2 rounded-full <%= quality_score_bar_color(avg) %>"
               style="width: <%= (avg * 100).round %>%"></div>
        </div>
      </div>
    </div>
  </div>
<% end %>
