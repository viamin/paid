<% content_for(:title) { "Review packages - #{@project.name} - Paid" } %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to back_link_path(project_path(@project)), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25a.75.75 0 0 1 .75.75Z" clip-rule="evenodd" />
      </svg>
      Back to <%= @project.name %>
    <% end %>
  </div>

  <h1 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Review packages</h1>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
    Immutable business-review package history. Each revision binds the obligation revisions, declared scope, verification-plan revision, contributing check results, recorded approvals, and Inbox decisions to one reproducible identity; changed inputs create a new revision and retain prior records unchanged.
  </p>

  <% packages_by_run = @packages.group_by(&:agent_run_id) %>
  <% packages_by_run.each do |agent_run_id, packages| %>
    <% current = packages.max_by(&:revision_number) %>
    <section class="mt-6 rounded-lg bg-white p-4 shadow dark:bg-gray-800" aria-labelledby="package-run-<%= agent_run_id %>">
      <h2 id="package-run-<%= agent_run_id %>" class="text-sm font-semibold text-gray-900 dark:text-gray-100">Audit run #<%= agent_run_id %></h2>
      <ul class="mt-2 space-y-1 text-sm text-gray-600 dark:text-gray-300">
        <% Array(current.bound_inputs["obligations"]).each do |obligation| %>
          <li>
            <span class="font-medium text-gray-900 dark:text-gray-100"><%= obligation["external_identity"] %></span>
            — <%= obligation["scope_description"] %>
            <span class="text-xs text-gray-500">(declared scope revision: <%= obligation["external_revision"].presence || "none" %>)</span>
          </li>
        <% end %>
      </ul>
      <div class="mt-3 overflow-x-auto">
        <table class="min-w-full text-left text-sm text-gray-600 dark:text-gray-300">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="px-2 py-2">Revision</th>
              <th class="px-2 py-2">Identity digest</th>
              <th class="px-2 py-2">Captured</th>
              <th class="px-2 py-2">State</th>
              <th class="px-2 py-2">Approvals</th>
              <th class="px-2 py-2"></th>
            </tr>
          </thead>
          <tbody>
            <% packages.each do |package| %>
              <tr class="border-b border-gray-100 last:border-b-0 dark:border-gray-700">
                <td class="px-2 py-2"><%= package.revision_number %></td>
                <td class="px-2 py-2 font-mono text-xs"><%= link_to package.package_digest, project_layered_verification_review_package_path(@project, package), class: "underline" %></td>
                <td class="px-2 py-2"><%= local_time(package.created_at, format: :short) %></td>
                <td class="px-2 py-2"><%= package.id == current.id ? "current" : "superseded" %></td>
                <td class="px-2 py-2">
                  <% if package.approvals.any? %>
                    <ul class="space-y-1">
                      <% package.approvals.each do |approval| %>
                        <li><%= approval.approved_by.name %> · <%= local_time(approval.approved_at, format: :short) %><%= " · #{approval.provenance["note"]}" if approval.provenance["note"].present? %></li>
                      <% end %>
                    </ul>
                  <% else %>
                    none
                  <% end %>
                </td>
                <td class="px-2 py-2"><%= link_to "Inspect", project_layered_verification_review_package_path(@project, package), class: "underline" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <% if @packages.empty? %>
    <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">No review packages have been captured for this project yet.</p>
  <% end %>
</div>
