<div class="mt-6 overflow-hidden rounded-lg bg-white shadow dark:bg-gray-800">
  <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-700 dark:bg-gray-900/50">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Session Summary</h2>
    <% if session_summary.promoted? %>
      <%= link_to "Promoted to Change Intent", project_change_intent_path(project, session_summary.change_intent),
            class: "rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/40 dark:text-green-200" %>
    <% else %>
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300"
            title="This is a raw observation from the agent run, not accepted project intent, unless promoted.">
        Observation
      </span>
    <% end %>
  </div>

  <div class="space-y-3 px-4 py-3 text-sm text-gray-700 dark:text-gray-200">
    <p><%= session_summary.summary %></p>

    <% [
         [ "Files Touched", session_summary.files_touched ],
         [ "Decisions", session_summary.decisions ],
         [ "Assumptions", session_summary.assumptions ],
         [ "Failures", session_summary.failures ],
         [ "Follow-ups", session_summary.follow_ups ],
         [ "Learnings", session_summary.learnings ]
       ].each do |heading, items| %>
      <% next if items.blank? %>
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= heading %></h3>
        <ul class="mt-1 list-inside list-disc space-y-0.5">
          <% items.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if session_summary.observation? && policy(agent_run).update? %>
      <%= button_to "Promote to Change Intent", promote_session_summary_project_agent_run_path(project, agent_run),
            method: :post,
            class: "mt-2 inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
  </div>
</div>
