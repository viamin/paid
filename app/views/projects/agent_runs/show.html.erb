<% content_for(:title) { "Agent Run ##{@agent_run.id} - #{@project.name} - Paid" } %>

<%= turbo_stream_from @agent_run, :detail %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to back_link_path(project_path(@project)), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to <%= @project.name %>
    <% end %>
  </div>

  <div data-controller="agent-run-actions"
       data-agent-run-actions-detail-id-value="<%= dom_id(@agent_run, :detail) %>">
    <%= render "agent_runs/detail",
          agent_run: @agent_run,
          quality_metrics: @quality_metrics,
          phase_timeline: @phase_timeline,
          phase_summary: @phase_summary,
           final_runner_record: @final_runner_record,
           attempted_runners_by_routing_key: @attempted_runners_by_routing_key,
           egress_policy_snapshot: @egress_policy_snapshot,
           egress_security_events: @egress_security_events,
           egress_denied_event_count: @egress_denied_event_count %>

    <% if @continuation_phase %>
      <section class="mt-6 rounded-lg border border-gray-200 bg-white p-4">
        <h2 class="text-sm font-semibold text-gray-900">Automation authority</h2>
        <p class="mt-1 text-sm text-gray-700">
          <%= Automation::Phases.label(@continuation_phase) %> is currently
          <strong><%= @continuation_authority.permitted? ? "permitted" : "not permitted" %></strong>
          <% if @continuation_authority.source %> through <%= @continuation_authority.source.to_s.humanize.downcase %>.<% end %>
        </p>
        <% if @continuation_grants.any? %>
          <ul class="mt-3 space-y-2 text-sm text-gray-700">
            <% @continuation_grants.each do |grant| %>
              <li class="rounded border border-gray-100 p-3">
                <p><strong>Continuation grant:</strong> <%= Automation::Phases.label(grant.start_phase) %> → <%= Automation::Phases.label(grant.endpoint) %>.</p>
                <p class="mt-1 text-xs text-gray-500">Revoking this grant removes only its exception; project defaults may independently permit this work.</p>
                <% if policy(@project).update? %>
                  <div class="mt-2 flex flex-wrap gap-2">
                    <%= button_to "Revoke", continuation_grant_project_automation_phases_path(@project, grant), method: :delete, class: "rounded border border-gray-300 px-3 py-1 text-xs font-semibold text-gray-700", form: { data: { turbo_confirm: "Revoke this continuation grant? Project settings may still permit this work." } } %>
                    <% endpoints = Automation::Phases.endpoints_for(grant.start_phase) - grant.covered_phases %>
                    <% if endpoints.any? %>
                      <%= form_with url: extend_continuation_grant_project_automation_phases_path(@project, grant), method: :patch, class: "flex items-center gap-2" do %>
                        <%= select_tag :endpoint, options_for_select(endpoints.map { |endpoint| [ Automation::Phases.label(endpoint), endpoint ] }), class: "rounded border-gray-300 px-2 py-1 text-xs" %>
                        <%= submit_tag "Extend", class: "rounded border border-gray-300 px-3 py-1 text-xs font-semibold text-gray-700" %>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 text-sm text-gray-500">No active continuation grant covers this work. Project defaults can still permit automatic work.</p>
        <% end %>
      </section>
    <% end %>

    <% if @agent_run.layered_verification_audit_goal? && @agent_run.external_metadata.dig("layered_verification", "coverage").present? %>
      <%= render "agent_runs/layered_verification_intent_validation", agent_run: @agent_run %>
      <%= render "agent_runs/layered_verification_coverage", agent_run: @agent_run %>
    <% end %>

    <%# Action buttons are rendered outside the Turbo broadcast target so that
        live updates (which re-render _detail without user-specific locals)
        do not wipe policy-gated controls like Cancel and Retry.
        The agent-run-actions Stimulus controller observes the detail target
        for status changes and hides/shows buttons client-side. %>
    <div data-agent-run-actions-target="actions">
      <%= render "agent_runs/detail_actions",
            agent_run: @agent_run,
            show_cancel: policy(@agent_run).cancel?,
            show_resume: policy(@agent_run).resume?,
            show_retry: policy(@agent_run.project).run_agent?,
            retry_provider_options: @retry_runner_options,
            retry_docker_host_options: @retry_docker_host_options %>
    </div>
  </div>

  <% if @session_summary %>
    <%= render "projects/agent_runs/session_summary", project: @project, agent_run: @agent_run, session_summary: @session_summary %>
  <% end %>

  <% if @logs.any? %>
    <div class="mt-6 overflow-hidden rounded-lg bg-white shadow dark:bg-gray-800">
      <h2 class="border-b border-gray-200 bg-gray-50 px-4 py-3 text-sm font-semibold text-gray-900 dark:border-gray-700 dark:bg-gray-900/50 dark:text-gray-100">Execution Logs</h2>
      <div class="max-h-96 overflow-auto">
        <% @logs.each do |log| %>
          <div class="border-b border-gray-100 px-4 py-2 font-mono text-xs text-gray-700 last:border-b-0 dark:border-gray-700 dark:text-gray-200 <%= log.log_type == 'stderr' ? 'bg-red-50 text-red-800 dark:bg-red-900/30 dark:text-red-200' : '' %> <%= log.log_type == 'system' ? 'bg-blue-50 text-blue-800 dark:bg-blue-900/30 dark:text-blue-200' : '' %>"
               data-controller="log-truncate" data-log-truncate-max-lines-value="10">
            <span class="mr-2 text-gray-400 dark:text-gray-500"><%= local_time(log.created_at, format: :time) %></span>
            <span class="mr-2 rounded bg-gray-200 px-1 text-gray-600"><%= log.log_type %></span>
            <pre class="inline-block whitespace-pre-wrap" data-log-truncate-target="content"><%= log.content %></pre>
            <button type="button" class="mt-1 hidden cursor-pointer text-xs font-medium text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300" data-log-truncate-target="toggle" data-action="log-truncate#toggle"></button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
