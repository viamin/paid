<div id="pending_recommendations_section">
  <% if recommendations.any? %>
    <div class="mt-8">
      <h2 class="text-lg font-medium text-gray-900">Setup Recommendations (<%= recommendations.size %>)</h2>
      <div class="mt-3 overflow-hidden overflow-x-auto rounded-lg bg-white shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Convention</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Action</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Recommendation</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
            </tr>
          </thead>
          <tbody id="pending_convention_recommendations" class="divide-y divide-gray-200 bg-white">
            <% recommendations.each do |rec| %>
              <tr id="<%= dom_id(rec) %>">
                <td class="whitespace-nowrap px-4 py-3 text-sm">
                  <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                    <%= rec.convention_key.humanize %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-sm">
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                    <%= case rec.action_type
                        when 'apply_in_paid' then 'bg-blue-100 text-blue-700'
                        when 'open_pr' then 'bg-purple-100 text-purple-700'
                        when 'apply_github_side' then 'bg-green-100 text-green-700'
                        else 'bg-gray-100 text-gray-500'
                        end %>">
                    <%= rec.action_type.humanize %>
                  </span>
                </td>
                <td class="px-4 py-3 text-sm text-gray-900">
                  <p class="font-medium"><%= rec.title %></p>
                  <p class="mt-1 text-gray-500"><%= rec.description %></p>
                  <% if rec.evidence.present? && rec.evidence.any? %>
                    <details class="mt-1">
                      <summary class="cursor-pointer text-xs text-gray-400 hover:text-gray-600">Evidence</summary>
                      <pre class="mt-1 whitespace-pre-wrap rounded bg-gray-50 p-2 text-xs text-gray-600"><%= JSON.pretty_generate(rec.evidence) %></pre>
                    </details>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
                  <div class="flex flex-col items-end gap-2 sm:flex-row sm:items-center">
                    <%= button_to "Apply",
                          update_recommendation_project_convention_settings_path(project),
                          method: :patch,
                          params: { id: rec.id, action_type: "apply" },
                          form: { data: { turbo_stream: true } },
                          class: "inline-flex items-center rounded-md bg-green-600 px-2.5 py-1.5 text-xs font-medium text-white hover:bg-green-500" %>

                    <%= form_with url: update_recommendation_project_convention_settings_path(project),
                          method: :patch,
                          data: { turbo_stream: true },
                          class: "flex items-center justify-end gap-2" do |f| %>
                      <%= f.hidden_field :id, value: rec.id %>
                      <%= f.hidden_field :action_type, value: "dismiss" %>
                      <label for="<%= dom_id(rec, :dismissal_reason) %>" class="sr-only">Dismissal reason</label>
                      <%= f.text_field :dismissal_reason,
                            id: dom_id(rec, :dismissal_reason),
                            placeholder: "Dismissal reason",
                            required: true,
                            class: "w-40 rounded-md border-gray-300 px-2 py-1 text-xs text-gray-900 placeholder:text-gray-400" %>
                      <%= f.submit "Dismiss", class: "inline-flex items-center rounded-md bg-gray-600 px-2.5 py-1.5 text-xs font-medium text-white hover:bg-gray-500" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="mt-8 rounded-lg bg-white px-4 py-5 text-center text-sm text-gray-500 shadow">
      No pending setup recommendations.
    </div>
  <% end %>
</div>
