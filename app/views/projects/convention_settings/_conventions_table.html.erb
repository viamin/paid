<div id="conventions_table_section" class="mt-6">
  <h2 class="text-lg font-medium text-gray-900">Detected Conventions</h2>

  <% conventions = profile[:conventions] %>
  <% if conventions.any? %>
    <div class="mt-3 overflow-hidden overflow-x-auto rounded-lg bg-white shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Convention</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Category</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Detected Value</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Source</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Confidence</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Override</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Resolved</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% conventions.each do |key, entry| %>
            <%= render "projects/convention_settings/convention_row", key: key, entry: entry, project: project %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-3 rounded-lg bg-white px-4 py-5 text-center text-sm text-gray-500 shadow">
      No conventions detected for this project yet.
    </div>
  <% end %>
</div>
