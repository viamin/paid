<% if @update_succeeded %>
  <%= turbo_stream.replace "conventions_table_section" do %>
    <%= render "projects/convention_settings/conventions_table", profile: @profile, project: @project %>
  <% end %>
  <%= turbo_stream.replace "pending_recommendations_section" do %>
    <%= render "projects/convention_settings/pending_recommendations", recommendations: @pending_recommendations, project: @project %>
  <% end %>
  <%= turbo_stream.replace "resolved_recommendations_section" do %>
    <%= render "projects/convention_settings/resolved_recommendations", recommendations: @resolved_recommendations %>
  <% end %>
  <%= turbo_stream.update "convention_settings_alert" do %>
    <% if @success_message.present? %>
      <div class="rounded-md bg-green-50 p-4" role="status">
        <p class="text-sm font-medium text-green-800">
          <%= @success_message %>
          <% if @pull_request_url.present? %>
            <%= link_to @pull_request_url, @pull_request_url, class: "underline" %>
          <% end %>
        </p>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.update "convention_settings_alert" do %>
    <div class="rounded-md bg-red-50 p-4" role="alert">
      <p class="text-sm font-medium text-red-800"><%= @error_message %></p>
    </div>
  <% end %>
<% end %>
