<% automation_enabled = pull_request.has_label?(project.automation_label_name) %>
<% paused_run = local_assigns.fetch(:paused_run, nil) %>
<li id="<%= dom_id(pull_request) %>" class="flex items-center justify-between px-4 py-3">
  <div class="min-w-0 flex-1">
    <div class="flex items-center space-x-2">
      <%= link_to "##{pull_request.github_number}",
            pull_request.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "flex-shrink-0 text-sm font-medium text-indigo-600 hover:text-indigo-900" %>
      <span class="truncate text-sm text-gray-900"><%= pull_request.title %></span>
      <% if paused_run.present? %>
        <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">
          Paused by <%= guardrail_violation_label_for(paused_run).downcase %>
        </span>
      <% elsif pull_request.auto_continue_paused? && automation_enabled %>
        <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">Paused</span>
      <% end %>
    </div>
    <% if pull_request.labels.any? %>
      <div class="mt-1 flex flex-wrap gap-1">
        <% pull_request.labels.each do |label| %>
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600"><%= label %></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="ml-4 flex flex-shrink-0 items-center space-x-2">
    <%= pr_review_phase_badge(pull_request.pr_review_phase, review_count: pull_request.draft_review_count) %>
    <%= render "projects/issue_pause_toggle", issue: pull_request, project: project %>
    <% if pull_request.local_control_state? && policy(project).update? %>
      <% if pull_request.escalated_phase? %>
        <%= button_to "Dismiss escalation", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "dismiss_escalation" }, class: "text-xs font-medium text-indigo-600" %>
      <% end %>
      <% if pull_request.skip_auto_merge %>
        <%= button_to "Allow merge", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "allow_auto_merge" }, class: "text-xs font-medium text-indigo-600" %>
      <% else %>
        <%= button_to "Skip merge", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "skip_auto_merge" }, class: "text-xs font-medium text-indigo-600" %>
      <% end %>
      <% if pull_request.hold_for_review %>
        <%= button_to "Release review hold", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "release_review_hold" }, class: "text-xs font-medium text-indigo-600" %>
      <% else %>
        <%= button_to "Hold review", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "hold_for_review" }, class: "text-xs font-medium text-indigo-600" %>
      <% end %>
      <% if pull_request.tdd_review_state == "ready_for_review" %>
        <%= button_to "Approve tests", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "approve_tests" }, class: "text-xs font-medium text-indigo-600" %>
        <%= button_to "Request test changes", update_issue_control_state_project_path(project), method: :post, params: { issue_id: pull_request.id, control_action: "request_test_changes" }, class: "text-xs font-medium text-indigo-600" %>
      <% end %>
      <%# @spec LABEL-CONTROL-007 — per-PR paid-activation toggle. PRs
          inherit activation from their parent issue when the parent is paid-
          activated, but a PR opened by an external actor can also be
          activated independently for scan scope. %>
      <%= button_to(pull_request.paid_activated? ? "Deactivate" : "Activate for Paid",
                    update_issue_control_state_project_path(project), method: :post,
                    params: { issue_id: pull_request.id, control_action: pull_request.paid_activated? ? "unmark_paid_activated" : "mark_paid_activated" },
                    class: "text-xs font-medium #{pull_request.paid_activated? ? 'text-gray-600' : 'text-green-700'}",
                    title: pull_request.paid_activated? ? "Stop Paid scanning/following up on this PR." : "Let Paid scan and follow up on this PR.") %>
    <% end %>
    <% subscription_locals = { issue: pull_request, project: project } %>
    <% if local_assigns.key?(:merge_notification_issue_ids) %>
      <% subscription_locals[:subscribed] = local_assigns[:merge_notification_issue_ids].include?(pull_request.id) %>
    <% end %>
    <%= render "projects/issue_merge_subscription", **subscription_locals %>
    <% if automation_enabled %>
      <%= button_to toggle_auto_continue_pause_project_agent_runs_path(project, pull_request_id: pull_request.id),
                    method: :post,
                    class: "text-xs font-medium #{pull_request.auto_continue_paused? ? 'text-green-600 hover:text-green-900' : 'text-yellow-600 hover:text-yellow-900'}",
                    title: pull_request.auto_continue_paused? ? "Resume auto-continue" : "Pause auto-continue",
                    aria: { label: pull_request.auto_continue_paused? ? "Resume auto-continue" : "Pause auto-continue" },
                    form: { data: { action_button: true } } do %>
        <%= pull_request.auto_continue_paused? ? "▶️" : "⏸️" %>
      <% end %>
    <% end %>
    <%# Three states: "Bump Priority" when queued automatic runs exist (only queued runs can be
        reprioritized — claimed/running are already claimed by a worker), "Run in progress" when
        any active run exists (prevents Quick Run which would violate the unique active-run index),
        and "Quick Run" when no active runs exist. %>
    <% if paused_run.present? %>
      <% if policy(paused_run).resume? %>
        <%= button_to "Resume Run",
                      resume_project_agent_run_path(project, paused_run),
                      method: :post,
                      params: { return_to: project_path(project) },
                      class: "text-xs font-semibold text-green-600 hover:text-green-900",
                      form: { data: { action_button: true, turbo_confirm: "Resume this paused agent run?" } } %>
      <% end %>
      <%= link_to "View Run",
                  project_agent_run_path(project, paused_run),
                  class: "text-xs font-medium text-yellow-700 hover:text-yellow-900" %>
    <% elsif pr_numbers_with_queued_auto_continue&.include?(pull_request.github_number) %>
      <%= button_to "Bump Priority",
                    bump_priority_project_agent_runs_path(project, pull_request_id: pull_request.id),
                    method: :post,
                    class: "text-xs font-medium text-amber-600 hover:text-amber-900",
                    form: { data: { action_button: true } } %>
    <% elsif pr_numbers_with_active_runs&.include?(pull_request.github_number) %>
      <span class="text-xs font-medium text-gray-400">Run in progress</span>
    <% else %>
      <%= button_to "Quick Run",
                    quick_create_project_agent_runs_path(project, pull_request_id: pull_request.id),
                    method: :post,
                    class: "text-xs font-medium text-indigo-600 hover:text-indigo-900",
                    form: { data: { action_button: true } } %>
    <% end %>
  </div>
</li>
