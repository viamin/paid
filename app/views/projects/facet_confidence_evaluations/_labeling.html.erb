<%# Blinded reference-judgment surface: facet, direction, thresholds, and
    evidence only. Case shapes, selection rationale, and the frozen
    expectations are structurally absent (CaseView whitelist), so this partial
    cannot render them before freeze. @spec FACET-CONFIDENCE-021 %>
<% remaining = progress[:total] - progress[:labeled] - progress[:skipped] %>
<% can_judge = policy(evaluation).label? %>

<div class="rounded-xl border border-gray-200 bg-white p-4" data-judgment-progress>
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold text-gray-900">Progress</h2>
    <span class="text-xs text-gray-500"><%= progress[:labeled] %> judged · <%= progress[:skipped] %> skipped · <%= progress[:total] %> total</span>
  </div>
  <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-gray-100">
    <div class="h-full rounded-full bg-indigo-600" style="width: <%= (progress[:labeled] * 100.0 / [progress[:total], 1].max).round %>%"></div>
  </div>
  <p class="mt-2 text-xs text-gray-500">
    Skipped cases are never counted as completed and block freezing. Answers stay hidden until you freeze.
  </p>
</div>

<% if case_view && case_view.exists? %>
  <% current = case_view.blinded_payload %>
  <% own = current["label"] %>
  <% references = Array(current["evidence"]).map { |item| item["reference"] } %>
  <div class="space-y-4 rounded-xl border border-gray-200 bg-white p-6" data-judgment-case="<%= current["id"] %>">
    <div class="space-y-1">
      <h2 class="text-lg font-semibold text-gray-900">Case <%= current["id"] %></h2>
      <dl class="space-y-1 text-sm text-gray-700">
        <div>Facet: <span class="font-medium"><%= current.dig("facet", "name") %></span> — <%= current.dig("facet", "design_claim") %></div>
        <div>Direction: <span class="font-medium"><%= current.dig("direction", "name") %></span> — <%= current.dig("direction", "description") %></div>
        <div>
          Thresholds: intent <%= current.dig("thresholds", "intent") %>/100 ·
          technical <%= current.dig("thresholds", "technical") %>/100 — judge each band independently; no averaging.
        </div>
      </dl>
    </div>

    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Evidence (in occurred-at order)</h3>
      <ol class="space-y-2">
        <% Array(current["evidence"]).each do |item| %>
          <li class="rounded-lg border border-gray-200 p-3 text-sm text-gray-700">
            <p>
              <code><%= item["reference"] %></code> · <%= item["source_type"].to_s.humanize %> ·
              <%= item["actor_role"] %> · <%= item["occurred_at"] %>
              <% if item["supersedes"] %> <span class="text-amber-700">(supersedes <%= item["supersedes"] %>)</span><% end %>
            </p>
            <p class="whitespace-pre-line"><%= item["statement"] %></p>
          </li>
        <% end %>
      </ol>
    </div>

    <% if can_judge %>
      <%= form_with url: label_project_facet_confidence_evaluation_path(project, evaluation, **inbox_context), method: :post, class: "space-y-3" do |form| %>
      <%= form.hidden_field :case_id, value: current["id"] %>
      <fieldset class="space-y-2">
        <legend class="text-sm font-medium text-gray-700">Verdict</legend>
        <% FacetConfidenceEvaluationLabel::VERDICTS.each do |verdict| %>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= form.radio_button :verdict, verdict, checked: own && own["state"] == "labeled" && own["verdict"] == verdict, required: true,
                  class: "h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            <code><%= verdict %></code>
          </label>
        <% end %>
      </fieldset>
      <% [ { field: :intent_band, label: "Intent band" }, { field: :technical_band, label: "Technical band" } ].each do |band| %>
        <fieldset class="space-y-2">
          <legend class="text-sm font-medium text-gray-700"><%= band[:label] %></legend>
          <% FacetConfidenceEvaluationLabel::BANDS.each do |value| %>
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <%= form.radio_button band[:field], value, checked: own && own["state"] == "labeled" && own[band[:field].to_s] == value, required: true,
                    class: "h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              <code><%= value %></code>
            </label>
          <% end %>
        </fieldset>
      <% end %>
      <fieldset class="space-y-2">
        <legend class="text-sm font-medium text-gray-700">Readiness</legend>
        <% FacetConfidenceEvaluationLabel::READINESS.each do |value| %>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= form.radio_button :readiness, value, checked: own && own["state"] == "labeled" && own["readiness"] == value, required: true,
                  class: "h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            <code><%= value %></code>
          </label>
        <% end %>
        <p class="text-xs text-gray-500">Readiness must follow the judged bands: only a completed verdict with both bands at or above their thresholds is ready.</p>
      </fieldset>
      <div>
        <%= form.label :cited_evidence_reference, "Cited evidence", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :cited_evidence_reference, options_for_select(references, own && own["cited_evidence_reference"]), { prompt: "One pivotal reference" }, required: true,
              class: "mt-1 w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">Cite the statement your judgment turns on; corrections must cite the correcting statement, not the superseded one.</p>
      </div>
      <div>
        <%= form.label :reason, "Reason", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :reason, value: own && own["reason"], required: true, rows: 3,
              class: "mt-1 w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <%= form.submit "Save judgment",
              class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <%= button_to "Skip case", skip_project_facet_confidence_evaluation_path(project, evaluation, **inbox_context),
              params: { case_id: current["id"] },
              form: { data: { turbo_frame: "_top" } },
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        <%= button_to "Finish and freeze reference set", freeze_project_facet_confidence_evaluation_path(project, evaluation, **inbox_context),
              form: { data: { turbo_frame: "_top", turbo_confirm: "Freeze the reference judgment set? The frozen expectations become visible and judging ends." } },
              disabled: remaining.positive? || progress[:skipped].positive?,
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        <% if remaining.positive? || progress[:skipped].positive? %>
          <span class="text-xs text-amber-800">Freezing is blocked until every case is judged (no pending or skipped cases).</span>
        <% end %>
      </div>
    <% else %>
      <p class="rounded-lg bg-gray-50 p-3 text-sm text-gray-700">Only the operator who started this evaluation can record judgments.</p>
    <% end %>
  </div>
<% else %>
  <div class="space-y-3 rounded-xl border border-gray-200 bg-white p-6 text-sm text-gray-700">
    <% if progress[:skipped].positive? %>
      <p><%= progress[:skipped] %> case(s) are still skipped — resolve them before freezing; a skipped case is never completed evidence.</p>
      <% evaluation.labels.where(state: "skipped").pluck(:case_id).each do |case_id| %>
        <%= link_to "Return to skipped case #{case_id}", project_facet_confidence_evaluation_path(project, evaluation, case_id:, **inbox_context),
              data: { turbo_frame: "_top" },
              class: "mr-3 inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
    <% elsif can_judge %>
      <p>Every case is judged. You can freeze the reference set.</p>
    <% else %>
      <p>Every case is judged. Only the operator who started this evaluation can freeze the reference set.</p>
    <% end %>
    <% if can_judge %>
      <%= button_to "Finish and freeze reference set", freeze_project_facet_confidence_evaluation_path(project, evaluation, **inbox_context),
            form: { data: { turbo_frame: "_top", turbo_confirm: "Freeze the reference judgment set? The frozen expectations become visible and judging ends." } },
            class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
  </div>
<% end %>
