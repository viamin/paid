<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200">
    <div class="mb-1 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-amber-600">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" />
      </svg>
      Chat paused
    </div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
  </article>
</div>
