<%# @spec CHAT-API-024 %>
<details class="group max-w-3xl" data-chat-tool-group>
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md bg-gray-50 px-4 py-1.5 text-xs font-medium text-gray-500 marker:hidden hover:bg-gray-100">
    <svg class="h-3 w-3 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
    <span><%= pluralize(messages.size, "tool action") %></span>
  </summary>
  <div class="mt-2 space-y-3" data-chat-tool-group-cards>
    <% messages.each do |message| %>
      <%= render "chat_messages/message", message: message %>
    <% end %>
  </div>
</details>
