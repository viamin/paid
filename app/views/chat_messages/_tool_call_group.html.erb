<%# @spec CHAT-API-024 %>
<% history = local_assigns[:history] %>
<details class="group max-w-3xl" data-chat-tool-group data-action="turbo:frame-load->chat#refreshToolGroupSummary">
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md bg-gray-50 px-4 py-1.5 text-xs font-medium text-gray-500 marker:hidden hover:bg-gray-100">
    <svg class="h-3 w-3 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
    <span data-chat-tool-group-summary><%= pluralize(messages.size, "tool action") %><%= " shown" if history %></span>
  </summary>
  <div class="mt-2 space-y-3" data-chat-tool-group-cards>
    <%= render "chat_sessions/tool_history_link", history: history if history %>
    <% messages.each do |message| %>
      <%= render "chat_messages/message", message: message %>
    <% end %>
  </div>
</details>
