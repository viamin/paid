<% tool_title = message.role == "tool" ? "Tool Result" : "Tool Call" %>
<% payload = message.role == "tool" ? (message.tool_result || message.content) : message.tool_arguments %>
<% configuration_profile_plan = chat_configuration_profile_plan(payload) %>
<% tool_name = message.tool_name.presence || tool_title %>
<% summary_text = chat_tool_payload_excerpt(message).presence || (message.role == "tool" ? "No output" : "No arguments") %>
<details class="group rounded-xl border border-gray-200 bg-white/80 shadow-sm shadow-gray-100/60 <%= "ring-2 ring-amber-300" if message.pending_confirmation? %>" <% if chat_tool_expanded_by_default?(message) %>open<% end %>>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2.5 text-sm text-gray-600 marker:hidden hover:bg-gray-50/80">
    <span class="min-w-0 truncate">
      <span class="font-medium text-gray-700"><%= tool_name %></span>
      <span class="text-gray-400"> · <%= summary_text %></span>
    </span>
    <span class="inline-flex shrink-0 items-center gap-2">
      <span class="inline-flex items-center rounded-full px-2 py-1 text-[11px] font-medium <%= chat_tool_status_classes(message) %>">
        <%= chat_tool_status_label(message) %>
      </span>
      <svg class="h-3.5 w-3.5 text-gray-300 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </span>
  </summary>
  <div class="border-t border-gray-200 px-4 py-3">
    <% if configuration_profile_plan %>
      <div class="mb-3 rounded-lg border border-gray-200 bg-gray-50/80 p-3">
        <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Configuration Profile Plan</div>
        <div class="mt-1 text-sm font-medium text-gray-900"><%= chat_configuration_profile_plan_title(payload) %></div>

        <% chat_configuration_profile_plan_changes(payload).each do |change| %>
          <div class="mt-3 rounded-md border border-gray-200 bg-white px-3 py-2">
            <div class="text-xs font-medium text-gray-700"><%= configuration_profile_field_label(change[:field]) %></div>
            <div class="mt-1 text-xs text-gray-600">
              <span class="font-medium text-gray-900">From:</span>
              <code><%= format_configuration_profile_change_value(change[:from]) %></code>
            </div>
            <div class="mt-1 text-xs text-gray-600">
              <span class="font-medium text-gray-900">To:</span>
              <code><%= format_configuration_profile_change_value(change[:to]) %></code>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <pre class="overflow-x-auto whitespace-pre-wrap break-words rounded-lg bg-gray-950 p-4 text-xs leading-6 text-gray-100"><%= pretty_chat_tool_payload(payload) %></pre>

    <% if message.pending_confirmation? %>
      <div class="mt-3 flex items-center gap-2 rounded-lg bg-amber-50 px-3 py-2">
        <span class="text-xs font-medium text-amber-800">Assistant wants to run this action. Approve it?</span>
        <div class="ml-auto flex gap-2">
          <button type="button"
                  class="rounded-md bg-green-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-green-700"
                  data-action="click->chat#approveToolCall">
            Approve
          </button>
          <button type="button"
                  class="rounded-md bg-gray-200 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-300"
                  data-action="click->chat#denyToolCall">
            Deny
          </button>
        </div>
      </div>
    <% end %>
  </div>
</details>
