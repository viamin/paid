<%# @spec CHAT-TURN-RECOVERY-008 %>
<% retry_available = message.metadata["retry_available"] == true %>
<div class="flex justify-center" data-message-id="<%= message.id %>" data-chat-turn-failure-notice>
  <article class="mx-auto max-w-2xl rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-800 ring-1 ring-rose-200" role="alert">
    <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-rose-600">Response stopped</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content %></div>
    <% if retry_available %>
      <div class="mt-2">
        <button type="button"
                class="rounded-md bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-700"
                data-action="click->chat#resumeStalledTurn"
                data-chat-turn-id="<%= message.metadata["chat_turn_id"] %>">
          Retry
        </button>
      </div>
    <% end %>
  </article>
</div>
