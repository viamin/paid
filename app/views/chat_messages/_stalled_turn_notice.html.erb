<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
    <div class="mb-1 font-semibold">Chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content %></div>
    <% if (turn = message.chat_turn) %>
      <p class="mt-2 text-xs">Detected <%= time_ago_in_words(turn.detected_stalled_at) %> ago. Recovery requires your explicit confirmation.</p>
      <%= button_to "Resume from checkpoint", resume_chat_session_chat_turn_path(message.chat_session, turn),
            class: "mt-3 rounded bg-amber-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-800" %>
    <% end %>
  </article>
</div>
