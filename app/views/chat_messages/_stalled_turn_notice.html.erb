<%# @spec CHAT-API-026 %>
<% turn_id = message.metadata["chat_turn_id"] %>
<% safe_to_replay = message.metadata["safe_to_replay"] == true %>
<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-900 ring-1 ring-rose-200">
    <div class="mb-1 font-semibold">This chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content %></div>
    <% if safe_to_replay && turn_id.present? %>
      <%= button_to "Retry from saved checkpoint", chat_session_chat_turn_recovery_path(message.chat_session, turn_id), method: :post,
            class: "mt-2 rounded bg-rose-700 px-3 py-1.5 text-xs font-medium text-white hover:bg-rose-800" %>
    <% else %>
      <p class="mt-2 text-xs">Saved tool activity will not be replayed automatically. Review any tool cards above, then send a new request if needed.</p>
    <% end %>
  </article>
</div>
