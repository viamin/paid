<%# @spec CHAT-TURN-RECOVERY-004 %>
<% pending_id = Array(message.metadata["pending_message_ids"]).first %>
<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
    <div class="mb-1 font-semibold">Chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if pending_id.present? %>
      <%= link_to "Review pending confirmation", "#chat-message-#{pending_id}", class: "mt-1 inline-block text-xs font-medium text-amber-800 underline" %>
    <% end %>
  </article>
</div>
