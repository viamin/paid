<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200">
    <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-amber-600">Chat needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <button type="button" class="mt-3 rounded bg-amber-700 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-800" data-chat-turn-id="<%= message.metadata["chat_turn_id"] %>" data-action="click->chat#recoverStalledTurn">Resume safely</button>
  </article>
</div>
