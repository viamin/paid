<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-300">
    <div class="mb-1 font-semibold">Turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content %></div>
    <% if message.metadata["resumable"] %>
      <%= button_to "Resume safely", resume_chat_session_chat_message_path(message.chat_session, message),
        method: :post, class: "mt-3 rounded bg-amber-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-800",
        params: { confirm_recovery: true } %>
    <% else %>
      <p class="mt-3 text-xs">A completed side-effecting action or pending confirmation requires review before retrying.</p>
    <% end %>
  </article>
</div>
