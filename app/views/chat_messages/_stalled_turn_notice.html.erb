<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-800 ring-1 ring-rose-200">
    <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-rose-600">Chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if message.metadata["retryable"] && (turn_id = message.metadata["chat_turn_id"]) %>
      <%= button_to "Retry safely", retry_chat_session_chat_turn_path(message.chat_session, turn_id), method: :post,
        class: "mt-3 rounded bg-rose-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-800" %>
    <% end %>
  </article>
</div>
