<% turn_id = message.metadata["chat_turn_id"] %>
<article id="chat-message-<%= message.id %>" class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
  <p class="font-semibold">This turn needs attention</p>
  <p class="mt-1"><%= message.content %></p>
  <% if message.metadata["side_effecting_tools_completed"] %>
    <p class="mt-2 font-medium">A tool may already have changed something. It will not be replayed automatically.</p>
  <% end %>
  <p class="mt-2"><a class="font-medium underline" href="#chat-message-<%= message.metadata["user_message_id"] %>">Review this turn</a>, then send a new message to continue safely.</p>
  <%= button_to "Start safe retry", recover_chat_turn_path(turn_id), method: :post, class: "mt-3 rounded bg-amber-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-amber-600" %>
</article>
