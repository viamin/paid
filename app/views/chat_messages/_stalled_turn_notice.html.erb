<% turn = message.chat_session.chat_turns.find_by(id: message.metadata["chat_turn_id"]) %>
<section class="rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950" role="status">
  <p class="font-medium">This turn needs attention</p>
  <p class="mt-1"><%= message.content %></p>
  <% if turn&.status == "stalled" %>
    <%= button_to "Resume safely", resume_chat_session_chat_turn_path(message.chat_session, turn), method: :post,
      class: "mt-3 rounded bg-amber-700 px-3 py-2 font-medium text-white hover:bg-amber-800" %>
  <% end %>
</section>
