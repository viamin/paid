<% turn = ChatTurn.find_by(id: message.metadata["chat_turn_id"]) %>
<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
    <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-amber-700">Chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content %></div>
    <% if turn&.replay_safe? %>
      <%= button_to "Retry safely", recover_stalled_turn_chat_session_chat_messages_path(message.chat_session, turn_id: turn.id, revision: turn.lock_version), method: :post, class: "mt-3 rounded bg-amber-700 px-3 py-1.5 text-xs font-semibold text-white" %>
    <% else %>
      <p class="mt-3 text-xs">A tool may have run. Review the tool cards above before taking any further action.</p>
    <% end %>
  </article>
</div>
