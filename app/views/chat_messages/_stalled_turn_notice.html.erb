<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-200">
    <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-amber-600">Turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if (turn = message.chat_turn) %>
      <%= button_to "Resume safely", recover_chat_session_chat_turn_path(message.chat_session, turn), method: :post,
        params: { lock_version: turn.lock_version }, class: "mt-3 rounded bg-amber-700 px-3 py-1.5 text-xs font-semibold text-white" %>
    <% end %>
  </article>
</div>
