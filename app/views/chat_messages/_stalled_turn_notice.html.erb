<section class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950" data-message-id="<%= message.id %>">
  <p class="font-semibold">This chat turn needs attention</p>
  <p class="mt-1"><%= message.content %></p>
  <% if (turn = ChatTurn.find_by(id: message.metadata["chat_turn_id"])) %>
    <%= button_to "Retry from preserved checkpoint", retry_chat_turn_path(turn),
      params: { lock_version: turn.lock_version },
      class: "mt-3 rounded bg-amber-700 px-3 py-1.5 font-medium text-white hover:bg-amber-800" %>
  <% end %>
</section>
