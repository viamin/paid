<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
    <div class="mb-1 font-semibold uppercase tracking-wide text-amber-700">Chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if (user_message_id = message.metadata["user_message_id"]).present? %>
      <%= link_to "Review the original request", "#chat-message-#{user_message_id}", class: "mt-1 inline-block text-xs font-medium text-amber-800 underline hover:text-amber-950" %>
    <% end %>
  </article>
</div>
