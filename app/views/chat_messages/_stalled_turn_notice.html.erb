<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
    <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-amber-700">Chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if (anchor_id = message.metadata["pending_message_ids"]&.first) %>
      <%= link_to "Review confirmation", "#chat-message-#{anchor_id}", class: "mt-1 inline-block text-xs font-medium underline" %>
    <% end %>
  </article>
</div>
