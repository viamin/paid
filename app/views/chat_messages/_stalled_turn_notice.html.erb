<%# @spec CHAT-TURN-003 %>
<% turn = message.chat_session.chat_turns.find_by(id: message.metadata["chat_turn_id"]) %>
<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-900 ring-1 ring-rose-200">
    <div class="mb-1 font-semibold uppercase tracking-wide text-rose-700">Response needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if turn&.status == "stalled" %>
      <%= button_to "Continue safely", recover_turn_chat_session_path(message.chat_session, turn_id: turn.id),
            method: :post,
            form: { class: "mt-2 inline-block" },
            class: "rounded bg-rose-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-800" %>
    <% end %>
  </article>
</div>
