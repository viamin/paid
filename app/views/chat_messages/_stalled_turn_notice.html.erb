<%# @spec CHAT-TURN-002 %>
<% turn_id = message.metadata["chat_turn_id"] %>
<div class="flex justify-center" data-message-id="<%= message.id %>">
  <article class="mx-auto max-w-2xl rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-900 ring-1 ring-rose-200">
    <div class="mb-1 font-semibold">This chat turn needs attention</div>
    <div class="whitespace-pre-wrap break-words leading-6"><%= message.content.to_s %></div>
    <% if turn_id.present? %>
      <%= button_to "Review and retry safely", resume_chat_session_chat_turn_path(message.chat_session, turn_id), method: :post,
            params: { confirmed: true }, class: "mt-2 text-xs font-medium underline" %>
    <% end %>
  </article>
</div>
