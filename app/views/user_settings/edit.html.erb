<% content_for(:title) { "Settings - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="bg-white dark:bg-gray-800 shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Settings</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Configure defaults for your projects and agent behavior. These settings will apply when creating new projects or starting new agent runs.
      </p>

      <%= form_with model: @user_setting, url: user_settings_path, method: :patch, class: "mt-6" do |form| %>
        <% if @user_setting.errors.any? %>
          <div class="mb-6 rounded-md bg-red-50 dark:bg-red-900/50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
                  <%= pluralize(@user_setting.errors.count, "error") %> prevented your settings from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @user_setting.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <%# === Appearance === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">Appearance</legend>
          <p class="text-sm text-gray-500 dark:text-gray-400">Choose how the application looks to you.</p>

          <div>
            <%= form.label :theme_preference, "Theme", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.select :theme_preference,
                options_for_select([["Light", "light"], ["Dark", "dark"], ["System (auto)", "system"]], @user_setting.theme_preference),
                {},
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Select Light or Dark, or choose System to follow your browser/OS preference.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200 dark:border-gray-600">

        <%# === Polling & Timing === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">Polling &amp; Timing</legend>
          <p class="text-sm text-gray-500 dark:text-gray-400">Configure how frequently the app polls for changes and caches data.</p>

          <div>
            <%= form.label :default_poll_interval_seconds, "Default Poll Interval (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :default_poll_interval_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Default poll interval for new projects. Minimum 60 seconds.</p>
          </div>

          <div>
            <%= form.label :github_token_cache_ttl_minutes, "GitHub Token Cache TTL (minutes)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :github_token_cache_ttl_minutes, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">How long to cache GitHub token data before refreshing.</p>
          </div>

          <div>
            <%= form.label :token_validation_stale_minutes, "Token Validation Stale Threshold (minutes)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :token_validation_stale_minutes, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">How long before a token validation is considered stale and re-checked.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200 dark:border-gray-600">

        <%# === Agent Execution === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">Agent Execution</legend>
          <p class="text-sm text-gray-500 dark:text-gray-400">Configure agent behavior and defaults for new runs.</p>

          <div>
            <%= form.label :agent_timeout_seconds, "Agent Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :agent_timeout_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum time an agent can run before being stopped. Minimum 60 seconds.</p>
          </div>

          <div>
            <%= form.label :agent_update_comment_mode, "Existing PR Update Comments", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.select :agent_update_comment_mode,
                options_for_select([["Off", "off"], ["Generate summary", "summary"]], @user_setting.agent_update_comment_mode),
                {},
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Choose whether existing-PR followups post no update comment or spend tokens to generate a concise public summary from the pushed diff.</p>
          </div>

          <label class="flex items-start gap-3 rounded-md border border-gray-200 p-4 text-sm text-gray-700 dark:border-gray-700 dark:text-gray-200">
            <%= form.check_box :marketplace_auto_attach_enabled, class: "mt-1 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
            <span>
              <span class="block font-medium text-gray-900 dark:text-gray-100">Apply automatic marketplace attachments to my runs</span>
              <span class="mt-1 block text-xs text-gray-500 dark:text-gray-400">Enables team-default and automatic marketplace rules for runs you start unless an account admin already requires them for everyone.</span>
            </span>
          </label>

          <label class="flex items-start gap-3 rounded-md border border-gray-200 p-4 text-sm text-gray-700 dark:border-gray-700 dark:text-gray-200">
            <%= form.check_box :default_auto_approve, class: "mt-1 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
            <span>
              <span class="block font-medium text-gray-900 dark:text-gray-100">Default auto-approve actions in new chat sessions</span>
              <span class="mt-1 block text-xs text-gray-500 dark:text-gray-400">When checked, the "Auto-approve actions" checkbox will be pre-checked when you start a new chat session.</span>
            </span>
          </label>

          <div>
            <%= form.label :max_execution_seconds, "Max Execution Time Override (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_execution_seconds, min: 60, max: 86_400, step: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Optional override for project max execution time. Leave blank to use the project setting. Allowed range: 60 to 86,400 seconds.</p>
          </div>

          <div>
            <%= form.label :max_tokens_per_run, "Max Tokens Per Run", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_tokens_per_run, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum number of tokens an agent run can consume. Default is 10,000,000.</p>
          </div>

          <div>
            <%= form.label :issue_goal_timeout_seconds, "Issue Goal Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :issue_goal_timeout_seconds, min: 30, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum time for issue creation goals. Default is 600 seconds (10 minutes).</p>
          </div>

          <div>
            <%= form.label :issue_goal_idle_timeout_seconds, "Issue Goal Idle Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :issue_goal_idle_timeout_seconds, min: 30, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum idle time for issue creation goals before considered stuck. Default is 120 seconds.</p>
          </div>

          <div>
            <%= form.label :review_goal_idle_timeout_seconds, "Review Goal Idle Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :review_goal_idle_timeout_seconds, min: 30, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum idle time for review goals before considered stuck. Default is 300 seconds.</p>
          </div>

          <div>
            <%= form.label :git_clone_timeout_seconds, "Git Clone Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :git_clone_timeout_seconds, min: 30, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum time for git clone operations. Default is 600 seconds.</p>
          </div>

          <div>
            <%= form.label :git_unshallow_timeout_seconds, "Git Unshallow Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :git_unshallow_timeout_seconds, min: 30, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum time for git fetch --unshallow operations. Default is 1800 seconds.</p>
          </div>

          <div>
            <%= form.label :git_push_timeout_seconds, "Git Push Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :git_push_timeout_seconds, min: 10, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum time for git push operations. Default is 60 seconds.</p>
          </div>

          <div>
            <%= form.label :max_prompt_comments, "Max Prompt Comments", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_prompt_comments, min: 0, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum number of issue comments to include in agent prompts. Default is 20.</p>
          </div>

          <div>
            <%= form.label :max_comment_length, "Max Comment Length", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_comment_length, min: 100, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum character length per comment in agent prompts. Default is 2000.</p>
          </div>

          <hr class="my-6 border-gray-200 dark:border-gray-600">
          <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Issue Analysis</h4>

          <div>
            <%= form.label :issue_analysis_runner, "Issue Analysis Runner", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.select :issue_analysis_runner,
                options_for_select([["Automatic (use my chat runners)", ""]] + @user_setting.issue_analysis_runner_options, @user_setting.issue_analysis_runner),
                {},
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Runner used for the lightweight issue-readiness assessment before a run starts. Leave on Automatic to use your chat-enabled runners in priority order.</p>
          </div>

          <div>
            <%= form.label :issue_analysis_fallback_runners_csv, "Issue Analysis Fallback Runners", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.text_field :issue_analysis_fallback_runners_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "codex, gemini" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Comma-separated runners tried when the primary issue analysis runner is unavailable. Only used when a specific runner is selected above.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200 dark:border-gray-600">

        <%# === Container Resources === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">Container Resources</legend>
          <p class="text-sm text-gray-500 dark:text-gray-400">Configure resource limits for agent execution containers.</p>

          <div>
            <%= form.label :container_memory_gb, "Container Memory (GB)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :container_memory_gb, min: 0.5, step: 0.5, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Memory limit for agent containers in gigabytes. Default is 4 GB. Minimum 0.5 GB.</p>
          </div>

          <div>
            <%= form.label :container_memory_limit_mode, "Container Memory Mode", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.select :container_memory_limit_mode,
                options_for_select([["Manual fixed limit", UserSetting::CONTAINER_MEMORY_LIMIT_MODE_MANUAL], ["Auto from run profiles", UserSetting::CONTAINER_MEMORY_LIMIT_MODE_AUTO]], @user_setting.container_memory_limit_mode),
                {},
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Manual mode always applies the value above. Auto mode takes the memory limit from the learned AgentRunResourceProfile and grows it conservatively after OOMs, clamping to the auto floor/ceiling below.</p>
          </div>

          <div>
            <%= form.label :container_memory_auto_floor_gb, "Auto Floor (GB)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :container_memory_auto_floor_gb, min: (UserSetting::MIN_CONTAINER_MEMORY_AUTO_FLOOR_BYTES / (1024.0 * 1024 * 1024)), step: 0.25, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Lower bound for auto-tuned memory limits so sparse profiles do not underprovision runs. Default 0.5 GB.</p>
          </div>

          <div>
            <%= form.label :container_memory_auto_ceiling_gb, "Auto Ceiling (GB)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :container_memory_auto_ceiling_gb, min: (UserSetting::MIN_CONTAINER_MEMORY_AUTO_CEILING_BYTES / (1024.0 * 1024 * 1024)), step: 0.25, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Upper bound for auto-tuned memory limits so capacity-blocked workloads stop requesting more memory than Docker can offer. Default 16 GB.</p>
          </div>

          <div>
            <%= form.label :run_concurrency_mode, "Run Concurrency Mode", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.select :run_concurrency_mode,
                options_for_select([["Manual limit", UserSetting::RUN_CONCURRENCY_MODE_MANUAL], ["Automatic from Docker capacity", UserSetting::RUN_CONCURRENCY_MODE_AUTO]], @user_setting.run_concurrency_mode),
                {},
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Manual mode enforces the numeric run limit below. Auto mode derives effective concurrency from available Docker memory and still respects project and create PR caps.</p>
          </div>

          <div>
            <%= form.label :max_concurrent_runs, "Max Concurrent Runs", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_concurrent_runs, min: 1, max: 100, step: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum number of agent runs that can execute simultaneously in manual mode (1&ndash;100). Leave blank in auto mode to let Docker capacity decide the effective limit.</p>
          </div>

          <div>
            <label class="flex items-center gap-2 text-sm font-medium leading-6 text-gray-900 dark:text-gray-100">
              <%= hidden_field_tag "user_setting[auto_pick_skip_labels_override]", "0" %>
              <%= check_box_tag "user_setting[auto_pick_skip_labels_override]", "1", @user_setting.auto_pick_skip_labels_configured?, class: "h-4 w-4 rounded border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-indigo-600 focus:ring-indigo-600" %>
              Override Auto-Pick Skip Labels
            </label>
            <div class="mt-2">
              <%= text_field_tag "user_setting[auto_pick_skip_labels_csv]", @user_setting.auto_pick_skip_labels_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "planning, research" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Comma-separated labels that prevent auto-pick for this user. When override is off, Paid falls back to tenant labels, then built-in defaults. When override is on and this field is blank, no labels are skipped.</p>
          </div>

          <div>
            <%= form.label :container_timeout_seconds, "Container Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :container_timeout_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Default timeout for container commands. Minimum 60 seconds.</p>
          </div>

          <div>
            <%= form.label :allowed_service_images_csv, "Allowed Service Images", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.text_field :allowed_service_images_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "postgres:16, redis:7-alpine" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Comma-separated list of Docker images allowed for service containers.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200 dark:border-gray-600">

        <%# === Display Settings === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">Display Settings</legend>
          <p class="text-sm text-gray-500 dark:text-gray-400">Configure how many items are shown on project pages.</p>

          <div>
            <%= form.label :max_issues_per_page, "Max Issues Per Page", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_issues_per_page, min: 5, max: 200, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum number of issues displayed on project pages (5&ndash;200). Default is 50.</p>
          </div>

          <div>
            <%= form.label :max_prs_per_page, "Max Pull Requests Per Page", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.number_field :max_prs_per_page, min: 5, max: 200, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum number of pull requests displayed on project pages (5&ndash;200). Default is 50.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200 dark:border-gray-600">

        <%# === Project Defaults === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">Project Defaults</legend>
          <p class="text-sm text-gray-500 dark:text-gray-400">Configure default values applied when creating new projects.</p>

          <div>
            <%= form.label :default_branch, "Default Branch", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.text_field :default_branch, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "main" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Default branch name for new projects.</p>
          </div>

          <div class="flex items-center">
            <%= form.check_box :default_project_active, class: "h-4 w-4 rounded border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-indigo-600 focus:ring-indigo-600" %>
            <%= form.label :default_project_active, "Projects Active by Default", class: "ml-3 block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
          </div>
          <p class="-mt-4 ml-7 text-xs text-gray-500 dark:text-gray-400">When enabled, new projects will start polling for issues immediately.</p>

          <div>
            <%= form.label :default_allowed_github_usernames_csv, "Default Allowed GitHub Usernames", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
            <div class="mt-2">
              <%= form.text_field :default_allowed_github_usernames_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "alice, bob" %>
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Comma-separated GitHub usernames automatically allowed to trigger agent runs on new projects.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200 dark:border-gray-600">

        <%# === Advanced: Retry & Resilience === %>
        <details class="group">
          <summary class="cursor-pointer text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">
            Advanced Settings
            <span class="ml-1 text-sm font-normal text-gray-500 dark:text-gray-400">(retry policies, circuit breakers, style guide limits)</span>
          </summary>

          <div class="mt-4 space-y-6">
            <div class="rounded-md bg-yellow-50 dark:bg-yellow-900/50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-xs text-yellow-700 dark:text-yellow-300">
                    These settings control retry behavior and circuit breakers. Incorrect values may affect agent reliability. Change only if you understand the implications.
                  </p>
                </div>
              </div>
            </div>

            <div>
              <%= form.label :circuit_breaker_failure_threshold, "Circuit Breaker Failure Threshold", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :circuit_breaker_failure_threshold, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Number of consecutive failures before the circuit breaker opens.</p>
            </div>

            <div>
              <%= form.label :circuit_breaker_timeout_seconds, "Circuit Breaker Recovery Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :circuit_breaker_timeout_seconds, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Time to wait before retrying after circuit breaker opens.</p>
            </div>

            <div>
              <%= form.label :retry_max_attempts, "Retry Max Attempts", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :retry_max_attempts, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum number of retry attempts for failed operations.</p>
            </div>

            <div>
              <%= form.label :retry_base_delay, "Retry Base Delay (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :retry_base_delay, min: 0.1, step: 0.1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Base delay between retries (exponential backoff).</p>
            </div>

            <div>
              <%= form.label :retry_max_delay, "Retry Max Delay (seconds)", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :retry_max_delay, min: 0.1, step: 0.1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum delay between retries.</p>
            </div>

            <hr class="my-6 border-gray-200 dark:border-gray-600">
            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300">Style Guide Limits</h4>

            <div>
              <%= form.label :style_guide_max_raw_bytes, "Max Raw Style Guide Bytes", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :style_guide_max_raw_bytes, min: 1000, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum raw content bytes sent to LLM for style guide compression. Default is 100,000.</p>
            </div>

            <div>
              <%= form.label :style_guide_max_total_bytes, "Max Total Style Guide Injection Bytes", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :style_guide_max_total_bytes, min: 1000, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Total byte budget for all injected style guide sections in prompts. Default is 32,000.</p>
            </div>

            <div>
              <%= form.label :style_guide_max_raw_prompt_bytes, "Max Uncompressed Style Guide Prompt Bytes", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-gray-100" %>
              <div class="mt-2">
                <%= form.number_field :style_guide_max_raw_prompt_bytes, min: 1000, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 dark:text-gray-100 dark:bg-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Maximum raw content bytes injected when no compressed version is available. Default is 8,000.</p>
            </div>
          </div>
        </details>

        <div class="mt-8 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", dashboard_path, class: "text-sm font-semibold leading-6 text-gray-900 dark:text-gray-100 hover:text-gray-700 dark:hover:text-gray-300" %>
          <%= form.submit "Save Settings", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
