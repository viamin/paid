<% content_for(:title) { "Settings - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900">Settings</h1>
      <p class="mt-1 text-sm text-gray-500">
        Configure defaults for your projects and agent behavior. These settings will apply when creating new projects or starting new agent runs.
      </p>

      <%= form_with model: @user_setting, url: user_settings_path, method: :patch, class: "mt-6" do |form| %>
        <% if @user_setting.errors.any? %>
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@user_setting.errors.count, "error") %> prevented your settings from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @user_setting.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <%# === Polling & Timing === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900">Polling & Timing</legend>
          <p class="text-sm text-gray-500">Configure how frequently the app polls for changes and caches data.</p>

          <div>
            <%= form.label :default_poll_interval_seconds, "Default Poll Interval (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :default_poll_interval_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Default poll interval for new projects. Minimum 60 seconds.</p>
          </div>

          <div>
            <%= form.label :github_token_cache_ttl_minutes, "GitHub Token Cache TTL (minutes)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :github_token_cache_ttl_minutes, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">How long to cache GitHub token data before refreshing.</p>
          </div>

          <div>
            <%= form.label :token_validation_stale_minutes, "Token Validation Stale Threshold (minutes)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :token_validation_stale_minutes, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">How long before a token validation is considered stale and re-checked.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200">

        <%# === Agent Execution === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900">Agent Execution</legend>
          <p class="text-sm text-gray-500">Configure agent behavior and defaults for new runs.</p>

          <div>
            <%= form.label :agent_timeout_seconds, "Agent Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :agent_timeout_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Maximum time an agent can run before being stopped. Minimum 60 seconds.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200">

        <%# === Container Resources === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900">Container Resources</legend>
          <p class="text-sm text-gray-500">Configure resource limits for agent execution containers.</p>

          <div>
            <%= form.label :container_memory_gb, "Container Memory (GB)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :container_memory_gb, min: 0.5, step: 0.5, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Memory limit for agent containers in gigabytes. Default is 4 GB. Minimum 0.5 GB.</p>
          </div>

          <div>
            <%= form.label :max_concurrent_runs, "Max Concurrent Runs", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :max_concurrent_runs, min: 1, max: 100, step: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Maximum number of agent runs that can execute simultaneously (1&ndash;100). Default is 2.</p>
          </div>

          <div>
            <%= form.label :container_timeout_seconds, "Container Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.number_field :container_timeout_seconds, min: 60, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Default timeout for container commands. Minimum 60 seconds.</p>
          </div>

          <div>
            <%= form.label :allowed_service_images_csv, "Allowed Service Images", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :allowed_service_images_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "postgres:16, redis:7-alpine" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Comma-separated list of Docker images allowed for service containers. Can also be set via the <code class="rounded bg-gray-100 px-1 py-0.5">SERVICE_CONTAINER_ALLOWED_IMAGES</code> environment variable.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200">

        <%# === Project Defaults === %>
        <fieldset class="space-y-6">
          <legend class="text-base font-semibold leading-7 text-gray-900">Project Defaults</legend>
          <p class="text-sm text-gray-500">Configure default values applied when creating new projects.</p>

          <div>
            <%= form.label :default_branch, "Default Branch", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :default_branch, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "main" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Default branch name for new projects.</p>
          </div>

          <div class="flex items-center">
            <%= form.check_box :default_project_active, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
            <%= form.label :default_project_active, "Projects Active by Default", class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
          </div>
          <p class="-mt-4 ml-7 text-xs text-gray-500">When enabled, new projects will start polling for issues immediately.</p>

          <div>
            <%= form.label :default_allowed_github_usernames_csv, "Default Allowed GitHub Usernames", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :default_allowed_github_usernames_csv, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "alice, bob" %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Comma-separated GitHub usernames automatically allowed to trigger agent runs on new projects.</p>
          </div>
        </fieldset>

        <hr class="my-8 border-gray-200">

        <%# === Advanced: Retry & Resilience === %>
        <details class="group">
          <summary class="cursor-pointer text-base font-semibold leading-7 text-gray-900">
            Advanced Settings
            <span class="ml-1 text-sm font-normal text-gray-500">(retry policies, circuit breakers)</span>
          </summary>

          <div class="mt-4 space-y-6">
            <div class="rounded-md bg-yellow-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-xs text-yellow-700">
                    These settings control retry behavior and circuit breakers. Incorrect values may affect agent reliability. Change only if you understand the implications.
                  </p>
                </div>
              </div>
            </div>

            <div>
              <%= form.label :circuit_breaker_failure_threshold, "Circuit Breaker Failure Threshold", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :circuit_breaker_failure_threshold, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Number of consecutive failures before the circuit breaker opens.</p>
            </div>

            <div>
              <%= form.label :circuit_breaker_timeout_seconds, "Circuit Breaker Recovery Timeout (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :circuit_breaker_timeout_seconds, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Time to wait before retrying after circuit breaker opens.</p>
            </div>

            <div>
              <%= form.label :retry_max_attempts, "Retry Max Attempts", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :retry_max_attempts, min: 1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Maximum number of retry attempts for failed operations.</p>
            </div>

            <div>
              <%= form.label :retry_base_delay, "Retry Base Delay (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :retry_base_delay, min: 0.1, step: 0.1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Base delay between retries (exponential backoff).</p>
            </div>

            <div>
              <%= form.label :retry_max_delay, "Retry Max Delay (seconds)", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :retry_max_delay, min: 0.1, step: 0.1, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Maximum delay between retries.</p>
            </div>
          </div>
        </details>

        <div class="mt-8 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", dashboard_path, class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
          <%= form.submit "Save Settings", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
