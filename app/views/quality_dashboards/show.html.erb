<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">Quality Metrics</h1>
      <p class="mt-2 text-sm text-gray-700">Track agent output quality across prompts and models.</p>
    </div>
  </div>

  <%# Overview Stats %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Overview</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Average Quality Score</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
          <%= @stats[:overview][:avg_quality_score] %>
        </dd>
      </div>
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Total Metrics Collected</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
          <%= number_with_delimiter(@stats[:overview][:total_metrics]) %>
        </dd>
      </div>
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Scored Metrics</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
          <%= number_with_delimiter(@stats[:overview][:scored_metrics]) %>
        </dd>
      </div>
    </div>
  </div>

  <%# Score Distribution %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Score Distribution</h2>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <% max_count = [@stats[:score_distribution].values.max || 1, 1].max %>
      <div class="space-y-3">
        <% @stats[:score_distribution].each do |range, count| %>
          <div class="flex items-center gap-3">
            <span class="w-16 text-sm text-gray-500"><%= range %></span>
            <div class="flex-1 bg-gray-100 rounded-full h-5">
              <div class="bg-indigo-500 rounded-full h-5" style="width: <%= (count.to_f / max_count * 100).round %>%"></div>
            </div>
            <span class="w-10 text-sm text-gray-700 text-right"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
    <%# Quality by Prompt %>
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Quality by Prompt</h2>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <% if @stats[:by_prompt].any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Prompt</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Avg Score</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @stats[:by_prompt].each do |row| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= row[:name] %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= row[:avg_score] %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= row[:sample_count] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-4 py-5 text-sm text-gray-500">No prompt quality data yet.</div>
        <% end %>
      </div>
    </div>

    <%# Quality by Model %>
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Quality by Model</h2>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <% if @stats[:by_model].any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Model</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Avg Score</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @stats[:by_model].each do |row| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= row[:name] %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= row[:avg_score] %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= row[:sample_count] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-4 py-5 text-sm text-gray-500">No model quality data yet.</div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Weekly Trend %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Weekly Quality Trend</h2>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <% if @stats[:weekly_trend].any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Week</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Avg Score</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @stats[:weekly_trend].each do |row| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-900"><%= row[:week].strftime("%Y-%m-%d") %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= row[:avg_score] %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= row[:count] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-4 py-5 text-sm text-gray-500">No weekly trend data yet.</div>
      <% end %>
    </div>
  </div>
</div>
