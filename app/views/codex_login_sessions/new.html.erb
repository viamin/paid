<% content_for(:title) { "Connect Codex - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="overflow-hidden rounded-lg bg-white shadow">
    <div class="px-6 py-5">
      <h1 class="text-xl font-semibold text-gray-900">Connect Codex</h1>
      <p class="mt-1 text-sm text-gray-500">Paid starts an OpenAI device-code login, shows you a verification link and code, and captures the resulting Codex subscription credential into a managed <code>RunnerCredential</code>.</p>

      <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        This flow only performs the OAuth device-code exchange. It does not provide a general shell or terminal.
      </div>

      <%= form_with model: @codex_login_session, class: "mt-6 space-y-6" do |form| %>
        <% if @codex_login_session.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <h2 class="text-sm font-medium text-red-800">Please fix the following:</h2>
            <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
              <% @codex_login_session.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :credential_name, "Credential name", class: "block text-sm font-medium text-gray-900" %>
          <%= form.text_field :credential_name, class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          <p class="mt-2 text-xs text-gray-500">The captured managed credential will be stored under this name.</p>
        </div>

        <%= hidden_field_tag "codex_login_session[metadata][return_to]", @return_to_path %>

        <div class="flex items-center gap-3">
          <%= form.submit "Start Codex Login", class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <%= link_to "Cancel", safe_return_path_or(@return_to_path, integration_credentials_path(category: "llm_provider", service_key: "openai")), class: "text-sm font-semibold text-gray-900 hover:text-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
