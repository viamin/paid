<% content_for(:title) { "MCP Server Definitions - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-4 flex gap-x-4 border-b border-gray-200">
    <%= link_to "Service Containers", service_containers_path, class: "border-b-2 border-transparent px-1 pb-2 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700" %>
    <span class="border-b-2 border-indigo-500 px-1 pb-2 text-sm font-medium text-indigo-600">MCP Servers</span>
  </div>

  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">MCP Server Definitions</h1>
      <p class="mt-1 text-sm text-gray-500">Define MCP servers (npx or Docker) for use in projects.</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_mcp_server_definition_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
        </svg>
        New MCP Server
      <% end %>
    </div>
  </div>

  <% if @mcp_server_definitions.any? %>
    <div class="mt-6 overflow-hidden overflow-x-auto bg-white shadow sm:rounded-lg">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Install Type</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Transport</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Enabled</th>
            <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @mcp_server_definitions.each do |mcp| %>
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
                <%= link_to mcp.name, mcp_server_definition_path(mcp), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= mcp.install_type %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= mcp.transport %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= mcp.enabled? ? "Yes" : "No" %></td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                <%= link_to "Edit", edit_mcp_server_definition_path(mcp), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-6 rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No MCP server definitions</h3>
      <p class="mt-1 text-sm text-gray-500">Create a new MCP server definition to get started.</p>
      <div class="mt-6">
        <%= link_to new_mcp_server_definition_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
          </svg>
          New MCP Server
        <% end %>
      </div>
    </div>
  <% end %>
</div>
