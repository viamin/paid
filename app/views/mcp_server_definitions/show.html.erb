<% content_for(:title) { "MCP Server Definition – #{@mcp_server_definition.name}" } %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to back_link_path(mcp_server_definitions_path), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to MCP Server Definitions
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900"><%= @mcp_server_definition.name %></h1>
      </div>

      <dl class="mt-6 grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Install Type</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @mcp_server_definition.install_type %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Transport</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @mcp_server_definition.transport %></dd>
        </div>

        <% if @mcp_server_definition.command.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Command</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs"><%= @mcp_server_definition.command %></code>
            </dd>
          </div>
        <% end %>

        <% if @mcp_server_definition.image.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Image</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs"><%= @mcp_server_definition.image %></code>
            </dd>
          </div>
        <% end %>

        <% if @mcp_server_definition.url.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">URL</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @mcp_server_definition.url %></dd>
          </div>
        <% end %>

        <div>
          <dt class="text-sm font-medium text-gray-500">Enabled</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @mcp_server_definition.enabled? ? "Yes" : "No" %></dd>
        </div>

        <% if @mcp_server_definition.args.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Args</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <pre class="overflow-x-auto rounded bg-gray-50 p-3 text-xs"><%= JSON.pretty_generate(@mcp_server_definition.args) %></pre>
            </dd>
          </div>
        <% end %>

        <% if @mcp_server_definition.env.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Env</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <pre class="overflow-x-auto rounded bg-gray-50 p-3 text-xs"><%= JSON.pretty_generate(@mcp_server_definition.env) %></pre>
            </dd>
          </div>
        <% end %>

        <% if @mcp_server_definition.metadata.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Metadata</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <pre class="overflow-x-auto rounded bg-gray-50 p-3 text-xs"><%= JSON.pretty_generate(@mcp_server_definition.metadata) %></pre>
            </dd>
          </div>
        <% end %>
      </dl>

      <div class="mt-6 flex items-center gap-x-4">
        <%= link_to "Edit", edit_mcp_server_definition_path(@mcp_server_definition), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% if policy(@mcp_server_definition).destroy? %>
          <%= button_to "Delete", mcp_server_definition_path(@mcp_server_definition), method: :delete, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500", data: { turbo_confirm: "Are you sure you want to delete this MCP server definition?" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
