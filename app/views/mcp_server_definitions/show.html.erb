<% content_for(:title) { "MCP Server Definition – #{mcp_server_definition.name}" } %>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= mcp_server_definition.name %></h1>
    <div class="flex space-x-2">
      <%= link_to "Edit", edit_mcp_server_definition_path(mcp_server_definition), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <%= button_to "Delete", mcp_server_definition_path(mcp_server_definition), method: :delete, data: { turbo_confirm: "Delete this MCP server definition?" }, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500" %>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div class="bg-white p-4 rounded shadow">
      <h2 class="text-lg font-medium text-gray-900">Details</h2>
      <dl class="mt-2">
        <dt class="font-medium text-gray-500">Install Type</dt>
        <dd class="mt-1 text-gray-900"><%= mcp_server_definition.install_type %></dd>
        <dt class="mt-2 font-medium text-gray-500">Transport</dt>
        <dd class="mt-1 text-gray-900"><%= mcp_server_definition.transport %></dd>
        <dt class="mt-2 font-medium text-gray-500">Command</dt>
        <dd class="mt-1 text-gray-900"><%= mcp_server_definition.command %></dd>
        <dt class="mt-2 font-medium text-gray-500">Image</dt>
        <dd class="mt-1 text-gray-900"><%= mcp_server_definition.image %></dd>
        <dt class="mt-2 font-medium text-gray-500">URL</dt>
        <dd class="mt-1 text-gray-900"><%= mcp_server_definition.url %></dd>
        <dt class="mt-2 font-medium text-gray-500">Enabled</dt>
        <dd class="mt-1 text-gray-900"><%= mcp_server_definition.enabled? ? "Yes" : "No" %></dd>
      </dl>
    </div>
    <div class="bg-white p-4 rounded shadow">
      <h2 class="text-lg font-medium text-gray-900">Configuration</h2>
      <dl class="mt-2">
        <dt class="font-medium text-gray-500">Args</dt>
        <dd class="mt-1 text-gray-900"><pre><code><%= JSON.pretty_generate(mcp_server_definition.args) rescue mcp_server_definition.args %></code></pre></dd>
        <dt class="mt-2 font-medium text-gray-500">Env</dt>
        <dd class="mt-1 text-gray-900"><pre><code><%= JSON.pretty_generate(mcp_server_definition.env) rescue mcp_server_definition.env %></code></pre></dd>
        <dt class="mt-2 font-medium text-gray-500">Metadata</dt>
        <dd class="mt-1 text-gray-900"><pre><code><%= JSON.pretty_generate(mcp_server_definition.metadata) rescue mcp_server_definition.metadata %></code></pre></dd>
      </dl>
    </div>
  </div>
</div>
