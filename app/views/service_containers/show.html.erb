<% content_for(:title) { "#{@service_container.name} - Service Containers - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to service_containers_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to Service Containers
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900"><%= @service_container.name %></h1>
        <%= render_service_container_status(@service_container.status) %>
      </div>

      <dl class="mt-6 grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Image</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs"><%= @service_container.image %></code>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Port</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @service_container.port %></dd>
        </div>

        <% if @service_container.docker_container_id.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Docker Container ID</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs"><%= @service_container.docker_container_id %></code>
            </dd>
          </div>
        <% end %>

        <% if @service_container.env.present? %>
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Environment Variables</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <pre class="overflow-x-auto rounded bg-gray-50 p-3 text-xs"><%= JSON.pretty_generate(@service_container.env) %></pre>
            </dd>
          </div>
        <% end %>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Associated Projects</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if @service_container.projects.any? %>
              <ul class="list-disc space-y-1 pl-5">
                <% @service_container.projects.each do |project| %>
                  <li><%= link_to project.name, project_path(project), class: "text-indigo-600 hover:text-indigo-900" %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-gray-500">No projects associated.</p>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @service_container.created_at.strftime("%B %d, %Y %H:%M") %></dd>
        </div>
      </dl>

      <div class="mt-6 flex items-center gap-x-4">
        <%= link_to "Edit", edit_service_container_path(@service_container), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% if policy(@service_container).destroy? %>
          <%= button_to "Delete", service_container_path(@service_container), method: :delete, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500", data: { turbo_confirm: "Are you sure you want to delete this service container?" } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
