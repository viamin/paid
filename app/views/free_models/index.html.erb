<% content_for(:title) { "Free Models - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Free Models</h1>
      <p class="mt-1 max-w-3xl text-sm text-gray-500">
        Browse the synced OpenRouter free-model catalog, review capability and privacy signals, and choose which models each project should exclude.
      </p>
    </div>
    <%= link_to (@openrouter_free_runner ? "Edit Free Models Runner" : "Configure Free Models Runner"),
                (@openrouter_free_runner ? edit_runner_path(@openrouter_free_runner) : new_runner_path(form_variant: "api_key", runner_key: Runner::OPENROUTER_FREE_RUNNER_KEY)),
                class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
  </div>

  <div class="mt-6 rounded-lg border border-sky-200 bg-sky-50 p-4">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="text-sm font-semibold text-sky-950">Project Opt-Outs</h2>
        <p class="mt-1 text-sm text-sky-900">
          Free-model exclusions are stored per project. Select a project, then check the models you want Paid to skip.
        </p>
      </div>

      <% if @projects.any? %>
        <%= form_with url: free_models_path, method: :get, class: "flex items-center gap-2" do |form| %>
          <%= form.label :project_id, "Project", class: "sr-only" %>
          <%= form.select :project_id,
                          options_from_collection_for_select(@projects, :id, :name, @project&.id),
                          {},
                          class: "rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          <%= form.submit "Load Project", class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        <% end %>
      <% else %>
        <p class="text-sm text-sky-900">Add a project to manage free-model exclusions.</p>
      <% end %>
    </div>
  </div>

  <% if @catalog.any? %>
    <%= form_with url: project_preferences_free_models_path, method: :patch, class: "mt-8 space-y-8" do |form| %>
      <% if @project %>
        <%= hidden_field_tag :project_id, @project.id %>
        <%= hidden_field_tag "project[excluded_free_model_ids][]", "" %>
      <% end %>

      <% @catalog.each do |group| %>
        <section>
          <div class="mb-4 flex items-center justify-between">
            <div>
              <h2 class="text-lg font-semibold text-gray-900"><%= group.label %> Tier</h2>
              <p class="mt-1 text-sm text-gray-500"><%= pluralize(group.models.size, "free model") %> in this tier.</p>
            </div>
            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= tier_badge_classes(group.tier == "untiered" ? nil : group.tier) %>">
              <%= group.label %>
            </span>
          </div>

          <div class="grid gap-4 lg:grid-cols-2">
            <% group.models.each do |model| %>
              <% excluded = free_model_excluded?(@project, model) %>
              <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm <%= model.below_quality_bar? ? 'opacity-60' : '' %>">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-base font-semibold text-gray-900"><%= model.display_name %></h3>
                      <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= free_model_status_classes(model) %>">
                        <%= free_model_status_label(model) %>
                      </span>
                      <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium <%= model.below_quality_bar? ? 'bg-gray-100 text-gray-600' : 'bg-indigo-100 text-indigo-700' %>">
                        <%= model.below_quality_bar? ? "Below Quality Bar" : "Above Quality Bar" %>
                      </span>
                    </div>

                    <p class="mt-1 text-sm text-gray-500"><code><%= model.model_id %></code></p>

                    <dl class="mt-3 grid grid-cols-2 gap-3 text-sm text-gray-600">
                      <div>
                        <dt class="font-medium text-gray-900">Context</dt>
                        <dd><%= free_model_context_label(model.context_window) %> tokens</dd>
                      </div>
                      <div>
                        <dt class="font-medium text-gray-900">Max Output</dt>
                        <dd><%= free_model_context_label(model.max_output_tokens) %> tokens</dd>
                      </div>
                    </dl>
                  </div>

                  <div class="min-w-48">
                    <div class="flex flex-wrap gap-2">
                      <% if model.supports_tools? %>
                        <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">Tools</span>
                      <% end %>
                      <% if model.reasoning_supported? %>
                        <span class="inline-flex items-center rounded-full bg-violet-100 px-2 py-0.5 text-xs font-medium text-violet-700">Reasoning</span>
                      <% end %>
                    </div>

                    <div class="mt-3 inline-flex items-center gap-2 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset <%= free_model_training_risk_classes(model) %>">
                      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                        <path fill-rule="evenodd" d="M10 1.75a.75.75 0 0 1 .405.119l6.5 4.25A.75.75 0 0 1 17.25 6.75v4.768c0 2.621-1.498 5.011-3.857 6.153l-3.091 1.496a.75.75 0 0 1-.654 0l-3.091-1.496A6.81 6.81 0 0 1 2.75 11.518V6.75a.75.75 0 0 1 .345-.631l6.5-4.25A.75.75 0 0 1 10 1.75Zm0 1.637L4.25 7.145v4.373a5.31 5.31 0 0 0 3.008 4.803L10 17.613l2.742-1.292a5.31 5.31 0 0 0 3.008-4.803V7.145L10 3.387Z" clip-rule="evenodd" />
                      </svg>
                      <span>Training Risk: <%= model.data_training_risk.to_s.presence || "Unknown" %></span>
                    </div>
                  </div>
                </div>

                <div class="mt-4">
                  <div class="flex items-center justify-between text-sm">
                    <span class="font-medium text-gray-900">Capability Score</span>
                    <span class="text-gray-600"><%= model.capability_score ? format("%.1f/10", model.capability_score) : "Unknown" %></span>
                  </div>
                  <div class="mt-2 h-2 rounded-full bg-gray-100">
                    <div class="h-2 rounded-full <%= model.below_quality_bar? ? 'bg-gray-400' : 'bg-indigo-500' %>" style="width: <%= free_model_capability_width(model) %>%"></div>
                  </div>
                </div>

                <% if @project %>
                  <div class="mt-4 border-t border-gray-100 pt-4">
                    <label class="flex items-center gap-3 text-sm text-gray-700">
                      <%= check_box_tag "project[excluded_free_model_ids][]",
                                        model.model_id,
                                        excluded,
                                        disabled: !policy(@project).update?,
                                        class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                      <span>Exclude from <%= @project.name %></span>
                    </label>
                  </div>
                <% end %>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @project %>
        <div class="flex justify-end">
          <%= form.submit "Save Project Preferences",
                          disabled: !policy(@project).update?,
                          class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-gray-300" %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div class="mt-8 rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
      <h2 class="text-sm font-semibold text-gray-900">No free models synced yet</h2>
      <p class="mt-1 text-sm text-gray-500">Sync the OpenRouter catalog first, then this page will show the available free models.</p>
    </div>
  <% end %>
</div>
