<% content_for(:title) { "Migrate Projects - GitHub App - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div>
    <%= link_to @github_installation.account_login, github_installation_path(@github_installation), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    <h1 class="mt-2 text-2xl font-bold text-gray-900">Migrate Projects to GitHub App</h1>
    <p class="mt-1 text-sm text-gray-500">
      Move projects from Personal Access Tokens to the <%= @github_installation.account_login %> installation.
    </p>
  </div>

  <div class="mt-8 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">Select a Token</h2>
    <p class="mt-1 text-sm text-gray-500">Projects using the selected token will be migrated in bulk.</p>

    <%= form_with url: migrate_project_github_installation_path(@github_installation), method: :post, local: true, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :github_token_id, "GitHub token", class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :github_token_id,
          @github_tokens.map { |token| [ "#{token.name} (#{token.projects.count} projects)", token.id ] },
          { include_blank: "Choose a token" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <%= form.submit "Migrate Projects", class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
  </div>

  <div class="mt-8 rounded-lg border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-semibold text-gray-900">Eligible Projects</h2>
      <p class="mt-1 text-sm text-gray-500">Projects currently using one of the active PATs in this account.</p>
    </div>

    <% if @projects.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Project</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Repository</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Current Token</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Installation Access</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @projects.each do |project| %>
              <tr>
                <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= project.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= project.full_name %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= project.github_token&.name || "None" %></td>
                <td class="px-6 py-4 text-sm">
                  <% if @project_access_status[project.id] %>
                    <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700">Accessible</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-md bg-yellow-100 px-2 py-1 text-xs font-medium text-yellow-800">Needs Admin Action</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-8 text-sm text-gray-500">
        No PAT-backed projects are available for migration.
      </div>
    <% end %>
  </div>
</div>
