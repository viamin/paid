<% content_for(:title) { "Add Runner Credential - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div>
    <%= link_to back_link_path(runner_runner_credentials_path(@runner)), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <span aria-hidden="true" class="mr-1">&larr;</span>
      Back to credentials
    <% end %>
  </div>

  <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
    <div class="px-6 py-5">
      <h1 class="text-xl font-semibold text-gray-900">Add Runner Credential</h1>
      <p class="mt-1 text-sm text-gray-500">Store an encrypted authentication token for a subscription runner. The token is encrypted at rest and the raw value is not shown after save.</p>

      <div class="mt-4 rounded-md border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800">
        <strong>For Claude Code:</strong> Paste your <code class="bg-white px-1 font-mono">claude setup-token</code> value here. This creates a long-lived OAuth token that works headlessly.
      </div>

      <%= form_with model: [@runner, @runner_credential], class: "mt-6 space-y-6" do |form| %>
        <% if @runner_credential.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <h2 class="text-sm font-medium text-red-800">Please fix the following:</h2>
            <ul class="mt-2 list-disc pl-5 text-sm text-red-700">
              <% @runner_credential.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :token, "Setup Token", class: "block text-sm font-medium text-gray-900" %>
          <%= form.password_field :token, class: "mt-2 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "sk-ant-oat01-...", autocomplete: "off" %>
          <p class="mt-2 text-xs text-gray-500">Paste the output of <code class="bg-gray-100 px-1 font-mono">claude setup-token</code> here. The token is encrypted and never shown after save.</p>
        </div>

        <div>
          <label class="flex items-center">
            <%= form.check_box :long_lived, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
            <span class="ml-3 block text-sm font-medium text-gray-900">Long-lived token</span>
          </label>
          <p class="mt-2 text-xs text-gray-500">Check this box if this is a long-lived token that does not require periodic refresh (e.g., a setup-token with ~1 year validity).</p>
        </div>

        <div class="flex items-center gap-3">
          <%= form.submit "Save Credential", class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <%= link_to "Cancel", runner_runner_credentials_path(@runner), class: "text-sm font-semibold text-gray-900 hover:text-gray-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
