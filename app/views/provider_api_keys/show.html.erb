<% content_for(:title) { "#{@provider_api_key.name} - LLM API Keys - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to provider_api_keys_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to LLM API Keys
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-semibold text-gray-900"><%= @provider_api_key.name %></h1>
          <p class="mt-1 text-sm text-gray-500">
            Added <%= time_ago_in_words(@provider_api_key.created_at) %> ago
          </p>
        </div>
        <div class="flex items-center gap-3">
          <% if policy(@provider_api_key).edit? %>
            <%= link_to "Edit", edit_provider_api_key_path(@provider_api_key), class: "inline-flex items-center rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
          <% end %>
          <span class="inline-flex items-center rounded-md bg-green-100 px-3 py-1 text-sm font-medium text-green-700">Active</span>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200">
      <dl class="divide-y divide-gray-200">
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">API Key</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <code class="rounded bg-gray-100 px-2 py-1 font-mono text-sm">
              <%= @provider_api_key.masked_api_key %>
            </code>
          </dd>
        </div>

        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Compatible Providers</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <div class="flex flex-wrap gap-2">
              <% @provider_api_key.compatible_providers.each do |provider_key| %>
                <span class="inline-flex items-center rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                  <%= provider_key.titleize %>
                </span>
              <% end %>
            </div>
          </dd>
        </div>

        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Provider Entries</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <% if @provider_api_key.providers.any? %>
              <ul class="list-disc pl-5 space-y-1">
                <% @provider_api_key.providers.each do |provider| %>
                  <li><%= provider.display_name %> (<%= provider.fallback_role.titleize %>)</li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-gray-500">No provider entries yet. <%= link_to "Add one on the Providers page", new_provider_path, class: "text-indigo-600 hover:text-indigo-500" %>.</p>
            <% end %>
          </dd>
        </div>

        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <%= local_time(@provider_api_key.created_at) %>
          </dd>
        </div>
      </dl>
    </div>

    <% if policy(@provider_api_key).destroy? %>
      <div class="border-t border-gray-200 bg-gray-50 px-4 py-4 sm:px-6">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-medium text-gray-900">Delete API Key</h3>
            <p class="text-sm text-gray-500">This API key can only be deleted if no provider entries are currently using it. If any providers use this key, you'll need to update or remove those references first.</p>
          </div>
          <%= button_to "Delete", provider_api_key_path(@provider_api_key), method: :delete, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500", form: { data: { turbo_confirm: "Are you sure you want to delete this API key? Deletion will be blocked if any provider entries are still using it." } } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
