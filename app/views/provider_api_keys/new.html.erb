<% content_for(:title) { "Add LLM API Key - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to provider_api_keys_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to LLM API Keys
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900">Add LLM API Key</h1>
      <p class="mt-1 text-sm text-gray-500">
        Add an API key for an AI provider. Once added, you can create API-key-based provider entries on the Providers page.
      </p>

      <div class="mt-6 rounded-md bg-blue-50 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Multi-provider API keys</h3>
            <div class="mt-2 text-sm text-blue-700">
              <p>Some API keys work with multiple providers or services. For example, an OpenRouter key can be used by an OpenCode provider entry that targets OpenRouter.</p>
            </div>
          </div>
        </div>
      </div>

      <%= form_with model: @provider_api_key, url: provider_api_keys_path, class: "mt-6",
          data: { controller: "form-submit", action: "submit->form-submit#submit" } do |form| %>
        <%= render "form", form: form %>

        <div class="mt-6 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", provider_api_keys_path, class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
          <%= form.submit "Add API Key", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer",
              data: { form_submit_target: "submit", disable_with: "Saving..." } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
