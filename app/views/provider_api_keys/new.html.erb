<% content_for(:title) { "Add LLM API Key - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to provider_api_keys_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to LLM API Keys
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900">Add LLM API Key</h1>
      <p class="mt-1 text-sm text-gray-500">
        Add an API key for an AI provider. Once added, you can create API-key-based provider entries on the Providers page.
      </p>

      <div class="mt-6 rounded-md bg-blue-50 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800">Multi-provider API keys</h3>
            <div class="mt-2 text-sm text-blue-700">
              <p>Some API keys work with multiple providers (e.g., an OpenRouter key). Select all compatible providers below.</p>
            </div>
          </div>
        </div>
      </div>

      <%= form_with model: @provider_api_key, url: provider_api_keys_path, class: "mt-6",
          data: { controller: "form-submit", action: "submit->form-submit#submit" } do |form| %>
        <% if @provider_api_key.errors.any? %>
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@provider_api_key.errors.count, "error") %> prevented this API key from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @provider_api_key.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="space-y-6">
          <div>
            <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "e.g., My Anthropic API Key", required: true %>
            </div>
            <p class="mt-1 text-xs text-gray-500">A friendly name to identify this API key.</p>
          </div>

          <div>
            <%= form.label :api_key, "API Key", class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.password_field :api_key, class: "block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "sk-...", autocomplete: "new-password", spellcheck: false, required: true %>
            </div>
            <p class="mt-1 text-xs text-gray-500">Your API key is encrypted at rest and only shown in masked form after saving.</p>
          </div>

          <fieldset>
            <legend class="block text-sm font-medium leading-6 text-gray-900">Compatible Providers</legend>
            <p class="mt-1 text-xs text-gray-500">Select which providers this API key can be used with.</p>
            <div class="mt-3 space-y-2">
              <% @compatible_provider_options.each do |label, key| %>
                <div class="flex items-center">
                  <input type="checkbox" name="provider_api_key[compatible_providers][]" value="<%= key %>" id="compatible_<%= key %>"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                    <%= "checked" if @provider_api_key.compatible_providers.include?(key) %>>
                  <label for="compatible_<%= key %>" class="ml-3 block text-sm text-gray-700"><%= label %></label>
                </div>
              <% end %>
            </div>
          </fieldset>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", provider_api_keys_path, class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
          <%= form.submit "Add API Key", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer",
              data: { form_submit_target: "submit", disable_with: "Saving..." } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
