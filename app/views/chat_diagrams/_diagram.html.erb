<%# @spec QUESTION-EXPLORATION-003 QUESTION-EXPLORATION-009 QUESTION-EXPLORATION-011 %>
<article class="mt-3 max-w-full rounded-xl border border-indigo-200 bg-indigo-50/40 p-3 text-gray-800"
         data-chat-diagram-id="<%= diagram.id %>"
         data-diagram-question-key="<%= diagram.question_key %>"
         aria-label="Diagram for <%= diagram.question_title %>">
  <details data-controller="diagram">
    <summary class="cursor-pointer text-sm font-semibold text-indigo-950 focus:outline-none focus:ring-2 focus:ring-indigo-500"
             data-action="click->diagram#toggle">
      <span><%= diagram.question_title %></span>
      <span class="ml-1 font-normal text-gray-600">— <%= diagram.summary %></span>
    </summary>
    <div class="mt-3 space-y-3">
      <p class="text-sm text-gray-700"><span class="font-medium">Text equivalent:</span> <%= diagram.text_equivalent %></p>
      <div class="grid gap-2 sm:grid-cols-2" role="group" aria-label="Diagram elements">
        <% diagram.elements.each do |element| %>
          <button type="button"
                  class="min-w-0 rounded-md border border-indigo-200 bg-white p-2 text-left text-sm hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  data-diagram-target="element"
                  data-diagram-element-id="<%= element.fetch("id") %>"
                  data-action="click->diagram#select keydown->diagram#selectWithKeyboard"
                  aria-pressed="false">
            <span class="block break-words font-medium"><%= element.fetch("label") %></span>
            <span class="block break-words text-gray-600"><%= element.fetch("description") %></span>
            <% if element["href"].present? %>
              <span class="block break-all text-indigo-700"><%= element["href"] %></span>
            <% end %>
          </button>
        <% end %>
      </div>
      <%= form_with url: chat_session_chat_diagram_comments_path(chat_session, diagram), class: "space-y-2" do |form| %>
        <%= form.hidden_field :element_id, data: { diagram_target: "elementId" } %>
        <%= form.label :body, "Comment on this diagram", class: "block text-sm font-medium" %>
        <%= form.text_area :body, rows: 2, required: true, maxlength: 12_000, class: "block w-full rounded-md border-gray-300 text-sm focus:border-indigo-500 focus:ring-indigo-500", data: { diagram_target: "comment" } %>
        <%= form.submit "Add comment", class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <% end %>
    </div>
  </details>
</article>
