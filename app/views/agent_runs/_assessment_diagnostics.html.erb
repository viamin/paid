<%# @spec PARTIAL-CLOSEOUT-058 PARTIAL-CLOSEOUT-059 %>
<% if diagnostic.present? %>
  <section aria-label="Assessment diagnostics" class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-900/30">
    <h2 class="text-sm font-semibold text-amber-900 dark:text-amber-200">Assessment diagnostics</h2>
    <dl class="mt-2 grid gap-3 text-sm text-amber-800 dark:text-amber-300 sm:grid-cols-3">
      <div><dt class="font-medium">Category</dt><dd class="break-words"><%= diagnostic["category"].to_s.humanize %></dd></div>
      <div><dt class="font-medium">Provider</dt><dd class="break-all"><%= diagnostic["provider"].presence || "Not recorded" %></dd></div>
      <div><dt class="font-medium">Model</dt><dd class="break-all"><%= diagnostic["model"].presence || "Not recorded" %></dd></div>
    </dl>
    <% if diagnostic["at"].present? %>
      <p class="mt-2 break-all text-xs text-amber-800 dark:text-amber-300">Recorded: <%= diagnostic["at"] %></p>
    <% end %>
    <% if diagnostic["invalid_fields"].present? %>
      <h3 class="mt-3 text-sm font-medium text-amber-900 dark:text-amber-200">Rejected fields</h3>
      <ul class="mt-2 space-y-2 text-sm text-amber-800 dark:text-amber-300">
        <% diagnostic["invalid_fields"].each do |field| %>
          <li>
            <code class="break-all"><%= field["path"] %></code>
            <p class="break-words">Expected <%= field["expected"] %>; received <%= field["actual"] %>.</p>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if diagnostic.dig("attempt_trace", "attempts").present? %>
      <h3 class="mt-3 text-sm font-medium text-amber-900 dark:text-amber-200">Route attempts</h3>
      <ol class="mt-2 space-y-2 text-sm text-amber-800 dark:text-amber-300">
        <% diagnostic.dig("attempt_trace", "attempts").each do |attempt| %>
          <li class="break-words">
            <span class="font-medium">Attempt <%= attempt["ordinal"] %>:</span>
            <%= attempt["outcome"].to_s.humanize %>
            <% if attempt["provider"].present? || attempt["model"].present? %>
              (<%= attempt["provider"] %><%= " / #{attempt["model"]}" if attempt["model"].present? %>)
            <% end %>
            <% if attempt["skip_reason"].present? %>
              — <%= attempt["skip_reason"].to_s.humanize %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
    <% if diagnostic["request_id"].present? || diagnostic["attempt_id"].present? %>
      <details class="mt-3 text-xs text-amber-800 dark:text-amber-300">
        <summary class="cursor-pointer font-medium">Request and attempt identifiers</summary>
        <dl class="mt-2 space-y-1">
          <div><dt class="font-medium">Request</dt><dd class="break-all"><%= diagnostic["request_id"] %></dd></div>
          <div><dt class="font-medium">Attempt</dt><dd class="break-all"><%= diagnostic["attempt_id"] %></dd></div>
        </dl>
      </details>
    <% end %>
  </section>
<% end %>
