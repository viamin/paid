<%# RDR-075 M01: start-time maintenance context snapshot. Rendered for any
    maintenance run regardless of the maintenance_runs guard so reports stay
    readable during a rollback. @spec MAINT-016 %>
<section class="mt-6 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
  <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Maintenance investigation</h2>
  <dl class="mt-3 grid gap-3 text-sm text-gray-700 sm:grid-cols-2 dark:text-gray-300">
    <% if agent_run.maintenance_type.present? %>
      <div>
        <dt class="font-medium text-gray-500 dark:text-gray-400">Optimization type</dt>
        <dd><%= agent_run.maintenance_type %></dd>
      </div>
    <% end %>
    <div>
      <dt class="font-medium text-gray-500 dark:text-gray-400">Objective</dt>
      <dd><%= agent_run.maintenance_objective.presence || "Free-text question" %><% if agent_run.maintenance_recipe_version.present? %> (recipe v<%= agent_run.maintenance_recipe_version %>)<% end %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500 dark:text-gray-400">Scope</dt>
      <dd>
        <% if agent_run.maintenance_scope.present? %>
          <span class="rounded bg-indigo-50 px-1.5 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300">named</span>
          <%= agent_run.maintenance_scope %>
        <% else %>
          <span class="rounded bg-amber-50 px-1.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">broad</span>
          Explicit broad-scope investigation (entire repository)
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500 dark:text-gray-400">Pinned revision</dt>
      <dd><%= agent_run.maintenance_pinned_revision.presence || "-" %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500 dark:text-gray-400">Report</dt>
      <dd>Report-only — this scan never changes source files or opens repair work.</dd>
    </div>
    <% if agent_run.maintenance_guidance.present? %>
      <div class="sm:col-span-2">
        <dt class="font-medium text-gray-500 dark:text-gray-400">Guidance</dt>
        <dd class="whitespace-pre-wrap"><%= agent_run.maintenance_guidance %></dd>
      </div>
    <% end %>
  </dl>
</section>
