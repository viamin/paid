<%# @spec LAYERED-VERIFY-006 LAYERED-VERIFY-024 %>
<% obligation_ids = agent_run.external_metadata.dig("layered_verification", "obligation_ids") || [] %>
<% obligations = agent_run.project.layered_verification_obligations.where(id: obligation_ids).includes(:correspondence_claims).order(:external_identity) %>

<section class="mt-6 rounded-lg bg-white p-4 shadow dark:bg-gray-800" aria-labelledby="business-intent-validation-heading">
  <h2 id="business-intent-validation-heading" class="text-sm font-semibold text-gray-900 dark:text-gray-100">Business-intent validation</h2>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Authority and declared correspondence are shown separately from check coverage.</p>
  <div class="mt-3 space-y-3">
    <% obligations.each do |obligation| %>
      <div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
        <p class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= obligation.external_identity %></p>
        <dl class="mt-2 grid gap-2 text-sm text-gray-600 dark:text-gray-300 sm:grid-cols-3">
          <div><dt class="font-medium">Framework</dt><dd><%= obligation.framework.humanize %></dd></div>
          <div><dt class="font-medium">Approval</dt><dd><%= obligation.approval_state.humanize %></dd></div>
          <div><dt class="font-medium">Source revision</dt><dd class="break-all font-mono text-xs"><%= obligation.external_revision.presence || "Unresolved" %></dd></div>
        </dl>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><%= obligation.scope_description %></p>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          <span class="font-medium">Declared correspondence:</span>
          <%= obligation.correspondence_claims.any? ? obligation.correspondence_claims.map { |claim| claim.claim_type.humanize }.to_sentence : "None declared" %>
        </p>
      </div>
    <% end %>
  </div>
</section>
