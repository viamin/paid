<section class="mt-6 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
  <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Maintenance report</h2>
  <p class="mt-1 text-sm text-gray-700 dark:text-gray-200">Outcome: <strong><%= report.outcome.humanize %></strong></p>
  <p class="mt-1 text-sm text-gray-700 dark:text-gray-200">Resolved scope: <%= report.resolved_scope.presence || "Scope not resolved" %></p>
  <% if report.incomplete_checks.any? %>
    <p class="mt-2 text-sm font-medium text-amber-700 dark:text-amber-300">Coverage is incomplete; this is not a clean scan.</p>
  <% end %>
  <% { "Exclusions" => report.exclusions, "Completed checks" => report.completed_checks,
       "Incomplete checks" => report.incomplete_checks, "Collected evidence and exceptions" => report.evidence }.each do |label, value| %>
    <details class="mt-2 text-sm text-gray-700 dark:text-gray-200">
      <summary><%= label %></summary>
      <pre class="whitespace-pre-wrap break-words"><%= JSON.pretty_generate(value) %></pre>
    </details>
  <% end %>
  <ul class="mt-3 space-y-2 text-sm text-gray-700 dark:text-gray-200">
    <% report.finding_occurrences.includes(:maintenance_finding).each do |occurrence| %>
      <li class="rounded border border-gray-100 p-3 dark:border-gray-700">
        <strong><%= occurrence.claim %></strong> — <%= occurrence.maintenance_finding.status.humanize %>
        <p>Assessment: <%= occurrence.agent_assessment || "Not assessed" %>; verification: <%= occurrence.verification_disposition.humanize %>.</p>
        <p>Analyzer provenance: <%= occurrence.analyzer_provenance.presence&.to_json || "Not recorded" %>.</p>
        <p>Observed status: <%= occurrence.observed_status.humanize %>; current status: <%= occurrence.maintenance_finding.status.humanize %>.</p>
        <% if occurrence.maintenance_finding.reassessment_required? %>
          <p>Changed evidence requires reassessment of the retained dismissal.</p>
        <% end %>
        <% if occurrence.maintenance_finding.dismissal_reason.present? %>
          <p>Dismissal reason: <%= occurrence.maintenance_finding.dismissal_reason %></p>
        <% end %>
        <details class="mt-2">
          <summary>Finding evidence and validation</summary>
          <dl>
            <% { "Symbols" => occurrence.symbols, "Locations" => occurrence.locations,
                 "Supporting evidence" => occurrence.supporting_evidence, "Contrary evidence" => occurrence.contrary_evidence,
                 "Raw tool confidence" => occurrence.raw_tool_confidence,
                 "Proposed action" => occurrence.proposed_action, "Validation plan" => occurrence.validation_plan }.each do |label, value| %>
              <dt class="font-medium"><%= label %></dt>
              <dd class="whitespace-pre-wrap break-words"><%= value.nil? ? "Not recorded" : JSON.pretty_generate(value) %></dd>
            <% end %>
          </dl>
        </details>
      </li>
    <% end %>
  </ul>
</section>
