<%# @spec AGENT-RUNS-INDEX-001 AGENT-RUNS-INDEX-004 AGENT-RUNS-INDEX-005 %>
<% selected_filters = params.fetch(:q, {}) %>
<% active_filters = {
  "Status" => Array(selected_filters[:status_in]).reject(&:blank?).map(&:titleize),
  "Agent" => Array(selected_filters[:agent_type_in]).reject(&:blank?).map(&:titleize),
  "Goal" => Array(selected_filters[:goal_in]).reject(&:blank?).map(&:titleize),
  "Runner" => Array(selected_filters[:effective_runner_in]).reject(&:blank?),
  "Trigger" => Array(selected_filters[:trigger_type_in]).reject(&:blank?).map(&:titleize),
  "Search" => Array(selected_filters[:branch_name_or_temporal_workflow_id_cont]).reject(&:blank?)
}.select { |_label, values| values.any? } %>
<details class="mt-4 rounded-lg bg-white shadow ring-1 ring-black ring-opacity-5" data-testid="agent-runs-filters">
  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-gray-900">
    <span>Filters</span>
    <span class="text-gray-400">⌄</span>
  </summary>

  <div class="border-t border-gray-200 p-4">
    <%= search_form_for q, url: request.path, html: { method: :get, class: "flex flex-wrap items-end gap-4" } do |f| %>
      <div>
        <%= f.label :branch_name_or_temporal_workflow_id_cont, "Search", class: "block text-sm font-medium text-gray-700" %>
        <%= f.search_field :branch_name_or_temporal_workflow_id_cont, placeholder: "Branch or workflow ID", class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
      </div>

      <% if filter_options[:status].any? %>
        <div>
          <%= f.label :status_in, "Status", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :status_in,
            options_for_select(AgentRun::STATUSES.filter_map { |status| [status.titleize, status] if filter_options[:status].include?(status) }, selected_filters[:status_in]),
            {}, multiple: true, size: [filter_options[:status].size, 4].min,
            class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if filter_options[:agent_type].any? %>
        <div>
          <%= f.label :agent_type_in, "Agent", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :agent_type_in,
            options_for_select(AgentRun::AGENT_TYPES.filter_map { |agent_type| [agent_type.titleize, agent_type] if filter_options[:agent_type].include?(agent_type) }, selected_filters[:agent_type_in]),
            {}, multiple: true, size: [filter_options[:agent_type].size, 4].min,
            class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if filter_options[:goal].any? %>
        <div>
          <%= f.label :goal_in, "Goal", class: "block text-sm font-medium text-gray-700" %>
          <% goal_labels = {
            "create_pr" => "Create PR",
            "create_issue" => "Create Issue",
            "review" => "PR Code Review"
          } %>
          <%= f.select :goal_in,
            options_for_select(AgentRun::GOALS.filter_map { |goal| [goal_labels.fetch(goal, goal.titleize), goal] if filter_options[:goal].include?(goal) }, selected_filters[:goal_in]),
            {}, multiple: true, size: [filter_options[:goal].size, 4].min,
            class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if local_assigns[:runner_options]&.any? %>
        <div>
          <%= f.label :effective_runner_in, "Runner", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :effective_runner_in,
            options_for_select(runner_options.map { |option| [option[:label], option[:value]] }, selected_filters[:effective_runner_in]),
            {}, multiple: true, size: [runner_options.size, 4].min,
            class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if filter_options[:trigger_type].any? %>
        <div>
          <%= f.label :trigger_type_in, "Trigger", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :trigger_type_in,
            options_for_select(AgentRun::TRIGGER_TYPES.filter_map { |trigger_type| [trigger_type.titleize, trigger_type] if filter_options[:trigger_type].include?(trigger_type) }, selected_filters[:trigger_type_in]),
            {}, multiple: true, size: [filter_options[:trigger_type].size, 4].min,
            class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <div>
        <%= label_tag :sort, "Sort", class: "block text-sm font-medium text-gray-700" %>
        <%= select_tag :sort,
          options_for_select([
            ["Newest first", "newest"],
            ["Queue priority (approximate)", "queue"]
          ], params[:sort].presence || "newest"),
          id: :sort,
          class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">Queue priority requires exactly one unfinished status; otherwise newest first is used.</p>
      </div>

      <div class="flex items-end gap-2">
        <%= f.submit "Filter",
          class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <%= link_to "Reset filters",
          request.path,
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    <% end %>
    <% if active_filters.any? %>
      <p class="mt-4 text-sm text-gray-700" data-testid="active-agent-run-filters" aria-live="polite">
        Active filters: <%= active_filters.map { |label, values| "#{label}: #{values.join(', ')}" }.join("; ") %>
      </p>
    <% end %>
  </div>
</details>
