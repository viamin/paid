<%# @spec AGENT-RUNS-INDEX-001 AGENT-RUNS-INDEX-004 AGENT-RUNS-INDEX-005 %>
<% selected_values = ->(predicate) { Array(params.dig(:q, predicate)).reject(&:blank?) } %>
<% active_filters = {
  "Status" => selected_values.call(:status_in).map(&:titleize),
  "Agent" => selected_values.call(:agent_type_in).map(&:titleize),
  "Goal" => selected_values.call(:goal_in).map(&:titleize),
  "Runner" => selected_values.call(:effective_runner_in),
  "Trigger" => selected_values.call(:trigger_type_in).map(&:titleize),
  "Search" => Array(params.dig(:q, :branch_name_or_custom_prompt_cont)).reject(&:blank?)
}.reject { |_, values| values.empty? } %>
<%= tag.details(class: "mt-4 rounded-lg bg-white shadow ring-1 ring-black ring-opacity-5", data: { testid: "agent-runs-filters" }, open: active_filters.any?) do %>
  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-gray-900">
    <span>Filters</span>
    <span class="text-gray-400">⌄</span>
  </summary>

  <div class="border-t border-gray-200 p-4">
    <%= search_form_for q, url: request.path, html: { method: :get, class: "flex flex-wrap items-end gap-4" } do |f| %>
      <div>
        <%= f.label :branch_name_or_custom_prompt_cont, "Search run text", class: "block text-sm font-medium text-gray-700" %>
        <%= f.search_field :branch_name_or_custom_prompt_cont,
          placeholder: "Branch name or prompt",
          class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
      </div>

      <% if filter_options[:status].any? %>
        <div>
          <%= f.label :status_in, "Status", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :status_in,
            options_for_select(AgentRun::STATUSES.filter_map { |status| [status.titleize, status] if filter_options[:status].include?(status) }, selected_values.call(:status_in)),
            {},
            multiple: true, size: 4, aria: { describedby: "queue-sort-help" }, class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if filter_options[:agent_type].any? %>
        <div>
          <%= f.label :agent_type_in, "Agent", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :agent_type_in,
            options_for_select(AgentRun::AGENT_TYPES.filter_map { |agent_type| [agent_type.titleize, agent_type] if filter_options[:agent_type].include?(agent_type) }, selected_values.call(:agent_type_in)),
            {},
            multiple: true, size: 4, class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if filter_options[:goal].any? %>
        <div>
          <%= f.label :goal_in, "Goal", class: "block text-sm font-medium text-gray-700" %>
          <% goal_labels = {
            "create_pr" => "Create PR",
            "create_issue" => "Create Issue",
            "review" => "PR Code Review"
          } %>
          <%= f.select :goal_in,
            options_for_select(AgentRun::GOALS.filter_map { |goal| [goal_labels.fetch(goal, goal.titleize), goal] if filter_options[:goal].include?(goal) }, selected_values.call(:goal_in)),
            {},
            multiple: true, size: 4, class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if local_assigns[:runner_options]&.any? %>
        <div>
          <%= f.label :effective_runner_in, "Runner", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :effective_runner_in,
            options_for_select(runner_options.map { |option| [option[:label], option[:value]] }, selected_values.call(:effective_runner_in)),
            {},
            multiple: true, size: 4, class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <% if filter_options[:trigger_type].any? %>
        <div>
          <%= f.label :trigger_type_in, "Trigger", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :trigger_type_in,
            options_for_select(AgentRun::TRIGGER_TYPES.filter_map { |trigger_type| [trigger_type.titleize, trigger_type] if filter_options[:trigger_type].include?(trigger_type) }, selected_values.call(:trigger_type_in)),
            {},
            multiple: true, size: 2, class: "mt-1 block rounded-md border-gray-300 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      <% end %>

      <div>
        <%= label_tag :sort, "Sort", class: "block text-sm font-medium text-gray-700" %>
        <%= select_tag :sort,
          options_for_select([
            ["Newest first", "newest"],
            ["Queue priority (approximate)", "queue"]
          ], params[:sort].presence || "newest"),
          id: :sort,
          class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        <p id="queue-sort-help" class="mt-1 max-w-xs text-xs text-gray-500">Queue priority is available only when every selected status is unfinished.</p>
      </div>

      <div class="flex items-end gap-2">
        <%= f.submit "Apply filters",
          class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <%= link_to "Reset filters",
          request.path,
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    <% end %>
    <% if active_filters.any? %>
      <p class="mt-4 text-sm text-gray-700" data-testid="active-agent-run-filters">
        <span class="font-medium">Active filters:</span>
        <%= active_filters.map { |label, values| "#{label}: #{values.join(', ')}" }.join("; ") %>
      </p>
    <% end %>
  </div>
<% end %>
