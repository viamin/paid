<% content_for(:title) { "Knowledge Search - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">Knowledge Search</h1>
      <p class="mt-2 text-sm text-gray-700">Search knowledge artifacts across your projects.</p>
    </div>
  </div>

  <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
    <div class="px-4 py-5 sm:p-6">
      <%= form_with url: knowledge_search_results_path, method: :get, data: { turbo_frame: "search-results" } do |f| %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
          <div class="sm:col-span-1">
            <%= f.label :project_id, "Project", class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :project_id, options_from_collection_for_select(@projects, :id, :name, @project&.id),
                  { include_blank: "Select project..." },
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div class="sm:col-span-2">
            <%= f.label :q, "Query", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :q, value: @query, placeholder: "Search artifacts...",
                  class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div class="sm:col-span-1 flex items-end">
            <%= f.submit "Search", class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "search-results" do %>
    <%= render "knowledge/search/results" %>
  <% end %>
</div>
