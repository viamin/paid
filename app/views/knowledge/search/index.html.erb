<% content_for(:title) { "Knowledge - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">Knowledge</h1>
      <p class="mt-2 text-sm text-gray-700">Browse and search indexed knowledge across your projects. Select a project to explore its knowledge base.</p>
      <% if @error.present? %>
        <div class="mt-2 rounded-md bg-yellow-50 px-3 py-2">
          <p class="text-sm text-yellow-700"><%= @error %></p>
        </div>
      <% end %>
    </div>
  </div>

  <% if @projects.any? %>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @projects.each do |proj| %>
        <div class="overflow-hidden rounded-lg bg-white shadow">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-semibold text-gray-900"><%= proj.name %></h3>
              <% proj_status = proj.knowledge_status.to_s %>
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                <%= case proj_status
                    when 'ready' then 'bg-green-100 text-green-700'
                    when 'collecting' then 'bg-blue-100 text-blue-700'
                    when 'failed' then 'bg-red-100 text-red-700'
                    when 'stale' then 'bg-yellow-100 text-yellow-700'
                    when 'pending' then 'bg-gray-100 text-gray-600'
                    else 'bg-gray-100 text-gray-500'
                    end %>">
                <%= proj_status.capitalize %>
              </span>
            </div>
            <p class="mt-1 text-sm text-gray-500"><%= proj.full_name %></p>

            <% counts = @project_artifact_counts[proj.id] || {} %>
            <% if counts.any? %>
              <div class="mt-3 flex flex-wrap gap-1">
                <% counts.each do |type, count| %>
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
                    <%= type.titleize %> (<%= count %>)
                  </span>
                <% end %>
              </div>
            <% else %>
              <p class="mt-3 text-xs text-gray-400">No artifacts indexed yet.</p>
            <% end %>

            <div class="mt-4 flex items-center space-x-3">
              <%= link_to "Browse", project_knowledge_browse_index_path(proj),
                    class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <%= link_to "Search", project_knowledge_search_path(proj),
                    class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-12 text-center">
        <h3 class="text-sm font-semibold text-gray-900">No projects</h3>
        <p class="mt-1 text-sm text-gray-500">Add a project to start building its knowledge base.</p>
      </div>
    </div>
  <% end %>
</div>
