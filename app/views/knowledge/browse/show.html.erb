<% content_for(:title) { "#{@artifact_type.titleize.pluralize} - #{@project.name} - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to project_knowledge_browse_index_path(@project), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to Knowledge Base
    <% end %>
  </div>

  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold leading-6 text-gray-900"><%= @artifact_type.titleize.pluralize %></h1>
      <p class="mt-2 text-sm text-gray-700">
        <%= pluralize(@artifacts.size, "artifact") %> in <span class="font-medium"><%= @project.name %></span>.
      </p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "Search Knowledge", project_knowledge_search_path(@project, type: @artifact_type),
            class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  </div>

  <% if @artifacts.any? %>
    <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Identifier</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Scope Path</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Collector</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Chunks</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @artifacts.each do |artifact| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm">
                <%= link_to knowledge_artifact_path(artifact), class: "font-medium text-indigo-600 hover:text-indigo-500" do %>
                  <%= artifact.identifier || "(no identifier)" %>
                <% end %>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500">
                <% if artifact.scope_path.present? %>
                  <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs"><%= truncate(artifact.scope_path, length: 80) %></code>
                <% else %>
                  <span class="text-gray-400">--</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500">
                <%= artifact.collector_type %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">
                <%= artifact.chunks_count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-12 text-center">
        <h3 class="text-sm font-semibold text-gray-900">No <%= @artifact_type.titleize.downcase %> artifacts</h3>
        <p class="mt-1 text-sm text-gray-500">No active artifacts of this type were found for this project.</p>
      </div>
    </div>
  <% end %>
</div>
