<%= form_with model: marketplace_entry, class: "space-y-6" do |form| %>
  <% if marketplace_entry.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
      <p class="font-semibold"><%= pluralize(marketplace_entry.errors.count, "error") %> prevented this marketplace entry from being saved:</p>
      <ul class="mt-2 list-disc pl-5">
        <% marketplace_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= form.label :entry_type, "Type", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :entry_type, MarketplaceEntry::ENTRY_TYPES.map { |type| [ type.humanize, type ] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= form.label :usage_guidance, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :usage_guidance, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div class="grid gap-6 md:grid-cols-4">
    <div>
      <%= form.label :provider, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :provider, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "claude" %>
    </div>

    <div>
      <%= form.label :provider_format, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :provider_format, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= form.label :team_scope, class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :team_scope, MarketplaceEntry::TEAM_SCOPES.map { |scope| [ scope.humanize, scope ] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :status, MarketplaceEntry::STATUSES.map { |status| [ status.humanize, status ] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <div>
      <%= form.label :tags_csv, "Tags", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :tags_csv, value: marketplace_entry.tags_csv, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "ruby, internal-api" %>
    </div>

    <div>
      <%= form.label :added_by_name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :added_by_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= form.label :added_by_email, class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :added_by_email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div>
    <%= form.label :changelog, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :changelog, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Describe what changed in this version." %>
  </div>

  <div>
    <%= form.label :canonical_artifact_json, "Canonical Artifact JSON", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :canonical_artifact_json, value: marketplace_entry.canonical_artifact_json.presence || JSON.pretty_generate({}), rows: 12, class: "mt-1 block w-full rounded-md border-gray-300 font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= form.label :renderers_json, "Provider Renderers JSON", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :renderers_json, value: marketplace_entry.renderers_json.presence || JSON.pretty_generate({}), rows: 12, class: "mt-1 block w-full rounded-md border-gray-300 font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <%= form.label :compatibility_constraints_json, "Compatibility Constraints JSON", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :compatibility_constraints_json, value: marketplace_entry.compatibility_constraints_json.presence || JSON.pretty_generate({}), rows: 8, class: "mt-1 block w-full rounded-md border-gray-300 font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div>
      <%= form.label :review_metadata_json, "Review Metadata JSON", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :review_metadata_json, value: marketplace_entry.review_metadata_json.presence || JSON.pretty_generate({}), rows: 8, class: "mt-1 block w-full rounded-md border-gray-300 font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div class="rounded-lg border border-gray-200 p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-900">Automatic Rule</h3>
        <label class="inline-flex items-center text-sm text-gray-700">
          <%= form.check_box :automatic_enabled, checked: ActiveModel::Type::Boolean.new.cast(marketplace_entry.automatic_enabled), class: "mr-2 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          Enabled
        </label>
      </div>
      <%= form.label :automatic_rationale, "Reason", class: "mt-4 block text-sm font-medium text-gray-700" %>
      <%= form.text_field :automatic_rationale, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <%= form.label :automatic_conditions_json, "Conditions JSON", class: "mt-4 block text-sm font-medium text-gray-700" %>
      <%= form.text_area :automatic_conditions_json, value: marketplace_entry.automatic_conditions_json.presence || JSON.pretty_generate({}), rows: 8, class: "mt-1 block w-full rounded-md border-gray-300 font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div class="rounded-lg border border-gray-200 p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-gray-900">Team Default Rule</h3>
        <label class="inline-flex items-center text-sm text-gray-700">
          <%= form.check_box :team_default_enabled, checked: ActiveModel::Type::Boolean.new.cast(marketplace_entry.team_default_enabled), class: "mr-2 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
          Enabled
        </label>
      </div>
      <%= form.label :team_default_rationale, "Reason", class: "mt-4 block text-sm font-medium text-gray-700" %>
      <%= form.text_field :team_default_rationale, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <%= form.label :team_default_conditions_json, "Conditions JSON", class: "mt-4 block text-sm font-medium text-gray-700" %>
      <%= form.text_area :team_default_conditions_json, value: marketplace_entry.team_default_conditions_json.presence || JSON.pretty_generate({}), rows: 8, class: "mt-1 block w-full rounded-md border-gray-300 font-mono shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-4 border-t border-gray-200 pt-4">
    <%= link_to "Cancel", marketplace_entries_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
    <%= form.submit class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
  </div>
<% end %>
