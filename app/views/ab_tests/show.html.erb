<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold leading-6 text-gray-900"><%= @ab_test.name %></h1>
      <p class="mt-2 text-sm text-gray-500">
        Prompt: <%= link_to @ab_test.prompt.name, @ab_test.prompt, class: "text-indigo-600 hover:text-indigo-500" %>
      </p>
    </div>
    <div class="mt-4 flex gap-2 sm:mt-0">
      <% if @ab_test.draft? || @ab_test.paused? %>
        <%= button_to "Start", start_ab_test_path(@ab_test), method: :post, class: "inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" %>
      <% end %>
      <% if @ab_test.running? %>
        <%= button_to "Pause", pause_ab_test_path(@ab_test), method: :post, class: "inline-flex items-center rounded-md bg-yellow-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-yellow-500" %>
        <%= button_to "Complete", complete_ab_test_path(@ab_test), method: :post, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
      <% end %>
      <% if @ab_test.completed? && @ab_test.winner_variant.present? %>
        <%= button_to "Promote Winner", promote_winner_ab_test_path(@ab_test), method: :post, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% end %>
      <% unless @ab_test.completed? %>
        <%= link_to "Edit", edit_ab_test_path(@ab_test), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
    </div>
  </div>

  <%# Status & Config %>
  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Status</dt>
      <dd class="mt-1 text-lg font-semibold">
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-sm font-medium
          <%= case @ab_test.status
              when 'draft' then 'bg-gray-100 text-gray-700'
              when 'running' then 'bg-blue-100 text-blue-700'
              when 'paused' then 'bg-yellow-100 text-yellow-700'
              when 'completed' then 'bg-green-100 text-green-700'
              when 'cancelled' then 'bg-red-100 text-red-700'
              end %>">
          <%= @ab_test.status.capitalize %>
        </span>
      </dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Total Samples</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @ab_test.total_samples %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Traffic %</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @ab_test.traffic_percentage %>%</dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Min Sample Size</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @ab_test.min_sample_size %></dd>
    </div>
  </div>

  <% if @ab_test.description.present? %>
    <div class="mt-6 rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <h3 class="text-sm font-medium text-gray-500">Description</h3>
      <p class="mt-2 text-sm text-gray-900"><%= @ab_test.description %></p>
    </div>
  <% end %>

  <%# Variants %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Variants</h2>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <% if @ab_test.variants.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Prompt Version</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Weight</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Avg Score</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Winner?</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @ab_test.variants.includes(:prompt_version).each do |variant| %>
              <tr class="<%= 'bg-green-50' if @ab_test.winner_variant == variant %>">
                <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= variant.name %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500">v<%= variant.prompt_version.version %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= variant.weight %>%</td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= variant.sample_count %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= variant.avg_quality_score&.round(3) || "—" %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm">
                  <% if @ab_test.winner_variant == variant %>
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Winner</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-4 py-5 text-sm text-gray-500">No variants configured yet.</div>
      <% end %>
    </div>
  </div>

  <%# Analysis Results %>
  <% if @analysis %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Analysis</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Statistical Status</dt>
          <dd class="mt-1 text-lg font-semibold
            <%= case @analysis[:status]
                when :significant then 'text-green-600'
                when :not_significant then 'text-yellow-600'
                else 'text-gray-500'
                end %>">
            <%= @analysis[:status].to_s.titleize %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Confidence</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= (@analysis[:confidence] * 100).round(1) %>%</dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Improvement</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight <%= @analysis[:improvement] > 0 ? 'text-green-600' : 'text-gray-900' %>">
            <%= @analysis[:improvement] > 0 ? '+' : '' %><%= @analysis[:improvement] %>%
          </dd>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-8">
    <%= link_to "Back to A/B Tests", ab_tests_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
  </div>
</div>
