<%= form_with(model: ab_test, class: "mt-6 space-y-6") do |f| %>
  <% if ab_test.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="list-disc pl-5 space-y-1 text-sm text-red-800">
        <% ab_test.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :prompt_id, "Prompt", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :prompt_id, prompts, :id, :name, { include_blank: "Select a prompt..." }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :traffic_percentage, "Traffic %", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :traffic_percentage, in: 0..100, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :min_sample_size, "Min samples per variant", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :min_sample_size, min: 1, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <fieldset class="border border-gray-300 rounded-md p-4">
    <legend class="text-sm font-medium text-gray-700 px-2">Variants</legend>
    <% if ab_test.prompt.present? %>
      <div id="variants" class="space-y-4">
        <%= f.fields_for :variants do |vf| %>
          <div class="grid grid-cols-12 gap-2 items-end">
            <div class="col-span-4">
              <%= vf.label :name, class: "block text-xs font-medium text-gray-500" %>
              <%= vf.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
            <div class="col-span-4">
              <%= vf.label :prompt_version_id, "Prompt Version", class: "block text-xs font-medium text-gray-500" %>
              <%= vf.collection_select :prompt_version_id, ab_test.prompt.prompt_versions.order(:version), :id, ->(pv) { "v#{pv.version}" }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
            <div class="col-span-2">
              <%= vf.label :weight, class: "block text-xs font-medium text-gray-500" %>
              <%= vf.number_field :weight, min: 1, max: 100, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
            <div class="col-span-2">
              <% if vf.object.persisted? %>
                <%= vf.label :_destroy, "Remove", class: "block text-xs font-medium text-gray-500" %>
                <%= vf.check_box :_destroy, class: "mt-2 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Select a prompt above and save the test first, then add variants to configure prompt versions for comparison.</p>
    <% end %>
    <p class="mt-2 text-xs text-gray-500">At least 2 variants are required to start a test. Name one "control" to designate it as the baseline.</p>
  </fieldset>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", ab_tests_path, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= f.submit class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
