<% content_for(:title) { "New A/B Test - #{@prompt.name} - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to prompt_ab_tests_path(@prompt), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to A/B Tests
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900">New A/B Test</h1>
      <p class="mt-1 text-sm text-gray-500">
        Create an A/B test for <strong><%= @prompt.name %></strong>.
        The current version (v<%= @prompt.current_version&.version || "?" %>) will be used as the control.
      </p>

      <%= form_with model: @ab_test, url: prompt_ab_tests_path(@prompt), method: :post, class: "mt-6" do |form| %>
        <% if @ab_test.errors.any? %>
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@ab_test.errors.count, "error") %> prevented this A/B test from being created:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @ab_test.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="space-y-6">
          <div>
            <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_field :name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", required: true, placeholder: "e.g. Improve coding prompt v2" %>
            </div>
          </div>

          <div>
            <%= form.label :description, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <div class="mt-2">
              <%= form.text_area :description, rows: 2, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "Optional description of what this test is comparing" %>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium leading-6 text-gray-900">Variants to Test</label>
            <p class="mt-1 text-xs text-gray-500">
              Select up to 3 prompt versions to test against the control (v<%= @prompt.current_version&.version || "?" %>).
              Only versions other than the current version are shown.
            </p>
            <% non_current_versions = @versions.reject { |v| v.id == @prompt.current_version_id } %>
            <div class="mt-3 space-y-2">
              <% non_current_versions.each do |version| %>
                <label class="flex items-start rounded-md border border-gray-200 p-3 hover:bg-gray-50 cursor-pointer">
                  <input type="checkbox" name="ab_test[variant_version_ids][]" value="<%= version.id %>"
                         <%= "checked" if @selected_variant_ids&.include?(version.id) %>
                         class="mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                  <div class="ml-3">
                    <span class="text-sm font-medium text-gray-900">v<%= version.version %></span>
                    <% if version.change_notes.present? %>
                      <span class="ml-2 text-sm text-gray-500"><%= version.change_notes %></span>
                    <% end %>
                    <div class="mt-0.5 text-xs text-gray-400"><%= local_time(version.created_at, format: :short) %></div>
                  </div>
                </label>
              <% end %>
              <% if non_current_versions.empty? %>
                <p class="text-sm text-gray-500 italic">No other versions available. Create additional prompt versions first.</p>
              <% end %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label :min_samples_per_variant, "Min Samples per Variant", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :min_samples_per_variant, value: @ab_test.min_samples_per_variant || 30, min: 2, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", required: true %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Minimum number of samples before analysis.</p>
            </div>

            <div>
              <%= form.label :confidence_threshold, "Confidence Threshold", class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= form.number_field :confidence_threshold, value: @ab_test.confidence_threshold || 0.95, min: 0.5, max: 0.999, step: 0.01, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", required: true %>
              </div>
              <p class="mt-1 text-xs text-gray-500">Statistical confidence level (e.g. 0.95 = 95%).</p>
            </div>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-end gap-x-4">
          <%= link_to "Cancel", prompt_ab_tests_path(@prompt), class: "text-sm font-semibold leading-6 text-gray-900 hover:text-gray-700" %>
          <%= form.submit "Create A/B Test", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
