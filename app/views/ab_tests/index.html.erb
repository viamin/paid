<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">A/B Tests</h1>
      <p class="mt-2 text-sm text-gray-700">Compare prompt versions to find the best performers.</p>
    </div>
    <% if policy(AbTest.new).create? %>
      <div class="mt-4 sm:mt-0">
        <%= link_to "New A/B Test", new_ab_test_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>

  <%# Filters %>
  <div class="mt-6 rounded-lg bg-white p-4 shadow">
    <%= search_form_for @q, url: ab_tests_path, html: { method: :get, class: "flex flex-wrap gap-4 items-end" } do |f| %>
      <div>
        <%= f.label :name_cont, "Name", class: "block text-sm font-medium text-gray-700" %>
        <%= f.search_field :name_cont, class: "mt-1 block rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Search..." %>
      </div>
      <div>
        <%= f.label :status_eq, "Status", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :status_eq, AbTest::STATUSES.map { |s| [s.capitalize, s] }, { include_blank: "All" }, class: "mt-1 block rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.submit "Filter", class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" %>
        <%= link_to "Clear", ab_tests_path, class: "ml-2 text-sm text-gray-500 hover:text-gray-700" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 overflow-hidden rounded-lg bg-white shadow">
    <% if @ab_tests.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Prompt</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Variants</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Samples</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @ab_tests.each do |test| %>
            <tr>
              <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-indigo-600">
                <%= link_to test.name, test %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500"><%= test.prompt.name %></td>
              <td class="whitespace-nowrap px-4 py-3 text-sm">
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                  <%= case test.status
                      when 'draft' then 'bg-gray-100 text-gray-700'
                      when 'running' then 'bg-blue-100 text-blue-700'
                      when 'completed' then 'bg-green-100 text-green-700'
                      when 'cancelled' then 'bg-red-100 text-red-700'
                      end %>">
                  <%= test.status.capitalize %>
                </span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= test.ab_test_variants.size %></td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= test.ab_test_variants.map(&:sample_count).sum %></td>
              <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500"><%= test.created_at.strftime("%Y-%m-%d") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="px-4 py-3">
        <%== pagy_nav(@pagy) %>
      </div>
    <% else %>
      <div class="px-4 py-12 text-center text-sm text-gray-500">
        No A/B tests yet. <%= link_to "Create one", new_ab_test_path, class: "text-indigo-600 hover:text-indigo-500" %> to start comparing prompt versions.
      </div>
    <% end %>
  </div>
</div>
