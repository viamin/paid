<%# @spec PROJECT-READINESS-005 %>
<div class="space-y-6">
  <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
    <h3 class="text-sm font-semibold text-amber-900">Project setup required</h3>
    <p class="mt-1 text-sm text-amber-800">
      TDD mode is enabled, but the latest checkout is missing prerequisites for its red/green cycle.
    </p>
  </div>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Missing prerequisites</h3>
    <ul class="space-y-2 text-sm text-gray-700">
      <% entry.record.readiness_gaps.each do |gap| %>
        <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
          <p><%= gap["description"] || gap[:description] %></p>
          <% evidence = gap["evidence"] || gap[:evidence] %>
          <% if evidence.present? %>
            <p class="mt-1 text-xs text-gray-500"><%= evidence.to_json %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="flex gap-3">
    <%= button_to "Start bootstrap run", bootstrap_readiness_project_agent_runs_path(entry.project),
          class: "inline-flex items-center rounded-md bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500" %>
    <%= link_to "Open project settings", entry.action_url,
          class: "inline-flex items-center rounded-md border border-amber-600 px-4 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-100" %>
  </div>
</div>
