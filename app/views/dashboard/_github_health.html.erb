<%= turbo_frame_tag "dashboard-github-health" do %>
<div class="overflow-hidden rounded-lg bg-white shadow">
  <div class="px-4 py-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-base font-semibold text-gray-900">GitHub Credential Health</h3>
        <p class="mt-1 text-sm text-gray-500">Per-credential rate-limit usage. App installations get a 15,000/hr budget each; PATs share 5,000/hr across projects.</p>
      </div>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= healthy ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
        <%= healthy ? "Healthy" : "Degraded" %>
      </span>
    </div>

    <% if has_github_credentials %>
      <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
        <div class="rounded-lg bg-gray-50 px-3 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">App Installs</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= app_count %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 px-3 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">PATs</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= pat_count %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 px-3 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Rate Limited</dt>
          <dd class="mt-1 text-2xl font-semibold text-amber-600"><%= rate_limited %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 px-3 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Circuit Open</dt>
          <dd class="mt-1 text-2xl font-semibold text-red-600"><%= circuit_open %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 px-3 py-3">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Inactive</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-500"><%= inactive %></dd>
        </div>
      </dl>

      <div class="mt-4 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
          <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
            <table class="min-w-full divide-y divide-gray-300">
              <thead>
                <tr>
                  <th scope="col" class="py-2 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500 sm:pl-0">Credential</th>
                  <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Auth</th>
                  <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Status</th>
                  <th scope="col" class="px-3 py-2 text-right text-xs font-medium uppercase tracking-wide text-gray-500">Quota Used</th>
                  <th scope="col" class="px-3 py-2 text-right text-xs font-medium uppercase tracking-wide text-gray-500">Remaining</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% credentials.each do |credential| %>
                  <tr>
                    <td class="whitespace-nowrap py-2 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-0"><%= credential.label %></td>
                    <td class="whitespace-nowrap px-3 py-2 text-sm text-gray-500">
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= credential.auth_source == 'app' ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-600' %>">
                        <%= credential.auth_source == 'app' ? 'App' : 'PAT' %>
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-sm text-gray-900">
                      <% badge_classes = case credential.status
                      when :rate_limited
                        "bg-amber-100 text-amber-700"
                      when :circuit_open
                        "bg-red-100 text-red-700"
                      when :recovering
                        "bg-sky-100 text-sky-700"
                      when :suspended, :revoked, :expired
                        "bg-gray-100 text-gray-600"
                      else
                        "bg-green-100 text-green-700"
                      end %>
                      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= badge_classes %>">
                        <%= credential.status_label %>
                      </span>
                      <% if credential.status == :rate_limited && credential.rate_limited_until.present? %>
                        <p class="mt-1 text-xs text-gray-500">Resets <%= local_time(credential.rate_limited_until, format: :relative) %></p>
                      <% elsif credential.inactive %>
                        <p class="mt-1 text-xs text-gray-500">No usable quota — remove or replace</p>
                      <% end %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-right text-sm text-gray-900">
                      <% if credential.rate_limit_usage_percent.present? %>
                        <%= number_to_percentage(credential.rate_limit_usage_percent.round(1), precision: 1) %>
                        <% if credential.rate_limit_limit.present? %>
                          <span class="block text-xs text-gray-400">of <%= number_with_delimiter(credential.rate_limit_limit) %>/hr</span>
                        <% end %>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-right text-sm text-gray-900">
                      <% if credential.rate_limit_remaining.present? %>
                        <%= number_with_delimiter(credential.rate_limit_remaining) %>
                      <% else %>
                        <span class="text-gray-400">—</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-gray-500">No GitHub credentials are configured for this account yet. Migrate projects to a GitHub App installation for isolated per-installation quotas.</p>
    <% end %>
  </div>
</div>
<% end %>
