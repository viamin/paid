<%# @spec OPERATOR-INBOX-024 INBOX-PROGRESS-004 %>
<% workflow = entry.workflow_milestones %>
<% if workflow[:milestones].any? %>
  <section data-testid="inbox-workflow" class="mb-6 min-w-0 border-b border-gray-200 pb-6" aria-labelledby="workflow-milestones-heading">
    <h3 id="workflow-milestones-heading" class="text-sm font-semibold text-gray-900">Workflow milestones</h3>
    <% actions = workflow[:current_actions] || Array(workflow[:current_action]) %>
    <% if actions.any? %>
      <div role="status">
      <ul class="mt-2 space-y-1 rounded-md bg-indigo-50 p-3 text-sm font-medium text-indigo-950" aria-label="Current gates and next actions">
        <% actions.each do |action| %>
          <li data-testid="progress-next-action"><%= action %></li>
        <% end %>
      </ul>
      </div>
    <% end %>
    <% sole_current = workflow[:milestones].count { |milestone| milestone[:current] } == 1 %>
    <ol class="mt-3 flex flex-wrap gap-2 pb-1" aria-label="Workflow milestones">
      <% workflow[:milestones].each do |milestone| %>
        <li class="min-w-0 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-700">
          <span class="block font-semibold text-gray-900"><%= milestone[:name] %></span>
          <span class="block"><%= milestone[:label] %></span>
        </li>
      <% end %>
    </ol>
    <div class="mt-3 space-y-2">
      <% workflow[:milestones].each do |milestone| %>
        <details data-progress-milestone="<%= milestone[:name].parameterize(separator: "_") %>" class="min-w-0 rounded-md border border-gray-200 p-3">
          <summary class="cursor-pointer break-words text-sm font-medium text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"<% if milestone[:current] && sole_current %> aria-current="step"<% end %>>
            <%= milestone[:name] %>: <span data-progress-state="<%= milestone[:state] %>"><%= milestone[:label] %></span>
          </summary>
          <p class="mt-2 text-sm text-gray-700"><%= milestone[:reason] %></p>
          <% if milestone[:revision].present? && milestone[:evidence].blank? %><p class="mt-1 text-xs text-gray-500">Revision: <code class="break-all"><%= milestone[:revision] %></code></p><% end %>
          <% if milestone[:actor].present? %><p class="mt-1 text-xs text-gray-500">Responsible role: <%= milestone[:actor] %></p><% end %>
          <% if milestone[:action].present? %><p class="mt-1 text-sm font-medium text-gray-900">Action: <%= milestone[:action] %></p><% end %>
          <% if milestone[:evidence].present? %>
            <ul class="mt-2 space-y-2 text-xs text-gray-500">
              <% milestone[:evidence].each do |evidence| %>
                <li>
                  <span><%= evidence[:source].to_s.humanize %></span>
                  <% if evidence[:revision].present? %><code class="block break-all"><%= evidence[:revision] %></code><% end %>
                  <% if safe_github_url?(evidence[:url]) %><%= link_to "View on GitHub", evidence[:url], target: "_blank", rel: "noopener noreferrer", class: "font-semibold underline" %><% end %>
                </li>
              <% end %>
            </ul>
          <% elsif safe_github_url?(milestone[:url]) %><p class="mt-2"><%= link_to "View on GitHub", milestone[:url], target: "_blank", rel: "noopener noreferrer", class: "text-sm font-semibold underline" %></p><% end %>
        </details>
      <% end %>
    </div>
  </section>
<% end %>
