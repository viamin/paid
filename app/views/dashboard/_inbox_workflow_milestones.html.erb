<%# @spec OPERATOR-INBOX-023 %>
<% workflow = entry.workflow_milestones %>
<% if workflow[:milestones].any? %>
  <section class="mb-6 border-b border-gray-200 pb-6" aria-labelledby="workflow-milestones-heading">
    <h3 id="workflow-milestones-heading" class="text-sm font-semibold text-gray-900">Workflow milestones</h3>
    <% if workflow[:current_action].present? %>
      <p class="mt-1 text-sm font-medium text-gray-900" role="status">Next action: <%= workflow[:current_action] %></p>
    <% end %>
    <ol class="mt-3 flex gap-2 overflow-x-auto pb-1" aria-label="Workflow milestones">
      <% workflow[:milestones].each do |milestone| %>
        <li class="min-w-32 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-xs text-gray-700"<% if milestone[:current] %> aria-current="step"<% end %>>
          <span class="block font-semibold text-gray-900"><%= milestone[:name] %></span>
          <span class="block"><%= milestone[:label] %></span>
        </li>
      <% end %>
    </ol>
    <div class="mt-3 space-y-2">
      <% workflow[:milestones].each do |milestone| %>
        <details class="rounded-md border border-gray-200 p-3">
          <summary class="cursor-pointer text-sm font-medium text-gray-900"<% if milestone[:current] %> aria-current="step"<% end %>>
            <%= milestone[:name] %>: <%= milestone[:label] %> (<%= milestone[:state].tr('_', ' ') %>)
          </summary>
          <p class="mt-2 text-sm text-gray-700"><%= milestone[:reason] %></p>
          <% if milestone[:revision].present? %><p class="mt-1 text-xs text-gray-500">Revision: <code><%= milestone[:revision] %></code></p><% end %>
          <% if milestone[:actor].present? %><p class="mt-1 text-xs text-gray-500">Actor: <%= milestone[:actor] %></p><% end %>
          <% if milestone[:action].present? %><p class="mt-1 text-sm font-medium text-gray-900">Action: <%= milestone[:action] %></p><% end %>
          <% if milestone[:url].present? %><p class="mt-2"><%= link_to "Open on GitHub", milestone[:url], target: "_blank", rel: "noopener noreferrer", class: "text-sm font-semibold underline" %></p><% end %>
        </details>
      <% end %>
    </div>
  </section>
<% end %>
