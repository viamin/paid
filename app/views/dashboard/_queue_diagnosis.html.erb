<%= turbo_frame_tag "dashboard-queue-diagnosis" do %>
  <%# @spec QUEUE-DIAG-001 @spec QUEUE-DIAG-002 @spec QUEUE-DIAG-003 @spec QUEUE-DIAG-010 %>
  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm"
    data-queue-diagnosis-state="<%= diagnosis.state %>"
    data-queue-diagnosis-generated-at="<%= diagnosis.generated_at.utc.iso8601 %>">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h3 class="text-base font-semibold text-gray-900">Queue Diagnosis</h3>
        <p class="mt-1 text-sm text-gray-500"><%= diagnosis.state_label %></p>
      </div>
      <p class="text-xs text-gray-400" data-queue-diagnosis-freshness>
        Updated <%= time_ago_in_words(diagnosis.generated_at) %> ago
      </p>
    </div>

    <p data-dashboard-frames-refresh-notice
      class="mt-3 hidden rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800">
      The last refresh failed. This is the last known queue state — reload the page to retry.
    </p>

    <% if diagnosis.failed? %>
      <p class="mt-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-800">
        <%= diagnosis.recovery %>
      </p>
    <% end %>

    <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-xs sm:grid-cols-3">
      <div>
        <dt class="text-gray-500">Eligible (not queued)</dt>
        <dd class="font-medium text-gray-900"><%= diagnosis.counts.eligible %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Queued</dt>
        <dd class="font-medium text-gray-900"><%= diagnosis.counts.queued %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Running</dt>
        <dd class="font-medium text-gray-900"><%= diagnosis.counts.running %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Blocked</dt>
        <dd class="font-medium text-gray-900"><%= diagnosis.counts.blocked %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Paused</dt>
        <dd class="font-medium text-gray-900"><%= diagnosis.counts.paused %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Held open</dt>
        <dd class="font-medium text-gray-900"><%= diagnosis.counts.held %></dd>
      </div>
    </dl>
    <p class="mt-2 text-xs text-gray-400">
      Issues with queued or running work are not counted as eligible candidates.
    </p>

    <% if diagnosis.next_actions.any? %>
      <ul class="mt-4 space-y-1 text-sm text-gray-700">
        <% diagnosis.next_actions.each do |action| %>
          <li><%= action %></li>
        <% end %>
      </ul>
    <% end %>

    <% unknown_projects = diagnosis.projects.select(&:coverage_unknown?) %>
    <% if unknown_projects.any? %>
      <div class="mt-4 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800">
        <p>Issue coverage is unknown for <%= unknown_projects.size %> project(s). A failed or stale sync is never proof that no work exists.</p>
        <ul class="mt-1 list-disc pl-4">
          <% unknown_projects.each do |project_diagnosis| %>
            <li>
              <%= project_diagnosis.project.full_name %> — <%= project_diagnosis.coverage_reason %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if diagnosis.blockers.any? %>
      <div class="mt-4 divide-y divide-gray-200 border-t border-gray-200">
        <% diagnosis.blockers.each do |detail| %>
          <div class="py-3" data-queue-diagnosis-issue="<%= detail.issue.id %>">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <%= link_to "##{detail.issue.github_number} #{detail.issue.title}".truncate(120),
                detail.issue.github_url,
                class: "text-sm font-medium text-gray-900 hover:text-indigo-600",
                target: "_blank",
                rel: "noopener" %>
              <% if detail.human_decision? %>
                <%= link_to "Open Inbox",
                  inbox_path(project_id: detail.issue.project_id, kind: inbox_lane_for(detail)),
                  class: "text-xs font-medium text-amber-700 hover:text-amber-800",
                  data: { turbo_frame: "_top" } %>
              <% end %>
            </div>
            <ul class="mt-2 space-y-1 text-xs text-gray-600">
              <% detail.blockers.each do |blocker| %>
                <li>
                  <span class="font-medium text-gray-800"><%= blocker.message %></span>
                  <% if blocker.owner.present? %>
                    <span class="text-gray-500">Owner: <%= blocker.owner %>.</span>
                  <% end %>
                  <span class="text-gray-500">Next: <%= blocker.recovery %></span>
                </li>
              <% end %>
            </ul>
            <% if detail.assessment %>
              <p class="mt-1 text-xs text-gray-400">
                Last assessed <%= time_ago_in_words(detail.assessment.assessed_at) %> ago
                (<%= detail.assessment.outcome %>).
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
