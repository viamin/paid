<%# @spec QUEUE-DIAGNOSIS-001 @spec QUEUE-DIAGNOSIS-002 @spec QUEUE-DIAGNOSIS-003 %>
<%= turbo_frame_tag "dashboard-queue-diagnosis" do %>
  <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h3 class="text-base font-semibold text-gray-900">Queue diagnosis</h3>
    <p class="mt-1 text-sm text-gray-600"><%= diagnosis.next_action %></p>
    <% if diagnosis.state == :unknown %>
      <p class="mt-3 text-sm text-amber-800">Coverage is unknown; refresh before concluding there is no work.</p>
    <% else %>
      <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
        <div><dt class="text-gray-500">Eligible</dt><dd class="font-semibold"><%= diagnosis.eligible_count %></dd></div>
        <div><dt class="text-gray-500">Queued</dt><dd class="font-semibold"><%= diagnosis.queued_count %></dd></div>
        <div><dt class="text-gray-500">Active</dt><dd class="font-semibold"><%= diagnosis.active_count %></dd></div>
        <div><dt class="text-gray-500">State</dt><dd class="font-semibold"><%= diagnosis.state.to_s.humanize %></dd></div>
      </dl>
      <p class="mt-3 text-xs text-gray-500">Last successful diagnosis: <%= l(diagnosis.checked_at, format: :short) %>.</p>
      <% if diagnosis.blockers.any? %>
        <ul class="mt-3 space-y-1 text-sm text-gray-700">
          <% diagnosis.blockers.each do |blocker| %>
            <li><%= link_to "##{blocker.issue.github_number}", blocker.issue.github_url, class: "font-medium text-indigo-600 hover:text-indigo-500" %>:
              <%= blocker.blocking_issues.map { |issue| "##{issue.github_number}" }.presence || blocker.kind.to_s.humanize %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </section>
<% end %>
