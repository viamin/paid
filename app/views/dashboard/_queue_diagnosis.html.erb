<%# @spec QUEUE-DIAGNOSIS-001 @spec QUEUE-DIAGNOSIS-002 @spec QUEUE-DIAGNOSIS-003 %>
<%= turbo_frame_tag "dashboard-queue-diagnosis" do %>
  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-semibold text-gray-900">Upcoming Queue diagnosis</h3>
        <p class="mt-1 text-sm text-gray-500">
          Eligible candidates, queued runs, and active work are separate facts.
        </p>
      </div>
      <span class="text-sm font-medium text-gray-700"><%= diagnosis.state.to_s.humanize %></span>
    </div>

    <% unless diagnosis.unknown? %>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600">
        <span><%= diagnosis.eligible_count %> eligible candidates</span>
        <span><%= diagnosis.queued_count %> queued runs</span>
        <span><%= diagnosis.active_count %> active runs</span>
      </div>
    <% end %>

    <p class="mt-3 text-sm text-gray-700"><%= diagnosis.recovery_action %>.</p>

    <% if diagnosis.entries.any? %>
      <ul class="mt-3 divide-y divide-gray-200 text-sm">
        <% diagnosis.entries.each do |entry| %>
          <li class="py-2">
            <%= link_to "##{entry.issue.github_number} #{entry.issue.title}", entry.issue.github_html_url || project_member_path(entry.issue.project),
              class: "font-medium text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "_top" } %>
            <% if entry.blockers.any? %>
              <span class="ml-2 text-gray-600"><%= entry.blockers.join("; ") %></span>
            <% end %>
            <span class="ml-2 text-xs text-gray-400">assessed <%= time_ago_in_words(entry.last_assessed_at) %> ago</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
