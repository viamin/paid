<%# @spec OPERATOR-INBOX-002B OPERATOR-INBOX-002L FACET-CONFIDENCE-022 %>
<div class="space-y-6">
  <% notification = entry.record %>
  <% facet_evaluation = entry.guidance %>
  <% inbox_context = { inbox_entry_id: entry.id, inbox_kind: entry.kind, inbox_sort: params[:sort].presence_in(Inbox::Queue::SORTS.keys) }.compact %>
  <% if facet_evaluation %>
    <% evaluation = facet_evaluation.evaluation %>
    <% progress = facet_evaluation.progress %>
    <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4" data-facet-confidence-evaluation-escalation>
      <h3 class="text-sm font-semibold text-indigo-900">Evaluation needed before this closeout can finish</h3>
      <p class="mt-1 text-sm text-indigo-800">
        A maintainer must independently review each saved test case, record a judgment for every case, and freeze the completed set.
        This is the evidence needed to finish the evaluation.
      </p>
      <p class="mt-2 text-sm text-indigo-800">
        <%= progress[:recorded] %> judgments recorded (<%= progress[:recorded] %> of <%= progress[:total] %>); <%= progress[:remaining] %> judgments remaining.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <% if facet_evaluation.ready_to_freeze? %>
          <%= button_to "Freeze judgments", freeze_project_facet_confidence_evaluation_path(entry.project, evaluation, **inbox_context),
                method: :post,
                form: { data: { turbo_frame: "_top", turbo_confirm: "Freeze the completed judgment set?" } },
                class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% elsif facet_evaluation.remaining? %>
          <%= link_to "Continue judging", project_facet_confidence_evaluation_path(entry.project, evaluation, **inbox_context),
                data: { turbo_frame: "_top" },
                class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% elsif facet_evaluation.complete? %>
          <%= link_to "View completed evaluation", project_facet_confidence_evaluation_path(entry.project, evaluation, **inbox_context),
                data: { turbo_frame: "_top" },
                class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% elsif evaluation %>
          <%= link_to "Open evaluation", project_facet_confidence_evaluation_path(entry.project, evaluation, **inbox_context),
                data: { turbo_frame: "_top" },
                class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% else %>
          <%= link_to "Start evaluation", new_project_facet_confidence_evaluation_path(entry.project, issue_id: facet_evaluation.issue.id, **inbox_context),
                data: { turbo_frame: "_top" },
                class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% end %>
        <%= link_to inbox_issue_link_label(facet_evaluation.issue), facet_evaluation.issue.github_url,
              target: "_blank", rel: "noopener noreferrer",
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% else %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
    <h3 class="text-sm font-semibold text-rose-900">Remediation Required</h3>
    <% if notification.description.present? %>
      <p class="mt-1 text-sm text-rose-800"><%= notification.description %></p>
    <% end %>
    <% if entry.summary.present? && entry.summary != notification.description %>
      <p class="mt-2 text-sm text-rose-800"><%= entry.summary %></p>
    <% elsif notification.description.blank? %>
      <p class="mt-1 text-sm text-rose-800">A human action is required before work can continue.</p>
    <% end %>
  </div>

  <% if entry.tasks.any? %>
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-gray-900">Remediation Steps</h3>
      <ol class="space-y-2 text-sm text-gray-600">
        <% entry.tasks.each do |step| %>
          <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"><%= step %></li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if entry.action_url.present? && entry.action_url != inbox_entry_path(entry) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Open linked action",
            entry.action_url,
            target: entry.action_url.start_with?("http") ? "_blank" : nil,
            rel: entry.action_url.start_with?("http") ? "noopener noreferrer" : nil,
            data: entry.action_url.start_with?("http") ? {} : { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
      <% if entry.issue %>
        <%= link_to inbox_issue_link_label(entry.issue),
              entry.issue.github_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% elsif notification.subject.is_a?(AgentRun) %>
        <%= link_to "View Agent Run",
              project_agent_run_path(notification.subject.project, notification.subject),
              data: { turbo_frame: "_top" },
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
    </div>
  <% elsif entry.issue %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to inbox_issue_link_label(entry.issue),
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% elsif notification.subject.is_a?(AgentRun) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "View Agent Run",
            project_agent_run_path(notification.subject.project, notification.subject),
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% end %>
  <% end %>
</div>
