<%# @spec OPERATOR-INBOX-002B @spec FACET-CONFIDENCE-022 %>
<div class="space-y-6">
  <% notification = entry.record %>
  <% evaluation_guidance = entry.guidance if entry.guidance&.fetch(:type, nil) == Inbox::FacetConfidenceEscalation::WORKFLOW_TYPE %>
  <% inbox_context = {
       inbox_kind: params[:kind].presence_in(Inbox::Queue::KINDS),
       inbox_sort: params[:sort].presence_in(Inbox::Queue::SORTS.keys),
       inbox_entry_id: entry.id
     }.compact %>
  <% evaluation = entry.issue&.facet_confidence_evaluations&.find_by(id: evaluation_guidance&.fetch(:evaluation_id)) if evaluation_guidance&.fetch(:evaluation_id) %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
    <h3 class="text-sm font-semibold text-rose-900"><%= evaluation_guidance ? evaluation_guidance.fetch(:title) : "Remediation Required" %></h3>
    <% if evaluation_guidance %>
      <p class="mt-1 text-sm text-rose-800"><%= evaluation_guidance.fetch(:explanation) %></p>
    <% elsif notification.description.present? %>
      <p class="mt-1 text-sm text-rose-800"><%= notification.description %></p>
    <% end %>
    <% if !evaluation_guidance && entry.summary.present? && entry.summary != notification.description %>
      <p class="mt-2 text-sm text-rose-800"><%= entry.summary %></p>
    <% elsif notification.description.blank? %>
      <p class="mt-1 text-sm text-rose-800">A human action is required before work can continue.</p>
    <% end %>
  </div>

  <% if evaluation_guidance %>
    <div class="space-y-3 rounded-xl border border-indigo-200 bg-indigo-50 p-4" data-facet-confidence-escalation>
      <p class="text-sm text-indigo-900">
        Progress: <%= evaluation_guidance.fetch(:recorded) %> judgments recorded, <%= evaluation_guidance.fetch(:total) - evaluation_guidance.fetch(:recorded) %> remaining.
        <% if evaluation_guidance.fetch(:skipped).positive? %><%= evaluation_guidance.fetch(:skipped) %> skipped cases still need a judgment.<% end %>
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <% if evaluation %>
          <%= link_to evaluation_guidance.fetch(:action_label), project_facet_confidence_evaluation_path(entry.project, evaluation, **inbox_context), data: { turbo_frame: "_top" }, class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% else %>
          <%= link_to evaluation_guidance.fetch(:action_label), new_project_facet_confidence_evaluation_path(entry.project, issue_id: entry.issue.id, **inbox_context), data: { turbo_frame: "_top" }, class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% end %>
        <%= link_to inbox_issue_link_label(entry.issue), entry.issue.github_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </div>
    </div>
  <% end %>

  <% if entry.tasks.any? && !evaluation_guidance %>
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-gray-900">Remediation Steps</h3>
      <ol class="space-y-2 text-sm text-gray-600">
        <% entry.tasks.each do |step| %>
          <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"><%= step %></li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if !evaluation_guidance && entry.action_url.present? && entry.action_url != inbox_entry_path(entry) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Open linked action",
            entry.action_url,
            target: entry.action_url.start_with?("http") ? "_blank" : nil,
            rel: entry.action_url.start_with?("http") ? "noopener noreferrer" : nil,
            data: entry.action_url.start_with?("http") ? {} : { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
      <% if entry.issue %>
        <%= link_to inbox_issue_link_label(entry.issue),
              entry.issue.github_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% elsif notification.subject.is_a?(AgentRun) %>
        <%= link_to "View Agent Run",
              project_agent_run_path(notification.subject.project, notification.subject),
              data: { turbo_frame: "_top" },
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
    </div>
  <% elsif !evaluation_guidance && entry.issue %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to inbox_issue_link_label(entry.issue),
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% elsif !evaluation_guidance && notification.subject.is_a?(AgentRun) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "View Agent Run",
            project_agent_run_path(notification.subject.project, notification.subject),
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% end %>
</div>
