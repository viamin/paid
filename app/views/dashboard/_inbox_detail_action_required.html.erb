<%# @spec OPERATOR-INBOX-002B @spec OPERATOR-INBOX-002L %>
<div class="space-y-6">
  <% notification = entry.record %>
  <% typed_guidance = entry.guidance %>
  <% if typed_guidance && entry.issue %>
    <% packet = FacetConfidence::CloseoutEvaluationPacket.call(issue: entry.issue, status: Issues::CloseoutStatus.call(entry.issue)) %>
    <% evaluation = entry.issue.facet_confidence_evaluations.where(corpus_digest: packet.corpus_digest).latest_first.first %>
    <% progress = evaluation&.progress %>
    <% inbox_context = {
         inbox_kind: params[:kind].presence_in(Inbox::Queue::KINDS),
         inbox_sort: params[:sort].presence_in(Inbox::Queue::SORTS.keys),
         inbox_entry_id: entry.id
       }.compact %>
    <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4" data-facet-confidence-action-required>
      <h3 class="text-sm font-semibold text-indigo-900"><%= typed_guidance[:title] %></h3>
      <p class="mt-1 text-sm text-indigo-800"><%= typed_guidance[:explanation] %></p>
      <% if packet.blockers.any? %>
        <p class="mt-3 text-sm font-medium text-indigo-900">The evaluation cannot start yet:</p>
        <ul class="mt-1 space-y-1 text-sm text-indigo-800">
          <% packet.blockers.each do |blocker| %>
            <li><%= blocker[:message] %> <span class="text-indigo-700">Next: <%= blocker[:recovery] %></span></li>
          <% end %>
        </ul>
      <% elsif evaluation %>
        <% remaining = progress[:total] - progress[:labeled] %>
        <p class="mt-3 text-sm text-indigo-900" data-evaluation-progress>
          <%= progress[:labeled] %> of <%= progress[:total] %> judgments recorded · <%= remaining %> remaining.
          <% if progress[:skipped].positive? %><%= progress[:skipped] %> skipped cases still need judgments.<% end %>
        </p>
        <%= link_to(
              evaluation.labeling? && remaining.positive? ? "Continue judging" :
                evaluation.labeling? ? "Freeze judgments" : "View evaluation report",
              project_facet_confidence_evaluation_path(entry.project, evaluation, **inbox_context),
              data: { turbo_frame: "_top" },
              class: "mt-3 inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
            ) %>
      <% else %>
        <p class="mt-3 text-sm text-indigo-900">No judgments have been recorded yet.</p>
        <%= link_to "Start evaluation",
              new_project_facet_confidence_evaluation_path(entry.project, issue_id: entry.issue.id, **inbox_context),
              data: { turbo_frame: "_top" },
              class: "mt-3 inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% end %>
    </div>
  <% end %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
    <h3 class="text-sm font-semibold text-rose-900"><%= typed_guidance ? "Action required" : "Remediation Required" %></h3>
    <% if notification.description.present? %>
      <p class="mt-1 text-sm text-rose-800"><%= typed_guidance ? "The closeout cannot move forward until the evaluation is complete." : notification.description %></p>
    <% end %>
    <% if !typed_guidance && entry.summary.present? && entry.summary != notification.description %>
      <p class="mt-2 text-sm text-rose-800"><%= entry.summary %></p>
    <% elsif notification.description.blank? %>
      <p class="mt-1 text-sm text-rose-800">A human action is required before work can continue.</p>
    <% end %>
  </div>

  <% if entry.tasks.any? %>
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-gray-900">Remediation Steps</h3>
      <ol class="space-y-2 text-sm text-gray-600">
        <% entry.tasks.each do |step| %>
          <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"><%= step %></li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if entry.action_url.present? && entry.action_url != inbox_entry_path(entry) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Open linked action",
            entry.action_url,
            target: entry.action_url.start_with?("http") ? "_blank" : nil,
            rel: entry.action_url.start_with?("http") ? "noopener noreferrer" : nil,
            data: entry.action_url.start_with?("http") ? {} : { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
      <% if entry.issue %>
        <%= link_to inbox_issue_link_label(entry.issue),
              entry.issue.github_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% elsif notification.subject.is_a?(AgentRun) %>
        <%= link_to "View Agent Run",
              project_agent_run_path(notification.subject.project, notification.subject),
              data: { turbo_frame: "_top" },
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
    </div>
  <% elsif entry.issue %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to inbox_issue_link_label(entry.issue),
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% elsif notification.subject.is_a?(AgentRun) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "View Agent Run",
            project_agent_run_path(notification.subject.project, notification.subject),
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% end %>
</div>
