<%# @spec OPERATOR-INBOX-002B %>
<div class="space-y-6">
  <% notification = entry.record %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 p-4">
    <h3 class="text-sm font-semibold text-rose-900">Remediation Required</h3>
    <% if notification.description.present? %>
      <p class="mt-1 text-sm text-rose-800"><%= notification.description %></p>
    <% end %>
    <% if entry.summary.present? && entry.summary != notification.description %>
      <p class="mt-2 text-sm text-rose-800"><%= entry.summary %></p>
    <% elsif notification.description.blank? %>
      <p class="mt-1 text-sm text-rose-800">A human action is required before work can continue.</p>
    <% end %>
  </div>

  <% if entry.tasks.any? %>
    <div class="space-y-3">
      <h3 class="text-sm font-semibold text-gray-900">Remediation Steps</h3>
      <ol class="space-y-2 text-sm text-gray-600">
        <% entry.tasks.each do |step| %>
          <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3"><%= step %></li>
        <% end %>
      </ol>
    </div>
  <% end %>

  <% if notification.source == PartialCloseouts::PREREQUISITE_NOTIFICATION_SOURCE %>
    <div class="space-y-3 rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Submit prerequisite evidence</h3>
      <p class="text-sm text-amber-800">A submitted link, artifact, run, or report is pending validation. It does not resolve this prerequisite or attest issue completion.</p>
      <% Array(notification.metadata.to_h["prerequisites"]).each do |prerequisite| %>
        <%= form_with url: submit_evidence_notification_path(notification), class: "space-y-2 border-t border-amber-200 pt-3" do |form| %>
          <%= form.hidden_field :prerequisite_id, value: prerequisite["id"] %>
          <p class="text-sm font-medium text-amber-900"><%= prerequisite["criterion"] %></p>
          <p class="text-xs text-amber-800"><%= prerequisite["requirement"] %></p>
          <%= form.select :evidence_type, PartialCloseouts::SubmitPrerequisiteEvidence::TYPES.map { |type| [ type.humanize, type ] }, {}, class: "rounded-md border-gray-300 text-sm" %>
          <%= form.url_field :reference, required: true, placeholder: "https://… or durable artifact reference", class: "w-full rounded-md border-gray-300 text-sm" %>
          <%= form.text_area :explanation, required: true, rows: 2, maxlength: 2000, placeholder: "Explain how this evidence meets the exact prerequisite.", class: "w-full rounded-md border-gray-300 text-sm" %>
          <%= form.submit "Submit for validation", class: "rounded-md bg-amber-600 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-500" %>
        <% end %>
      <% end %>
      <% Array(notification.metadata.to_h["evidence_submissions"]).each do |submission| %>
        <p class="text-xs text-amber-900"><%= submission["outcome"].to_s.humanize %>: <%= submission["reasoning"] %></p>
      <% end %>
    </div>
  <% end %>

  <% if entry.action_url.present? && entry.action_url != inbox_entry_path(entry) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Open linked action",
            entry.action_url,
            target: entry.action_url.start_with?("http") ? "_blank" : nil,
            rel: entry.action_url.start_with?("http") ? "noopener noreferrer" : nil,
            data: entry.action_url.start_with?("http") ? {} : { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
      <% if entry.issue %>
        <%= link_to inbox_issue_link_label(entry.issue),
              entry.issue.github_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% elsif notification.subject.is_a?(AgentRun) %>
        <%= link_to "View Agent Run",
              project_agent_run_path(notification.subject.project, notification.subject),
              data: { turbo_frame: "_top" },
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <% end %>
    </div>
  <% elsif entry.issue %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to inbox_issue_link_label(entry.issue),
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% elsif notification.subject.is_a?(AgentRun) %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "View Agent Run",
            project_agent_run_path(notification.subject.project, notification.subject),
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
    </div>
  <% end %>
</div>
