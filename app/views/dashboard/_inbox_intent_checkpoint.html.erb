<%# @spec PROJECT-DELEGATION-002 %>
<section class="space-y-3 rounded-xl border border-indigo-200 bg-indigo-50 p-4 text-sm" data-testid="intent-checkpoint-<%= checkpoint.id %>">
  <h3 class="font-semibold text-indigo-950">Intent checkpoint · <%= checkpoint.status.humanize %></h3>
  <p class="text-indigo-900">These questions share one decision context. Answering records your response; it does not approve the feature or authorize execution.</p>
  <ul class="list-disc space-y-1 pl-5 text-indigo-950">
    <% checkpoint.questions.each do |question| %>
      <li class="break-words"><%= question.fetch(:prompt) %></li>
    <% end %>
  </ul>
  <dl class="space-y-3 text-indigo-950">
    <div><dt class="font-semibold">Recommendation</dt><dd class="mt-1 whitespace-pre-wrap break-words"><%= checkpoint.recommendation %></dd></div>
    <% { "Alternatives" => checkpoint.alternatives, "Consequences" => checkpoint.consequences }.each do |label, values| %>
      <div>
        <dt class="font-semibold"><%= label %></dt>
        <dd class="mt-1"><%= render "dashboard/inbox_checkpoint_value", value: values %></dd>
      </div>
    <% end %>
  </dl>
  <details class="rounded-lg border border-indigo-200 bg-white p-3 text-gray-700">
    <summary class="cursor-pointer font-medium">Scope, evidence and proposed revisions</summary>
    <dl class="mt-3 space-y-3">
      <% { "Affected scope" => checkpoint.affected_scope, "Evidence" => checkpoint.evidence,
           "Proposed design revision" => checkpoint.proposed_design_revision,
           "Proposed acceptance revision" => checkpoint.proposed_acceptance_revision }.each do |label, value| %>
        <div><dt class="font-medium"><%= label %></dt><dd class="mt-1 break-words"><%= render "dashboard/inbox_checkpoint_value", value: value %></dd></div>
      <% end %>
    </dl>
  </details>
</section>
