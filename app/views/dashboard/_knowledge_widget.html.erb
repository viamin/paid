<%# Knowledge Base Health Widget %>
<div class="mt-8">
  <h2 class="text-lg font-semibold text-gray-900">Knowledge Base</h2>
  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Projects Indexed</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
        <%= knowledge_stats[:projects_indexed] %>/<%= knowledge_stats[:projects_total] %>
      </dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Active Artifacts</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
        <%= number_with_delimiter(knowledge_stats[:total_artifacts]) %>
      </dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Stale Artifacts</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
        <span class="<%= knowledge_stats[:stale_percent] > 20 ? 'text-yellow-600' : 'text-gray-900' %>">
          <%= number_with_delimiter(knowledge_stats[:stale_artifacts]) %>
          (<%= knowledge_stats[:stale_percent] %>%)
        </span>
      </dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Last Collection</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
        <% if knowledge_stats[:last_collection_at] %>
          <%= time_ago_in_words(knowledge_stats[:last_collection_at]) %> ago
        <% else %>
          --
        <% end %>
      </dd>
    </div>
  </div>

  <% if knowledge_stats[:artifacts_by_type].any? %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-sm font-medium text-gray-500">Active Artifacts by Type</h3>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          <% knowledge_stats[:artifacts_by_type].each do |type, count| %>
            <div class="flex items-center gap-1.5">
              <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">
                <%= type %>
              </span>
              <span class="font-semibold text-gray-900"><%= number_with_delimiter(count) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if knowledge_stats[:token_usage_summary].any? %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-sm font-medium text-gray-500">Token Usage by Operation</h3>
        <div class="mt-3">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="text-left text-gray-500">
                <th class="pr-4 font-medium">Operation</th>
                <th class="pr-4 font-medium text-right">Tokens</th>
                <th class="font-medium text-right">Runs</th>
              </tr>
            </thead>
            <tbody>
              <% knowledge_stats[:token_usage_summary].each do |summary| %>
                <tr>
                  <td class="pr-4 py-1">
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">
                      <%= summary[:operation_type].humanize %>
                    </span>
                  </td>
                  <td class="pr-4 py-1 text-right font-semibold text-gray-900"><%= number_with_delimiter(summary[:total_tokens]) %></td>
                  <td class="py-1 text-right text-gray-700"><%= number_with_delimiter(summary[:run_count]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to "Search Knowledge Base", knowledge_search_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>
</div>
