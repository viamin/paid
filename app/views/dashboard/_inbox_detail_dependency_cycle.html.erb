<%# @spec AUTO-PICK-QUEUE-015 %>
<% cycle = entry.record %>
<div class="space-y-6">
  <div class="rounded-xl border border-red-200 bg-red-50 p-4">
    <h3 class="text-sm font-semibold text-red-900">Dependency cycle blocks automatic work</h3>
    <p class="mt-1 text-sm text-red-800">Paid will keep this work held. Review the declared dependencies on GitHub and remove or correct the specific declaration that is wrong; Paid does not choose an edge to delete.</p>
  </div>

  <% analysis_run = cycle.project.agent_runs.for_cycle_analysis_fingerprint(cycle.fingerprint).where(goal: AgentRun::CYCLE_ANALYSIS_GOAL).order(created_at: :desc).first %>
  <% analysis_stale = analysis_run && analysis_run.external_metadata.dig(CycleAnalyses::METADATA_KEY, "occurrence") != cycle.occurrence %>
  <% analysis_retryable = analysis_run.nil? || analysis_stale || AgentRun::TERMINAL_FAILURE_STATUSES.include?(analysis_run.status) %>
  <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4">
    <h3 class="text-sm font-semibold text-indigo-900">Cycle analysis</h3>
    <% if analysis_run %>
      <p class="mt-1 text-sm text-indigo-800">Analysis <%= analysis_run.status %>: <%= link_to "view run", project_agent_run_path(analysis_run.project, analysis_run), class: "font-medium underline" %>.</p>
      <% if analysis_stale %>
        <p class="mt-1 text-sm font-medium text-amber-800">This analysis is stale because the effective dependency graph changed.</p>
      <% end %>
      <% if analysis_run.successful? %>
        <% analysis_result = analysis_run.verification_result.fetch(CycleAnalyses::RESULT_KEY, {}) %>
        <pre class="mt-2 whitespace-pre-wrap text-xs text-indigo-900"><%= JSON.pretty_generate(analysis_result["recommendation"]) %></pre>
        <% coverage = analysis_result["coverage"] %>
        <% if coverage.present? %>
          <div class="mt-3 rounded-lg border border-indigo-200 bg-white p-3 text-xs text-indigo-900">
            <h4 class="font-semibold"><%= coverage.values.any?(&:present?) ? "Unavailable evidence coverage" : "Evidence coverage complete" %></h4>
            <% if coverage["unavailable_provenance_edge_ids"].present? %>
              <p class="mt-1">Edge IDs without declaration provenance: <%= coverage["unavailable_provenance_edge_ids"].join(", ") %></p>
            <% end %>
            <% if coverage["unavailable_content_issue_ids"].present? %>
              <p class="mt-1">Issue IDs with unavailable trusted content: <%= coverage["unavailable_content_issue_ids"].join(", ") %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <% if analysis_retryable %>
      <%= form_with url: dashboard_cycle_analyses_path, class: "mt-3" do |form| %>
        <%= form.hidden_field :occurrence, value: cycle.occurrence %>
        <%= form.submit analysis_run && AgentRun::TERMINAL_FAILURE_STATUSES.include?(analysis_run.status) ? "Retry cycle analysis" : "Start cycle analysis", class: "rounded bg-indigo-600 px-3 py-2 text-sm font-medium text-white" %>
      <% end %>
    <% end %>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-gray-900">Declarations to review</h3>
    <ul class="mt-2 space-y-2 text-sm text-gray-700">
      <% cycle.path_edges.each_with_index do |edge, index| %>
        <% from = cycle.path[index] %>
        <% to = cycle.path[index + 1] %>
        <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
          <%= from.project.full_name %>#<%= from.github_number %> declares <%= to.project.full_name %>#<%= to.github_number %> as a dependency
          <% if edge.declaration_url.present? %>
            — <%= link_to edge.declaration_source == "issue_comment" ? "view declaring comment" : "view issue declaration", edge.declaration_url, target: "_blank", rel: "noopener noreferrer", class: "font-medium text-indigo-600 hover:text-indigo-500" %>
          <% else %>
            — declaration source unavailable; review the issue body and trusted comments
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-gray-900">Cycle path</h3>
    <p class="mt-2 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700">
      <% cycle.path.each_with_index do |issue, index| %>
        <%= " → " if index.positive? %>
        <%= link_to "#{issue.project.full_name}##{issue.github_number}", issue.github_url, target: "_blank", rel: "noopener noreferrer", class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      <% end %>
    </p>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-gray-900">Affected work</h3>
    <p class="mt-1 text-sm text-gray-600"><%= cycle.downstream_issues.size %> downstream open issue(s) are held by this cycle.</p>
  </div>

  <div class="text-sm text-gray-700">
    Open the linked issues’ <strong>Dependencies</strong> declarations on GitHub, confirm intent with the owners, then edit the declaration(s) that should not block. This occurrence clears only after a later synchronization persists an acyclic effective graph.
  </div>
</div>
