<%# @spec AUTO-PICK-QUEUE-015 AUTO-PICK-QUEUE-016 AUTO-PICK-QUEUE-020 AUTO-PICK-QUEUE-023 AUTO-PICK-QUEUE-024 %>
<% cycle = entry.record %>
<% analysis_run = cycle.project.agent_runs.for_cycle_analysis_fingerprint(cycle.fingerprint).where(goal: AgentRun::CYCLE_ANALYSIS_GOAL).order(created_at: :desc).first %>
<% view_state = CycleAnalyses::OperatorView.new(cycle:, run: analysis_run) %>
<% status = view_state.status %>
<% cycle_issues = cycle.issues.index_by(&:id) %>
<% edges_by_source = cycle.effective_edges.group_by(&:from_id) %>
<div class="space-y-6">
  <div class="rounded-xl border border-red-200 bg-red-50 p-4" data-testid="cycle-blocked-work">
    <h3 class="text-sm font-semibold text-red-900">Dependency cycle blocks automatic work</h3>
    <p class="mt-1 text-sm text-red-800">
      <%= cycle.issues.size %> <%= cycle.issues.one? ? "issue waits on itself in a closed loop" : "issues wait on each other in a closed loop" %>, holding
      <%= pluralize(cycle.downstream_issues.size, "downstream open issue") %>.
      Paid keeps this work held until a later synchronization confirms an acyclic graph.
    </p>
  </div>

  <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <h3 class="text-sm font-semibold text-indigo-900">Cycle repair</h3>
      <p class="text-sm font-semibold text-indigo-900" data-testid="cycle-repair-status"><%= status.title %></p>
    </div>
    <p class="mt-1 text-sm text-indigo-800"><%= status.description %></p>
    <p class="mt-1 text-sm font-medium text-indigo-900">Next: <%= status.next_action %></p>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
      <% if status.button %>
        <%= form_with url: dashboard_cycle_analyses_path, data: { turbo_frame: "_top", turbo_confirm: status.button.confirm } do |form| %>
          <%= form.hidden_field :occurrence, value: cycle.occurrence %>
          <%= form.submit status.button.label, data: { inbox_action: "" }, class: "rounded bg-indigo-600 px-3 py-2 text-sm font-medium text-white" %>
        <% end %>
      <% end %>
      <% if analysis_run %>
        <%= link_to "Check analysis status", project_agent_run_path(analysis_run.project, analysis_run),
              data: { inbox_action: "", turbo_frame: "_top" }, class: "font-medium text-indigo-700 underline" %>
      <% end %>
    </div>
  </div>

  <% if view_state.evidence_warning %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4" data-testid="evidence-warning">
      <h4 class="text-sm font-semibold text-amber-900"><%= view_state.evidence_warning.title %></h4>
      <p class="mt-1 text-sm text-amber-800"><%= view_state.evidence_warning.description %></p>
      <p class="mt-1 text-sm font-medium text-amber-900">Next: <%= view_state.evidence_warning.next_action %></p>
    </div>
  <% end %>

  <% if view_state.render_recommendation? %>
    <% manual_repair_candidate_indexes = view_state.manual_repair_candidates.index_by(&:index) %>
    <div data-testid="cycle-recommendation">
      <h3 class="text-sm font-semibold text-gray-900">Analysis recommendation</h3>
      <% if view_state.recommendation_summary.present? %>
        <p class="mt-2 text-sm text-gray-700"><%= view_state.recommendation_summary %></p>
      <% end %>
      <% view_state.candidates.each do |candidate| %>
        <div class="mt-3 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-700">
          <h4 class="font-semibold text-gray-900">Candidate <%= candidate.index + 1 %></h4>
          <% candidate.changes.each do |change| %>
            <p class="mt-2 flex min-w-0 flex-wrap items-baseline gap-x-1 gap-y-1 break-words">
              <span class="shrink-0 font-medium text-gray-900">Proposed change:</span>
              <span class="min-w-0"><%= change.readable_description %></span>
            </p>
          <% end %>
          <% if candidate.evidence.any? %>
            <p class="mt-2 font-medium text-gray-900">Evidence</p>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              <% candidate.evidence.each do |item| %><li><%= item %></li><% end %>
            </ul>
          <% end %>
          <% if candidate.tradeoffs.any? %>
            <p class="mt-2 font-medium text-gray-900">Tradeoffs</p>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              <% candidate.tradeoffs.each do |item| %><li><%= item %></li><% end %>
            </ul>
          <% end %>
          <p class="mt-2 font-medium text-gray-900">Missing or conflicting intent</p>
          <% if candidate.missing_or_conflicting_intent.any? %>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              <% candidate.missing_or_conflicting_intent.each do |item| %><li><%= item %></li><% end %>
            </ul>
          <% else %>
            <p class="mt-1">None recorded.</p>
          <% end %>
          <p class="mt-2 break-words"><span class="font-medium text-gray-900">Expected result:</span> <%= candidate.expected_result %></p>
        </div>
        <% if manual_repair_candidate_indexes.key?(candidate.index) %>
          <div class="mt-2 rounded-lg border border-red-200 bg-white p-4 text-sm text-gray-700" data-testid="manual-repair">
            <p class="break-words"><span class="font-medium text-gray-900">Before:</span> <%= candidate.before_description %></p>
            <p class="mt-1 break-words"><span class="font-medium text-gray-900">After:</span> <%= candidate.after_description %></p>
            <%= form_with url: dashboard_cycle_analysis_repairs_path, data: { turbo_frame: "_top", turbo_confirm: candidate.repair_confirmation } do |form| %>
              <%= form.hidden_field :agent_run_id, value: analysis_run.id %>
              <%= form.hidden_field :candidate_index, value: candidate.index %>
              <%= form.submit candidate.repair_button_label, class: "mt-3 rounded bg-red-700 px-3 py-2 text-sm font-medium text-white" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div>
    <h3 class="text-sm font-semibold text-gray-900">The cycle group</h3>
    <ol class="mt-2 space-y-3">
      <% cycle.issues.each_with_index do |issue, index| %>
        <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3" data-testid="cycle-group-issue" data-issue-id="<%= issue.id %>">
          <div class="flex min-w-0 items-start gap-2">
            <span class="mt-0.5 shrink-0 text-xs font-semibold text-gray-400"><%= index + 1 %></span>
            <div class="min-w-0 flex-1">
              <%= dependency_cycle_issue_link(issue) %>
              <%= dependency_cycle_label_badges(issue) %>
              <%= dependency_cycle_umbrella_link(cycle, issue) %>
            </div>
          </div>
          <% edges_by_source.fetch(issue.id, []).each do |edge| %>
            <% target = cycle_issues.fetch(edge.to_id) %>
            <details class="mt-2 text-xs" data-testid="cycle-declaration-detail" data-edge-id="<%= edge.id %>">
              <summary class="cursor-pointer text-gray-600">
                Blocked by <span class="font-medium"><%= target.project.full_name %>#<%= target.github_number %></span>
              </summary>
              <p class="mt-1">
                <% if edge.declaration_url.present? %>
                  <%= link_to edge.declaration_source == "issue_comment" ? "view declaring comment" : "view issue declaration",
                        edge.declaration_url, target: "_blank", rel: "noopener noreferrer",
                        class: "font-medium text-indigo-600 hover:text-indigo-500" %>
                <% else %>
                  declaration source unavailable; review the issue body and trusted comments
                <% end %>
              </p>
            </details>
          <% end %>
        </li>
      <% end %>
    </ol>
  </div>

  <div class="text-sm text-gray-700">
    Prefer a human edit? Open the linked issues’ <strong>Dependencies</strong> declarations on GitHub, confirm intent with the owners, then edit the declaration that should not block. This occurrence clears only after a later synchronization persists an acyclic effective graph.
  </div>

  <details class="rounded-lg border border-gray-200 bg-gray-50 p-3 text-xs text-gray-600" data-testid="cycle-technical-details">
    <summary class="cursor-pointer font-medium">Technical details</summary>
    <dl class="mt-2 space-y-1">
      <% view_state.diagnostics.each do |label, value| %>
        <div class="flex flex-wrap gap-x-2">
          <dt class="font-medium"><%= label %>:</dt>
          <dd class="break-all"><%= value %></dd>
        </div>
      <% end %>
    </dl>
    <% if view_state.coverage_provenance_edge_ids.any? %>
      <p class="mt-2 break-all">Declarations without recorded provenance (edge ids): <%= view_state.coverage_provenance_edge_ids.join(", ") %></p>
    <% end %>
    <% if view_state.coverage_unavailable_content_issue_ids.any? %>
      <p class="mt-1 break-all">Issues with unavailable trusted content (issue ids): <%= view_state.coverage_unavailable_content_issue_ids.join(", ") %></p>
    <% end %>
    <% if analysis_run %>
      <pre class="mt-2 whitespace-pre-wrap"><%= view_state.raw_recommendation_json %></pre>
    <% end %>
  </details>
</div>
