<%= turbo_stream_from current_account, :dashboard_updates %>
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold leading-6 text-gray-900">Dashboard</h1>
      <p class="mt-2 text-sm text-gray-700">
        Welcome to Paid, <%= current_user.name.presence || current_user.email %>!
        You're part of the <strong><%= current_user.account.name %></strong> account.
      </p>
    </div>
  </div>

  <%= render "dashboard/content", stats: @stats, account: current_account %>
</div>
