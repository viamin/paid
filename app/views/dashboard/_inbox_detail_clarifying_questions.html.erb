<%# @spec OPERATOR-INBOX-008 @spec OPERATOR-INBOX-011 %>
<%# The two-column lg+ layout puts the agent-authored context beside the
    answer form (sticky sidebar, scrolls with the page if long); below lg the
    same context lives inside a collapsible <details> above the questions so
    mobile operators can read the context once without it dominating the
    answer form. Without the lg grid wrapper the flex default would still
    render but the question list would lose its sticky bottom submit button. %>
<div class="space-y-6">
  <%# Whitelisted embedded flow: this form intentionally renders inside the
      `inbox-detail` Turbo frame so the chat panel replaces the questions
      in place (see #4031, #4374). The CI guard in
      spec/views/dashboard/inbox_detail_navigation_intent_spec.rb
      recognizes the `data-turbo-frame-spec-whitelist="answer-in-chat"` marker
      on the form and exempts it from the `data-turbo-frame="_top"`
      requirement. Do NOT "fix" this to `_top` — that re-introduces the
      Content-missing bug (see #4502). %>
  <% if Inbox::InteractiveChatAccess.allowed?(user: current_user, project: entry.project) %>
    <%= button_to "Answer in chat",
          project_issue_clarifying_questions_chat_path(entry.project, entry.issue),
          class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500",
          form: { data: { turbo_frame_spec_whitelist: "answer-in-chat" } } %>
  <% end %>
  <% if entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% else %>
    <p class="text-sm text-gray-500">No clarifying questions are pending for this issue.</p>
    <div class="flex items-center gap-3">
      <%= link_to inbox_issue_link_label(entry.issue),
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
