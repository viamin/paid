<%# @spec OPERATOR-INBOX-008 @spec OPERATOR-INBOX-011 %>
<%# The two-column lg+ layout puts the agent-authored context beside the
    answer form (sticky sidebar, scrolls with the page if long); below lg the
    same context lives inside a collapsible <details> above the questions so
    mobile operators can read the context once without it dominating the
    answer form. Without the lg grid wrapper the flex default would still
    render but the question list would lose its sticky bottom submit button. %>
<div class="space-y-6">
  <% if entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% else %>
    <p class="text-sm text-gray-500">No clarifying questions are pending for this issue.</p>
    <div class="flex items-center gap-3">
      <%= link_to inbox_issue_link_label(entry.issue),
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
