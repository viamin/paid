<div class="space-y-6">
  <% if entry.questions.any? %>
    <%= form_with url: project_issue_clarifying_questions_path(entry.project, entry.issue),
                  method: :post,
                  data: { turbo_frame: "_top" },
                  class: "space-y-6" do |f| %>
      <%= hidden_field_tag :inbox, "1" %>
      <%= hidden_field_tag :selected, inbox_selected_param(entry) %>
      <% if scoped_project %>
        <%= hidden_field_tag :inbox_project_id, scoped_project.id %>
      <% end %>

      <div class="space-y-4">
        <h3 class="text-sm font-semibold text-gray-900">Clarifying Questions</h3>
        <% entry.questions.each_with_index do |question, index| %>
          <div class="rounded-lg bg-gray-50 px-4 py-3">
            <label for="<%= dom_id(entry.record, "answer_#{index}") %>" class="block text-sm font-medium text-gray-700">
              <span class="mr-2 font-semibold text-gray-500"><%= index + 1 %>.</span>
              <%= render "shared/markdown_text", content: question %>
            </label>
            <%= hidden_field_tag "questions[]", question, id: dom_id(entry.record, "question_#{index}") %>
            <%= text_area_tag "answers[]", nil,
                  id: dom_id(entry.record, "answer_#{index}"),
                  rows: 4,
                  required: true,
                  placeholder: "Enter your answer...",
                  data: { testid: "inbox-answer-#{index}" },
                  class: "mt-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
        <% end %>
      </div>

      <div class="flex items-center justify-end gap-3">
        <%= link_to "View Issue",
              entry.issue.github_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        <%= f.submit "Submit Answers",
              class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer",
              data: { turbo_confirm: "Submit your answers? They will be posted as a comment on the GitHub issue." } %>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-gray-500">No clarifying questions are pending for this issue.</p>
    <div class="flex items-center gap-3">
      <%= link_to "View Issue",
            entry.issue.github_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
