<% if projects.any? %>
  <div class="quality-pause-card rounded-md border border-amber-200 bg-amber-50 p-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-sm font-semibold text-amber-900">Quality-paused projects</h3>
        <p class="mt-1 text-sm text-amber-800">Automatic work is paused until an operator resumes the project.</p>
      </div>
      <span class="inline-flex items-center rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800">
        <%= pluralize(projects.size, "project") %>
      </span>
    </div>
    <div class="mt-3 divide-y divide-amber-200">
      <% projects.each do |project| %>
        <div class="flex items-center justify-between gap-4 py-2">
          <div class="min-w-0">
            <%= link_to project.name, project_path(project), class: "truncate text-sm font-medium text-amber-950 hover:text-amber-700 dark:hover:text-amber-300" %>
            <p class="mt-0.5 text-xs text-amber-700">
              Paused <%= local_time(project.quality_paused_at, format: :relative) %>
              <% if project.quality_pause_metadata["composite_score"].present? && project.quality_pause_metadata["threshold"].present? %>
                at <%= format("%.1f%%", project.quality_pause_metadata["composite_score"].to_f * 100) %>
                below <%= format("%.1f%%", project.quality_pause_metadata["threshold"].to_f * 100) %>
              <% end %>
            </p>
          </div>
          <% if policy(project).update? %>
            <%= link_to "Review", edit_project_path(project), class: "shrink-0 text-sm font-medium text-amber-900 hover:text-amber-700 dark:hover:text-amber-300" %>
          <% else %>
            <%= link_to "View", project_path(project), class: "shrink-0 text-sm font-medium text-amber-900 hover:text-amber-700 dark:hover:text-amber-300" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
