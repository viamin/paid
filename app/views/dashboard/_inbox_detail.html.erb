<%# @spec OPERATOR-INBOX-006 %>
<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 px-4 py-4 sm:px-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= entry.plan_review? ? 'bg-amber-100 text-amber-800' : 'bg-sky-100 text-sky-800' %>">
            <%= entry.kind.humanize %>
          </span>
          <span class="text-xs text-gray-500" data-testid="inbox-detail-waiting-age"><%= entry.waiting_since ? "Waiting #{time_ago_in_words(entry.waiting_since)}" : "Waiting —" %></span>
        </div>
        <h2 class="mt-2 text-xl font-semibold text-gray-900">#<%= entry.issue.github_number %> <%= entry.title %></h2>
        <p class="mt-1 text-sm text-gray-500"><%= entry.project.full_name %></p>
      </div>

      <%= link_to inbox_path(project: scoped_project, kind: selected_kind),
            data: {
              turbo_frame: "_top",
              action: "click->inbox-master-detail#close"
            },
            class: "inline-flex rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 lg:hidden" do %>
        <span aria-hidden="true">&larr;</span>
        <span class="ml-1">Back to queue</span>
      <% end %>
    </div>
  </div>

  <div class="px-4 py-5 sm:px-6">
    <% if entry.clarifying_questions? %>
      <%= render "dashboard/inbox_detail_clarifying_questions",
            entry: entry,
            scoped_project: scoped_project,
            selected_kind: selected_kind %>
    <% else %>
      <%= render "dashboard/inbox_detail_plan_review",
            entry: entry,
            scoped_project: scoped_project,
            selected_kind: selected_kind %>
    <% end %>
  </div>
</div>
