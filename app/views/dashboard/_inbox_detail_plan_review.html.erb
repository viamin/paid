<div class="space-y-6">
  <div>
    <h3 class="text-sm font-semibold text-gray-900">Proposed Task Breakdown</h3>
    <ol class="mt-3 space-y-3">
      <% entry.tasks.each_with_index do |task, index| %>
        <li class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
          <p class="text-sm font-semibold text-gray-900"><%= index + 1 %>. <%= task["title"] %></p>
          <p class="mt-1 text-sm text-gray-600"><%= task["description"] %></p>
        </li>
      <% end %>
    </ol>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_to approve_plan_review_path(entry.record),
          method: :post,
          params: { return_to: dashboard_inbox_path(project_id: scoped_project&.id, kind: selected_kind) },
          class: "inline-flex items-center rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
      Approve
    <% end %>

    <%= button_to reject_plan_review_path(entry.record),
          method: :post,
          params: { return_to: dashboard_inbox_path(project_id: scoped_project&.id, kind: selected_kind) },
          class: "inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500",
          form: { data: { turbo_confirm: "Reject this plan? No sub-issues will be created." } } do %>
      Reject
    <% end %>
  </div>

  <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
    <h3 class="text-sm font-semibold text-amber-900">Revise Plan</h3>
    <p class="mt-1 text-sm text-amber-800">
      Edit the proposed titles or descriptions before sending the revised task list back to the planning workflow.
    </p>

    <%= form_with url: revise_plan_review_path(entry.record), method: :post, class: "mt-4 space-y-4" do %>
      <%= hidden_field_tag :return_to, dashboard_inbox_path(project_id: scoped_project&.id, kind: selected_kind) %>

      <% entry.tasks.each_with_index do |task, index| %>
        <% title_id = "entry_#{entry.record.id}_task_#{index}_title" %>
        <% description_id = "entry_#{entry.record.id}_task_#{index}_description" %>
        <fieldset class="space-y-3 rounded-lg border border-amber-200 bg-white p-4">
          <legend class="px-1 text-sm font-medium text-gray-900">Task <%= index + 1 %></legend>

          <div>
            <%= label_tag title_id, "Title", class: "block text-sm font-medium text-gray-700" %>
            <%= text_field_tag "tasks[][title]", task["title"],
                  id: title_id,
                  class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>

          <div>
            <%= label_tag description_id, "Description", class: "block text-sm font-medium text-gray-700" %>
            <%= text_area_tag "tasks[][description]", task["description"], rows: 3,
                  id: description_id,
                  class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </fieldset>
      <% end %>

      <%= submit_tag "Revise",
            class: "inline-flex items-center rounded-md bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-500" %>
    <% end %>
  </div>
</div>
