<% flagged_auth_health = auth_health.select { |health| health.invalid? || health.expiring_soon? } %>

<% if flagged_auth_health.any? %>
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-6 shadow-sm" data-testid="dashboard-auth-health-banner">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-base font-semibold text-amber-900">Claude auth health needs attention</h3>
        <p class="mt-1 text-sm text-amber-700">
          These subscription runners are missing valid Claude authentication or will expire soon.
          Review Runner Auth Setup before the next run fails with <code>auth_expired</code>.
        </p>
      </div>
      <%= link_to "Review runners", runners_path, class: "inline-flex items-center rounded-md bg-amber-100 px-3 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-200", data: { turbo_frame: "_top" } %>
    </div>

    <div class="mt-4 flow-root">
      <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
          <table class="min-w-full divide-y divide-amber-200">
            <thead>
              <tr>
                <th scope="col" class="py-2 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-amber-700 sm:pl-0">Runner</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-amber-700">Owner</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-amber-700">Source</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-amber-700">Status</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-amber-700">Expires</th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium uppercase tracking-wide text-amber-700">Detail</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-amber-200 bg-amber-50">
              <% flagged_auth_health.each do |health| %>
                <tr>
                  <td class="whitespace-nowrap py-3 pl-4 pr-3 text-sm font-medium text-amber-900 sm:pl-0">
                    <%= health.runner %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-3 text-sm text-amber-900">
                    <span class="font-medium"><%= health.owner_name %></span>
                    <span class="text-amber-700"><%= health.owner_email %></span>
                  </td>
                  <td class="whitespace-nowrap px-3 py-3 text-sm text-amber-900">
                    <%= health.source_label %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-3 text-sm">
                    <% if health.invalid? %>
                      <span class="inline-flex items-center rounded-md bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20"><%= health.status_label %></span>
                    <% else %>
                      <span class="inline-flex items-center rounded-md bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20"><%= health.status_label %></span>
                    <% end %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-3 text-sm text-amber-700">
                    <% if health.expires_at.present? %>
                      <%= local_time(health.expires_at, format: :relative) %>
                    <% else %>
                      Unknown
                    <% end %>
                  </td>
                  <td class="px-3 py-3 text-sm text-amber-700 max-w-sm truncate" title="<%= health.error.to_s %>">
                    <%= health.error.presence || "Credential expires soon" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>
