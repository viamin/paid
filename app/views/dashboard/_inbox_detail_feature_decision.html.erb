<%# @spec FEATURE-APPROVAL-020 CONFIDENCE-DELIVERY-016 OPERATOR-INBOX-019 FACET-CONFIDENCE-019 %>
<% feature_intent = entry.record %>
<% readiness = Inbox::FeatureDecisionReadiness.call(feature_intent: feature_intent) %>
<% response_drafts = FeatureIntents::ResponseDrafts.for_feature_intent(session, feature_intent) %>
<% confidence_driven = feature_intent.confidence_driven? %>
<div class="space-y-6">
  <div class="rounded-xl border <%= readiness.ready? ? "border-emerald-200 bg-emerald-50" : "border-amber-200 bg-amber-50" %> p-4">
    <% if confidence_driven %>
      <p class="text-xs font-medium uppercase tracking-wide text-indigo-700">Confidence-driven delivery</p>
    <% end %>
    <h3 class="text-sm font-semibold <%= readiness.ready? ? "text-emerald-900" : "text-amber-900" %>">
      <%= confidence_driven ? (readiness.actionable? ? "Human action required" : "Scoped readiness") : (readiness.ready? ? "Ready for approval" : "Held") %>
    </h3>
    <p class="mt-1 text-sm <%= readiness.ready? ? "text-emerald-800" : "text-amber-800" %>">
      <%= entry.summary %>
    </p>
    <% if readiness.blockers.any? %>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-800">
        <% readiness.blockers.each do |blocker| %>
          <li data-testid="feature-decision-blocker-<%= blocker.code %>"><%= blocker.message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if confidence_driven && readiness.human_actions.any? %>
    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Next action</h3>
      <% readiness.human_actions.each do |action| %>
        <p class="rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-900" data-testid="feature-decision-action-<%= action.kind %>"><%= action.message %></p>
      <% end %>
      <p class="text-xs text-gray-500">Answers and evidence corrections trigger normal scoped-readiness reassessment; they do not approve the feature or authorize execution.</p>
    </div>
  <% end %>

  <% if feature_intent.brief.present? %>
    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Feature brief</h3>
      <p class="whitespace-pre-line rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600"><%= feature_intent.brief %></p>
    </div>
  <% end %>

  <% open_questions = feature_intent.feature_intent_decisions.questions.open_decisions %>
  <% if open_questions.any? %>
    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Open questions</h3>
      <ul class="space-y-2">
        <% open_questions.each do |decision| %>
          <li class="rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm">
            <p class="text-gray-900"><%= decision.prompt %></p>
            <p class="mt-1 text-xs text-gray-500">Affects: <%= decision.design_claim %></p>
            <% if policy(feature_intent).approve? %>
              <%# Decisions have no emitted option schema. Do not infer choices from prose. %>
              <%= form_with url: respond_to_decision_feature_intent_path(feature_intent, decision_id: decision.id), method: :post, class: "mt-3 space-y-2", data: { turbo_frame: "_top" } do |form| %>
                <%= form.label :answer, "Your response", for: dom_id(decision, :answer), class: "block text-xs font-medium text-gray-700" %>
                <%= form.text_area :answer, rows: 3, required: true, maxlength: FeatureIntents::ResponseDrafts::MAX_ANSWER_CHARS, placeholder: "State the direction or answer…", value: response_drafts[decision.id.to_s], id: dom_id(decision, :answer), class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
                <%= form.submit "Save response", class: "inline-flex min-h-11 items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% unconfirmed = feature_intent.feature_intent_decisions.inferred_decisions.open_decisions %>
  <% if unconfirmed.any? %>
    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Inferred decisions awaiting confirmation</h3>
      <ul class="space-y-2">
        <% unconfirmed.each do |decision| %>
          <li class="rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm">
            <%# The [inferred] flag lives in the decision's prompt text (FEATURE-APPROVAL-019). %>
            <p class="text-gray-900"><%= decision.prompt %></p>
            <p class="mt-1 text-xs text-gray-500">Affects: <%= decision.design_claim %></p>
            <% if policy(feature_intent).approve? %>
              <%= form_with url: respond_to_decision_feature_intent_path(feature_intent, decision_id: decision.id), method: :post, class: "mt-3 space-y-2", data: { turbo_frame: "_top" } do |form| %>
                <%= form.label :answer, "Confirm or correct this inference", for: dom_id(decision, :answer), class: "block text-xs font-medium text-gray-700" %>
                <%= form.text_area :answer, rows: 3, required: true, maxlength: FeatureIntents::ResponseDrafts::MAX_ANSWER_CHARS, placeholder: "Confirm it, or state the correction…", value: response_drafts[decision.id.to_s], id: dom_id(decision, :answer), class: "block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
                <%= form.submit "Save response", class: "inline-flex min-h-11 items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% design_prs = feature_intent.feature_intent_design_prs %>
  <% if design_prs.any? %>
    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Design pull requests</h3>
      <ul class="space-y-2">
        <% design_prs.each do |design_pr| %>
          <li class="flex items-center justify-between gap-3 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm">
            <div>
              <%= link_to "##{design_pr.pull_request_number}", design_pr.github_url, target: "_blank", rel: "noopener noreferrer", class: "font-medium text-indigo-600 hover:text-indigo-500" %>
              <span class="ml-2 text-xs text-gray-500"><%= design_pr.design_pr_kind.tr("_", " ").upcase %></span>
              <% unless design_pr.required? %>
                <span class="ml-2 text-xs text-gray-400">optional</span>
              <% end %>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <% if design_pr.merged? %>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 font-medium text-emerald-800">Merged</span>
              <% elsif design_pr.stale? %>
                <span class="rounded-full bg-amber-100 px-2 py-0.5 font-medium text-amber-800">Stale head</span>
              <% else %>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600">Open</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Preload each issue's feature-intent links (and their features) so the
      per-issue IssueHold projection below reads preloaded associations
      instead of issuing one link query per tree row (FEATURE-APPROVAL-023). %>
  <% issue_links = feature_intent.feature_intent_issues.includes(issue: { feature_intent_issues: :feature_intent }) %>
  <% if issue_links.any? %>
    <div class="space-y-2">
      <h3 class="text-sm font-semibold text-gray-900">Proposed issue tree</h3>
      <ul class="space-y-1">
        <% issue_links.each do |issue_link| %>
          <% issue = issue_link.issue %>
          <li class="text-sm text-gray-600">
            <%= link_to "##{issue.github_number} #{issue.title}", issue.github_url, target: "_blank", rel: "noopener noreferrer", class: "text-indigo-600 hover:text-indigo-500" %>
            <% if (link_hold = FeatureIntents::IssueHold.call(issue: issue, feature: feature_intent)) %>
              <span class="ml-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800" data-testid="feature-intent-hold" title="<%= link_hold.code %>">
                <%= link_hold.message %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if !confidence_driven && policy(feature_intent).approve? %>
    <div class="flex flex-wrap items-center gap-3">
      <%= button_to "Mark approved",
            approve_feature_intent_path(feature_intent),
            method: :post,
            disabled: !readiness.ready?,
            class: "inline-flex items-center rounded-md bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-500 disabled:cursor-not-allowed disabled:bg-gray-300",
            form: { data: { turbo_confirm: "Approve #{feature_intent.title} at its current design PR heads?", turbo_frame: "_top" } } %>
    </div>

    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
      <h3 class="text-sm font-semibold text-gray-900">Remove this proposal from the Inbox</h3>
      <p class="mt-1 text-sm text-gray-600">Declining preserves the brief, linked issues, evidence, and approval history. It does not release, close, or cancel replacement work.</p>
      <%= form_with url: cancel_feature_intent_path(feature_intent), method: :post, class: "mt-3 flex flex-wrap items-end gap-3", data: { turbo_confirm: "Decline this proposal? It can later be reopened for discovery.", turbo_frame: "_top" } do |form| %>
        <div>
          <%= form.label :cancellation_reason, "Reason", class: "block text-xs font-medium text-gray-700" %>
          <%= form.select :cancellation_reason, [["Already handled or duplicate", "already_handled"], ["Superseded", "superseded"], ["No longer wanted", "no_longer_wanted"]], {}, class: "mt-1 rounded-md border-gray-300 text-sm" %>
        </div>
        <div>
          <%= form.label :replacement_reference, "Replacement issue, PR, or feature (optional)", class: "block text-xs font-medium text-gray-700" %>
          <%= form.url_field :replacement_reference, class: "mt-1 rounded-md border-gray-300 text-sm", placeholder: "https://github.com/org/repo/pull/123" %>
        </div>
        <%= form.submit "Decline and remove", class: "inline-flex items-center rounded-md border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
      <% end %>
    </div>
  <% end %>
</div>
