<%# @spec DASHBOARD-CHART-A11Y-006 %>
<%= turbo_frame_tag "dashboard-pr-cycle-time" do %>
  <div class="overflow-hidden rounded-lg bg-white shadow"
    data-controller="pr-cycle-time"
    data-pr-cycle-time-base-url-value="<%= dashboard_pr_cycle_time_path(time_range: time_range) %>"
    data-pr-cycle-time-merged-counts-value="<%= data[:merged_counts].transform_keys(&:to_s).to_json %>">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-sm font-medium text-gray-500">PR Cycle Time (Issue Created → Merged)</h3>
          <p class="mt-1 text-xs text-gray-400">
            Daily average and median hours from issue creation to PR merge.
            Outliers above <%= outlier_cutoff %>h are excluded.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <label for="outlier-cutoff" class="text-xs text-gray-500">Cutoff (h):</label>
          <input type="number" id="outlier-cutoff" value="<%= outlier_cutoff %>" min="1" max="720" step="1"
            class="w-16 rounded-md border border-gray-300 px-2 py-1 text-xs text-gray-900"
            data-action="change->pr-cycle-time#reloadWithCutoff">
        </div>
      </div>

      <% summary = data[:summary] %>
      <% if summary[:total_merged] > 0 %>
        <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-4">
          <div class="text-center">
            <dt class="text-xs font-medium text-gray-500">Total Merged</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= summary[:total_merged] %></dd>
          </div>
          <div class="text-center">
            <dt class="text-xs font-medium text-gray-500">Overall Avg</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= summary[:overall_avg_hours] %>h</dd>
          </div>
          <div class="text-center">
            <dt class="text-xs font-medium text-gray-500">Overall Median</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= summary[:overall_p50_hours] %>h</dd>
          </div>
          <div class="text-center">
            <dt class="text-xs font-medium text-gray-500">Days with Data</dt>
            <dd class="mt-1 text-2xl font-semibold text-gray-900"><%= summary[:total_days] %></dd>
          </div>
        </dl>

        <div class="mt-4">
          <%= line_chart data[:series],
              id: "pr-cycle-time-chart",
              height: "320px",
              colors: ["#6366f1", "#10b981", "#f59e0b"],
              xtitle: "Merge Date",
              ytitle: "Hours",
              curve: false,
              library: {
                plugins: {
                  legend: { display: true, position: "bottom" },
                  annotation: { annotations: chart_annotations(data) }
                },
                scales: {
                  y: {
                    beginAtZero: true,
                    title: { display: true, text: "Hours" }
                  }
                },
                elements: {
                  line: { tension: 0.3 },
                  point: { radius: 3, hoverRadius: 6 }
                }
              } %>
          <%= tag.p(class: "sr-only") do %>
            Daily average and median hours from issue creation to PR merge, with outliers above <%= outlier_cutoff %> hours excluded.
          <% end %>
        </div>

        <% annotations = data[:outlier_annotations] %>
        <% if annotations.any? %>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="text-xs text-gray-400">Outliers excluded:</span>
            <% annotations.each do |date, count| %>
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                <%= date.strftime("%b %d") %>: <%= count %> removed
              </span>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="mt-4 py-8 text-center text-sm text-gray-400">
          No merged PRs with cycle time data in this period.
        </div>
      <% end %>
    </div>
  </div>
<% end %>
