<%# @spec OPERATOR-INBOX-002I %>
<% chat_action = Inbox::ChatAction.for(entry.kind) %>
<% if chat_action.shared_detail? && Inbox::InteractiveChatAccess.allowed?(user: current_user, project: entry.project) %>
  <div class="mt-6 border-t border-gray-200 pt-4">
    <%= button_to chat_action.label,
          inbox_interactive_chat_path(entry),
          method: :post,
          class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3.5 py-2 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-50",
          form: { data: { turbo_frame: "_top" } } %>
  </div>
<% end %>
