<%# @spec OPERATOR-INBOX-002D %>
<div class="space-y-6">
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">Paid stopped working this issue</h3>
    <p class="mt-1 text-sm text-purple-800">
      <% recovery = Issues::ManualReviewRecovery.call(issue: entry.issue) %>
      <% if recovery.reopen_review? %>
        This issue was reopened after closure. Record an intent-validation decision before choosing any further work.
      <% elsif recovery.dependency? %>
        This issue is waiting on a real dependency. Resolving the dependency will re-evaluate work; an acknowledgement does not waive it.
      <% elsif recovery.scanner_recurrence? %>
        A scanner-confirmed recurrence needs remediation evidence, not a generic enhancement retry.
      <% elsif recovery.unknown? %>
        Paid cannot identify the source of this hold, so it remains visible for investigation.
      <% elsif entry.questions.any? %>
        Paid stopped enhancing this issue and preserved its latest clarifying questions. Answer them below to resume, or start a new enhancement run.
      <% else %>
        Automatic picking skips issues in manual review. Starting a new enhancement run is the only way to resume work.
      <% end %>
    </p>
  </div>

  <% if recovery.reopen_review? && policy(entry.project).run_agent? %>
    <%= form_with url: resolve_reopen_review_project_agent_runs_path(entry.project), method: :post, class: "space-y-3" do |form| %>
      <%= form.hidden_field :issue_id, value: entry.issue.id %>
      <%= form.hidden_field :revision, value: entry.issue.github_updated_at.iso8601(6) %>
      <%= form.label :reason, "Validation decision and remaining scope", class: "block text-sm font-semibold text-gray-900" %>
      <%= form.text_area :reason, required: true, class: "block w-full rounded-md border-gray-300" %>
      <%= form.submit "Record intent validation", class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  <% end %>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if recovery.enhancement? && policy(entry.project).run_agent? %>
      <%= button_to "Start enhancement run",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Queue a manual enhancement run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>
</div>
