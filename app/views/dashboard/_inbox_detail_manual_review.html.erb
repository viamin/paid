<%# @spec OPERATOR-INBOX-002D %>
<% recovery = Inbox::ManualReviewRecovery.call(entry.issue) %>
<div class="space-y-6">
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">Paid stopped working this issue</h3>
    <p class="mt-1 text-sm text-purple-800">
      <% if recovery.cause == :reopen_review %>
        Paid needs a revision-bound decision about the prior closure before it can collect fresh validation evidence.
      <% elsif recovery.cause == :dependency %>
        Paid is waiting for prerequisite work. Acknowledging this item does not waive the dependency.
      <% elsif recovery.cause == :scanner_recurrence %>
        A scanner-confirmed recurrence needs remediation implementation, not another enhancement pass.
      <% elsif recovery.cause == :technical_failure %>
        Paid recorded a technical failure. Retrying analysis uses its supported recovery policy.
      <% elsif entry.questions.any? %>
        Paid stopped enhancing this issue and preserved its latest clarifying questions. Answer them below to resume, or start a new enhancement run.
      <% elsif recovery.cause == :unknown %>
        The recovery cause is unavailable. This hold remains visible until its provenance is reconciled.
      <% else %>
        Automatic picking skips this enhancement hold. Starting a new enhancement run retries its analysis.
      <% end %>
    </p>
  </div>

  <% if recovery.cause == :dependency %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Waiting for dependency resolution</h3>
      <p class="mt-1 text-sm text-amber-800">The owning issue must resolve before this work can be reconsidered.</p>
      <ul class="mt-2 list-disc pl-5 text-sm text-amber-800">
        <% recovery.dependencies.each do |dependency| %>
          <li><%= link_to "#{dependency.project.full_name}##{dependency.github_number}", dependency.github_url, target: "_blank", rel: "noopener noreferrer", class: "underline" %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(entry.project).run_agent? %>
      <% if recovery.cause == :reopen_review %>
        <%= form_with url: resume_manual_review_project_agent_runs_path(entry.project), method: :post, class: "space-y-2" do |form| %>
          <%= hidden_field_tag :issue_id, entry.issue.id %>
          <%= hidden_field_tag :reopen_review_revision, (entry.issue.github_updated_at || entry.issue.updated_at).iso8601 %>
          <%= hidden_field_tag :return_to, inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) %>
          <%= form.text_area :reopen_review_reason, required: true, rows: 2, placeholder: "Why does the prior closure still cover, or no longer cover, the remaining scope?", class: "block w-full rounded-md border-gray-300 text-sm" %>
          <%= form.submit "Record decision and collect validation evidence", class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500", data: { turbo_confirm: "Record this reopen-review decision and queue a validation analysis run?", turbo_frame: "_top" } %>
        <% end %>
      <% elsif recovery.action == :enhance_issue %>
        <%= button_to "Start enhancement run",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Queue a manual enhancement run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
      <% elsif recovery.action == :create_pr %>
        <%= button_to "Start remediation implementation",
              resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
              method: :post,
              params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
              class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
              form: { data: { turbo_confirm: "Queue a remediation implementation run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
      <% elsif recovery.action == :analyze_issue %>
        <%= button_to "Retry technical analysis",
              resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
              method: :post,
              params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
              class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
              form: { data: { turbo_confirm: "Queue a technical analysis retry for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
      <% end %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>
</div>
