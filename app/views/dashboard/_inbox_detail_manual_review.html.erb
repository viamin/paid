<%# @spec OPERATOR-INBOX-002D %>
<div class="space-y-6">
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">Paid stopped working this issue</h3>
    <p class="mt-1 text-sm text-purple-800">
      <% recovery = Issues::ManualReviewRecovery.call(issue: entry.issue) %>
      <% if recovery.reopen_review? %>
        This issue was reopened after closure. Validate its current intent before resuming implementation.
      <% elsif recovery.dependency_wait? %>
        Work is waiting on an unresolved dependency; acknowledgment does not waive that dependency.
      <% elsif recovery.unknown? %>
        Paid retained this hold because its cause is unknown. Review the recorded reason before continuing.
      <% elsif entry.questions.any? %>
        Paid stopped enhancing this issue and preserved its latest clarifying questions. Answer them below to resume, or start a new enhancement run.
      <% else %>
        Automatic picking skips issues in manual review. Starting a new enhancement run is the only way to resume work.
      <% end %>
    </p>
  </div>

  <% if recovery.reopen_review? %>
    <div class="rounded-xl border border-purple-200 bg-white p-4">
      <h3 class="text-sm font-semibold text-gray-900">Reopen review</h3>
      <p class="mt-1 text-sm text-gray-600">Original closure: <%= entry.issue.closed_at || "not recorded" %>. Remaining scope: <%= entry.issue.title %>. Reopen reason: <%= entry.issue.reopen_reason.presence || "not supplied" %>.</p>
      <% unless entry.issue.reopen_review_validated_for_current_revision? %>
        <%= form_with url: validate_reopen_review_project_agent_runs_path(entry.project), method: :post, class: "mt-3 space-y-3" do |form| %>
          <%= hidden_field_tag :issue_id, entry.issue.id %>
          <%= hidden_field_tag :revision, entry.issue.reopen_review_revision %>
          <%= hidden_field_tag :return_to, inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) %>
          <%= form.text_area :reason, required: true, rows: 3, class: "block w-full rounded-md border-gray-300", placeholder: "Why the current intent still requires work" %>
          <%= form.submit "Record intent validation", class: "rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white" %>
        <% end %>
      <% else %>
        <p class="mt-2 text-sm text-green-700">Intent validation recorded for the current revision. Resume implementation when ready.</p>
      <% end %>
    </div>
  <% elsif recovery.dependency_wait? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <% entry.issue.blocking_issues.each do |dependency| %>
        <%= link_to "Waiting on ##{dependency.github_number}: #{dependency.title}", dependency.github_url, target: "_blank", rel: "noopener noreferrer", class: "underline" %>
      <% end %>
      <% entry.issue.blocking_deployment_dependencies.each do |dependency| %>
        <%= link_to "Waiting for deployment of ##{dependency.depends_on_issue.github_number}", dependency.depends_on_issue.github_url, target: "_blank", rel: "noopener noreferrer", class: "underline" %>
      <% end %>
      <% entry.issue.blocking_external_dependencies.each do |dependency| %>
        <%= link_to "Waiting on #{dependency.depends_on_owner}/#{dependency.depends_on_repo}##{dependency.depends_on_number}", "https://github.com/#{dependency.depends_on_owner}/#{dependency.depends_on_repo}/issues/#{dependency.depends_on_number}", target: "_blank", rel: "noopener noreferrer", class: "underline" %>
      <% end %>
      <p class="mt-2">Paid reevaluates this hold when the dependency resolves; recording another acknowledgment does not waive it.</p>
    </div>
  <% end %>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(entry.project).run_agent? && recovery.active_run.nil? && !recovery.dependency_wait? && !recovery.unknown? && (!recovery.reopen_review? || entry.issue.reopen_review_validated_for_current_revision?) %>
      <%= button_to(recovery.enhancement? ? "Start enhancement run" : "Resume implementation",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "#{recovery.enhancement? ? "Queue a manual enhancement run" : "Resume implementation"} for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } }) %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>
</div>
