<%# @spec OPERATOR-INBOX-002D %>
<% recovery = Issues::ManualReviewRecovery.call(issue: entry.issue) %>
<div class="space-y-6">
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">Paid stopped working this issue</h3>
    <p class="mt-1 text-sm text-purple-800">
      <% if recovery.cause == :active_work %>
        Paid has queued or running work for this issue. Reconcile it before starting another run.
      <% elsif recovery.reopen? %>
        This issue was reopened after closure. Validate the original closure and remaining scope before choosing supported implementation work.
      <% elsif recovery.dependency? %>
        This issue is waiting for a dependency. The hold will be reevaluated when its owner resolves it.
      <% elsif recovery.active_work? %>
        Existing queued or running work must be reconciled before another recovery action can start.
      <% elsif recovery.scanner? %>
        Scanner evidence found a recurrence. Review the evidence and explicitly authorize remediation if it is appropriate.
      <% elsif recovery.enhancement? && entry.questions.any? %>
        Paid stopped enhancing this issue and preserved its latest clarifying questions. Answer them below to resume, or start a new enhancement run.
      <% elsif recovery.enhancement? %>
        Automatic picking skips issues in manual review. Starting a new enhancement run is the only way to resume work.
      <% else %>
        Paid retained this stop because its producer is unknown. Inspect the retained evidence before resuming work.
      <% end %>
    </p>
  </div>

  <% if recovery.cause == :active_work %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Work already in progress</h3>
      <p class="mt-1 text-sm text-amber-800">Reuse or reconcile the existing run before resuming this hold.</p>
    </div>
  <% elsif recovery.reopen? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Validate reopened intent</h3>
      <p class="mt-1 text-sm text-amber-800">Review the original closure and remaining scope. This action records a decision; it does not retry enhancement.</p>
      <p class="mt-2 text-sm text-amber-800"><strong>Original closure:</strong> <%= entry.issue.reopen_reason.presence || "No Paid-recorded reopen reason is available." %></p>
    </div>
  <% elsif recovery.dependency? || recovery.active_work? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900"><%= recovery.dependency? ? "Waiting for dependency" : "Existing work needs reconciliation" %></h3>
      <ul class="mt-2 list-disc pl-5 text-sm text-amber-800">
        <% recovery.blockers.each do |blocker| %>
          <% if blocker.respond_to?(:github_url) %>
            <li><%= link_to "##{blocker.github_number}", blocker.github_url, target: "_blank", rel: "noopener noreferrer", class: "underline" %></li>
          <% else %>
            <li><%= link_to "#{blocker.depends_on_owner}/#{blocker.depends_on_repo}##{blocker.depends_on_number}", "https://github.com/#{blocker.depends_on_owner}/#{blocker.depends_on_repo}/issues/#{blocker.depends_on_number}", target: "_blank", rel: "noopener noreferrer", class: "underline" %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% elsif recovery.unknown? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Unknown manual-review cause</h3>
      <p class="mt-1 text-sm text-amber-800"><%= recovery.description %></p>
    </div>
  <% end %>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if recovery.enhancement? && entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(entry.project).run_agent? && recovery.enhancement? %>
      <%= button_to "Start enhancement run",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Queue a manual enhancement run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>
</div>
