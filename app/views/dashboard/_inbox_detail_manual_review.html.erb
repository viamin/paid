<%# @spec OPERATOR-INBOX-002D %>
<div class="space-y-6">
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">Paid stopped working this issue</h3>
    <p class="mt-1 text-sm text-purple-800">
      Manual review preserves this hold until the cause-specific action below succeeds.
    </p>
  </div>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Recovery route</h3>
    <% entry.recovery.causes.each do |cause| %>
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-3">
        <p class="text-sm font-semibold text-gray-900"><%= cause.label %></p>
        <p class="mt-1 text-sm text-gray-600"><%= cause.explanation %></p>
        <% if cause.type == :reopen_review %>
          <dl class="mt-3 space-y-2 text-sm text-gray-700">
            <div><dt class="font-semibold">Prior closure</dt><dd><%= cause.evidence[:prior_closed_at] || "Closure time unavailable" %></dd></div>
            <div><dt class="font-semibold">Recorded reopen reason</dt><dd><%= cause.evidence[:reopen_reason].presence || "No chat-tool reason recorded" %></dd></div>
            <div><dt class="font-semibold">Current remaining scope</dt><dd class="whitespace-pre-wrap"><%= cause.evidence[:current_scope].presence || "Issue body is empty" %></dd></div>
          </dl>
        <% end %>
        <% cause.links.each do |link| %>
          <%= link_to link[:label], link[:url], target: "_blank", rel: "noopener noreferrer",
                class: "mt-2 mr-3 inline-flex text-sm font-semibold text-purple-700 hover:text-purple-600" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if entry.recovery.active_runs.any? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Work already in flight</h3>
      <% entry.recovery.active_runs.each do |run| %>
        <p class="mt-1 text-sm text-amber-800">Run #<%= run[:run_id] %> is <%= run[:status] %> for <%= run[:goal].humanize.downcase %>. The action will reuse compatible work; incompatible work must be reconciled.</p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(entry.project).run_agent? && entry.recovery.action == :retry_analysis %>
      <%= button_to "Retry analysis",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { recovery_action: "retry_analysis", return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Retry analysis for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
    <% elsif policy(entry.project).run_agent? && entry.recovery.action == :resume_implementation %>
      <%= button_to "Resume implementation",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { recovery_action: "resume_implementation", return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Resume implementation for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>

  <% if policy(entry.project).run_agent? && entry.recovery.action == :record_reopen_decision %>
    <%= form_with url: resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id), method: :post,
          class: "space-y-3 rounded-xl border border-purple-200 bg-white p-4", data: { turbo_frame: "_top" } do |form| %>
      <%= hidden_field_tag :recovery_action, "record_reopen_decision" %>
      <%= hidden_field_tag :issue_revision, entry.recovery.required_revision %>
      <%= hidden_field_tag :return_to, inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) %>
      <div>
        <%= form.label :reason, "Intent-validation decision and reason", class: "block text-sm font-medium text-gray-900" %>
        <%= form.text_area :reason, required: true, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 text-sm" %>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= form.button "Resume implementation", name: "continuation", value: "implementation",
              class: "rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white" %>
        <%= form.button "Retry analysis", name: "continuation", value: "analysis",
              class: "rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-gray-300" %>
      </div>
    <% end %>
  <% end %>
</div>
