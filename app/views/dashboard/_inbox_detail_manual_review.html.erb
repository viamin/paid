<%# @spec OPERATOR-INBOX-002D %>
<div class="space-y-6">
  <% recovery = Inbox::ManualReviewRecovery.for(issue: entry.issue) %>
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">
      <%= recovery.requires_decision? ? "Review reopened issue" : "Paid stopped working this issue" %>
    </h3>
    <p class="mt-1 text-sm text-purple-800">
      <% if recovery.requires_decision? %>
        Confirm the original closure and remaining scope against this synchronized issue revision. Your decision and reason are recorded before implementation can resume.
      <% elsif recovery.waiting? %>
        This issue is waiting for a dependency. Its hold remains in place until the dependency is resolved.
      <% elsif recovery.action == :review_scanner_evidence %>
        A scanner-confirmed recurrence needs remediation evidence and its supported recovery action; starting an enhancement run would not resolve it.
      <% elsif recovery.action == :none %>
        The source of this hold is unknown. It remains visible until an operator reconciles its provenance.
      <% elsif entry.questions.any? %>
        Paid stopped enhancing this issue and preserved its latest clarifying questions. Answer them below to resume, or start a new enhancement run.
      <% else %>
        Automatic picking skips issues in manual review. Resume the recorded enhancement work when appropriate.
      <% end %>
    </p>
  </div>

  <% if recovery.waiting? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Waiting for dependency</h3>
      <ul class="mt-2 list-disc pl-5 text-sm text-amber-800">
        <% recovery.dependencies.each do |dependency| %>
          <% if dependency.respond_to?(:github_url) %>
            <li><%= link_to "##{dependency.github_number} #{dependency.title}", dependency.github_url, target: "_blank", rel: "noopener noreferrer", class: "underline" %></li>
          <% else %>
            <li><%= dependency.external_ref %> (external dependency)</li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if recovery.action == :resume_enhancement && entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if recovery.requires_decision? && policy(entry.project).run_agent? %>
      <%= form_with url: resume_manual_review_project_agent_runs_path(entry.project), method: :post, class: "space-y-2" do |form| %>
        <%= hidden_field_tag :issue_id, entry.issue.id %>
        <%= hidden_field_tag :reopen_review_revision, entry.issue.github_updated_at.iso8601 %>
        <%= hidden_field_tag :return_to, inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) %>
        <%= form.text_area :reopen_reason, required: true, rows: 2, placeholder: "Why the prior closure is insufficient or what scope remains", class: "block w-full rounded-md border-gray-300 text-sm" %>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= check_box_tag :reopen_review_confirmed, "1", false, required: true %>
          I reviewed the original closure and current issue revision.
        </label>
        <%= form.submit "Resume implementation", class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500" %>
      <% end %>
    <% elsif recovery.action == :resume_enhancement && policy(entry.project).run_agent? %>
      <%= button_to "Start enhancement run",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Queue a manual enhancement run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>
</div>
