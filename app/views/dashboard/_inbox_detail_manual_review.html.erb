<%# @spec OPERATOR-INBOX-002D %>
<div class="space-y-6">
  <div class="rounded-xl border border-purple-200 bg-purple-50 p-4">
    <h3 class="text-sm font-semibold text-purple-900">Paid stopped working this issue</h3>
    <p class="mt-1 text-sm text-purple-800">
      <% recovery = entry.manual_review_recovery %>
      <% if recovery.reopen_review? %>
        This issue was reopened after closure. Record a current-revision intent decision before Paid evaluates supported continuation.
      <% elsif recovery.dependency? %>
        Work remains held by an unresolved dependency. This acknowledgement cannot waive that dependency.
      <% elsif recovery.authorize_new_remediation? %>
        Scanner evidence confirms the finding recurred after the merged fix. Review the evidence below, then authorize one new remediation run if another fix attempt is appropriate.
      <% elsif recovery.scanner? %>
        Scanner verification is still pending or incomplete. No operator action is needed; the verifier revisits it on the next scan.
      <% elsif recovery.enhancement? && entry.questions.any? %>
        Paid stopped enhancing this issue and preserved its latest clarifying questions. Answer them below to resume, or start a new enhancement run.
      <% elsif recovery.enhancement? %>
        This is an enhancement recovery. Starting a new enhancement run retries analysis; it does not implement the issue.
      <% else %>
        Paid retained this hold because its provenance is unknown. No automatic retry is offered until the cause is reconciled.
      <% end %>
    </p>
  </div>

  <div class="space-y-3">
    <h3 class="text-sm font-semibold text-gray-900">Why this is in your inbox</h3>
    <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      <%= entry.summary %>
    </p>
  </div>

  <%# A scanner-confirmed recurrence routes through manual_review, not the
      partial_closeout lane (SecurityAlerts::VerifyRemediationAttempt#fail!
      moves the issue here) — surface the same alert/evidence/recovery here
      so that path is not reduced to the generic reason text alone (#4188). %>
  <% scanner_blockers = Issues::CloseoutStatus.scanner_verification_blockers(entry.issue) %>
  <% if scanner_blockers.any? %>
    <div class="rounded-xl border border-violet-200 bg-violet-50 p-4">
      <h3 class="text-sm font-semibold text-violet-900">Scanner verification evidence</h3>
      <%= render "dashboard/inbox_closeout_blockers", blockers: scanner_blockers %>
    </div>
  <% end %>

  <%# @spec ISSUE-ENHANCEMENT-011
      The terminal round's preserved clarifying questions ARE the manual
      review this state asks for: render the same answer form the
      clarifying_questions lane uses, submitting to the same endpoint. %>
  <% if recovery.enhancement? && entry.questions.any? %>
    <%= render "dashboard/inbox_clarifying_answer_form",
          entry: entry,
          scoped_project: scoped_project,
          selected_kind: selected_kind %>
  <% end %>

  <% if recovery.reopen_review? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Validate reopened intent</h3>
      <p class="mt-1 text-sm text-amber-800">Confirm the remaining scope against the current GitHub revision and explain why work should continue. This records a decision; it does not start an agent run.</p>
      <% if policy(entry.project).run_agent? %>
        <%= form_with url: resolve_reopen_review_project_agent_runs_path(entry.project), method: :post, class: "mt-3 space-y-3" do |form| %>
          <%= hidden_field_tag :issue_id, entry.issue.id %>
          <%= hidden_field_tag :revision, entry.issue.github_updated_at&.iso8601 %>
          <%= hidden_field_tag :return_to, inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) %>
          <%= form.label :reason, "Remaining scope and validation reason", class: "block text-sm font-medium text-amber-900" %>
          <%= form.text_area :reason, required: true, rows: 3, class: "block w-full rounded-md border-amber-300 text-sm" %>
          <%= form.submit "Record intent validation", class: "inline-flex items-center rounded-md bg-amber-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600" %>
        <% end %>
      <% end %>
    </div>
  <% elsif recovery.dependency? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <h3 class="font-semibold">Waiting on dependency</h3>
      <% dependency = recovery.dependency %>
      <% if dependency.respond_to?(:github_url) %>
        <%= link_to "Open dependency ##{dependency.github_number}", dependency.github_url, target: "_blank", rel: "noopener noreferrer", class: "mt-2 inline-block font-semibold underline" %>
      <% else %>
        <p class="mt-1"><%= dependency.external_ref %> must resolve before this issue can be reevaluated.</p>
      <% end %>
    </div>
  <% elsif recovery.authorize_new_remediation? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
      <h3 class="text-sm font-semibold text-amber-900">Authorize new remediation</h3>
      <p class="mt-1 text-sm text-amber-800">The scanner confirmed this finding recurred after the merged fix. Starting a new remediation run queues one more create-PR attempt; only do this if another fix attempt is appropriate.</p>
      <% if policy(entry.project).run_agent? %>
        <%= button_to "Start remediation run",
              authorize_scanner_remediation_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
              method: :post,
              params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
              class: "mt-3 inline-flex items-center rounded-md bg-amber-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600",
              form: { data: { turbo_confirm: "Queue one new remediation run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
      <% end %>
    </div>
  <% elsif recovery.unknown? %>
    <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700">
      This hold has no recognized producer provenance. Inspect the originating issue and run history before selecting a recovery action.
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(entry.project).run_agent? && recovery.enhancement? %>
      <%= button_to "Start enhancement run",
            resume_manual_review_project_agent_runs_path(entry.project, issue_id: entry.issue.id),
            method: :post,
            params: { return_to: inbox_path(**inbox_query_params(project: scoped_project, kind: selected_kind)) },
            class: "inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500",
            form: { data: { turbo_confirm: "Queue a manual enhancement run for #{entry.project.full_name}##{entry.issue.github_number}?", turbo_frame: "_top" } } %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue),
          entry.issue.github_url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <%= render "inbox/supplement_content", entry: entry %>
  </div>
</div>
