<%# @spec INBOX-PROGRESS-001 %>
<section class="mb-6 rounded-lg border border-gray-200 p-4" data-testid="inbox-progress">
  <h3 class="text-sm font-semibold text-gray-900">Delivery progress</h3>
  <ol class="mt-3 space-y-2">
    <% projection.milestones.each do |milestone| %>
      <li class="flex items-start justify-between gap-3 text-sm">
        <span class="font-medium text-gray-800"><%= milestone.label %></span>
        <span class="text-right text-gray-600" data-progress-state="<%= milestone.state %>"><%= milestone.state.humanize %></span>
      </li>
      <% if milestone.next_action.present? %>
        <li class="-mt-1 text-sm text-gray-500"><%= milestone.next_action %></li>
      <% end %>
    <% end %>
  </ol>
</section>
