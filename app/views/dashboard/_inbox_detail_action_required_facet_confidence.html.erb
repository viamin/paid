<%# @spec FACET-CONFIDENCE-022 OPERATOR-INBOX-002M %>
<% inbox_context = {
     inbox_kind: params[:kind].presence_in(Inbox::Queue::KINDS),
     inbox_sort: params[:sort].presence_in(Inbox::Queue::SORTS.keys),
     inbox_entry_id: entry.id
   }.compact %>
<div class="space-y-6" data-facet-confidence-action-required>
  <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4">
    <h3 class="text-sm font-semibold text-indigo-900"><%= guidance.title %></h3>
    <p class="mt-1 text-sm text-indigo-800"><%= guidance.description %></p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-4">
    <h3 class="text-sm font-semibold text-gray-900">Judgment progress</h3>
    <p class="mt-1 text-sm text-gray-600">
      <%= guidance.labeled %> recorded · <%= guidance.remaining %> remaining · <%= guidance.total %> total.
      <% if guidance.skipped.positive? %><%= guidance.skipped %> skipped case(s) still need a judgment.<% end %>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <% if guidance.action == :start %>
      <%= link_to guidance.action_label,
            new_project_facet_confidence_evaluation_path(entry.project, issue_id: entry.issue.id, **inbox_context),
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% elsif guidance.action == :freeze %>
      <%= button_to guidance.action_label,
            freeze_project_facet_confidence_evaluation_path(entry.project, guidance.evaluation, **inbox_context),
            form: { data: { turbo_frame: "_top", turbo_confirm: "Freeze the completed judgment set?" } },
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% else %>
      <%= link_to guidance.action_label,
            project_facet_confidence_evaluation_path(entry.project, guidance.evaluation, **inbox_context),
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    <% end %>
    <%= link_to inbox_issue_link_label(entry.issue), entry.issue.github_url,
          target: "_blank", rel: "noopener noreferrer",
          class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
  </div>
</div>
