<%# @spec DASHBOARD-CHART-A11Y-006 %>
<%= turbo_frame_tag "dashboard-metrics" do %>
  <%# Time Range Filter Buttons — navigate the full dashboard page so both
      metrics and performance frames reload with the new time_range, and the
      browser URL stays on /dashboard (not a frame-only endpoint). %>
  <div class="mb-6 flex flex-wrap gap-2">
    <% Dashboard::Stats::TIME_RANGES.each do |range| %>
      <%= link_to time_range_label(range),
            dashboard_path(time_range: range),
            class: filter_button_classes(time_range == range),
            data: { turbo_frame: "_top" } %>
    <% end %>
  </div>

  <%# Run Volume & Outcome %>
  <div>
    <h2 class="text-lg font-semibold text-gray-900">Run Volume &amp; Outcome</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Total Runs</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
          <%= number_with_delimiter(stats[:run_volume][:total]) %>
        </dd>
      </div>
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Last 7 Days</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
          <%= number_with_delimiter(stats[:run_volume][:last_7_days]) %>
        </dd>
      </div>
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Last 30 Days</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
          <%= number_with_delimiter(stats[:run_volume][:last_30_days]) %>
        </dd>
      </div>
      <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Active Now</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-indigo-600">
          <%= number_with_delimiter(stats[:run_volume][:active]) %>
        </dd>
      </div>
    </div>

    <%# Status breakdown %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-sm font-medium text-gray-500">Status Breakdown</h3>
        <div class="mt-3 flex flex-wrap gap-4 text-sm">
          <% %w[completed no_output failed cancelled timeout token_budget_exceeded queued running].each do |status| %>
            <% count = stats[:run_volume][:by_status][status] || 0 %>
            <% next if count.zero? %>
            <div class="flex items-center gap-1.5">
              <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                <%= case status
                    when 'completed' then 'bg-green-100 text-green-700'
                    when 'no_output' then 'bg-slate-100 text-slate-600'
                    when 'failed' then 'bg-red-100 text-red-700'
                    when 'cancelled' then 'bg-gray-100 text-gray-700'
                    when 'timeout' then 'bg-yellow-100 text-yellow-700'
                    when 'token_budget_exceeded' then 'bg-rose-100 text-rose-700'
                    when 'running' then 'bg-blue-100 text-blue-700'
                    when 'queued' then 'bg-indigo-100 text-indigo-700'
                    end %>">
                <%= status.titleize %>
              </span>
              <span class="font-semibold text-gray-900"><%= number_with_delimiter(count) %></span>
            </div>
          <% end %>
          <div class="flex items-center gap-1.5">
            <span class="text-gray-500">Failure rate:</span>
            <span class="font-semibold <%= stats[:run_volume][:failure_rate] > 25 ? 'text-red-600' : 'text-gray-900' %>">
              <%= stats[:run_volume][:failure_rate] %>%
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Agent Runs per Day</h3>
            <p class="mt-1 text-sm text-gray-500">Completed runs are stacked above failed runs across the last 30 days.</p>
          </div>
        </div>
        <div class="mt-4">
          <%= dashboard_chartkick_chart "ColumnChart", stats[:daily_run_status_chart],
              id: "daily-runs-chart",
              caption: "Agent runs per day, stacked by completed and failed status, over the last 30 days.",
              stacked: true,
              height: "320px",
              colors: ["#dc2626", "#16a34a"],
              xtitle: "Day",
              ytitle: "Runs",
              discrete: true,
              thousands: ",",
              library: {
                plugins: {
                  legend: {
                    display: true,
                    position: "bottom"
                  }
                },
                scales: {
                  x: {
                    stacked: true
                  },
                  y: {
                    stacked: true,
                    beginAtZero: true,
                    ticks: {
                      precision: 0
                    }
                  }
                }
              } %>
        </div>
      </div>
    </div>

    <%# PR Creation Run Outcomes %>
    <% outcome_data = stats[:daily_outcome_chart] %>
    <% outcome_window_label = time_range_label(time_range) %>
    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">PR Creation Run Outcomes (<%= outcome_window_label %>)</h3>
            <p class="mt-1 text-sm text-gray-500">Daily agent run outcomes for <code>create_pr</code> goal, grouped by completion status.</p>
          </div>
          <% if outcome_data[:overall_total] > 0 %>
            <div class="shrink-0 text-right">
              <span class="text-2xl font-semibold text-green-600"><%= outcome_data[:overall_completion_rate] %>%</span>
              <p class="text-xs text-gray-500">overall completion rate</p>
              <p class="text-xs text-gray-400"><%= number_with_delimiter(outcome_data[:overall_completed]) %> / <%= number_with_delimiter(outcome_data[:overall_total]) %> runs</p>
            </div>
          <% end %>
        </div>

        <% if outcome_data[:overall_total] > 0 %>
          <%# Stacked column chart of outcomes per day %>
          <div class="mt-4">
            <%= dashboard_chartkick_chart "ColumnChart", outcome_data[:series],
                id: "daily-outcome-chart",
                caption: "PR Creation run outcomes per day for #{outcome_window_label}, grouped by completion status.",
                stacked: true,
                height: "280px",
                colors: outcome_data[:colors],
                xtitle: "Day",
                ytitle: "Runs",
                discrete: true,
                thousands: ",",
                library: {
                  plugins: {
                    legend: {
                      display: true,
                      position: "bottom"
                    },
                    tooltip: {
                      mode: "index",
                      intersect: false
                    }
                  },
                  scales: {
                    x: { stacked: true },
                    y: {
                      stacked: true,
                      beginAtZero: true,
                      ticks: { precision: 0 }
                    }
                  }
                } %>
          </div>

          <%# Completion rate % line chart %>
          <div class="mt-6">
            <h4 class="text-xs font-medium text-gray-500 uppercase tracking-wider">Daily Completion Rate %</h4>
            <%= dashboard_chartkick_chart "LineChart", outcome_data[:completion_rate],
                id: "daily-completion-rate-chart",
                caption: "Daily PR creation completion rate percentage for #{outcome_window_label}.",
                height: "180px",
                colors: ["#16a34a"],
                xtitle: "Day",
                ytitle: "Completion %",
                discrete: true,
                library: {
                  plugins: {
                    legend: { display: false }
                  },
                  scales: {
                    y: {
                      beginAtZero: true,
                      max: 100
                    }
                  }
                } %>
          </div>

          <%# Legend with overall distribution stats %>
          <div class="mt-4 flex flex-wrap gap-3 text-sm">
            <% outcome_data[:series].each_with_index do |series, index| %>
              <% count = series[:data].values.sum %>
              <% next if count.zero? %>
              <div class="flex items-center gap-1.5">
                <span class="h-3 w-3 rounded-full shrink-0" style="background-color: <%= outcome_data[:colors][index] %>"></span>
                <span class="text-gray-600"><%= series[:name] %></span>
                <span class="font-semibold text-gray-900"><%= number_with_delimiter(count) %></span>
                <span class="text-gray-400">(<%= ((count.to_f / outcome_data[:overall_total]) * 100).round(1) %>%)</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="mt-4 py-8 text-center text-sm text-gray-400">No <code>create_pr</code> runs with outcomes in <%= outcome_window_label.downcase %>.</div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Cost & Token Usage — hidden when all values are zero %>
  <% cost_tokens = stats[:cost_and_tokens] %>
  <% has_cost_or_token_data = cost_tokens[:total_cost_cents].to_i > 0 || cost_tokens[:trailing_30d_tokens].to_i > 0 %>
  <% if has_cost_or_token_data %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Cost &amp; Token Usage</h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Total Cost</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            $<%= format("%.2f", cost_tokens[:total_cost_cents] / 100.0) %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Cost (30 days)</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            $<%= format("%.2f", cost_tokens[:trailing_30d_cost_cents] / 100.0) %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Tokens (30 days)</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= number_with_delimiter(cost_tokens[:trailing_30d_tokens]) %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Avg Cost / Run</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            $<%= format("%.2f", cost_tokens[:avg_cost_per_run_cents] / 100.0) %>
          </dd>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Avg Tokens / Run</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= number_with_delimiter(cost_tokens[:avg_tokens_per_run]) %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Avg Iterations / Run</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= cost_tokens[:avg_iterations_per_run] %>
          </dd>
        </div>
      </div>
    </div>
  <% end %>

  <%# Duration Percentiles %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Duration (Completed Runs)</h2>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% { "Median (p50)" => :p50, "p75" => :p75, "p90" => :p90, "Average" => :avg }.each do |label, key| %>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500"><%= label %></dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= format_duration(stats[:duration_percentiles][key]) %>
          </dd>
        </div>
      <% end %>
    </div>
  </div>

  <%# Duration Trend Chart %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Duration Trend (PR Creation Runs)</h2>
    <p class="mt-1 text-sm text-gray-500">Daily avg and median (p50) duration for completed PR creation runs.</p>
    <% dtc = stats[:duration_trend_chart] %>
    <% dtc_has_data = dtc[:series].any? { |s| s[:data].any? } %>
    <% if dtc_has_data %>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <div class="px-4 py-5 sm:p-6">
          <% slope = dtc[:slope_seconds_per_day] %>
          <% if slope != 0.0 %>
            <p class="mb-3 text-xs text-gray-500">
              Trend: <span class="font-medium <%= slope > 0 ? 'text-red-600' : 'text-green-600' %>">
                <%= slope > 0 ? "+" : "" %><%= slope %>s/day
              </span>
            </p>
          <% end %>
          <%= dashboard_chartkick_chart "LineChart", dtc[:series],
              id: "duration-trend-chart",
              caption: "Daily average and median (p50) duration in seconds for completed PR creation runs.",
              height: "320px",
              colors: ["#4f46e5", "#059669", "#94a3b8"],
              xtitle: "Date",
              ytitle: "Seconds",
              library: {
                plugins: {
                  legend: { display: true, position: "bottom" }
                },
                scales: {
                  y: { beginAtZero: true }
                }
              } %>
        </div>
      </div>
    <% else %>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <div class="px-4 py-5 text-sm text-gray-500">No completed PR creation runs yet.</div>
      </div>
    <% end %>
  </div>

  <%# Phase Breakdown %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Run Phase Breakdown</h2>
    <p class="mt-1 text-sm text-gray-500">Separate queue and setup overhead from prompt preparation, agent execution, and wrap-up work.</p>
    <% phase_groups = stats[:phase_breakdown].keys %>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% phase_groups.each do |phase_group| %>
        <% phase_stats = stats[:phase_breakdown][phase_group] %>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500"><%= phase_group_label(phase_group) %></dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= format_duration(phase_stats[:avg_seconds]) %>
          </dd>
          <dd class="mt-2 text-xs text-gray-500">
            p50 <%= format_duration(phase_stats[:p50_seconds]) %>
            · p75 <%= format_duration(phase_stats[:p75_seconds]) %>
            · p90 <%= format_duration(phase_stats[:p90_seconds]) %>
          </dd>
        </div>
      <% end %>
    </div>

    <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-sm font-medium text-gray-500">Average End-to-End Composition</h3>
        <% total_avg_seconds = phase_groups.sum { |group| stats[:phase_breakdown][group][:avg_seconds] } %>
        <div class="mt-4 h-4 overflow-hidden rounded-full bg-gray-100"
             role="img"
             aria-label="Average end-to-end composition by phase">
          <% phase_groups.each do |phase_group| %>
            <% avg_seconds = stats[:phase_breakdown][phase_group][:avg_seconds] %>
            <% width_pct = total_avg_seconds.zero? ? 0 : ((avg_seconds.to_f / total_avg_seconds) * 100).round(1) %>
            <div class="<%= phase_group_bar_style(phase_group) %> h-4 float-left"
                 style="width: <%= width_pct %>%"
                 title="<%= phase_group_label(phase_group) %>: <%= format_duration(avg_seconds) %>"
                 aria-label="<%= phase_group_label(phase_group) %> average duration <%= format_duration(avg_seconds) %> (<%= width_pct %>%) of total run time"
                 tabindex="0"></div>
          <% end %>
        </div>
        <div class="mt-4 flex flex-wrap gap-3 text-sm text-gray-600">
          <% phase_groups.each do |phase_group| %>
            <div class="flex items-center gap-2">
              <span class="<%= phase_group_bar_style(phase_group) %> h-3 w-3 rounded-full"></span>
              <span><%= phase_group_label(phase_group) %>: <span class="font-medium text-gray-900"><%= format_duration(stats[:phase_breakdown][phase_group][:avg_seconds]) %></span></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Issue Completion %>
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Issue Completion <span class="text-sm font-normal text-gray-500">(All Time)</span></h2>
    <% ic = stats[:issue_completion] %>
    <% if ic[:merged_count] > 0 %>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Merged PRs (with agent runs)</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-green-600">
            <%= ic[:merged_count] %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Avg Runs / Issue</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= ic[:runs_per_issue][:avg] %>
          </dd>
          <dd class="mt-1 text-xs text-gray-500">
            min <%= ic[:runs_per_issue][:min] %> / max <%= ic[:runs_per_issue][:max] %> / median <%= ic[:runs_per_issue][:median] %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Avg Time to Merge</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= format_duration(ic[:time_to_merge][:avg_seconds]) %>
          </dd>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <dt class="truncate text-sm font-medium text-gray-500">Avg Agent Time / Issue</dt>
          <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900">
            <%= format_duration(ic[:agent_run_seconds][:avg_seconds]) %>
          </dd>
        </div>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <h3 class="text-sm font-medium text-gray-500">Time to Merge Percentiles</h3>
          <div class="mt-3 flex flex-wrap gap-6 text-sm">
            <% { "p50" => :p50_seconds, "p90" => :p90_seconds }.each do |label, key| %>
              <div>
                <span class="text-gray-500"><%= label %>:</span>
                <span class="font-semibold text-gray-900">
                  <%= format_duration(ic[:time_to_merge][key]) %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow px-4 py-5 sm:p-6">
          <h3 class="text-sm font-medium text-gray-500">Agent Time Percentiles</h3>
          <div class="mt-3 flex flex-wrap gap-6 text-sm">
            <% { "p50" => :p50_seconds, "p90" => :p90_seconds }.each do |label, key| %>
              <div>
                <span class="text-gray-500"><%= label %>:</span>
                <span class="font-semibold text-gray-900">
                  <%= format_duration(ic[:agent_run_seconds][key]) %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <div class="px-4 py-5 text-sm text-gray-500">No merged PRs with agent runs yet.</div>
      </div>
    <% end %>
  </div>

  <%# Cost by Project — hidden when all costs are zero %>
  <% cost_by_project_with_data = stats[:cost_by_project].select { |_, cost_cents| cost_cents > 0 } %>
  <% if cost_by_project_with_data.any? %>
    <div class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Cost by Project <span class="text-sm font-normal text-gray-500">(All Time)</span></h2>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Project</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Total Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% cost_by_project_with_data.each do |project_name, cost_cents| %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= project_name %></td>
                <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right">$<%= format("%.2f", cost_cents / 100.0) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
    <%# Runs by Runner (effective runner accounting for fallbacks) %>
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Runs by Runner</h2>
      <% fallback_stats = stats[:runner_fallback_stats] %>
      <% if fallback_stats[:fallback_count] > 0 %>
        <p class="mt-1 text-xs text-gray-500">
          <%= fallback_stats[:fallback_count] %> of <%= fallback_stats[:total_runs] %> runs
          (<%= fallback_stats[:fallback_rate] %>%) used runner fallback
        </p>
      <% end %>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <% if stats[:runs_by_runner].any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Runner</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Runs</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% stats[:runs_by_runner].each do |runner, count| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= runner %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= number_with_delimiter(count) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-4 py-5 text-sm text-gray-500">No agent runs yet.</div>
        <% end %>
      </div>

    </div>

    <%# Runs by Project %>
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Top Projects by Runs</h2>
      <div class="mt-4 overflow-hidden rounded-lg bg-white shadow">
        <% if stats[:runs_by_project].any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Project</th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">Runs</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% stats[:runs_by_project].each do |project_name, count| %>
                <tr>
                  <td class="whitespace-nowrap px-4 py-3 text-sm font-medium text-gray-900"><%= project_name %></td>
                  <td class="whitespace-nowrap px-4 py-3 text-sm text-gray-500 text-right"><%= number_with_delimiter(count) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-4 py-5 text-sm text-gray-500">No projects with runs yet.</div>
        <% end %>
      </div>
    </div>
  </div>

<% end %>
