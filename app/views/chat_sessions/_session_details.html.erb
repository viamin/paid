<%# @spec CHAT-API-009 @spec QUESTION-EXPLORATION-015
    Body of the "Session details" disclosure rendered from both the mobile
    and the desktop chat panel headers. The chat page is chat-first, so the
    disclosure is closed by default: the always-visible chrome is just the
    title and a single "Session details" toggle. The body only appears when
    the user chooses to expand it, which means the transcript and the
    composer stay the dominant region of the viewport-bound panel.

    `dom_id_suffix` keeps the title / runner-model field ids unique
    between the two headers (mobile uses `_mobile`, desktop uses no
    suffix) so the `<label for>` association works in either copy without
    colliding in the DOM. %>
<% session_projects = chat_session_projects(chat_session) %>
<% dom_id_suffix = local_assigns.fetch(:dom_id_suffix, "") %>
<div class="space-y-3 border-t border-gray-200 px-4 pb-3 pt-3 sm:px-6">
  <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
    <%= chat_container_status_badge(chat_session) %>
    <% if session_projects.any? %>
      <% session_projects.each do |project| %>
        <%= link_to project.name,
                    project_path(project),
                    data: { turbo_frame: "_top" },
                    class: "inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-200 hover:text-gray-900" %>
      <% end %>
    <% else %>
      <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500">No project linked</span>
    <% end %>
    <span>Updated <%= local_time(chat_session.updated_at, format: :relative) %></span>
  </div>

  <% current_thinking_values = ChatSessions::ThinkingEffort.allowed_values(chat_session.model) %>
  <% current_thinking_effort = chat_session.metadata["thinking_effort"] %>
  <% if can_update_chat_session %>
    <% runner_model_options = ChatSessions::RunnerModelOptions.options_for(available_runners, projects: session_projects) %>
    <% selected_runner_model = runner_model_options.find { |option| option.runner_id == chat_session.runner_id && option.model_id == chat_session.model } %>
    <% runner_model_choices = runner_model_options.map { |option| [option.label, option.value] } %>
    <% runner_model_choices.unshift(["Choose a valid runner and model", ""]) unless selected_runner_model %>
    <% thinking_effort_capability_map = runner_model_options.index_by(&:value).transform_values { |option| ChatSessions::ThinkingEffort.allowed_values(option.model_id) } %>
    <%= form_with model: chat_session,
                  url: chat_session_path(chat_session),
                  method: :patch,
                  class: "space-y-2",
                  data: { action: "change->chat#submitForm blur->chat#submitTitleOnBlur" } do |form| %>
      <div>
        <%= form.label :title,
                       "Title",
                       for: "chat_session_title#{dom_id_suffix}",
                       class: "block text-xs font-medium uppercase tracking-wide text-gray-500" %>
        <%= form.text_field :title,
                            value: chat_session.title,
                            placeholder: "Untitled chat",
                            id: "chat_session_title#{dom_id_suffix}",
                            class: "mt-1 block w-full rounded-md border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
      </div>
    <% end %>
  <% else %>
    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Title</p>
      <p class="mt-1 text-sm text-gray-900"><%= chat_session_title(chat_session) %></p>
    </div>
  <% end %>

  <%# @spec CHAT-SESSION-PREFERENCES-002 CHAT-THINKING-EFFORT-002 %>
  <% if can_update_chat_session %>
    <%= form_with model: chat_session,
                  url: chat_session_path(chat_session),
                  method: :patch,
                  class: "space-y-3",
                  data: {
                    controller: "chat-thinking-effort",
                    action: "change->chat#saveSettings turbo:submit-end->chat#settingsSubmitted",
                    chat_thinking_effort_models_value: thinking_effort_capability_map.to_json,
                    chat_thinking_effort_default_label_value: ChatSessions::ThinkingEffort::DEFAULT_LABEL
                  } do |form| %>
      <div>
        <%= form.label :runner_model,
                       "Runner and model",
                       for: "chat_session_runner_model#{dom_id_suffix}",
                       class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :runner_model,
                        options_for_select(runner_model_choices, selected_runner_model&.value),
                        {},
                        id: "chat_session_runner_model#{dom_id_suffix}",
                        data: { chat_thinking_effort_target: "runnerModelSelect", action: "change->chat-thinking-effort#sync" },
                        class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
      </div>
      <%# @spec CHAT-THINKING-EFFORT-002 CHAT-THINKING-EFFORT-003 %>
      <%= tag.div data: { chat_thinking_effort_target: "field" }, hidden: !current_thinking_values.any? do %>
        <%= form.label :thinking_effort,
                       "Thinking effort",
                       for: "chat_session_thinking_effort#{dom_id_suffix}",
                       class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :thinking_effort,
                        options_for_select(
                          [[ChatSessions::ThinkingEffort::DEFAULT_LABEL, ""]] +
                            ChatSessions::ThinkingEffort.options_for(chat_session.model).map { |option| [option.label, option.value] },
                          current_thinking_effort
                        ),
                        {},
                        id: "chat_session_thinking_effort#{dom_id_suffix}",
                        data: { chat_thinking_effort_target: "select" },
                        class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">"Default" sends no reasoning-effort parameter; it does not select maximum effort.</p>
      <% end %>
      <p data-chat-settings-status role="status" class="text-sm text-gray-600"></p>
      <p data-chat-thinking-effort-target="status" role="status" class="text-sm text-gray-600"></p>
    <% end %>
  <% else %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg bg-gray-50 px-4 py-3">
        <p class="text-sm font-medium text-gray-500">Runner</p>
        <p class="mt-1 text-sm text-gray-900"><%= chat_session.runner&.display_name || "Default runner" %></p>
      </div>
      <div class="rounded-lg bg-gray-50 px-4 py-3">
        <p class="text-sm font-medium text-gray-500">Model</p>
        <p class="mt-1 text-sm text-gray-900"><%= chat_session.model.presence || "Automatic" %></p>
      </div>
      <%# @spec CHAT-THINKING-EFFORT-002 %>
      <% if current_thinking_values.any? %>
        <div class="rounded-lg bg-gray-50 px-4 py-3">
          <p class="text-sm font-medium text-gray-500">Thinking effort</p>
          <p class="mt-1 text-sm text-gray-900">
            <%= current_thinking_effort.present? ? ChatSessions::ThinkingEffort::LABELS.fetch(current_thinking_effort, current_thinking_effort.to_s.capitalize) : ChatSessions::ThinkingEffort::DEFAULT_LABEL %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center justify-between rounded-lg bg-gray-900 px-4 py-3 text-white">
    <div>
      <p class="text-xs font-medium text-gray-300">Token usage</p>
      <p class="mt-1 font-medium">
        <span data-chat-target="tokenUsage"><%= number_with_delimiter(chat_session.total_tokens) %></span>
        tokens
      </p>
    </div>
    <div class="flex items-center gap-2">
      <% if can_unarchive_chat_session %>
        <%= button_to "Unarchive",
                      unarchive_chat_session_path(chat_session),
                      method: :patch,
                      form: { data: { turbo_frame: "_top" } },
                      class: "inline-flex items-center rounded-md bg-emerald-400/15 px-3 py-2 text-xs font-semibold text-emerald-100 hover:bg-emerald-400/25" %>
      <% end %>
      <% if can_archive_chat_session %>
        <%= button_to "Archive",
                      archive_chat_session_path(chat_session),
                      method: :patch,
                      form: { data: { turbo_frame: "_top" } },
                      class: "inline-flex items-center rounded-md bg-amber-400/15 px-3 py-2 text-xs font-semibold text-amber-100 hover:bg-amber-400/25" %>
      <% end %>
    </div>
  </div>
</div>
