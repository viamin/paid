<% content_for(:title) { "Chat - Paid" } %>

<%= turbo_stream_from current_account, :chat_sessions %>

<div class="min-h-[calc(100vh-4rem)] bg-[radial-gradient(circle_at_top_left,_rgba(125,211,252,0.22),_transparent_32%),radial-gradient(circle_at_bottom_right,_rgba(253,224,71,0.18),_transparent_28%),linear-gradient(180deg,_#f8fafc_0%,_#e2e8f0_100%)]">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Interactive Chat</p>
        <h1 class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">Conversations</h1>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[22rem_minmax(0,1fr)]">
      <%= render "sidebar",
                 active_session: @chat_session,
                 sessions: @sessions,
                 sidebar_has_more: @sidebar_has_more,
                 sidebar_next_frame_id: @sidebar_next_frame_id,
                 sidebar_next_params: @sidebar_next_params,
                 chat_session: @new_chat_session,
                 available_providers: @available_providers,
                 available_projects: @available_projects,
                 available_models: @available_models %>

      <section class="overflow-hidden rounded-[2rem] border border-white/70 bg-white/60 shadow-[0_20px_70px_-32px_rgba(15,23,42,0.45)] backdrop-blur">
        <div class="flex min-h-[70vh] flex-col items-center justify-center px-6 py-16 text-center">
          <div class="max-w-xl">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">Start Here</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Open a conversation or create a new one</h2>
            <p class="mt-4 text-sm leading-6 text-slate-600">
              Sessions stream responses in real time, render markdown, and keep workspace context attached to the thread.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
