<% page_context = chat_session.page_context %>
<% archived_chat_session = chat_session.archived? %>
<% can_archive_chat_session = policy(chat_session).archive? && !archived_chat_session %>
<% can_unarchive_chat_session = policy(chat_session).unarchive? && archived_chat_session %>
<% can_create_chat_session = policy(ChatSession.new(account: current_account)).create? %>

<section class="flex h-full flex-col overflow-hidden rounded-[1.75rem] bg-white shadow-[0_32px_80px_-32px_rgba(15,23,42,0.45)] ring-1 ring-slate-200"
         data-controller="chat"
         data-chat-session-id-value="<%= chat_session.id %>">
  <header class="shrink-0 border-b border-slate-200 bg-[radial-gradient(circle_at_top,_rgba(99,102,241,0.12),_transparent_60%),linear-gradient(180deg,_#ffffff_0%,_#f8fafc_100%)] px-3.5 py-2.5">
    <div class="flex items-center gap-2">
      <h2 class="min-w-0 flex-1 truncate text-sm font-semibold text-slate-900" title="<%= chat_session_title(chat_session) %>"><%= chat_session_title(chat_session) %></h2>

      <p class="shrink-0 text-[11px] font-medium text-slate-400">
        <span data-chat-target="tokenUsage"><%= number_with_delimiter(chat_session.total_tokens) %></span>
        tokens
      </p>

      <details class="relative">
        <summary class="flex h-7 w-7 cursor-pointer list-none items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 [&::-webkit-details-marker]:hidden">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
          </svg>
          <span class="sr-only">Chat actions</span>
        </summary>
        <div class="absolute right-0 top-full z-10 mt-1 w-48 overflow-hidden rounded-lg bg-white py-1 shadow-lg ring-1 ring-slate-200">
          <% if can_create_chat_session %>
            <button type="button"
                    class="block w-full px-3 py-2 text-left text-xs font-medium text-slate-700 hover:bg-slate-50"
                    data-action="chat-popup#newChat">
              New Chat
            </button>
          <% end %>
          <% if can_create_chat_session && can_archive_chat_session %>
            <button type="button"
                    class="block w-full px-3 py-2 text-left text-xs font-medium text-slate-700 hover:bg-slate-50"
                    data-action="chat-popup#archiveAndNewChat">
              Archive &amp; New Chat
            </button>
          <% end %>
          <% if can_unarchive_chat_session %>
            <%= button_to "Unarchive",
                          unarchive_chat_session_path(chat_session),
                          method: :patch,
                          form: { "data-turbo-frame" => "_top" },
                          class: "block w-full px-3 py-2 text-left text-xs font-medium text-slate-700 hover:bg-slate-50" %>
          <% end %>
          <%= link_to "Open page",
                      chat_session_path(chat_session),
                      class: "block px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50" %>
        </div>
      </details>

      <button type="button"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
              data-action="chat-popup#close"
              aria-label="Close chat">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
      <%= chat_session_status_badge(chat_session) %>
      <%= chat_mode_badge(chat_session) %>
      <%= chat_container_status_badge(chat_session) %>
      <% if page_context["project_name"].present? %>
        <span class="inline-flex items-center rounded-full bg-slate-900 px-2 py-0.5 text-[11px] font-medium text-white"><%= page_context["project_name"] %></span>
      <% end %>
      <% if page_context["page_title"].present? %>
        <span class="inline-flex items-center rounded-full bg-white px-2 py-0.5 text-[11px] font-medium text-slate-600 ring-1 ring-slate-200"><%= page_context["page_title"] %></span>
      <% end %>
    </div>

    <%# Workspace / capability details — collapsed by default to keep the header
        compact. The summary is intentionally a static label: the live capability
        status is shown by the color-coded badge above (updated via
        chat_controller), and cloning/reopen details live in the expandable panel. %>
    <details class="group mt-2">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-medium text-slate-500 transition hover:text-slate-800 [&::-webkit-details-marker]:hidden">
        <svg class="h-3.5 w-3.5 text-slate-400 transition group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
        </svg>
        Workspace
      </summary>
      <div class="mt-2">
        <%= render "chat_sessions/capability_panel", chat_session: chat_session %>
      </div>
    </details>
  </header>

  <div class="min-h-0 flex-1 overflow-hidden">
    <%= render "conversation",
               chat_session:,
               chat_messages:,
               has_older_messages: %>
  </div>
</section>
