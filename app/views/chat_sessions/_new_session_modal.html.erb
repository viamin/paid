<dialog class="w-full max-w-2xl rounded-[2rem] border border-slate-200 p-0 shadow-2xl backdrop:bg-slate-900/50 dark:border-slate-600 dark:backdrop:bg-black/70"
        data-chat-session-list-target="modal">
  <div class="bg-white p-6 dark:bg-slate-800">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500 dark:text-slate-400">New Session</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">Start a chat</h2>
      </div>
      <button type="button"
              class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-700 dark:hover:text-slate-200"
              data-action="chat-session-list#closeModal">
        <span class="sr-only">Close</span>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 1 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </div>

    <%= form_with model: chat_session, url: chat_sessions_path, class: "mt-6 space-y-5" do |form| %>
      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <%= form.label :mode, class: "mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
          <%= form.select :mode,
                          options_for_select(ChatSession::MODES.map { |mode| [mode.titleize, mode] }, chat_session.mode),
                          {},
                          class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
        <div>
          <%= form.label :provider_id, "Provider", class: "mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
          <%= form.select :provider_id,
                          options_from_collection_for_select(available_providers, :id, :display_name),
                          { include_blank: "Default provider" },
                          class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
        <div>
          <%= form.label :model, class: "mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
          <%= form.select :model,
                          options_for_select(available_models.map { |model| ["#{model.display_name} (#{model.model_id})", model.model_id] }),
                          { include_blank: "Automatic" },
                          class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
        <div>
          <%= form.label :project_id, "Project", class: "mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
          <%= form.select :project_id,
                          options_from_collection_for_select(available_projects, :id, :name),
                          { include_blank: "No project" },
                          class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
      </div>

      <div>
        <%= form.label :title, class: "mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.text_field :title,
                            placeholder: "Planning assistant for onboarding flow",
                            class: "w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500" %>
      </div>

      <div>
        <%= form.label :system_prompt, "Custom system prompt", class: "mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-300" %>
        <%= form.text_area :system_prompt,
                           rows: 4,
                           placeholder: "Optional advanced instructions for the session…",
                           class: "w-full rounded-[1.5rem] border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-200 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 dark:placeholder:text-slate-500" %>
      </div>

      <div class="flex items-center justify-end gap-3">
        <button type="button"
                class="rounded-full px-4 py-2 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-100"
                data-action="chat-session-list#closeModal">
          Cancel
        </button>
        <%= form.submit "Create session",
                        class: "inline-flex items-center rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-sky-600 dark:hover:bg-sky-500" %>
      </div>
    <% end %>
  </div>
</dialog>
