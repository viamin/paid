<dialog class="w-full max-w-2xl rounded-lg border border-gray-200 p-0 shadow-2xl backdrop:bg-gray-900/50"
        data-chat-session-list-target="modal">
  <div class="bg-white p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Start a new chat</h2>
        <p class="mt-1 text-sm text-gray-500">Configure your chat session settings.</p>
      </div>
      <button type="button"
              class="rounded-md p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500"
              data-action="chat-session-list#closeModal">
        <span class="sr-only">Close</span>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 1 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </div>

    <%= form_with model: chat_session, url: chat_sessions_path, class: "mt-6 space-y-5" do |form| %>
      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <%= form.label :container_capability, "Session type", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :container_capability,
                          options_for_select([["Inline only", "none"], ["Container workspace", "pending"]], chat_session.container_capability),
                          {},
                          class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
        <div>
          <%= form.label :runner_id, "Runner", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :runner_id,
                          options_from_collection_for_select(available_runners, :id, :display_name),
                          { include_blank: "Default runner" },
                          class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
        <div>
          <%= form.label :model, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :model,
                          options_for_select(available_models.map { |model| ["#{model.display_name} (#{model.model_id})", model.model_id] }),
                          { include_blank: "Automatic" },
                          class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
        <div>
          <%= form.label :project_id, "Project", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :project_id,
                          options_from_collection_for_select(available_projects, :id, :name),
                          { include_blank: "No project" },
                          class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
      </div>

      <div>
        <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :title,
                            placeholder: "Planning assistant for onboarding flow",
                            class: "mt-1 block w-full rounded-md border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
      </div>

      <label class="flex items-center gap-2">
        <%= form.check_box :auto_approve,
              class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500",
              title: "Skip the approval prompt and run requested actions (like agent runs) automatically" %>
        <span class="text-sm font-medium text-gray-700">Auto-approve actions</span>
      </label>

      <div>
        <%= form.label :system_prompt, "Custom system prompt", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :system_prompt,
                           rows: 4,
                           placeholder: "Optional advanced instructions for the session...",
                           class: "mt-1 block w-full rounded-md border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
      </div>

      <div class="flex items-center justify-end gap-3">
        <button type="button"
                class="rounded-md px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
                data-action="chat-session-list#closeModal">
          Cancel
        </button>
        <%= form.submit "Create session",
                        class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</dialog>
