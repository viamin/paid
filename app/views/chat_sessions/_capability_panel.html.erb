<% snapshot = chat_session_capability_snapshot(chat_session) %>
<% can_manage_workspace = policy(chat_session).update? %>
<div class="rounded-lg border border-gray-200 bg-gray-50 p-4"
     data-chat-target="capabilityPanel"
     data-chat-capability="<%= snapshot[:container_capability] %>">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Workspace capability</p>
      <div class="mt-2 flex items-center gap-2">
        <svg class="h-4 w-4 <%= chat_container_capability_icon_classes(snapshot[:container_capability]) %>"
             data-chat-target="capabilityIcon"
             viewBox="0 0 20 20"
             aria-hidden="true">
          <circle cx="10" cy="10" r="8" />
        </svg>
        <p class="text-sm font-semibold text-gray-900" data-chat-target="capabilityLabel"><%= snapshot[:container_capability_label] %></p>
      </div>
    </div>

    <% if can_manage_workspace %>
      <%= button_to "Reopen with workspace",
                    reopen_chat_session_path(chat_session),
                    method: :patch,
                    class: "inline-flex items-center rounded-md bg-gray-900 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700",
                    form_class: (chat_session.container_stopped? ? nil : "hidden"),
                    form: { data: { chat_capability_stopped_only: true } } %>
    <% end %>
  </div>

  <% if can_manage_workspace %>
    <div class="mt-4 <%= "hidden" unless chat_session.container_ready? %>" data-chat-capability-ready-only="true">
      <%= form_with url: clone_project_chat_session_path(chat_session), method: :post, class: "flex flex-col gap-2 sm:flex-row sm:items-end" do |form| %>
        <div class="min-w-0 flex-1">
          <%= form.label :project_id, "Clone another project", class: "block text-xs font-medium text-gray-600" %>
          <%= form.select :project_id,
                          options_from_collection_for_select(policy_scope(Project).order(:name), :id, :name),
                          { include_blank: "Choose a project" },
                          class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>
        <%= form.submit "Clone into workspace",
                        class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-gray-300 hover:bg-gray-100" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4">
    <p class="text-xs font-medium text-gray-600">Cloned repos</p>
    <div class="mt-2 space-y-2" data-chat-target="capabilityRepos">
      <% if snapshot[:cloned_repos].any? %>
        <% snapshot[:cloned_repos].each do |repo| %>
          <div class="rounded-md bg-white px-3 py-2 text-sm text-gray-700 ring-1 ring-gray-200">
            <div class="flex items-center justify-between gap-2">
              <p class="font-medium text-gray-900"><%= repo[:project_full_name].presence || repo[:project_name] %></p>
              <% if repo[:stale] %>
                <span class="inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-[11px] font-medium text-rose-700">stale</span>
              <% end %>
            </div>
            <p class="mt-1 font-mono text-xs text-gray-500"><%= repo[:path] %></p>
            <p class="mt-1 text-xs text-gray-500">Clone identity: <%= repo[:token_identity].presence || "unknown" %></p>
            <% if repo[:stale_reason].present? %>
              <p class="mt-1 text-xs text-rose-600"><%= repo[:stale_reason].humanize %></p>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="rounded-md bg-white px-3 py-2 text-sm text-gray-500 ring-1 ring-gray-200" data-chat-target="capabilityReposEmpty">No repos cloned yet.</p>
      <% end %>
    </div>
  </div>
</div>
