<% snapshot = chat_session_capability_snapshot(chat_session) %>
<% can_manage_workspace = policy(chat_session).update? %>
<%# The show page renders this partial twice (mobile + desktop headers) in
    the same DOM at once, only one visible via CSS. dom_id_suffix keeps the
    clone-project select's id/label association unique per instance. %>
<% dom_id_suffix = local_assigns.fetch(:dom_id_suffix, "") %>
<%# Keep the open-by-default mobile workspace disclosure compact enough for
    CHAT-API-009's 18rem transcript floor. The wider header retains the
    roomier spacing from `sm` upward. %>
<div class="rounded-lg border border-gray-200 bg-gray-50 p-2 sm:p-4"
     data-chat-target="capabilityPanel"
     data-chat-capability="<%= snapshot[:container_capability] %>">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Workspace capability</p>
      <div class="mt-2 flex items-center gap-2">
        <svg class="h-4 w-4 <%= chat_container_capability_icon_classes(snapshot[:container_capability]) %>"
             data-chat-target="capabilityIcon"
             viewBox="0 0 20 20"
             aria-hidden="true">
          <circle cx="10" cy="10" r="8" />
        </svg>
        <p class="text-sm font-semibold text-gray-900" data-chat-target="capabilityLabel"><%= snapshot[:container_capability_label] %></p>
      </div>
    </div>

    <% if can_manage_workspace %>
      <%= button_to "Reopen with workspace",
                    reopen_chat_session_path(chat_session),
                    method: :patch,
                    class: "inline-flex items-center rounded-md bg-gray-900 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700",
                    form_class: (chat_session.container_stopped? ? nil : "hidden"),
                    form: { data: { chat_capability_stopped_only: true } } %>
    <% end %>
  </div>

  <%# A workspace itself stays open so its recovery action is immediately
      reachable. Its potentially tall configuration and clone list are a
      nested disclosure on mobile, however: keeping them open makes the
      390×844 chat panel lose the CHAT-API-009 18rem transcript floor. The
      desktop version is a normal block: forcing a closed <details> body
      visible at that breakpoint paints it without reserving its height. %>
  <details class="group/workspace-options mt-2 sm:hidden" data-chat-workspace-options>
    <summary class="cursor-pointer text-xs font-semibold text-gray-600 sm:hidden">Workspace options</summary>
    <div class="hidden group-open/workspace-options:block">
      <%= render "workspace_options", chat_session:, snapshot:, can_manage_workspace:, dom_id_suffix: "#{dom_id_suffix}_mobile_options" %>
    </div>
  </details>

  <div class="hidden sm:block" data-chat-workspace-options-desktop>
    <%= render "workspace_options", chat_session:, snapshot:, can_manage_workspace:, dom_id_suffix: "#{dom_id_suffix}_desktop_options" %>
  </div>
</div>
