<% session_title = chat_session_title(chat_session) %>
<% session_preview = chat_session_preview(chat_session) %>

<%= link_to chat_session_path(chat_session),
            id: dom_id(chat_session),
            class: "chat-session-card block rounded-[1.5rem] border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-md",
            data: {
              chat_session_list_target: "card",
              session_id: chat_session.id,
              search_text: "#{session_title} #{session_preview} #{chat_session.project&.name} #{chat_session.provider&.display_name} #{chat_session.model}".downcase
            } do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-semibold text-slate-900"><%= session_title %></p>
      <p class="mt-1 truncate text-xs text-slate-500"><%= session_preview %></p>
    </div>
    <%= chat_session_status_badge(chat_session) %>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <%= chat_mode_badge(chat_session.mode) %>
    <% if chat_session.model.present? %>
      <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600"><%= chat_session.model %></span>
    <% end %>
    <% if chat_session.project.present? %>
      <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-700"><%= chat_session.project.name %></span>
    <% end %>
  </div>

  <div class="mt-3 flex items-center justify-between text-xs text-slate-400">
    <span><%= chat_session.provider&.display_name || "Default provider" %></span>
    <span><%= local_time(chat_session.updated_at, format: :relative) %></span>
  </div>
<% end %>
