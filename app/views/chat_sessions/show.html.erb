<% content_for(:title) { "#{chat_session_title(@chat_session)} - Chat - Paid" } %>
<% archived_chat_session = @chat_session.archived? %>
<% can_update_chat_session = policy(@chat_session).update? && !archived_chat_session %>
<% can_archive_chat_session = policy(@chat_session).archive? && !archived_chat_session %>
<% can_unarchive_chat_session = policy(@chat_session).unarchive? && archived_chat_session %>

<%= turbo_stream_from current_account, :chat_sessions %>

<div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8 lg:py-8">
  <div class="grid gap-4 lg:grid-cols-[22rem_minmax(0,1fr)] lg:gap-6">
    <%= render "sidebar",
               active_session: @chat_session,
               sessions: @sessions,
               sidebar_has_more: @sidebar_has_more,
               sidebar_next_frame_id: @sidebar_next_frame_id,
               sidebar_next_params: @sidebar_next_params,
               archived_view: @archived_view,
               chat_session: @new_chat_session,
               available_runners: @available_runners,
               available_projects: @available_projects,
               available_models: @available_models %>

    <section class="overflow-hidden rounded-lg bg-white shadow">
      <%# The viewport bound is applied from the controller with a measured
          `--chat-panel-offset-top` variable instead of a fixed subtraction
          so layout chrome above `<main>` (notably notice/alert flashes)
          still leaves the conversation pane as the real scroll container.
          The remaining `2rem` subtraction preserves this page's bottom
          `py-8` padding. dvh (not vh) so the iOS Safari URL bar doesn't
          shrink the available space.

          This must be a definite `height`, never a `max-height`, and must
          carry no `min-h` floor. A `max-height` leaves the panel's own
          height `auto` — indefinite — so percentage heights below it do not
          resolve: the shared conversation partial's `h-full` root falls
          back to its natural content height, overflows the
          `min-h-0 flex-1 overflow-hidden` wrapper below, and the transcript
          is clipped mid-conversation with the input unreachable and nothing
          scrollable. A `min-height` is equally wrong here: against a height
          already fitted to the viewport it can only clamp the panel taller
          than the viewport, which is the document-scroll failure this bound
          exists to prevent.
          (@spec CHAT-API-008, #3459, #3575) %>
      <div class="flex flex-col overflow-x-hidden"
           data-controller="chat"
           data-chat-session-id-value="<%= @chat_session.id %>"
           style="height: calc(100dvh - var(--chat-panel-offset-top, 0px) - 2rem);">
        <%# The panel is viewport-bound, so header growth comes straight out
            of the transcript. Below `xl`, swap to a compact header so
            runner/model/workspace controls stay reachable without consuming
            most of the panel. At `xl` and up, keep the richer header but cap
            it to a share of the panel and let it scroll internally;
            `overflow-y-auto` also zeroes its automatic minimum size so it can
            shrink when the panel is short, and `overflow-x-hidden` keeps that
            from computing the x axis to `auto` and hanging a horizontal
            scrollbar off the header. The cap relaxes while the workspace
            disclosure is open: clipping content the user just chose to expand
            is worse than a temporarily shorter transcript, and they can
            collapse it again to reclaim the space. (@spec CHAT-API-009) %>
        <header class="shrink-0 border-b border-gray-200 px-4 py-4 xl:hidden">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h1 class="truncate text-base font-semibold text-gray-900" title="<%= chat_session_title(@chat_session) %>"><%= chat_session_title(@chat_session) %></h1>
              <p class="mt-1 text-xs text-gray-500">Updated <%= local_time(@chat_session.updated_at, format: :relative) %></p>
            </div>

            <div class="shrink-0 rounded-lg bg-gray-900 px-3 py-2 text-right text-white">
              <p class="text-[11px] font-medium text-gray-300">Tokens</p>
              <p class="mt-1 text-sm font-semibold">
                <span data-chat-target="tokenUsage"><%= number_with_delimiter(@chat_session.total_tokens) %></span>
              </p>
            </div>
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            <%= chat_session_status_badge(@chat_session) %>
            <%= chat_mode_badge(@chat_session) %>
            <%= chat_container_status_badge(@chat_session) %>
            <% session_projects = chat_session_projects(@chat_session) %>
            <% if session_projects.any? %>
              <% session_projects.each do |project| %>
                <%= link_to project.name,
                            project_path(project),
                            class: "inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-200 hover:text-gray-900" %>
              <% end %>
            <% else %>
              <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500">No project linked</span>
            <% end %>
          </div>

          <details class="group mt-3 rounded-lg border border-gray-200 bg-gray-50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-gray-700 transition hover:text-gray-900 [&::-webkit-details-marker]:hidden">
              <span>Session details</span>
              <svg class="h-4 w-4 text-gray-400 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
              </svg>
            </summary>
            <div class="space-y-3 px-4 pb-4">
              <% if can_update_chat_session %>
                <%= form_with model: @chat_session,
                              url: chat_session_path(@chat_session),
                              method: :patch,
                              class: "space-y-3",
                              data: { action: "change->chat#submitForm blur->chat#submitTitleOnBlur" } do |form| %>
                  <div>
                    <%= form.label :title, "Title", for: "chat_session_title_mobile", class: "block text-xs font-medium uppercase tracking-wide text-gray-500" %>
                    <%= form.text_field :title,
                                        value: @chat_session.title,
                                        placeholder: "Untitled chat",
                                        id: "chat_session_title_mobile",
                                        class: "mt-1 block w-full rounded-md border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
                  </div>

                  <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                      <%= form.label :runner_id, "Runner", for: "chat_session_runner_id_mobile", class: "block text-sm font-medium text-gray-700" %>
                      <%= form.select :runner_id,
                                      options_from_collection_for_select(@available_runners, :id, :display_name, @chat_session.runner_id),
                                      { include_blank: "Default runner" },
                                      id: "chat_session_runner_id_mobile",
                                      class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
                    </div>
                    <div>
                      <%= form.label :model, "Model", for: "chat_session_model_mobile", class: "block text-sm font-medium text-gray-700" %>
                      <%= form.select :model,
                                      options_for_select(@available_models.map { |model| ["#{model.display_name} (#{model.model_id})", model.model_id] }, @chat_session.model),
                                      { include_blank: "Automatic" },
                                      id: "chat_session_model_mobile",
                                      class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div class="rounded-lg bg-white px-4 py-3 ring-1 ring-gray-200">
                    <p class="text-sm font-medium text-gray-500">Runner</p>
                    <p class="mt-1 text-sm text-gray-900"><%= @chat_session.runner&.display_name || "Default runner" %></p>
                  </div>
                  <div class="rounded-lg bg-white px-4 py-3 ring-1 ring-gray-200">
                    <p class="text-sm font-medium text-gray-500">Model</p>
                    <p class="mt-1 text-sm text-gray-900"><%= @chat_session.model.presence || "Automatic" %></p>
                  </div>
                </div>
              <% end %>

              <div class="flex items-center gap-2">
                <% if can_unarchive_chat_session %>
                  <%= button_to "Unarchive",
                                unarchive_chat_session_path(@chat_session),
                                method: :patch,
                                class: "inline-flex items-center rounded-md bg-emerald-50 px-3 py-2 text-xs font-semibold text-emerald-700 hover:bg-emerald-100" %>
                <% end %>
                <% if can_archive_chat_session %>
                  <%= button_to "Archive",
                                archive_chat_session_path(@chat_session),
                                method: :patch,
                                class: "inline-flex items-center rounded-md bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-100" %>
                <% end %>
              </div>
            </div>
          </details>

          <%= tag.details class: "group mt-2 rounded-lg border border-gray-200 bg-gray-50" do %>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-gray-700 transition hover:text-gray-900 [&::-webkit-details-marker]:hidden">
              <span>Workspace</span>
              <svg class="h-4 w-4 text-gray-400 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-2 pb-2">
              <%= render "capability_panel", chat_session: @chat_session, dom_id_suffix: "_mobile" %>
            </div>
          <% end %>
        </header>

        <header class="hidden max-h-[45%] overflow-y-auto overflow-x-hidden border-b border-gray-200 px-4 py-5 sm:px-6 has-[details[open]]:max-h-[75%] xl:block">
          <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
            <div class="min-w-0 flex-1 overflow-hidden">
              <% session_projects = chat_session_projects(@chat_session) %>
              <% if can_update_chat_session %>
                <%= form_with model: @chat_session,
                              url: chat_session_path(@chat_session),
                              method: :patch,
                              class: "flex flex-col gap-3 lg:flex-row lg:items-center",
                              data: { action: "change->chat#submitForm blur->chat#submitTitleOnBlur" } do |form| %>
                  <%= form.text_field :title,
                                      value: @chat_session.title,
                                      placeholder: "Untitled chat",
                                      class: "w-full rounded-md border-gray-300 px-3 py-2 text-lg font-semibold text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 lg:max-w-md" %>
                  <div class="flex flex-wrap items-center gap-2">
                    <%= chat_session_status_badge(@chat_session) %>
                    <%= chat_mode_badge(@chat_session) %>
                    <%= chat_container_status_badge(@chat_session) %>
                  </div>
                <% end %>
              <% else %>
                <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
                  <h1 class="text-lg font-semibold text-gray-900 lg:max-w-md"><%= chat_session_title(@chat_session) %></h1>
                  <div class="flex flex-wrap items-center gap-2">
                    <%= chat_session_status_badge(@chat_session) %>
                    <%= chat_mode_badge(@chat_session) %>
                    <%= chat_container_status_badge(@chat_session) %>
                  </div>
                </div>
              <% end %>
              <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-gray-500">
                <% if session_projects.any? %>
                  <% session_projects.each do |project| %>
                    <%= link_to project.name,
                                project_path(project),
                                class: "inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 hover:bg-gray-200 hover:text-gray-900" %>
                  <% end %>
                <% else %>
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500">No project linked</span>
                <% end %>
                <span>Updated <%= local_time(@chat_session.updated_at, format: :relative) %></span>
              </div>
            </div>

            <div class="flex flex-col gap-3 xl:min-w-[18rem]">
              <% if can_update_chat_session %>
                <%= form_with model: @chat_session,
                              url: chat_session_path(@chat_session),
                              method: :patch,
                              class: "grid gap-3 md:grid-cols-2 xl:grid-cols-1",
                              data: { action: "change->chat#submitForm" } do |form| %>
                  <div>
                    <%= form.label :runner_id, "Runner", class: "block text-sm font-medium text-gray-700" %>
                    <%= form.select :runner_id,
                                    options_from_collection_for_select(@available_runners, :id, :display_name, @chat_session.runner_id),
                                    { include_blank: "Default runner" },
                                    class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
                  </div>
                  <div>
                    <%= form.label :model, "Model", class: "block text-sm font-medium text-gray-700" %>
                    <%= form.select :model,
                                    options_for_select(@available_models.map { |model| ["#{model.display_name} (#{model.model_id})", model.model_id] }, @chat_session.model),
                                    { include_blank: "Automatic" },
                                    class: "mt-1 block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
                  </div>
                <% end %>
              <% else %>
                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-1">
                  <div class="rounded-lg bg-gray-50 px-4 py-3">
                    <p class="text-sm font-medium text-gray-500">Runner</p>
                    <p class="mt-1 text-sm text-gray-900"><%= @chat_session.runner&.display_name || "Default runner" %></p>
                  </div>
                  <div class="rounded-lg bg-gray-50 px-4 py-3">
                    <p class="text-sm font-medium text-gray-500">Model</p>
                    <p class="mt-1 text-sm text-gray-900"><%= @chat_session.model.presence || "Automatic" %></p>
                  </div>
                </div>
              <% end %>

              <div class="flex items-center justify-between rounded-lg bg-gray-900 px-4 py-3 text-sm text-white">
                <div>
                  <p class="text-xs font-medium text-gray-300">Token usage</p>
                  <p class="mt-1 font-medium">
                    <span data-chat-target="tokenUsage"><%= number_with_delimiter(@chat_session.total_tokens) %></span>
                    tokens
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <% if can_unarchive_chat_session %>
                    <%= button_to "Unarchive",
                                  unarchive_chat_session_path(@chat_session),
                                  method: :patch,
                                  class: "inline-flex items-center rounded-md bg-emerald-400/15 px-3 py-2 text-xs font-semibold text-emerald-100 hover:bg-emerald-400/25" %>
                  <% end %>
                  <% if can_archive_chat_session %>
                    <%= button_to "Archive",
                                  archive_chat_session_path(@chat_session),
                                  method: :patch,
                                  class: "inline-flex items-center rounded-md bg-amber-400/15 px-3 py-2 text-xs font-semibold text-amber-100 hover:bg-amber-400/25" %>
                  <% end %>
                </div>
              </div>

              <%# Collapsed for inline-only chats: the capability panel's
                  cloned-repo list grows without bound, and inside a
                  viewport-bound panel an unbounded header starves the
                  transcript. Sessions that actually have a workspace render it
                  open, because the panel then holds the only controls for that
                  workspace — "Reopen with workspace" is a stopped chat's sole
                  recovery path, and folding it away leaves the chat looking
                  unrecoverable. Open by default (not on click) so it works
                  before, and without, JavaScript. (@spec CHAT-API-009) %>
              <%= tag.details class: "group rounded-lg border border-gray-200 bg-gray-50",
                              open: !@chat_session.inline_only? do %>
                <summary class="flex cursor-pointer list-none items-center gap-1.5 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-gray-500 transition hover:text-gray-800 [&::-webkit-details-marker]:hidden">
                  <svg class="h-3.5 w-3.5 text-gray-400 transition group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
                  </svg>
                  Workspace
                </summary>
                <div class="px-2 pb-2">
                  <%= render "capability_panel", chat_session: @chat_session %>
                </div>
              <% end %>
            </div>
          </div>
        </header>

        <div class="min-h-0 flex-1 overflow-hidden px-4 pb-4 pt-5 sm:px-6">
          <%= render "conversation",
                     chat_session: @chat_session,
                     chat_messages: @chat_messages,
                     has_older_messages: @has_older_messages %>
        </div>
      </div>
    </section>
  </div>
</div>
