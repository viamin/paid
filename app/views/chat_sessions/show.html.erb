<% content_for(:title) { "#{chat_session_title(@chat_session)} - Chat - Paid" } %>
<% archived_chat_session = @chat_session.archived? %>
<% can_update_chat_session = policy(@chat_session).update? && !archived_chat_session %>
<% can_archive_chat_session = policy(@chat_session).archive? && !archived_chat_session %>
<% can_unarchive_chat_session = policy(@chat_session).unarchive? && archived_chat_session %>

<%= turbo_stream_from current_account, :chat_sessions %>

<%# @spec CHAT-API-008 @spec CHAT-API-009 @spec LIST-DETAIL-001
    The page chrome (max-w-7xl + responsive padding) stays feature-specific —
    it carries the chat show page's no-bottom-padding mobile rule so the
    viewport-bound panel runs edge-to-edge on small screens. The two-pane
    shell below it is shared with Inbox. %>
<div class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-8 lg:py-8">
  <%= render "shared/list_detail_shell",
             list: render("sidebar",
                          active_session: @chat_session,
                          sessions: @sessions,
                          sidebar_has_more: @sidebar_has_more,
                          sidebar_next_frame_id: @sidebar_next_frame_id,
                          sidebar_next_params: @sidebar_next_params,
                          archived_view: @archived_view,
                          chat_session: @new_chat_session,
                          available_runners: @available_runners,
                          available_projects: @available_projects,
                          available_models: @available_models),
             detail: render("chat_panel",
                            chat_session: @chat_session,
                            chat_messages: @chat_messages,
                            has_older_messages: @has_older_messages,
                            can_update_chat_session: can_update_chat_session,
                            can_archive_chat_session: can_archive_chat_session,
                            can_unarchive_chat_session: can_unarchive_chat_session,
                            available_runners: @available_runners,
                            available_projects: @available_projects,
                            available_models: @available_models),
             list_dom_id: "chat-list",
             detail_dom_id: "chat-detail" %>
</div>
