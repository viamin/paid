<% content_for(:title) { "Inbox - Paid" } %>

<%# @spec OPERATOR-INBOX-003 @spec LIST-DETAIL-001 @spec LIST-DETAIL-005 %>
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
     data-controller="inbox-master-detail"
     data-inbox-master-detail-detail-open-value="<%= @detail_view %>">
  <div class="mb-6 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Inbox</h1>
      <p class="mt-1 text-sm text-gray-500">
        <% if @scoped_project %>
          Human-actionable work waiting in <strong><%= @scoped_project.full_name %></strong>.
        <% else %>
          Human-actionable work across your accessible projects.
        <% end %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <% [
        [ "All", nil ],
        [ "Clarifying Questions", Inbox::Queue::CLARIFYING_QUESTIONS_KIND ],
        [ "Plan Reviews", Inbox::Queue::PLAN_REVIEW_KIND ],
        [ "Merge Approvals", Inbox::Queue::MERGE_APPROVAL_KIND ],
        [ "Action Required", Inbox::Queue::ACTION_REQUIRED_KIND ],
        [ "Blocked PRs", Inbox::Queue::ESCALATED_PR_KIND ],
        [ "Manual Review", Inbox::Queue::MANUAL_REVIEW_KIND ],
        [ "Feature Decision", Inbox::Queue::FEATURE_DECISION_KIND ],
        [ "Retry-limited", Inbox::Queue::RETRY_LIMITED_KIND ]
      ].each do |label, kind| %>
        <% active = @selected_kind == kind || (@selected_kind.nil? && kind.nil?) %>
        <%= link_to label,
              inbox_path(**inbox_query_params(project: @scoped_project, kind: kind)),
              class: [
                "rounded-full px-3 py-1.5 text-sm font-medium",
                active ? "bg-indigo-600 text-white" : "bg-white text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
              ].join(" ") %>
      <% end %>
    </div>
  </div>

  <% if @inbox_entries.empty? %>
    <%= render "shared/list_detail_empty_state",
               title: "Inbox clear",
               body: "Paid does not currently have any clarifying-question, plan-review, merge-approval, action-required, blocked-PR, manual-review, feature-decision, or retry-limited items waiting here." %>
  <%# Split-pane activates at Tailwind's `lg` breakpoint (≥1024px) instead of
      the `md` (≥768px) called out in #3506: the answer form renders multi-row
      textareas and a sticky submit, so the 22rem list + flexible detail grid
      needs the wider viewport to avoid cramping the textareas into a
      sub-300px column. Below `lg` the master-detail Stimulus controller takes
      over and stacks the panes. (@spec OPERATOR-INBOX-003 @spec LIST-DETAIL-001) %>
  <% else %>
    <% detail_content = capture do %>
      <%= turbo_frame_tag("inbox-detail") do %>
        <%= render "dashboard/inbox_detail",
                   entry: @selected_entry,
                   scoped_project: @scoped_project,
                   selected_kind: @selected_kind %>
      <% end %>
    <% end %>
    <%= render "shared/list_detail_shell",
               list: render("dashboard/inbox_list",
                            entries: @inbox_entries,
                            selected_entry: @selected_entry,
                            scoped_project: @scoped_project,
                            selected_kind: @selected_kind),
               detail: detail_content,
               list_dom_id: "inbox-list",
               detail_dom_id: "inbox-detail-pane",
               list_data: { "inbox-master-detail-target" => "list" },
               detail_data: { "inbox-master-detail-target" => "detailSection" },
               list_classes: @detail_view ? "hidden lg:block" : "block",
               detail_classes: @detail_view ? "block" : "hidden lg:block" %>
  <% end %>
</div>
