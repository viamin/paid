<% content_for(:title) { "Inbox - Paid" } %>
<%# The collection route renders its first detail asynchronously. Do not cache a
    later row selection under that collection URL: browser Back must request the
    collection again so its canonical first selection and detail stay aligned.
    @spec OPERATOR-INBOX-026 %>
<% turbo_exempts_page_from_cache %>
<%# @spec OPERATOR-INBOX-015 %>
<% turbo_page_requires_reload if turbo_frame_request_id == "inbox-detail" %>
<%# @spec OPERATOR-INBOX-026
    A row selection advances the URL after replacing the detail frame. Exempt
    the collection page from Turbo's snapshot cache so browser Back reloads
    its canonical first selection instead of restoring the later frame body. %>
<% turbo_exempts_page_from_cache if action_name == "index" %>

<%# @spec OPERATOR-INBOX-003 @spec LIST-DETAIL-001 @spec LIST-DETAIL-005 @spec INBOX-FOUNDATION-009 %>
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
     data-controller="inbox-master-detail"
     data-inbox-collection-path="<%= inbox_path %>"
     data-inbox-master-detail-detail-open-value="<%= @detail_view %>">
  <div class="mb-6 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900">Inbox</h1>
      <p class="mt-1 text-sm text-gray-500">
        <% if @scoped_projects.any? %>
          Human-actionable work waiting in <strong><%= @scoped_projects.map(&:full_name).join(", ") %></strong>.
        <% else %>
          Human-actionable work across your accessible projects.
        <% end %>
      </p>
    </div>

    <div class="relative shrink-0" data-controller="inbox-filters">
      <button type="button"
              class="flex max-w-[55vw] items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
              data-inbox-filters-target="trigger"
              data-action="inbox-filters#open"
              aria-haspopup="dialog">
        <span>Filters</span>
        <% @selected_kinds.each do |kind| %><span class="truncate rounded-full bg-indigo-50 px-2 py-0.5 text-indigo-700"><%= Inbox::Queue::KIND_LABELS.fetch(kind) %></span><% end %>
        <% @scoped_projects.each do |project| %><span class="truncate rounded-full bg-indigo-50 px-2 py-0.5 text-indigo-700"><%= project.full_name %></span><% end %>
        <% if @selected_sort != Inbox::Queue::DEFAULT_SORT %><span class="whitespace-nowrap rounded-full bg-indigo-50 px-2 py-0.5 text-indigo-700"><%= Inbox::Queue::SORTS.fetch(@selected_sort) %></span><% end %>
      </button>

      <dialog class="m-0 h-dvh w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-gray-900/50 lg:absolute lg:right-0 lg:top-0 lg:h-auto lg:w-[28rem] lg:max-w-[calc(100vw-2rem)]"
              aria-label="Inbox filters"
              data-inbox-filters-target="dialog"
              data-action="close->inbox-filters#closed cancel->inbox-filters#cancel">
        <div class="flex h-full flex-col bg-white p-6 shadow-2xl lg:h-auto lg:rounded-xl" data-action="keydown.esc->inbox-filters#close">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">Filters and sort</h2>
            <button type="button" class="rounded p-2 text-gray-500 hover:bg-gray-100" data-action="inbox-filters#close" aria-label="Close filters">×</button>
          </div>
          <%= form_with url: inbox_path, method: :get, class: "flex flex-1 flex-col gap-6", data: { action: "submit->inbox-filters#apply" } do %>
            <fieldset>
              <legend class="text-sm font-semibold text-gray-900">Search</legend>
              <%= search_field_tag "q[text_cont]", @inbox_search[Inbox::Query::TEXT_PREDICATE], placeholder: "Project, repository, title, or summary", class: "mt-2 w-full rounded-md border-gray-300 text-sm shadow-sm" %>
            </fieldset>
            <fieldset>
              <legend class="text-sm font-semibold text-gray-900">Type</legend>
              <div class="mt-2 grid gap-2">
                <% @inbox_availability.available_kinds.each do |kind| %>
                  <% label = Inbox::Queue::KIND_LABELS.fetch(kind) %>
                  <label class="flex items-center gap-2 text-sm text-gray-700"
                         data-inbox-filters-target="kindOption"
                         data-project-ids="<%= @inbox_availability.project_ids_for(kind).join(",") %>">
                    <%= check_box_tag "kinds[]", kind, @selected_kinds.include?(kind) %> <%= label %> (<%= @inbox_availability.kind_counts[kind] %>)
                  </label>
                <% end %>
              </div>
            </fieldset>
            <fieldset>
              <legend class="text-sm font-semibold text-gray-900">Project</legend>
              <div class="mt-2 max-h-44 space-y-2 overflow-y-auto">
                <% @inbox_projects.each do |project| %>
                  <label class="flex items-center gap-2 text-sm text-gray-700"
                         data-inbox-filters-target="projectOption"
                         data-project-name="<%= project.full_name.downcase %>"
                         data-kind-ids="<%= @inbox_availability.kinds_for(project).join(",") %>">
                    <%= check_box_tag "project_ids[]", project.id, @scoped_projects.include?(project) %> <%= project.full_name %> (<%= @inbox_availability.project_counts[project.id] %>)
                  </label>
                <% end %>
              </div>
            </fieldset>
            <fieldset>
              <legend class="text-sm font-semibold text-gray-900">Sort</legend>
              <div class="mt-2 grid gap-2" role="radiogroup">
                <% Inbox::Queue::SORTS.each do |sort, label| %>
                  <label class="flex items-center gap-2 text-sm text-gray-700"><%= radio_button_tag :sort, sort, @selected_sort == sort %> <%= label %></label>
                <% end %>
              </div>
            </fieldset>
            <div class="mt-auto flex items-center justify-between gap-4">
              <%= link_to "Clear all", inbox_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
              <%= submit_tag "Apply filters", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
            </div>
          <% end %>
        </div>
      </dialog>
    </div>
  </div>

  <%# @spec INBOX-PHASE-RELEVANCE-002 @spec INBOX-PHASE-RELEVANCE-006 %>
  <% scope_labels = { "actionable" => "Inbox", "disabled_phases" => "Disabled phases", "removed" => "Removed" } %>
  <div class="mb-4 flex flex-wrap items-center gap-3 text-sm">
    <% scope_labels.each do |scope, label| %>
      <% next if scope == @selected_scope %>
      <%= link_to label,
            inbox_path(request.query_parameters.except("scope").merge(scope: scope == "actionable" ? nil : scope)),
            class: "rounded-full bg-white px-3 py-1 font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    <% end %>
    <span class="rounded-full bg-indigo-50 px-3 py-1 font-medium text-indigo-700">
      <%= scope_labels.fetch(@selected_scope) %>
    </span>
  </div>

  <% if @inbox_entries.empty? %>
    <%= render "shared/list_detail_empty_state",
               title: "Inbox clear",
               body: "Paid does not currently have any human-actionable work waiting in your accessible projects." %>
  <%# Split-pane activates at Tailwind's `lg` breakpoint (≥1024px) instead of
      the `md` (≥768px) called out in #3506: the answer form renders multi-row
      textareas and a sticky submit, so the 22rem list + flexible detail grid
      needs the wider viewport to avoid cramping the textareas into a
      sub-300px column. Below `lg` the master-detail Stimulus controller takes
      over and stacks the panes. (@spec OPERATOR-INBOX-003 @spec LIST-DETAIL-001) %>
  <% else %>
    <%# @spec QUESTION-EXPLORATION-015 @spec LIST-DETAIL-007
        `<turbo-frame>` has no app- or gem-level CSS rule, so it defaults to
        `display: inline` per the HTML spec and its height is content-based.
        The "Answer in chat" embedded flow renders the chat panel inside this
        frame, and the panel's inline `height: 100%` then resolves to `auto`
        at `lg`+ — dropping the panel to content height and turning the
        shared list-detail shell's `lg:overflow-y-auto` inner wrapper into a
        second scroll container in front of the transcript (#4374 review).
        `block` overrides the default `display: inline` and `h-full` carries
        the wrapper's definite height through the frame so the chat panel
        can resolve `100%` against the shared grid track. Below `lg` the
        wrapper is naturally sized and `h-full` resolves to `auto` (content
        height), so the panel's mobile `calc(100dvh - ...)` fallback still
        drives its viewport bound and the mobile single-column flow is
        unaffected. %>
    <% detail_content = capture do %>
      <% if action_name == "index" %>
        <%# @spec OPERATOR-INBOX-025 %>
        <%= turbo_frame_tag("inbox-detail",
              src: inbox_entry_path(@selected_entry, **inbox_query_params(project: @scoped_project, kind: @selected_kind)),
              loading: :eager, class: "block h-full") do %>
          <p class="px-4 py-5 text-sm text-gray-500" data-inbox-detail-placeholder role="status">Loading item…</p>
        <% end %>
      <% else %>
        <%= turbo_frame_tag("inbox-detail", class: "block h-full") do %>
          <%= render "dashboard/inbox_detail",
                     entry: @selected_entry,
                     scoped_project: @scoped_project,
                     selected_kind: @selected_kind,
                     selected_scope: @selected_scope,
                     root_prerequisite_ranking: @root_prerequisite_ranking %>
        <% end %>
      <% end %>
    <% end %>
    <%= render "shared/list_detail_shell",
               list: render("dashboard/inbox_list",
                            entries: @inbox_entries,
                            selected_entry: @selected_entry,
                            scoped_project: @scoped_project,
                            selected_kind: @selected_kind),
               detail: detail_content,
               list_dom_id: "inbox-list",
               detail_dom_id: "inbox-detail-pane",
               list_data: { "inbox-master-detail-target" => "list" },
               detail_data: { "inbox-master-detail-target" => "detailSection" },
               list_classes: @detail_view ? "hidden lg:block" : "block",
               detail_classes: @detail_view ? "block" : "hidden lg:block" %>
  <% end %>
</div>
