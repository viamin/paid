<%# @spec OPERATOR-INBOX-017 @spec OPERATOR-INBOX-011 %>
<% if entry&.clarifying_questions? && entry.context_markdown.present? %>
  <details open
           class="group rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 lg:max-h-[calc(100vh-2rem)] lg:overflow-y-auto"
           data-testid="inbox-clarifying-context">
    <summary class="flex cursor-pointer items-center justify-between gap-2 text-sm font-semibold text-gray-900 lg:cursor-default">
      <span>Context from Paid's analysis</span>
      <svg class="h-4 w-4 text-gray-500 transition-transform group-open:rotate-180 lg:hidden"
           xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </summary>
    <div class="mt-2 lg:mt-3">
      <%= render "shared/markdown_text", content: entry.context_markdown,
            tag: :div, block: true, class: "prose prose-sm max-w-none text-gray-700" %>
    </div>
  </details>
<% elsif entry&.manual_review? && entry.manual_review_comment_url.present? %>
  <%= link_to "View enhancement comment", entry.manual_review_comment_url,
        target: "_blank", rel: "noopener noreferrer",
        class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
<% end %>
