<% is_api_key = runner.api_key? %>
<% is_new = !runner.persisted? %>
<% selectable_runner = runner.persisted? || subscription_runner_options.any? || api_key_runner_options.any? %>
<% feature_flagged_model_form_runner_keys = %w[opencode kilocode pi omp] %>
<% feature_flagged_model_form = runner_model_policy_form_enabled && feature_flagged_model_form_runner_keys.include?(runner.runner_key.to_s) %>
<% submitted_runner_params = params[:runner].respond_to?(:to_unsafe_h) ? params[:runner].to_unsafe_h : {} %>
<% submitted_model_selection_choice =
     if submitted_runner_params.key?("model_selection_choice") || submitted_runner_params.key?(:model_selection_choice)
       submitted_runner_params["model_selection_choice"] || submitted_runner_params[:model_selection_choice]
     end %>
<% submitted_custom_model_id =
     if submitted_runner_params.key?("custom_model_id") || submitted_runner_params.key?(:custom_model_id)
       submitted_runner_params["custom_model_id"] || submitted_runner_params[:custom_model_id]
     end %>
<% initial_api_service_type = runner.provider_api_key&.api_service_type %>
<% initial_model_options = if feature_flagged_model_form && initial_api_service_type.present?
     Runners::ModelOptions.call(runner_key: runner.runner_key, api_service_type: initial_api_service_type).options
   else
     []
   end %>
<% initial_model_values = initial_model_options.map { |option| option[:value] } %>
<% direct_outbound_model_id = runner.direct_outbound_model_id.to_s.presence %>
<% selected_model_choice = if submitted_model_selection_choice.present?
     submitted_model_selection_choice
   elsif runner.opencode_model_policy == "free"
     Runners::ModelOptions::FREE_POLICY_OPTION
   elsif direct_outbound_model_id.present? && initial_model_values.include?(direct_outbound_model_id)
     direct_outbound_model_id
   elsif direct_outbound_model_id.present?
     LlmModel::CUSTOM_MODEL_OPTION
   else
     ""
   end %>
<% custom_model_id = if selected_model_choice == LlmModel::CUSTOM_MODEL_OPTION
     submitted_custom_model_id.nil? ? direct_outbound_model_id.to_s : submitted_custom_model_id.to_s
   else
     ""
   end %>

<%= form_with model: runner,
    class: "space-y-6",
    data: {
      controller: "runner-form",
      runner_form_auth_type_value: runner.auth_type,
      runner_form_model_policy_form_enabled_value: runner_model_policy_form_enabled,
      runner_form_model_options_value: runner_model_options_map_json,
      runner_form_initial_api_service_type_value: initial_api_service_type
    } do |form| %>

  <% if runner.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <h3 class="text-sm font-medium text-red-800">
        <%= pluralize(runner.errors.count, "error") %> prevented this runner from being saved:
      </h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% runner.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if is_new %>
    <div>
      <span class="block text-sm font-medium text-gray-900">Authentication Type</span>
      <div class="mt-2 flex gap-4">
        <label class="flex items-center">
          <%= form.radio_button :auth_type, "subscription", class: "h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600",
              data: { action: "change->runner-form#toggleAuthType" } %>
          <span class="ml-2 text-sm text-gray-700">Subscription</span>
        </label>
        <% if api_key_runner_options.any? %>
          <label class="flex items-center">
            <%= form.radio_button :auth_type, "api_key", class: "h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600",
                data: { action: "change->runner-form#toggleAuthType" } %>
            <span class="ml-2 text-sm text-gray-700">API Key</span>
          </label>
        <% else %>
          <span class="flex items-center text-sm text-gray-400">
            API Key (add compatible keys on the <%= link_to "LLM API Keys page", provider_api_keys_path, class: "text-indigo-600 hover:text-indigo-500" %> first)
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div>
    <span id="runner_key_label" class="block text-sm font-medium text-gray-900">Runner</span>
    <div class="mt-2">
      <% if runner.persisted? %>
        <%= form.hidden_field :runner_key, value: runner.runner_key %>
        <input type="text" value="<%= runner.display_name %>" disabled autocomplete="off" class="block w-full rounded-md border-0 bg-gray-100 px-3 py-1.5 text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm sm:leading-6">
      <% else %>
        <% if subscription_runner_options.any? %>
          <div data-runner-form-target="subscriptionFields" <% if is_api_key %>hidden<% end %>>
            <%= form.select :runner_key,
                subscription_runner_options.map { |key| [Runner.display_name_for(key), key] },
                {},
                id: "runner_runner_key_subscription",
                "aria-labelledby": "runner_key_label",
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6",
                disabled: is_api_key,
                data: { runner_form_target: "runnerSelect", action: "change->runner-form#refreshRunnerSpecificFields" } %>
          </div>
        <% end %>
        <% if api_key_runner_options.any? %>
          <div data-runner-form-target="apiKeyFields" <% unless is_api_key %>hidden<% end %>>
            <%= form.select :runner_key,
                api_key_runner_options.map { |key| [Runner.display_name_for(key), key] },
                {},
                id: "runner_runner_key_api_key",
                "aria-labelledby": "runner_key_label",
                class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6",
                disabled: !is_api_key,
                data: { runner_form_target: "runnerSelect", action: "change->runner-form#refreshRunnerSpecificFields" } %>
          </div>
        <% end %>
        <% unless subscription_runner_options.any? || api_key_runner_options.any? %>
          <%= form.text_field :runner_key, value: "No additional runners are installed in paid-agent yet", disabled: true, class: "block w-full rounded-md border-0 bg-gray-100 px-3 py-1.5 text-gray-500 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm sm:leading-6" %>
        <% end %>
      <% end %>
    </div>
    <% unless selectable_runner %>
      <p class="mt-2 text-xs text-gray-500">Install and ship runner support in the paid-agent image before it can be added here.</p>
    <% end %>
    <p class="mt-2 text-xs text-gray-500">
      Need a subscription login instead of a pasted token or API key? Use the
      <%= link_to "Connect Runner flow picker", new_runner_login_flow_path(return_to: request.fullpath), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      to capture a managed runner credential without host shell access when that flow is supported.
    </p>
    <% if is_new && managed_credential_preferred_runner_key == "claude" %>
      <p class="mt-2 text-xs text-gray-500">Paid prefers it over host-mounted Claude auth.</p>
    <% end %>
  </div>

  <div>
    <%= form.label :name, "Custom Name (optional)", class: "block text-sm font-medium text-gray-900" %>
    <div class="mt-2">
      <%= form.text_field :name, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "e.g., Claude via OpenRouter" %>
    </div>
    <p class="mt-1 text-xs text-gray-500">A custom label to distinguish this runner entry.</p>
  </div>

  <% if is_new && available_api_keys.any? %>
    <div data-runner-form-target="apiKeySelectContainer" <% unless is_api_key %>hidden<% end %>>
      <%= form.label :provider_api_key_id, "API Key", class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <select name="runner[provider_api_key_id]"
                id="runner_provider_api_key_id"
                class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                <% unless is_api_key %>disabled<% end %>
                data-runner-form-target="apiKeySelect"
                data-action="change->runner-form#refreshRunnerSpecificFields">
          <option value="" data-runner-form-target="apiKeyOption">Select an API key</option>
          <% available_api_keys.group_by(&:api_service_type).sort.each do |service_type, api_keys| %>
            <optgroup label="<%= RunnerSupport.api_service_type_label(service_type) %>">
              <% api_keys.each do |ak| %>
                <option value="<%= ak.id %>"
                        <% if runner.provider_api_key_id == ak.id %>selected<% end %>
                        data-runner-form-target="apiKeyOption"
                        data-api-service-type="<%= ak.api_service_type %>">
                  <%= ak.name %>
                </option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
      </div>
    </div>
  <% elsif runner.persisted? && is_api_key %>
    <div>
      <%= form.label :provider_api_key_id, "API Key", class: "block text-sm font-medium text-gray-900" %>
      <div class="mt-2">
        <input type="text" value="<%= runner.provider_api_key&.name || 'None' %>" disabled autocomplete="off" class="block w-full rounded-md border-0 bg-gray-100 px-3 py-1.5 text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 sm:text-sm sm:leading-6">
      </div>
    </div>
  <% end %>

  <div data-runner-form-target="fallbackRoleField" <% unless is_api_key %>hidden<% end %>>
    <%= form.label :fallback_role, "Fallback Role", class: "block text-sm font-medium text-gray-900" %>
    <div class="mt-2">
      <%= form.select :fallback_role,
          [["Standard", "standard"], ["Rate-limit fallback only", "rate_limit_fallback"]],
          {},
          class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6",
          disabled: !is_api_key %>
    </div>
    <p class="mt-1 text-xs text-gray-500">Rate-limit fallback entries will be used when the subscription runner for the same key is rate-limited. (Automatic fallback execution is planned; currently these entries are tracked but not yet auto-invoked.)</p>
  </div>

  <div <% unless is_api_key %>hidden<% end %>>
    <%= form.label :monthly_token_budget, "Monthly Token Budget", class: "block text-sm font-medium text-gray-900" %>
    <div class="mt-2">
      <%= form.number_field :monthly_token_budget,
          min: 1,
          step: 1,
          class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6",
          placeholder: "Leave empty for unlimited" %>
    </div>
    <p class="mt-1 text-xs text-gray-500">Set a monthly token budget for automatic weight balancing. Leave empty for unlimited (quota balancing will be disabled for this runner).</p>
  </div>

  <% if runner_model_policy_form_enabled %>
    <div data-runner-form-target="modelSettings" <% unless feature_flagged_model_form && is_api_key %>hidden<% end %>>
      <% feature_flagged_model_form_runner_keys.each do |runner_key| %>
        <% runner_config = runner.config.is_a?(Hash) ? runner.config.fetch(runner_key, {}) : {} %>
        <input type="hidden"
               name="runner[config][<%= runner_key %>][api_provider]"
               value="<%= runner_config.fetch("api_provider", "") %>"
               data-runner-form-target="configField"
               data-runner-key="<%= runner_key %>"
               data-config-field="api_provider">
        <input type="hidden"
               name="runner[config][<%= runner_key %>][model]"
               value="<%= runner_config.fetch("model", "") %>"
               data-runner-form-target="configField"
               data-runner-key="<%= runner_key %>"
               data-config-field="model">
        <% if runner_key == "opencode" %>
          <input type="hidden"
                 name="runner[config][opencode][model_policy]"
                 value="<%= runner.opencode_model_policy %>"
                 data-runner-form-target="configField"
                 data-runner-key="opencode"
                 data-config-field="model_policy">
        <% end %>
      <% end %>

      <div class="rounded-lg border border-gray-200 p-4">
        <h3 class="text-sm font-semibold text-gray-900">Model Settings</h3>
        <p class="mt-1 text-xs text-gray-500">Choose a model from the selected key's catalog. The custom option keeps the existing manual catalog escape hatch.</p>

        <div class="mt-4">
          <label for="runner_model_selection_choice" class="block text-sm font-medium text-gray-900">Model</label>
          <select id="runner_model_selection_choice"
                  name="runner[model_selection_choice]"
                  class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                  data-runner-form-target="modelSelect"
                  data-initial-model-selection="<%= selected_model_choice %>"
                  data-action="change->runner-form#refreshModelState">
            <option value="">Select a model</option>
            <% initial_model_options.each do |option| %>
              <% next if option[:kind] == "catalog" %>
              <option value="<%= option[:value] %>" <% if selected_model_choice == option[:value] %>selected<% end %>><%= option[:label] %></option>
            <% end %>
            <% initial_model_options.select { |option| option[:kind] == "catalog" }.group_by { |option| option[:family] }.each do |family, options| %>
              <optgroup label="<%= family %>">
                <% options.each do |option| %>
                  <option value="<%= option[:value] %>" <% if selected_model_choice == option[:value] %>selected<% end %>><%= option[:label] %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>
        </div>

        <div class="mt-4" data-runner-form-target="customModelField" <% unless selected_model_choice == LlmModel::CUSTOM_MODEL_OPTION %>hidden<% end %>>
          <label for="runner_custom_model_id" class="block text-sm font-medium text-gray-900">Custom Model ID</label>
          <input id="runner_custom_model_id"
                 name="runner[custom_model_id]"
                 type="text"
                 value="<%= custom_model_id %>"
                 placeholder="moonshotai/kimi-k2-0905"
                 autocomplete="off"
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                 data-runner-form-target="customModelInput"
                 data-action="input->runner-form#syncModelConfig">
          <p class="mt-1 text-xs text-gray-500">Use this only when the seeded catalog does not include the model you need yet.</p>
        </div>

        <div class="mt-4" data-runner-form-target="kilocodePreflightField" <% unless is_api_key && runner.runner_key == "kilocode" %>hidden<% end %>>
          <label for="runner_config_kilocode_preflight_timeout_seconds" class="block text-sm font-medium text-gray-900">Preflight Timeout (seconds)</label>
          <input id="runner_config_kilocode_preflight_timeout_seconds"
                 name="runner[config][kilocode][preflight_timeout_seconds]"
                 type="number"
                 min="<%= Runner::MIN_PREFLIGHT_TIMEOUT_SECONDS %>"
                 value="<%= runner.kilocode_preflight_timeout_seconds %>"
                 placeholder="<%= Activities::RunAgentActivity::DIRECT_OUTBOUND_PREFLIGHT_TIMEOUT_SECONDS %>"
                 autocomplete="off"
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          <p class="mt-1 text-xs text-gray-500">Optional. Overrides the default direct-outbound preflight timeout for this KiloCode entry only.</p>
        </div>
      </div>
    </div>
  <% else %>
    <% opencode_settings_enabled = is_api_key && runner.runner_key == "opencode" %>
    <% opencode_api_provider = runner.opencode_api_provider || Runner::OPENCODE_DEFAULT_API_PROVIDER %>
    <div data-runner-form-target="opencodeSettings" <% unless opencode_settings_enabled %>hidden<% end %>>
      <div class="rounded-lg border border-gray-200 p-4">
        <h3 class="text-sm font-semibold text-gray-900">OpenCode Model Settings</h3>
        <p class="mt-1 text-xs text-gray-500">Configure the upstream API provider and model for this OpenCode entry.</p>

        <div class="mt-4">
          <label for="runner_config_opencode_api_provider" class="block text-sm font-medium text-gray-900">API Provider</label>
          <select id="runner_config_opencode_api_provider"
                  name="runner[config][opencode][api_provider]"
                  <% unless opencode_settings_enabled %>disabled<% end %>
                  class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                  data-runner-form-target="directOutboundApiProviderSelect"
                  data-runner-key="opencode"
                  data-action="change->runner-form#refreshRunnerSpecificFields">
            <% Runner::DIRECT_OUTBOUND_API_PROVIDERS.each do |slug, cfg| %>
              <option value="<%= slug %>" data-service-type="<%= cfg[:service_type] %>" <% if opencode_api_provider == slug %>selected<% end %>><%= cfg[:label] %></option>
            <% end %>
          </select>
        </div>

        <div class="mt-4">
          <label for="runner_config_opencode_model" class="block text-sm font-medium text-gray-900">Model ID</label>
          <input id="runner_config_opencode_model"
                 name="runner[config][opencode][model]"
                 type="text"
                 value="<%= runner.opencode_model_id %>"
                 placeholder="moonshotai/kimi-k2-0905"
                 autocomplete="off"
                  <% unless opencode_settings_enabled %>disabled<% end %>
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          <p class="mt-1 text-xs text-gray-500">Required. The model identifier for the selected API provider.</p>
        </div>
      </div>
    </div>

    <% kilocode_settings_enabled = is_api_key && runner.runner_key == "kilocode" %>
    <% kilocode_api_provider = runner.kilocode_api_provider || Runner::KILOCODE_DEFAULT_API_PROVIDER %>
    <div data-runner-form-target="kilocodeSettings" <% unless kilocode_settings_enabled %>hidden<% end %>>
      <div class="rounded-lg border border-gray-200 p-4">
        <h3 class="text-sm font-semibold text-gray-900">KiloCode Model Settings</h3>
        <p class="mt-1 text-xs text-gray-500">Configure the upstream API provider and model for this KiloCode entry.</p>

        <div class="mt-4">
          <label for="runner_config_kilocode_api_provider" class="block text-sm font-medium text-gray-900">API Provider</label>
          <select id="runner_config_kilocode_api_provider"
                  name="runner[config][kilocode][api_provider]"
                  <% unless kilocode_settings_enabled %>disabled<% end %>
                  class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                  data-runner-form-target="directOutboundApiProviderSelect"
                  data-runner-key="kilocode"
                  data-action="change->runner-form#refreshRunnerSpecificFields">
            <% Runner::DIRECT_OUTBOUND_API_PROVIDERS.each do |slug, cfg| %>
              <option value="<%= slug %>" data-service-type="<%= cfg[:service_type] %>" <% if kilocode_api_provider == slug %>selected<% end %>><%= cfg[:label] %></option>
            <% end %>
          </select>
        </div>

        <div class="mt-4">
          <label for="runner_config_kilocode_model" class="block text-sm font-medium text-gray-900">Model ID</label>
          <input id="runner_config_kilocode_model"
                 name="runner[config][kilocode][model]"
                 type="text"
                 value="<%= runner.kilocode_model_id %>"
                 placeholder="mercury-2"
                 autocomplete="off"
                  <% unless kilocode_settings_enabled %>disabled<% end %>
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          <p class="mt-1 text-xs text-gray-500">Required. The model identifier for the selected API provider.</p>
        </div>

        <div class="mt-4">
          <label for="runner_config_kilocode_preflight_timeout_seconds" class="block text-sm font-medium text-gray-900">Preflight Timeout (seconds)</label>
          <input id="runner_config_kilocode_preflight_timeout_seconds"
                 name="runner[config][kilocode][preflight_timeout_seconds]"
                 type="number"
                 min="<%= Runner::MIN_PREFLIGHT_TIMEOUT_SECONDS %>"
                 value="<%= runner.kilocode_preflight_timeout_seconds %>"
                 placeholder="<%= Activities::RunAgentActivity::DIRECT_OUTBOUND_PREFLIGHT_TIMEOUT_SECONDS %>"
                 autocomplete="off"
                  <% unless kilocode_settings_enabled %>disabled<% end %>
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          <p class="mt-1 text-xs text-gray-500">Optional. Overrides the default direct-outbound preflight timeout for this KiloCode entry only.</p>
        </div>
      </div>
    </div>

    <% pi_settings_enabled = is_api_key && runner.runner_key == "pi" %>
    <% pi_api_provider = runner.pi_api_provider || Runner::PI_DEFAULT_API_PROVIDER %>
    <div data-runner-form-target="piSettings" <% unless pi_settings_enabled %>hidden<% end %>>
      <div class="rounded-lg border border-gray-200 p-4">
        <h3 class="text-sm font-semibold text-gray-900">Pi API Key Settings</h3>
        <p class="mt-1 text-xs text-gray-500">Choose the upstream Pi provider to pair with this API key. Model selection is optional.</p>

        <div class="mt-4">
          <label for="runner_config_pi_api_provider" class="block text-sm font-medium text-gray-900">API Provider</label>
          <select id="runner_config_pi_api_provider"
                  name="runner[config][pi][api_provider]"
                  <% unless pi_settings_enabled %>disabled<% end %>
                  class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                  data-runner-form-target="directOutboundApiProviderSelect"
                  data-runner-key="pi"
                  data-action="change->runner-form#refreshRunnerSpecificFields">
            <% Runner::PI_API_PROVIDERS.each do |slug, cfg| %>
              <option value="<%= slug %>" data-service-type="<%= cfg[:service_type] %>" <% if pi_api_provider == slug %>selected<% end %>><%= cfg[:label] %></option>
            <% end %>
          </select>
        </div>

        <div class="mt-4">
          <label for="runner_config_pi_model" class="block text-sm font-medium text-gray-900">Model ID</label>
          <input id="runner_config_pi_model"
                 name="runner[config][pi][model]"
                 type="text"
                 value="<%= runner.pi_model_id %>"
                 placeholder="Optional: deepseek-chat"
                 autocomplete="off"
                  <% unless pi_settings_enabled %>disabled<% end %>
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          <p class="mt-1 text-xs text-gray-500">Optional. Leave blank to let Pi use its default or previously selected model for the chosen provider.</p>
        </div>
      </div>
    </div>

    <% omp_settings_enabled = is_api_key && runner.runner_key == "omp" %>
    <% omp_api_provider = runner.omp_api_provider || Runner::OMP_DEFAULT_API_PROVIDER %>
    <div data-runner-form-target="ompSettings" <% unless omp_settings_enabled %>hidden<% end %>>
      <div class="rounded-lg border border-gray-200 p-4">
        <h3 class="text-sm font-semibold text-gray-900">Oh My Pi API Key Settings</h3>
        <p class="mt-1 text-xs text-gray-500">Choose the upstream Oh My Pi provider to pair with this API key. Model selection is optional.</p>

        <div class="mt-4">
          <label for="runner_config_omp_api_provider" class="block text-sm font-medium text-gray-900">API Provider</label>
          <select id="runner_config_omp_api_provider"
                  name="runner[config][omp][api_provider]"
                  <% unless omp_settings_enabled %>disabled<% end %>
                  class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                  data-runner-form-target="directOutboundApiProviderSelect"
                  data-runner-key="omp"
                  data-action="change->runner-form#refreshRunnerSpecificFields">
            <% Runner::OMP_API_PROVIDERS.each do |slug, cfg| %>
              <option value="<%= slug %>" data-service-type="<%= cfg[:service_type] %>" <% if omp_api_provider == slug %>selected<% end %>><%= cfg[:label] %></option>
            <% end %>
          </select>
        </div>

        <div class="mt-4">
          <label for="runner_config_omp_model" class="block text-sm font-medium text-gray-900">Model ID</label>
          <input id="runner_config_omp_model"
                 name="runner[config][omp][model]"
                 type="text"
                 value="<%= runner.omp_model_id %>"
                 placeholder="Optional: deepseek-chat"
                 autocomplete="off"
                  <% unless omp_settings_enabled %>disabled<% end %>
                 class="mt-2 block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          <p class="mt-1 text-xs text-gray-500">Optional. Leave blank to let Oh My Pi use its default or previously selected model for the chosen provider.</p>
        </div>
      </div>
    </div>
  <% end %>

  <% tier_model_provider = Runners::DefaultTierModelIds::RUNNER_KEY_TO_MODEL_PROVIDER[runner.runner_key.to_s] %>
  <% free_runner = runner.runner_key == Runner::OPENROUTER_FREE_RUNNER_KEY || selected_model_choice == Runners::ModelOptions::FREE_POLICY_OPTION %>
  <%# Flagged OpenCode can switch its model dropdown to OpenRouter Free client-side, so the free-tier
      picker must be in the DOM even when the runner is currently in specific-model mode — otherwise the
      Stimulus controller has nothing to reveal and the form falls back to submitting stale, non-free
      tier_model_ids (rejected by tier_model_ids_must_be_valid). %>
  <% opencode_free_capable = feature_flagged_model_form && runner.runner_key == "opencode" %>
  <% render_free_tier_block = free_runner || opencode_free_capable %>
  <% tier_models = if render_free_tier_block
       LlmModel.openrouter_synced_free.active.order(:display_name)
     elsif tier_model_provider
       LlmModel.active.by_provider(tier_model_provider).order(:display_name)
     else
       []
     end %>
  <% if tier_models.any? %>
    <% tier_runner_key = render_free_tier_block && feature_flagged_model_form ? "opencode" : runner.runner_key %>
    <%# Only trust the persisted tier_model_ids when the runner is actually free today — for a
        specific-mode runner rendering this block purely so it's ready to reveal on a client-side
        switch to Free, runner.tier_model_ids still holds the specific-mode mapping and would leave
        the free selects matching nothing. %>
    <% current_tier_ids = if free_runner
         runner.tier_model_ids.presence || FreeModels::DefaultTierModels.call
       elsif render_free_tier_block
         FreeModels::DefaultTierModels.call
       else
         runner.tier_model_ids.presence || Runners::DefaultTierModelIds.call(runner_key: tier_runner_key)
       end %>
    <div class="rounded-lg border border-gray-200 p-4"
         data-runner-form-target="tierSettings"
         data-tier-runner-key="<%= tier_runner_key %>"
         data-model-policy-state="<%= render_free_tier_block ? "free" : "specific" %>">
      <% if render_free_tier_block %>
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-sm font-semibold text-gray-900">Free Model Configuration</h3>
          <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Free</span>
        </div>
        <p class="mt-1 text-xs text-gray-500">Pick which free model fills each tier slot for this runner.</p>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class="rounded-lg border border-sky-200 bg-sky-50 p-3">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-sky-950">Data classification routing</h4>
            <p class="mt-2 text-xs text-sky-900">Paid maps project sensitivity to OpenRouter routing controls for this runner.</p>
            <dl class="mt-3 space-y-2 text-xs text-sky-900">
              <div class="flex items-start justify-between gap-3">
                <dt class="font-medium">Open / Internal</dt>
                <dd>Standard OpenRouter routing</dd>
              </div>
              <div class="flex items-start justify-between gap-3">
                <dt class="font-medium">Confidential</dt>
                <dd><code>provider.data_collection: "deny"</code></dd>
              </div>
              <div class="flex items-start justify-between gap-3">
                <dt class="font-medium">Restricted</dt>
                <dd><code>data_collection: "deny"</code> + <code>zdr: true</code></dd>
              </div>
            </dl>
          </div>

          <div class="rounded-lg border border-amber-200 bg-amber-50 p-3">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-amber-950">Rate limit expectations</h4>
            <p class="mt-2 text-xs text-amber-900">~20 free requests/day without OpenRouter credits. Limits are account-wide, so switching models does not avoid the daily cap.</p>
            <p class="mt-2 text-xs text-amber-900">Models marked <span class="font-medium">Below quality bar</span> stay selectable for manual use, but they are not chosen as defaults.</p>
          </div>
        </div>
      <% else %>
        <h3 class="text-sm font-semibold text-gray-900">Tier Model Mapping</h3>
        <p class="mt-1 text-xs text-gray-500">Pick which model fills each tier slot for this runner.</p>
      <% end %>
      <% LlmModel::TIERS.each do |tier| %>
        <div class="mt-3">
          <label class="block text-sm font-medium text-gray-900" for="runner_tier_model_ids_<%= tier %>"><%= tier.titleize %></label>
          <select id="runner_tier_model_ids_<%= tier %>"
                  name="runner[tier_model_ids][<%= tier %>]"
                  data-runner-form-target="tierSelect"
                  class="mt-1 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            <option value="">— None —</option>
            <% if render_free_tier_block %>
              <% grouped_free_models = tier_models.group_by { |model| model.tier.presence || "untiered" } %>
              <% LlmModel::TIERS.each do |group_tier| %>
                <% models_for_group = grouped_free_models[group_tier] || [] %>
                <% next if models_for_group.empty? %>

                <optgroup label="<%= group_tier.titleize %> tier free models">
                  <% models_for_group.each do |m| %>
                    <option value="<%= m.model_id %>" <% if current_tier_ids[tier] == m.model_id %>selected<% end %>>
                      <%= m.display_name %> (<%= m.tier %>) <%= m.below_quality_bar? ? "• Below quality bar" : "• Above quality bar" %>
                    </option>
                  <% end %>
                </optgroup>
              <% end %>
            <% else %>
              <% tier_models.each do |m| %>
                <option value="<%= m.model_id %>" <% if current_tier_ids[tier] == m.model_id %>selected<% end %>>
                  <%= m.display_name %><%= " (#{m.tier})" if m.tier.present? %><%= " - below quality bar" if m.below_quality_bar? %>
                </option>
              <% end %>
            <% end %>
          </select>
        </div>
      <% end %>
    </div>
  <% end %>

  <% thresholds = runner.effective_complexity_thresholds %>
  <div class="rounded-lg border border-gray-200 p-4">
    <h3 class="text-sm font-semibold text-gray-900">Complexity → Tier Thresholds</h3>
    <p class="mt-1 text-xs text-gray-500">Tasks with complexity score (1–10) at or below each threshold route to that tier. Scores above mid_max route to the high tier.</p>
    <div class="mt-3 grid grid-cols-2 gap-4">
      <div>
        <label for="runner_complexity_thresholds_low_max" class="block text-sm font-medium text-gray-900">Low tier max</label>
        <input type="number" name="runner[complexity_thresholds][low_max]" id="runner_complexity_thresholds_low_max"
               value="<%= thresholds["low_max"] %>" min="1" max="10" step="1" autocomplete="off"
               class="mt-1 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
      </div>
      <div>
        <label for="runner_complexity_thresholds_mid_max" class="block text-sm font-medium text-gray-900">Mid tier max</label>
        <input type="number" name="runner[complexity_thresholds][mid_max]" id="runner_complexity_thresholds_mid_max"
               value="<%= thresholds["mid_max"] %>" min="1" max="10" step="1" autocomplete="off"
               class="mt-1 block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
      </div>
    </div>
  </div>

  <div class="space-y-3 rounded-lg border border-gray-200 p-4">
    <div class="flex items-center">
      <%= form.check_box :enabled_for_agent_runs, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
      <%= form.label :enabled_for_agent_runs, "Enable for agent runs", class: "ml-3 block text-sm font-medium text-gray-900" %>
    </div>

    <div class="flex items-center">
      <%= form.check_box :enabled_for_chat, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
      <%= form.label :enabled_for_chat, "Enable for chat sessions", class: "ml-3 block text-sm font-medium text-gray-900" %>
    </div>

    <div class="flex items-center">
      <%= form.check_box :enabled_for_fallback, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
      <%= form.label :enabled_for_fallback, "Allow as fallback runner", class: "ml-3 block text-sm font-medium text-gray-900" %>
    </div>
  </div>

  <div>
    <%= form.label :agent_co_author_trailer, "Co-Authored-By Trailer", class: "block text-sm font-medium text-gray-900" %>
    <div class="mt-2">
      <%= form.text_field :agent_co_author_trailer, class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", placeholder: "Co-Authored-By: Claude <noreply@anthropic.com>" %>
    </div>
    <p class="mt-1 text-xs text-gray-500">When set, this trailer is appended to all commits made during agent runs that use this runner. The trailer follows the runner that actually generated the commit, so attribution remains accurate after fallback. Must be a single line; newlines are not allowed.</p>
  </div>

  <div class="flex justify-end gap-3 border-t border-gray-200 pt-4">
    <%= link_to "Cancel", runners_path, class: "text-sm font-semibold text-gray-700 hover:text-gray-900" %>
    <%= form.submit disabled: !selectable_runner,
        class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-gray-300" %>
  </div>
<% end %>
