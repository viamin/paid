<div class="rounded-lg bg-white shadow">
  <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
    <h2 class="text-base font-semibold text-gray-900">Runner Priority</h2>
    <p class="mt-1 text-sm text-gray-500">Choose the automated runner and configure automatic fallback order in one place.</p>
  </div>

  <div class="px-4 py-5 sm:p-6">
    <%= form_with model: user_setting, url: settings_runners_path, method: :patch do |form| %>
      <% if user_setting.errors.any? %>
        <div class="mb-6 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= pluralize(user_setting.errors.count, "error") %> prevented your runner settings from being saved:
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc space-y-1 pl-5">
                  <% user_setting.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="space-y-6">
        <%
          current_mode = user_setting.runner_selection_mode
          combined_value = if current_mode == "single"
            "single:#{default_runner_identifier}"
          else
            current_mode
          end
          combined_options = enabled_agent_runners.map do |runr|
            [ runner_labels[runr] || runr.titleize, "single:#{runr}" ]
          end
          if enabled_agent_runners.length > 1
            combined_options += [
              [ "Round Robin (cycle through all runners, respecting weights)", "round_robin" ],
              [ "Random (pick at random, respecting weights)", "random" ]
            ]
          end
        %>
        <div>
          <label for="user_setting_runner_mode" class="block text-sm font-medium leading-6 text-gray-900">Automated Runner</label>
          <div class="mt-2">
            <select name="user_setting[runner_mode]" id="user_setting_runner_mode"
                    class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
              <% combined_options.each do |label, value| %>
                <option value="<%= value %>" <% if value == combined_value %>selected<% end %>><%= label %></option>
              <% end %>
            </select>
          </div>
          <p class="mt-1 text-xs text-gray-500">Choose a single runner for all automated agent runs, or distribute across all enabled runners.</p>
        </div>

        <% if enabled_agent_runners.length > 1 %>
          <div>
            <h3 class="block text-sm font-medium leading-6 text-gray-900">Runner Weights</h3>
            <p class="mt-1 text-xs text-gray-500">A runner with weight N is picked N times more often in Random mode and used N consecutive times in Round Robin mode. Default is 1.</p>
            <% total_weight = run_enabled_runners.sum { |runr| runr.weight || Runner::DEFAULT_WEIGHT } %>
            <div class="mt-3 space-y-2">
              <% run_enabled_runners.each do |runr| %>
                <% weight = runr.weight || Runner::DEFAULT_WEIGHT %>
                <% share_pct = total_weight.positive? ? ((weight.to_f / total_weight) * 100).round : 0 %>
                <div class="flex items-center justify-between gap-3 rounded-md border border-gray-200 px-3 py-2">
                  <span class="text-sm font-medium text-gray-900"><%= runr.display_name %></span>
                  <div class="flex items-center gap-3">
                    <span class="text-xs text-gray-500" data-runner-share><%= share_pct %>% share</span>
                    <%= number_field_tag "user_setting[runner_weights][#{runr.id}]",
                        weight,
                        min: 1,
                        max: Runner::MAX_WEIGHT,
                        step: 1,
                        class: "w-20 rounded-md border-0 px-2 py-1 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600",
                        aria: { label: "Weight for #{runr.display_name}" } %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div>
          <h3 class="block text-sm font-medium leading-6 text-gray-900">Per-Run-Type Defaults</h3>
          <p class="mt-1 text-xs text-gray-500">Override the global automated runner for specific run types, or leave them on the shared default.</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <% AgentRun::GOALS.each do |goal| %>
              <div>
                <label for="user_setting_default_agent_runners_by_goal_<%= goal %>" class="block text-sm font-medium leading-6 text-gray-900">
                  <%= goal_runner_labels.fetch(goal, goal.humanize) %>
                </label>
                <div class="mt-2">
                  <% global_runner_label = runner_labels[default_runner_identifier] || default_runner_identifier.to_s.titleize.presence || "Not set" %>
                  <%= select_tag "user_setting[default_agent_runners_by_goal][#{goal}]",
                      options_for_select(
                        [[ "Use global automated runner (#{global_runner_label})", "" ]] +
                        enabled_agent_runners.map { |runr| [ runner_labels[runr] || runr.titleize, runr ] },
                        explicit_goal_default_runners[goal]
                      ),
                      id: "user_setting_default_agent_runners_by_goal_#{goal}",
                      class: "block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex items-center">
          <%= form.check_box :fallback_enabled, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
          <%= form.label :fallback_enabled, "Enable automatic runner fallback", class: "ml-3 block text-sm font-medium leading-6 text-gray-900" %>
        </div>
        <p class="-mt-4 ml-7 text-xs text-gray-500">When enabled, the system will try the other configured fallback runners using the order below. If the active automated runner appears in that order, fallback starts after it and wraps around.</p>

        <div data-controller="sortable">
          <p class="mb-2 text-sm font-medium text-gray-700">Fallback order:</p>
          <div class="space-y-2" data-sortable-target="list">
            <% runner_states_by_name = runner_states %>
            <% fallback_candidates = fallback_candidate_runners %>
            <% all_runners = (enabled_agent_runners + fallback_candidate_runners).uniq %>
            <% saved_order = Array(saved_fallback_runner_tokens) %>
            <% runners_in_order = (saved_order.select { |runr| all_runners.include?(runr) } + (all_runners - saved_order)).uniq %>
            <% runners_in_order.each do |runr| %>
              <% runner_state = runner_states_by_name[runr] %>
              <% runner_state ||= runner_states_by_name[runner_state_aliases[runr]] if subscription_runner_identifiers.include?(runr) %>
              <% fallback_enabled = fallback_candidates.include?(runr) %>
              <div class="runner-item flex items-center justify-between rounded-md border border-gray-200 px-3 py-2 shadow-sm <%= fallback_enabled ? 'bg-white' : 'bg-gray-50 opacity-60' %>" data-runner="<%= runr %>" data-fallback-enabled="<%= fallback_enabled %>" data-sortable-target="item">
                <div class="flex items-center">
                  <svg class="drag-handle mr-2 h-4 w-4 cursor-move text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
                  </svg>
                  <input type="checkbox"
                         class="mr-2 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                         data-action="sortable#toggleFallback"
                         data-sortable-target="checkbox"
                         data-runner="<%= runr %>"
                         <% if fallback_enabled %>checked<% end %>
                         aria-label="Enable <%= runner_labels[runr] || runr.titleize %> as fallback">
                   <span class="text-sm font-medium <%= fallback_enabled ? 'text-gray-900' : 'text-gray-400' %>"><%= runner_labels[runr] || runr.titleize %></span>
                </div>
                <div>
                  <% if runr == default_runner_identifier %>
                    <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Automated</span>
                  <% elsif runner_state&.rate_limited? %>
                    <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">Rate limited</span>
                  <% elsif runner_state&.circuit_open? %>
                    <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">Circuit open</span>
                  <% elsif runner_state&.circuit_half_open? %>
                    <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800">Recovering</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Available</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

          <%= form.hidden_field :fallback_runners,
              value: (saved_fallback_runner_tokens || []).to_json,
              data: { sortable_target: "input", primary_runner: default_runner_identifier } %>
          <input type="hidden" name="user_setting[enabled_fallback_runner_keys]"
                 value="<%= fallback_candidates.to_json %>"
                 data-sortable-target="enabledInput">
        </div>

        <p class="text-xs text-gray-500">The active automated runner is excluded automatically for each run. Use the checkboxes to enable or disable individual runners as fallbacks.</p>

        <div class="flex justify-end">
          <%= form.submit "Save Runner Settings", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
