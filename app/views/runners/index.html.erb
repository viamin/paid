<% content_for(:title) { "Runners - Paid" } %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8" data-controller="test-all">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Runners</h1>
      <p class="mt-1 text-sm text-gray-500">Configure runners available for agent runs, chat sessions, and fallback routing.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Connect Runner", new_runner_login_flow_path(return_to: request.fullpath), class: "rounded-md bg-sky-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sky-500" %>
      <% if @runners.any? %>
        <button
          data-action="test-all#testAll"
          data-test-all-target="button"
          type="button"
          class="rounded-md bg-emerald-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 disabled:cursor-not-allowed disabled:bg-emerald-300"
        >
          Test All
        </button>
      <% end %>

      <% if @addable_runner_options.any? %>
        <%= link_to "Add Runner", new_runner_path, class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% else %>
        <div class="text-right">
          <span class="inline-flex items-center rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-500">
            No More Runners Yet
          </span>
          <p class="mt-1 text-xs text-gray-500">Ship more runner CLIs in <code>paid-agent</code> to add them here.</p>
        </div>
      <% end %>
    </div>
  </div>

  <% if @runners.any? %>
    <div class="mb-4 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      Test Runner uses the same configured runner auth path as normal execution, so results here should match real run behavior.
    </div>
  <% end %>

  <div class="overflow-x-auto rounded-lg bg-white shadow">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Runner</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Auth</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Agent Runs</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Chat</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Fallback</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Usage (7d)</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Fallback Rate</th>
          <th class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Quota</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @runners.each do |runner| %>
          <tr
            data-controller="test-agent"
            data-test-all-target="runner"
            data-test-agent-url-value="<%= test_agent_runner_path(runner) %>"
            data-test-agent-csrf-token-value="<%= form_authenticity_token %>"
          >
            <td class="px-4 py-3 text-sm font-medium text-gray-900">
              <div class="flex flex-wrap items-center gap-2">
                <span><%= runner.display_name %></span>
                <% if runner.runner_key == Runner::OPENROUTER_FREE_RUNNER_KEY %>
                  <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Free Models</span>
                <% end %>
              </div>
            </td>
            <td data-test-agent-target="status" class="px-4 py-3 text-sm">
              <% state = @runner_states[runner.state_key] %>
              <% state ||= @runner_states[runner.runner_key] if runner.subscription? %>
              <% if state&.rate_limited? %>
                <span class="inline-flex items-center rounded-md bg-orange-100 px-2 py-1 text-xs font-medium text-orange-700">
                  Rate Limited
                </span>
                <p class="mt-1 text-xs text-gray-500">Resets <%= local_time(state.rate_limited_until, format: :relative) %></p>
              <% elsif state&.circuit_open? %>
                <span class="inline-flex items-center rounded-md bg-red-100 px-2 py-1 text-xs font-medium text-red-700">
                  Circuit Open
                </span>
              <% else %>
                <span class="inline-flex items-center rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700">
                  Available
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">
              <% if runner.subscription? %>
                <span class="inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">Subscription</span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">API Key</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">
              <%= check_box_tag "agent_runs_#{runner.id}", "1", runner.enabled_for_agent_runs?,
                    disabled: true,
                    title: runner.enabled_for_agent_runs? ? "Enabled" : "Disabled",
                    aria: { label: "Agent Runs" } %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">
              <%= check_box_tag "chat_#{runner.id}", "1", runner.enabled_for_chat?,
                    disabled: true,
                    title: runner.enabled_for_chat? ? "Enabled" : "Disabled",
                    aria: { label: "Chat" } %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">
              <% fallback_title =
                   if runner.api_key? && runner.rate_limit_fallback?
                     runner.enabled_for_fallback? ? "Enabled (rate-limit only)" : "Disabled (rate-limit only)"
                   else
                     runner.enabled_for_fallback? ? "Enabled" : "Disabled"
                   end %>
              <%= check_box_tag "fallback_#{runner.id}", "1", runner.enabled_for_fallback?,
                    disabled: true,
                    title: fallback_title,
                    aria: { label: "Fallback" } %>
            </td>
            <% stats = @runner_stats_by_id[runner.id] %>
            <td class="px-4 py-3 text-sm text-gray-700">
              <% if stats && stats[:runs_7d] > 0 %>
                <span class="font-medium"><%= number_to_currency(stats[:cost_cents_7d] / 100.0) %></span>
                <span class="text-gray-500">&middot;</span>
                <%= format_token_count(stats[:tokens_7d]) %> tokens
                <span class="text-gray-500">&middot;</span>
                <%= stats[:runs_7d] %> runs
              <% else %>
                <span class="text-gray-400">No usage</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700">
              <% if stats && stats[:fallback_total] > 0 %>
                <%= stats[:fallback_rate] %>%
                <span class="text-xs text-gray-500">(<%= stats[:fallback_switched] %> of <%= stats[:fallback_total] %>)</span>
              <% else %>
                <span class="text-gray-400">&mdash;</span>
              <% end %>
            </td>
            <% quota_state = @runner_states[runner.state_key] %>
            <% quota_state ||= @runner_states[runner.runner_key] if runner.subscription? %>
            <td class="px-4 py-3 text-sm text-gray-700">
              <% if quota_state&.quota_available? %>
                <% pct = quota_state.quota_headroom_pct %>
                <% quota_color = pct >= 50 ? "text-green-700" : pct >= 20 ? "text-yellow-700" : "text-red-700" %>
                <span class="font-medium <%= quota_color %>"><%= pct %>%</span>
                <span class="text-xs text-gray-500">remaining</span>
                <% if quota_state.quota_remaining && quota_state.quota_limit %>
                  <p class="mt-0.5 text-xs text-gray-500">
                    <%= number_with_delimiter(quota_state.quota_remaining) %> / <%= number_with_delimiter(quota_state.quota_limit) %>
                    <%= quota_state.quota_unit.to_s.tr("_", " ") %>
                  </p>
                <% end %>
                <% if quota_state.quota_checked_at %>
                  <p class="mt-0.5 text-xs text-gray-400">checked <%= local_time(quota_state.quota_checked_at, format: :relative) %></p>
                <% end %>
                <% if quota_state.quota_reset_at %>
                  <p class="mt-0.5 text-xs text-gray-400">resets <%= local_time(quota_state.quota_reset_at, format: :relative) %></p>
                <% end %>
              <% elsif quota_state&.quota_stale? %>
                <span class="text-xs font-medium text-yellow-700">Stale</span>
                <p class="mt-0.5 text-xs text-gray-500">Quota routing paused until the next refresh.</p>
              <% elsif quota_state&.quota_source == "monthly_budget_missing" %>
                <span class="text-xs text-gray-500">No budget set</span>
              <% elsif quota_state&.quota_source == "provider_unsupported" %>
                <span class="text-xs text-gray-500">Reactive only</span>
                <p class="mt-0.5 text-xs text-gray-400">No upstream quota API for this runner.</p>
              <% elsif quota_state&.quota_source == "refresh_failed" %>
                <span class="text-xs text-red-600">Refresh failed</span>
                <p class="mt-0.5 text-xs text-gray-400">Routing fell back to reactive availability.</p>
              <% elsif quota_state&.quota_source == "provider_no_data" %>
                <span class="text-xs text-gray-500">No quota data</span>
                <p class="mt-0.5 text-xs text-gray-400">Routing fell back to reactive availability.</p>
              <% else %>
                <span class="text-gray-400">&mdash;</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right text-sm">
              <div class="inline">
                <button data-test-agent-target="button" data-action="test-agent#test" type="button" class="font-medium text-emerald-600 hover:text-emerald-500">Test Runner</button>
                <div data-test-agent-target="result"></div>
              </div>
              <% if runner.runner_key == Runner::OPENROUTER_FREE_RUNNER_KEY %>
                <%= link_to "Free Models", free_models_path, class: "ml-3 font-medium text-sky-600 hover:text-sky-500" %>
              <% end %>
              <%= link_to "Edit", edit_runner_path(runner), class: "ml-3 font-medium text-indigo-600 hover:text-indigo-500" %>
              <%= button_to "Delete", runner_path(runner), method: :delete, class: "ml-3 inline text-red-600 hover:text-red-500", form: { class: "inline" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "usage_stats", usage_stats: @usage_stats, runners: @runners, runner_stats_by_id: @runner_stats_by_id %>

  <%= render "provider_outcomes",
        provider_outcome_stats: @provider_outcome_stats,
        outcome_time_range: @outcome_time_range %>

  <% if @free_model_runners.any? %>
    <div class="mt-8 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-base font-semibold text-emerald-950">Free Models</h2>
          <p class="mt-1 text-sm text-emerald-900">Manage your OpenRouter free-model runner and review the synced catalog by tier.</p>
        </div>
        <div class="flex gap-3">
          <%= link_to "Open Catalog", free_models_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-emerald-900 shadow-sm ring-1 ring-inset ring-emerald-200 hover:bg-emerald-100" %>
          <%= link_to "Edit Runner", edit_runner_path(@free_model_runners.first), class: "rounded-md bg-emerald-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-8">
    <%= render "settings",
          user_setting: @user_setting,
          default_runner_identifier: @default_runner_identifier,
          enabled_agent_runners: @enabled_agent_runners,
          runner_labels: @runner_labels,
          run_enabled_runners: @run_enabled_runners,
          auto_weight_budget_warnings: @auto_weight_budget_warnings,
          goal_runner_labels: @goal_runner_labels,
          explicit_goal_default_runners: @explicit_goal_default_runners,
          runner_states: @runner_states,
          fallback_candidate_runners: @fallback_candidate_runners,
          saved_fallback_runner_tokens: @saved_fallback_runner_tokens,
          subscription_runner_identifiers: @subscription_runner_identifiers,
          runner_state_aliases: @runner_state_aliases %>
  </div>
</div>
