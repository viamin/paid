<%# @spec FEATURE-APPROVAL-020 %>
<% content_for(:title) { "Feature proposals - Paid" } %>

<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Feature proposals</h1>
    <p class="mt-1 text-sm text-gray-500">Background discovery and declined proposals stay here, separate from the actionable Inbox.</p>
  </div>

  <section class="mt-8" aria-labelledby="active-proposals-heading">
    <h2 id="active-proposals-heading" class="text-lg font-semibold text-gray-900">Active proposals</h2>
    <% if @feature_intents.any? %>
      <div class="mt-4 space-y-4">
        <% @feature_intents.each do |feature_intent| %>
          <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold text-gray-900"><%= feature_intent.title %></h3>
                <p class="mt-1 text-sm text-gray-500"><%= feature_intent.project.name %> · <%= feature_intent.status.humanize %></p>
              </div>
              <% if policy(feature_intent).cancel? %>
                <%= form_with url: cancel_feature_intent_path(feature_intent), method: :post, class: "flex flex-wrap items-end gap-3", data: { turbo_confirm: "Decline this proposal? It can later be reopened for discovery." } do |form| %>
                  <div>
                    <%= form.label :cancellation_reason, "Reason", class: "block text-xs font-medium text-gray-700" %>
                    <%= form.select :cancellation_reason, [["Already handled or duplicate", "already_handled"], ["Superseded", "superseded"], ["No longer wanted", "no_longer_wanted"]], {}, class: "mt-1 rounded-md border-gray-300 text-sm" %>
                  </div>
                  <div>
                    <%= form.label :replacement_reference, "Replacement reference (optional)", class: "block text-xs font-medium text-gray-700" %>
                    <%= form.url_field :replacement_reference, class: "mt-1 rounded-md border-gray-300 text-sm", placeholder: "https://github.com/org/repo/pull/123" %>
                  </div>
                  <%= form.submit "Decline", class: "inline-flex items-center rounded-md border border-red-300 bg-white px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
                <% end %>
              <% end %>
            </div>
            <% if feature_intent.brief.present? %>
              <p class="mt-3 whitespace-pre-line text-sm text-gray-600"><%= feature_intent.brief %></p>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-gray-500">No active feature proposals.</p>
    <% end %>
  </section>

  <section class="mt-10" aria-labelledby="declined-proposals-heading">
    <h2 id="declined-proposals-heading" class="text-lg font-semibold text-gray-900">Declined proposals</h2>
    <% if @cancelled_feature_intents.any? %>
      <div class="mt-4 space-y-4">
        <% @cancelled_feature_intents.each do |feature_intent| %>
          <article class="rounded-lg border border-gray-200 bg-gray-50 p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 class="font-semibold text-gray-900"><%= feature_intent.title %></h3>
                <p class="mt-1 text-sm text-gray-500"><%= feature_intent.project.name %> · declined <%= time_ago_in_words(feature_intent.cancelled_at || feature_intent.updated_at) %> ago</p>
                <p class="mt-1 text-sm text-gray-600">Reason: <%= feature_intent.cancellation_reason&.humanize || "Not recorded" %></p>
                <% if feature_intent.replacement_reference.present? %>
                  <p class="mt-1 text-sm text-gray-600">Replacement: <%= link_to feature_intent.replacement_reference, feature_intent.replacement_reference, class: "text-indigo-600 hover:text-indigo-500" %></p>
                <% end %>
              </div>
              <% if policy(feature_intent).reopen? %>
                <%= button_to "Reopen for discovery", reopen_feature_intent_path(feature_intent), method: :post, class: "inline-flex items-center rounded-md bg-teal-600 px-3 py-2 text-sm font-semibold text-white hover:bg-teal-500", form: { data: { turbo_confirm: "Reopen this proposal for discovery?" } } %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-gray-500">No declined feature proposals.</p>
    <% end %>
  </section>
</div>
