<% content_for :title do %><%= @prompt.name %> - Prompts - Paid<% end %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to prompts_path, class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to Prompts
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-semibold text-gray-900"><%= @prompt.name %></h1>
          <p class="mt-1 text-sm text-gray-500 font-mono"><%= @prompt.slug %></p>
        </div>
        <div class="flex items-center space-x-3">
          <%= prompt_scope_badge(@prompt) %>
          <% if @prompt.active? %>
            <span class="inline-flex items-center rounded-md bg-green-100 px-3 py-1 text-sm font-medium text-green-700">Active</span>
          <% else %>
            <span class="inline-flex items-center rounded-md bg-gray-100 px-3 py-1 text-sm font-medium text-gray-600">Inactive</span>
          <% end %>
          <% if policy(@prompt).update? %>
            <%= link_to edit_prompt_path(@prompt), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
              <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
              </svg>
              Edit
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200">
      <dl class="divide-y divide-gray-200">
        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Category</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <%= prompt_category_badge(@prompt.category) %>
          </dd>
        </div>

        <% if @prompt.description.present? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Description</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @prompt.description %></dd>
          </div>
        <% end %>

        <% if @prompt.project.present? %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Project</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
              <%= link_to @prompt.project.name, project_path(@prompt.project), class: "text-indigo-600 hover:text-indigo-900" %>
            </dd>
          </div>
        <% end %>

        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Current Version</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <% if @prompt.current_version %>
              v<%= @prompt.current_version.version %>
            <% else %>
              <span class="text-gray-400">No versions yet</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <% if @prompt.current_version %>
    <div class="mt-8 bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:px-6">
        <h2 class="text-lg font-medium text-gray-900">Current Template</h2>
        <p class="mt-1 text-sm text-gray-500">Version <%= @prompt.current_version.version %> template content.</p>
      </div>
      <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
        <pre class="overflow-x-auto rounded-lg bg-gray-50 p-4 text-sm text-gray-800 font-mono whitespace-pre-wrap"><%= @prompt.current_version.template %></pre>

        <% if @prompt.current_version.system_prompt.present? %>
          <div class="mt-4">
            <h3 class="text-sm font-medium text-gray-700">System Prompt</h3>
            <pre class="mt-2 overflow-x-auto rounded-lg bg-gray-50 p-4 text-sm text-gray-800 font-mono whitespace-pre-wrap"><%= @prompt.current_version.system_prompt %></pre>
          </div>
        <% end %>

        <% if @prompt.current_version.variables.present? && @prompt.current_version.variables.any? %>
          <div class="mt-4">
            <h3 class="text-sm font-medium text-gray-700">Variables</h3>
            <div class="mt-2 flex flex-wrap gap-2">
              <% @prompt.current_version.variables.each do |var| %>
                <code class="rounded bg-indigo-50 px-2 py-1 text-xs font-mono text-indigo-700">{{<%= variable_display_name(var) %>}}</code>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h2 class="text-lg font-medium text-gray-900">Version History</h2>
      <p class="mt-1 text-sm text-gray-500">All versions of this prompt template. Previous versions are immutable.</p>
    </div>
    <div class="border-t border-gray-200">
      <% if @versions.any? %>
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Version</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Change Notes</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Created By</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Created At</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Usage</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                <span class="sr-only">Compare</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @versions.each do |version| %>
              <tr class="<%= 'bg-indigo-50' if version == @prompt.current_version %>">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
                  <span class="font-medium text-gray-900">v<%= version.version %></span>
                  <% if version == @prompt.current_version %>
                    <span class="ml-2 inline-flex items-center rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">current</span>
                  <% end %>
                </td>
                <td class="px-3 py-4 text-sm text-gray-500">
                  <%= version.change_notes.presence || "-" %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= version.created_by_user&.email || version.created_by || "-" %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= version.created_at.strftime("%b %d, %Y %H:%M") %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= version.usage_count %> runs
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                  <% if version.parent_version_id.present? %>
                    <%= link_to "Diff",
                      diff_prompt_path(@prompt, a: version.parent_version_id, b: version.id),
                      class: "text-indigo-600 hover:text-indigo-900" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-4 py-8 text-center text-sm text-gray-500">
          No versions yet. Edit this prompt to create the first version.
        </div>
      <% end %>
    </div>
  </div>

  <% if policy(@prompt).destroy? %>
    <div class="mt-8 bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="sm:flex sm:items-start sm:justify-between">
          <div>
            <h3 class="text-base font-semibold leading-6 text-gray-900">Delete Prompt</h3>
            <div class="mt-2 max-w-xl text-sm text-gray-500">
              <p>Permanently remove this prompt and all its versions. This action cannot be undone.</p>
            </div>
          </div>
          <div class="mt-5 sm:ml-6 sm:mt-0 sm:flex sm:flex-shrink-0 sm:items-center">
            <%= button_to "Delete Prompt", prompt_path(@prompt), method: :delete, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500", form: { data: { turbo_confirm: "Are you sure you want to delete this prompt? All versions will be permanently deleted." } } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
