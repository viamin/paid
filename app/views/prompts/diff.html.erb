<% content_for(:title) { "Diff v#{@version_a.version} / v#{@version_b.version} - #{@prompt.name} - Paid" } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to prompt_path(@prompt), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to Prompt
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h1 class="text-xl font-semibold text-gray-900">Version Diff: <%= @prompt.name %></h1>
      <p class="mt-1 text-sm text-gray-500">
        Comparing version <%= @version_a.version %> with version <%= @version_b.version %>.
      </p>
    </div>

    <div class="border-t border-gray-200">
      <div class="grid grid-cols-2 divide-x divide-gray-200">
        <div class="px-4 py-3 bg-gray-50">
          <span class="text-sm font-medium text-gray-900">v<%= @version_a.version %></span>
          <span class="ml-2 text-xs text-gray-500"><%= @version_a.created_at.strftime("%b %d, %Y %H:%M") %></span>
          <% if @version_a.change_notes.present? %>
            <p class="mt-1 text-xs text-gray-500"><%= @version_a.change_notes %></p>
          <% end %>
        </div>
        <div class="px-4 py-3 bg-gray-50">
          <span class="text-sm font-medium text-gray-900">v<%= @version_b.version %></span>
          <span class="ml-2 text-xs text-gray-500"><%= @version_b.created_at.strftime("%b %d, %Y %H:%M") %></span>
          <% if @version_b == @prompt.current_version %>
            <span class="ml-2 inline-flex items-center rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">current</span>
          <% end %>
          <% if @version_b.change_notes.present? %>
            <p class="mt-1 text-xs text-gray-500"><%= @version_b.change_notes %></p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-200">
      <div class="px-4 py-3 bg-gray-50">
        <h3 class="text-sm font-medium text-gray-700">Template</h3>
      </div>
      <div class="grid grid-cols-2 divide-x divide-gray-200">
        <div class="p-4">
          <pre class="overflow-x-auto rounded-lg bg-red-50 p-4 text-sm text-gray-800 font-mono whitespace-pre-wrap"><%= @version_a.template %></pre>
        </div>
        <div class="p-4">
          <pre class="overflow-x-auto rounded-lg bg-green-50 p-4 text-sm text-gray-800 font-mono whitespace-pre-wrap"><%= @version_b.template %></pre>
        </div>
      </div>
    </div>

    <% if @version_a.system_prompt.present? || @version_b.system_prompt.present? %>
      <div class="border-t border-gray-200">
        <div class="px-4 py-3 bg-gray-50">
          <h3 class="text-sm font-medium text-gray-700">System Prompt</h3>
        </div>
        <div class="grid grid-cols-2 divide-x divide-gray-200">
          <div class="p-4">
            <% if @version_a.system_prompt.present? %>
              <pre class="overflow-x-auto rounded-lg bg-red-50 p-4 text-sm text-gray-800 font-mono whitespace-pre-wrap"><%= @version_a.system_prompt %></pre>
            <% else %>
              <p class="text-sm text-gray-400 italic">No system prompt</p>
            <% end %>
          </div>
          <div class="p-4">
            <% if @version_b.system_prompt.present? %>
              <pre class="overflow-x-auto rounded-lg bg-green-50 p-4 text-sm text-gray-800 font-mono whitespace-pre-wrap"><%= @version_b.system_prompt %></pre>
            <% else %>
              <p class="text-sm text-gray-400 italic">No system prompt</p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="border-t border-gray-200">
      <div class="px-4 py-3 bg-gray-50">
        <h3 class="text-sm font-medium text-gray-700">Variables</h3>
      </div>
      <div class="grid grid-cols-2 divide-x divide-gray-200">
        <div class="p-4">
          <% if @version_a.variables.present? && @version_a.variables.any? %>
            <div class="flex flex-wrap gap-2">
              <% @version_a.variables.each do |var| %>
                <code class="rounded bg-gray-100 px-2 py-1 text-xs font-mono text-gray-700">{{<%= var %>}}</code>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-400 italic">No variables</p>
          <% end %>
        </div>
        <div class="p-4">
          <% if @version_b.variables.present? && @version_b.variables.any? %>
            <div class="flex flex-wrap gap-2">
              <% @version_b.variables.each do |var| %>
                <code class="rounded bg-gray-100 px-2 py-1 text-xs font-mono text-gray-700">{{<%= var %>}}</code>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-400 italic">No variables</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
