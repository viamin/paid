<% content_for :title do %>Edit <%= @prompt.name %> - Prompts - Paid<% end %>

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to prompt_path(@prompt), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      Back to Prompt
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <h1 class="text-xl font-semibold text-gray-900">Edit Prompt</h1>
      <p class="mt-1 text-sm text-gray-500">
        Update <strong><%= @prompt.name %></strong>. Changing the template creates a new version (previous versions are immutable).
      </p>

      <%= render "form", prompt: @prompt, projects: @projects, url: prompt_path(@prompt), method: :patch %>
    </div>
  </div>
</div>
