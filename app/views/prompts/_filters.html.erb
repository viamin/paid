<div class="mt-4 rounded-lg bg-white p-4 shadow ring-1 ring-black ring-opacity-5">
  <%= search_form_for q, url: request.path, html: { method: :get, class: "flex flex-wrap items-end gap-4" } do |f| %>
    <div>
      <%= f.label :category_eq, "Category", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :category_eq,
        options_for_select(Prompt::CATEGORIES.map { |c| [c.titleize, c] }, params.dig(:q, :category_eq)),
        { include_blank: "All Categories" },
        class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :active_eq, "Status", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :active_eq,
        options_for_select([["Active", "true"], ["Inactive", "false"]], params.dig(:q, :active_eq)),
        { include_blank: "All" },
        class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :name_cont, "Name", class: "block text-sm font-medium text-gray-700" %>
      <%= f.search_field :name_cont,
        placeholder: "Search prompts...",
        class: "mt-1 block rounded-md border-gray-300 py-2 pl-3 pr-3 text-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
    </div>

    <div class="flex items-end gap-2">
      <%= f.submit "Filter",
        class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <%= link_to "Clear",
        request.path,
        class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
