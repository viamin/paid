<h2 class="text-lg font-semibold text-gray-900">Start with a chat key</h2>
<p class="mt-1 text-sm text-gray-500">Choose one provider key. Paid uses it only to start your setup chat and encrypts it at rest.</p>

<%= form_with url: onboarding_path, method: :patch, class: "mt-6" do |form| %>
  <div class="space-y-6">
    <div>
      <%= form.label "chat_api_key[api_service_type]", "Provider", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.select "chat_api_key[api_service_type]", RunnerSupport.api_service_types.map { |service_type, label| ["#{label} — #{onboarding_api_key_guidance(service_type)}", service_type] }, { selected: "openrouter" }, class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label "chat_api_key[api_key]", "API key", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <div class="mt-2">
        <%= form.password_field "chat_api_key[api_key]", autocomplete: "off", spellcheck: false, required: true, class: "block w-full rounded-md border-0 px-3 py-1.5 font-mono text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
      </div>
      <p class="mt-1 text-xs text-gray-500">OpenRouter is recommended: it has free models and one key works with many providers. Other providers may require a paid account or have their own free tier.</p>
    </div>
  </div>

  <%= form.hidden_field :step, value: "chat_api_key" %>
  <div class="mt-6 flex justify-end">
    <%= form.submit "Start setup chat", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
