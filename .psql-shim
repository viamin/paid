#!/usr/bin/env ruby
require 'pg'
require 'uri'

file = nil
dbname = nil

args = ARGV.dup
i = 0
while i < args.length
  case args[i]
  when '--file', '-f'
    file = args[i + 1]
    i += 2
  when '--quiet', '-q', '--no-psqlrc'
    i += 1
  when '--set'
    i += 2
  when '--output', '-o'
    i += 2
  else
    dbname = args[i] unless args[i].to_s.start_with?('-')
    i += 1
  end
end

if file && dbname
  db_url = ENV['DATABASE_URL'] || ''
  uri = URI.parse(db_url)
  conn = PG.connect(host: uri.host, port: uri.port, user: uri.user, password: uri.password, dbname: dbname)
  sql = File.read(file)
  # Replace search_path reset that causes issues - keep everything in public schema
  sql = sql.gsub("SELECT pg_catalog.set_config('search_path', '', false);", "SET search_path TO public;")
  conn.exec(sql)
  conn.close
end
