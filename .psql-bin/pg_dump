#!/bin/bash
# Minimal pg_dump shim for development environments without full PostgreSQL client.
# Writes a minimal structure.sql that just records this was a shim dump.
OUTPUT_FILE=""
DB=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --file|-f) OUTPUT_FILE="$2"; shift 2;;
    --schema-only|--no-privileges|--no-owner) shift;;
    *) DB="$1"; shift;;
  esac
done
if [ -n "$OUTPUT_FILE" ]; then
  # Just touch the file so Rails doesn't error; the real structure.sql is in git
  touch "$OUTPUT_FILE"
fi
exit 0
