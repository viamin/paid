#!/bin/bash
# Shim for pg_dump - writes a minimal valid structure file for Rails
OUTPUT_FILE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --file) OUTPUT_FILE="$2"; shift 2;;
    --schema-only|--no-privileges|--no-owner) shift;;
    *) shift;;
  esac
done
if [ -n "$OUTPUT_FILE" ]; then
  echo "-- pg_dump shim output" > "$OUTPUT_FILE"
fi
exit 0
