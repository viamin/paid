{
  "consumer": {
    "name": "paid-mobile-api-schema"
  },
  "provider": {
    "name": "paid-mobile-api"
  },
  "interactions": [
    {
      "description": "returns the count for the authenticated mobile inbox",
      "request": {
        "method": "GET",
        "path": "/api/v1/inbox/count"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "count": 1
        },
        "matchingRules": {
          "body": {
            "$.count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}
