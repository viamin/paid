#!/usr/bin/env bash
# @spec REPO-SECRET-SCAN-001, REPO-SECRET-SCAN-002
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/.." && pwd)"

gitleaks_bin="${GITLEAKS_BIN:-$("${repo_root}/bin/install-gitleaks" --print-path)}"
mode="${1:---repo}"

run_staged_scan() {
  echo "== Security: Secret scan (staged) =="

  if "${gitleaks_bin}" protect --staged --redact --no-banner; then
    return
  fi

  echo "Secret scan failed: remove the credential or add a narrow Gitleaks allowlist." >&2
  exit 1
}

run_repo_scan() {
  local scan_root

  echo "== Security: Secret scan =="
  scan_root="$(mktemp -d "${TMPDIR:-/tmp}/paid-gitleaks-repo.XXXXXX")"
  trap 'rm -rf "${scan_root:-}"' RETURN

  while IFS= read -r -d '' path; do
    [[ -f "${path}" ]] || continue

    mkdir -p "${scan_root}/$(dirname "${path}")"
    cp -p "${path}" "${scan_root}/${path}"
  done < <(git ls-files -z)

  (
    cd "${scan_root}"
    "${gitleaks_bin}" dir --redact --no-banner \
      --config "${repo_root}/.gitleaks.toml" \
      --gitleaks-ignore-path "${repo_root}/.gitleaksignore" \
      .
  )
}

cd "${repo_root}"

case "${mode}" in
  --staged)
    run_staged_scan
    ;;
  --repo)
    run_repo_scan
    ;;
  *)
    echo "Usage: bin/secret-scan [--staged|--repo]" >&2
    exit 1
    ;;
esac
