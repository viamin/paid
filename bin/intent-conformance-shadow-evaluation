#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require "securerandom"
require_relative "../lib/intent_conformance/shadow_evaluation_ledger"
require_relative "../lib/intent_conformance/shadow_evaluation_policy"
require_relative "../lib/intent_conformance/shadow_evaluation_worksheet"

module IntentConformance
  # @spec INTENT-CONFORMANCE-ROLLOUT-002
  # @spec INTENT-CONFORMANCE-ROLLOUT-005
  # @spec INTENT-CONFORMANCE-ROLLOUT-007 INTENT-CONFORMANCE-ROLLOUT-011
  module ShadowEvaluationCli
    COMMANDS = %w[init append validate shadow-run compile].freeze
    EXECUTE_COMMAND = %(bin/rails "intent_conformance:shadow_evaluation:execute[<evaluation-id>]")

    module_function

    def call(argv)
      command = argv.shift
      abort "usage: #{$PROGRAM_NAME} {init|append|validate|shadow-run|compile} --manifest PATH --ledger PATH --manifest-commit SHA" unless COMMANDS.include?(command)

      options = parse(argv)
      case command
      when "init" then init(options)
      when "append" then append(options)
      when "validate" then validate(options)
      when "shadow-run" then shadow_run(options)
      when "compile" then compile(options)
      end
    rescue ShadowEvaluationLedger::PendingHumanInput => error
      warn error.message
      exit 2
    rescue ShadowEvaluationLedger::InvalidLedger => error
      warn "invalid shadow-evaluation ledger: #{error.message}"
      exit 1
    rescue OptionParser::ParseError => error
      warn "invalid shadow-evaluation ledger: #{error.message}"
      exit 1
    end

    def parse(argv)
      options = {}
      OptionParser.new do |parser|
        parser.on("--manifest PATH") { |value| options[:manifest] = value }
        parser.on("--ledger PATH") { |value| options[:ledger] = value }
        parser.on("--manifest-commit SHA") { |value| options[:manifest_commit] = value }
        parser.on("--policy POLICY") { |value| options[:policy] = value }
        parser.on("--maintainer IDENTITY") { |value| options[:maintainer] = value }
        parser.on("--event JSON") do |value|
          options[:event] = JSON.parse(value)
        rescue JSON::ParserError => error
          raise ShadowEvaluationLedger::InvalidLedger, "--event is not valid JSON: #{error.message}"
        end
      end.parse!(argv)
      %i[manifest ledger manifest_commit].each do |key|
        raise ShadowEvaluationLedger::InvalidLedger, "--#{key.to_s.tr('_', '-')} is required" if options[key].to_s.strip.empty?
      end
      options
    end

    # Records the explicitly selected evaluation policy before any label.
    # Omitting `init` keeps the two-operator team policy; a solo evaluation
    # must name its single authenticated maintainer up front.
    def init(options)
      policy = options[:policy].to_s
      policy = ShadowEvaluationPolicy::DEFAULT_POLICY if policy.empty?
      raise ShadowEvaluationLedger::InvalidLedger, "--policy must be one of #{ShadowEvaluationPolicy::POLICIES.join('|')}" unless ShadowEvaluationPolicy::POLICIES.include?(policy)
      raise ShadowEvaluationLedger::InvalidLedger, "--maintainer is required for the solo policy" if policy == "solo" && options[:maintainer].to_s.strip.empty?

      event = {
        "event_id" => "policy-#{SecureRandom.uuid}",
        "type" => "evaluation_policy",
        "policy" => policy,
        "maintainer" => options[:maintainer].to_s,
        "recorded_at" => Time.now.utc.iso8601,
        "manifest_commit" => options[:manifest_commit]
      }
      ShadowEvaluationLedger.append!(path: options[:ledger], event: event, manifest_path: options[:manifest])
    end

    def append(options)
      raise ShadowEvaluationLedger::InvalidLedger, "--event is required" unless options[:event]
      raise ShadowEvaluationLedger::InvalidLedger, "--event must be a JSON object" unless options[:event].is_a?(Hash)

      event = options[:event].merge("manifest_commit" => options[:manifest_commit])
      ShadowEvaluationLedger.append!(path: options[:ledger], event: event, manifest_path: options[:manifest])
    end

    def validate(options)
      ShadowEvaluationLedger.validate!(**ledger_options(options))
      puts "valid"
    end

    # Prerequisite validation only: the ledger proves adjudications are
    # frozen, it never executes the reviewer. The documented execute command
    # (and only it) runs the real reviewer end to end.
    def shadow_run(options)
      ShadowEvaluationLedger.ready_for_shadow_run!(**ledger_options(options))
      raise ShadowEvaluationLedger::PendingHumanInput,
        "prerequisites validated, but nothing has executed: run the real reviewer with `#{EXECUTE_COMMAND}` (see docs/intent/intent-conformance-rollout/solo-maintainer-evaluation-runbook.md)"
    end

    def compile(options)
      puts ShadowEvaluationWorksheet.compile(**ledger_options(options))
    end

    def ledger_options(options)
      { manifest_path: options[:manifest], ledger_path: options[:ledger], manifest_commit: options[:manifest_commit] }
    end
  end
end

IntentConformance::ShadowEvaluationCli.call(ARGV)
