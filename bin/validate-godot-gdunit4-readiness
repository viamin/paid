#!/usr/bin/env bash
set -euo pipefail

# Runs PROJECT-READINESS-009 in an isolated, disposable Godot/gdUnit4 checkout.
# Nothing downloaded here is written to the Paid working tree.
readonly GODOT_VERSION="4.4.1"
validation_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly validation_root
validation_temp_dir="$(mktemp -d)"
readonly validation_temp_dir
readonly FIXTURE_DIR="${validation_temp_dir}/godot-gdunit4-ready"
readonly GODOT_ARCHIVE="${validation_temp_dir}/godot.zip"
readonly GODOT_DIR="${validation_temp_dir}/godot"

case "$(uname -m)" in
  x86_64)
    GODOT_ARCH="x86_64"
    GODOT_SHA512="ef4e76880a514257175544952c61191106fdef3095b909bafed9fcbeb230c3e5533920a0f3012882dd4bbde83028a67549825794e2d2c3cf76eba7918b71370e"
    ;;
  aarch64|arm64)
    GODOT_ARCH="arm64"
    GODOT_SHA512="8af79fe5fbc4cc42f5a7e4a52bd124973e084218f4d299cb5400595c6083ca800a59770c9c289b622dfc164fc3c6f369b362134ea2ac44223361657ea7941b09"
    ;;
  *) echo "Unsupported Godot validation architecture: $(uname -m)" >&2; exit 1 ;;
esac

cleanup() {
  rm -rf "${validation_temp_dir}"
}
trap cleanup EXIT

mkdir -p "${GODOT_DIR}"
curl --fail --location --retry 3 --connect-timeout 10 --max-time 180 \
  --output "${GODOT_ARCHIVE}" \
  "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}.zip"
echo "${GODOT_SHA512}  ${GODOT_ARCHIVE}" | sha512sum --check --status
unzip -q "${GODOT_ARCHIVE}" -d "${GODOT_DIR}"

cp -R "${validation_root}/spec/fixtures/projects/godot-gdunit4-ready/." "${FIXTURE_DIR}"
GODOT_BIN="${GODOT_DIR}/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}" \
  "${FIXTURE_DIR}/bin/install-test-tools"

"${GODOT_DIR}/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}" --headless --path "${FIXTURE_DIR}" --editor --quit

if GODOT_BIN="${GODOT_DIR}/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}" \
  "${FIXTURE_DIR}/bin/test"; then
  echo "Expected intentionally red gdUnit4 fixture to fail" >&2
  exit 1
fi

GODOT_GDUNIT4_FIXTURE_PATH="${FIXTURE_DIR}" \
GODOT_BIN="${GODOT_DIR}/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}" \
bundle exec rspec spec/requests/godot_gdunit4_readiness_lifecycle_spec.rb --tag godot_gdunit4
