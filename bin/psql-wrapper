#!/usr/bin/env ruby
# Minimal psql replacement that can load structure.sql files
# Uses the pg gem directly instead of the psql CLI binary

require "bundler/setup"
require "pg"
require "uri"

# Parse arguments
file = nil
dbname = nil
on_error_stop = false
quiet = false
output = nil

args = ARGV.dup
while args.any?
  arg = args.shift
  case arg
  when "--set"
    setting = args.shift
    on_error_stop = true if setting&.start_with?("ON_ERROR_STOP")
  when "--quiet", "-q"
    quiet = true
  when "--no-psqlrc"
    # ignore
  when "--output", "-o"
    output = args.shift
  when "--file", "-f"
    file = args.shift
  else
    dbname = arg unless arg.start_with?("-")
  end
end

unless file
  $stderr.puts "psql-wrapper: --file is required"
  exit 1
end

# Connect using DATABASE_URL or individual params
db_url = ENV["DATABASE_URL"]
if db_url
  uri = URI.parse(db_url)
  conn_params = {
    host: uri.host,
    port: uri.port || 5432,
    user: uri.user,
    password: uri.password,
    dbname: dbname || uri.path&.sub(%r{^/}, "")
  }
else
  conn_params = {
    host: ENV["DB_HOST"] || "localhost",
    port: ENV["DB_PORT"] || 5432,
    user: ENV["DB_USERNAME"] || "postgres",
    password: ENV["DB_PASSWORD"] || "",
    dbname: dbname || "paid_test"
  }
end

conn = PG.connect(conn_params)
sql = File.read(file)

begin
  conn.exec(sql)
rescue PG::Error => e
  $stderr.puts e.message
  exit 1 if on_error_stop
ensure
  conn.close
end
