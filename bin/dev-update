#!/usr/bin/env bash
#
# Dev environment auto-updater.
#
# Pulls the latest changes from main and optionally performs a full restart
# of the dev environment (Overmind stop + bin/setup).
#
# This script is intentionally standalone (no Ruby/Rails dependency) so it
# can run even when Rails cannot boot (e.g., pending migrations).
#
# Usage:
#   bin/dev-update --lightweight   # git pull only
#   bin/dev-update --full          # git pull + overmind stop + bin/setup
#   bin/dev-update --recover       # continue the recorded admission generation
#
# Safety:
#   - Must be run from the repository root.
#   - The full-restart path uses setsid to detach the overmind stop command,
#     so stopping Overmind does not kill this script even when invoked from
#     an Overmind-managed process.

set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_ROOT" || exit

# shellcheck source=bin/lib/dev_supervisor.sh
source "${APP_ROOT}/bin/lib/dev_supervisor.sh"
# shellcheck source=bin/lib/dev_worker_admission.sh
source "${APP_ROOT}/bin/lib/dev_worker_admission.sh"
trap worker_admission_cleanup EXIT

MODE="${1:---lightweight}"
LOG_PREFIX="[dev-update]"
DEFAULT_OVERMIND_SOCKET="${APP_ROOT}/.overmind.sock"
OVERMIND_SOCKET="${OVERMIND_SOCKET:-$DEFAULT_OVERMIND_SOCKET}"
if [[ "$OVERMIND_SOCKET" != /* ]]; then
  OVERMIND_SOCKET="${APP_ROOT}/${OVERMIND_SOCKET}"
fi
SCRIPT_LOG="log/dev-update/dev-update.log"
START_DEV_LOG="log/dev-update/dev-start.log"
TMUX_LOG="log/dev-update/tmux.log"
OVERMIND_LOG="log/dev-update/overmind.log"
STOPPED_OVERMIND=0
OVERMIND_STOP_POLL_COUNT="${DEV_UPDATE_OVERMIND_STOP_POLL_COUNT:-10}"
OVERMIND_START_POLL_COUNT="${DEV_UPDATE_OVERMIND_START_POLL_COUNT:-15}"
OVERMIND_POLL_INTERVAL="${DEV_UPDATE_OVERMIND_POLL_INTERVAL:-1}"
OVERMIND_HEALTHY_CONFIRM_COUNT="${DEV_UPDATE_OVERMIND_HEALTHY_CONFIRM_COUNT:-2}"
WORKER_ADOPTION_POLL_COUNT="${DEV_UPDATE_WORKER_ADOPTION_POLL_COUNT:-120}"
STARTUP_CLEANUP_KILL_ALL="${DEV_UPDATE_STARTUP_CLEANUP_KILL_ALL:-}"
STASHED_CHANGES=0
FAILURE_LOCK_FILE="${APP_ROOT}/tmp/dev-update-failure.lock"
FAILURE_REASON_FILE="${FAILURE_LOCK_FILE}.reason"
MAX_CONSECUTIVE_FAILURES="${DEV_UPDATE_MAX_CONSECUTIVE_FAILURES:-3}"

newline_list_to_csv() {
  printf '%s' "${1:-}" | tr '\n' ',' | sed 's/,$//'
}

# Worker-loaded application code requires the full restart path: the
# long-lived Temporal workers (worker_poll, worker_agent) and the GoodJob
# jobs process boot Rails once and keep the constants they loaded, so a git
# pull alone cannot make them run new code. Web-autoloaded code
# (controllers, views) and docs/specs stay lightweight. This list must stay
# in sync with Activities::TriggerDevEnvironmentUpdateActivity::FULL_RESTART_PATTERNS.
# @spec DEVELOPMENT-ENVIRONMENT-UPDATE-002
restart_required_for_file() {
  local file="$1"

  case "$file" in
    app/temporal/*|app/services/*|app/models/*|app/jobs/*|config/*|db/migrate/*|bin/*|lib/*|Procfile*)
      return 0
      ;;
    Gemfile|Gemfile.lock|package.json|package-lock.json|yarn.lock)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

restart_required_from_trigger_context() {
  local file

  if [ -n "${DEV_UPDATE_RESTART_TRIGGER_FILES:-}" ]; then
    return 0
  fi

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    if restart_required_for_file "$file"; then
      return 0
    fi
  done <<< "${DEV_UPDATE_CHANGED_FILES:-}"

  return 1
}

migrations_changed_in() {
  local files="$1"
  local file

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    case "$file" in
      db/migrate/*)
        return 0
        ;;
    esac
  done <<< "$files"

  return 1
}

migrations_changed() {
  migrations_changed_in "${DEV_UPDATE_RESTART_TRIGGER_FILES:-}" ||
    migrations_changed_in "${DEV_UPDATE_CHANGED_FILES:-}" ||
    migrations_changed_in "$PULL_CHANGED_FILES"
}

migrations_changed_in_trigger_context() {
  migrations_changed_in "${DEV_UPDATE_RESTART_TRIGGER_FILES:-}" ||
    migrations_changed_in "${DEV_UPDATE_CHANGED_FILES:-}"
}

log() {
  echo "$LOG_PREFIX $(date '+%Y-%m-%d %H:%M:%S') $*"
}

MAX_LOG_BYTES="${DEV_UPDATE_MAX_LOG_BYTES:-524288}"  # 512 KB default
KEEP_LOG_BYTES="${DEV_UPDATE_KEEP_LOG_BYTES:-102400}" # 100 KB tail to keep

truncate_log_if_oversized() {
  local file="$1"
  [ -f "$file" ] || return 0
  local size
  size="$(wc -c < "$file")"
  if [ "$size" -gt "$MAX_LOG_BYTES" ]; then
    local tmp="${file}.trim"
    tail -c "$KEEP_LOG_BYTES" "$file" > "$tmp"
    mv "$tmp" "$file"
  fi
}

truncate_dev_update_logs() {
  truncate_log_if_oversized "$SCRIPT_LOG"
  truncate_log_if_oversized "$START_DEV_LOG"
  truncate_log_if_oversized "$TMUX_LOG"
  truncate_log_if_oversized "$OVERMIND_LOG"
}

tree_is_dirty() {
  # Exclude .worktrees/ — sibling git worktrees live there and always appear
  # untracked in the primary checkout; they are not changes to stash or commit.
  [ -n "$(git status --porcelain -- . ':(exclude).worktrees' 2>/dev/null)" ]
}

stash_dirty_tree() {
  if tree_is_dirty; then
    log "Working tree has uncommitted changes; auto-stashing..."
    local pre_stash_ref
    pre_stash_ref="$(git rev-parse --verify -q refs/stash 2>/dev/null || true)"
    local stash_output
    # @spec DEVELOPMENT-ENVIRONMENT-UPDATE-001
    if ! stash_output="$(git stash push --include-untracked -m "dev-update-autostash" 2>&1)"; then
      log_command_output "git stash" "$stash_output"
      record_failure "git-stash"
      # A full restart may have stopped Overmind before pulling; bring it back
      # before exiting so a stash failure does not leave dev down. No-op when
      # this invocation never stopped Overmind.
      recover_dev_if_needed
      fail "git stash push failed. Resolve the Git error and rerun bin/dev-update."
    fi
    log_command_output "git stash" "$stash_output"
    # A zero exit status does not prove this invocation created a stash: if
    # another process cleans the tree between tree_is_dirty and the push, Git
    # exits 0 with "No local changes to save" without moving refs/stash. Claim
    # ownership only when refs/stash actually changed, so unstash_dirty_tree
    # never pops an unrelated pre-existing dev-update-autostash entry.
    local post_stash_ref
    post_stash_ref="$(git rev-parse --verify -q refs/stash 2>/dev/null || true)"
    if [ "$pre_stash_ref" != "$post_stash_ref" ]; then
      STASHED_CHANGES=1
    else
      log "Auto-stash created no stash entry; skipping restore."
    fi
  fi
}

unstash_dirty_tree() {
  if [ "$STASHED_CHANGES" -eq 1 ]; then
    log "Restoring auto-stashed changes..."
    local pop_output
    if ! pop_output="$(git stash pop 2>&1)"; then
      log_command_output "git stash pop" "$pop_output"
      # Abort on conflict — continuing with a conflicted tree would leave the
      # repo in a broken state that downstream steps (bin/setup, restart) cannot
      # recover from.  The stash entry is preserved so the user can resolve
      # manually with `git stash pop`.
      record_failure "stash-pop-conflict"
      fail "git stash pop failed (conflict). Resolve manually with 'git stash pop'."
    else
      log_command_output "git stash pop" "$pop_output"
    fi
    STASHED_CHANGES=0
  fi
}

check_failure_lock() {
  mkdir -p "$(dirname "$FAILURE_LOCK_FILE")"
  if [ -f "$FAILURE_LOCK_FILE" ]; then
    local count
    count="$(cat "$FAILURE_LOCK_FILE")"
    if [ "$count" -ge "$MAX_CONSECUTIVE_FAILURES" ]; then
      if failure_lock_can_self_clear; then
        clear_failure_lock "Cleared failure lock after resolved working-tree condition."
        return 0
      fi

      log "ERROR: $count consecutive pull failures detected. Manual intervention required."
      log "Remove $FAILURE_LOCK_FILE after resolving the working tree issue."
      exit 1
    fi
  fi
}

record_failure() {
  local reason="${1:-unknown}"
  mkdir -p "$(dirname "$FAILURE_LOCK_FILE")"
  local count=0
  [ -f "$FAILURE_LOCK_FILE" ] && count="$(cat "$FAILURE_LOCK_FILE")"
  count=$((count + 1))
  echo "$count" > "$FAILURE_LOCK_FILE"
  echo "$reason" > "$FAILURE_REASON_FILE"
  log "Recorded pull failure ($count/$MAX_CONSECUTIVE_FAILURES)."
}

clear_failure_lock() {
  if [ -f "$FAILURE_LOCK_FILE" ]; then
    local message="${1:-Cleared failure lock after successful pull.}"
    rm -f "$FAILURE_LOCK_FILE" "$FAILURE_REASON_FILE"
    log "$message"
  fi
}

failure_lock_can_self_clear() {
  local reason=""
  [ -f "$FAILURE_REASON_FILE" ] && reason="$(cat "$FAILURE_REASON_FILE")"

  if [ "$reason" = "dirty-non-main" ] && ! tree_is_dirty; then
    log "Failure lock was caused by dirty non-main branch, but the working tree is clean now; retrying update."
    return 0
  fi

  # Older lock files only stored a count. If the updater is still on a clean
  # non-main branch, this matches the historical dirty-branch failure shape and
  # lets the next run switch to main instead of requiring manual lock removal.
  if [ -z "$reason" ] && ! tree_is_dirty; then
    local current_branch
    current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ -n "$current_branch" ] && [ "$current_branch" != "main" ]; then
      log "Legacy failure lock found on clean non-main branch; retrying update."
      return 0
    fi
  fi

  return 1
}

configure_logging() {
  mkdir -p "$(dirname "$SCRIPT_LOG")"
  truncate_dev_update_logs
  dev_supervisor_prepare_logging

  if [ -t 1 ]; then
    exec > >(tee -a "$SCRIPT_LOG") 2>&1
  else
    exec >>"$SCRIPT_LOG" 2>&1
  fi
}

log_trigger_context() {
  log "Trigger source: ${DEV_UPDATE_TRIGGER_SOURCE:-unknown}"
  log "Requested mode: ${DEV_UPDATE_TRIGGER_MODE:-unknown}"
  log "Project ID: ${DEV_UPDATE_PROJECT_ID:-unknown}"
  log "PR number: ${DEV_UPDATE_PR_NUMBER:-unknown}"

  local changed_files_csv
  changed_files_csv="$(newline_list_to_csv "${DEV_UPDATE_CHANGED_FILES:-}")"
  local restart_files_csv
  restart_files_csv="$(newline_list_to_csv "${DEV_UPDATE_RESTART_TRIGGER_FILES:-}")"

  [ -z "$changed_files_csv" ] || log "Changed files: $changed_files_csv"
  [ -z "$restart_files_csv" ] || log "Restart trigger files: $restart_files_csv"
}

enforce_safe_mode() {
  if [ "$MODE" = "--lightweight" ] && restart_required_from_trigger_context; then
    log "Restart-worthy files were provided with a lightweight request; upgrading to full restart."
    MODE="--full"
  fi
}

log_command_output() {
  local label="$1"
  local output="$2"
  [ -z "$output" ] && return

  while IFS= read -r line; do
    log "${label}: ${line}"
  done <<< "$output"
}

fail() {
  log "ERROR: $*"
  exit 1
}

on_error() {
  local exit_code=$?
  local line_number="${1:-unknown}"
  local command="${2:-unknown}"
  log "ERROR: command failed at line ${line_number}: ${command} (exit ${exit_code})"
  exit "$exit_code"
}

trap 'on_error "${LINENO}" "${BASH_COMMAND}"' ERR

overmind_available() {
  command -v overmind &> /dev/null
}

overmind_running() {
  overmind_available && dev_supervisor_run_overmind overmind status &>/dev/null
}

overmind_healthy() {
  overmind_available || return 1

  local status_output
  if ! status_output="$(dev_supervisor_overmind_status_output)"; then
    return 1
  fi

  if dev_supervisor_overmind_has_dead_processes "$status_output"; then
    return 1
  fi

  if dev_supervisor_tmux_has_dead_panes; then
    return 1
  fi

  return 0
}

remove_stale_overmind_socket() {
  if [ -S "$OVERMIND_SOCKET" ] && ! overmind_running; then
    log "Removing stale Overmind socket..."
    rm -f "$OVERMIND_SOCKET"
  fi
}

ensure_on_main() {
  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"

  if [ "$current_branch" != "main" ]; then
    # Refuse to switch branches with a dirty tree — stashing would carry
    # feature-branch edits onto main when unstash_dirty_tree runs later.
    if tree_is_dirty; then
      record_failure "dirty-non-main"
      log "ERROR: Working tree on '$current_branch' has uncommitted changes. Commit or stash them before running dev-update."
      return 1
    fi
    log "Switching to main branch (currently on $current_branch)..."
    git checkout main
  fi
}

PULL_CHANGED_FILES=""

pull_latest() {
  PULL_CHANGED_FILES=""
  stash_dirty_tree
  local pre_head
  pre_head="$(git rev-parse HEAD)"

  log "Pulling latest changes from main..."
  local pull_ref="main"
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ]; then
    pull_ref="$WORKER_ADMISSION_TARGET"
  fi
  if ! git pull --ff-only origin "$pull_ref"; then
    record_failure "git-pull"
    unstash_dirty_tree
    log "ERROR: git pull --ff-only failed. Check for diverged history or upstream issues."
    return 1
  fi

  local post_head
  post_head="$(git rev-parse HEAD)"
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ] && [ "$post_head" != "$WORKER_ADMISSION_TARGET" ]; then
    log "Pinned update target disagrees with checkout; admission remains closed for recovery."
    return 1
  fi

  clear_failure_lock
  unstash_dirty_tree

  if [ "$pre_head" != "$post_head" ]; then
    PULL_CHANGED_FILES="$(git diff --name-only "$pre_head" "$post_head")"
    if [ -n "$PULL_CHANGED_FILES" ]; then
      local csv
      csv="$(newline_list_to_csv "$PULL_CHANGED_FILES")"
      log "Files changed in pull: $csv"
    fi
  fi
}

restart_required_from_pull() {
  local file

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    if restart_required_for_file "$file"; then
      return 0
    fi
  done <<< "$PULL_CHANGED_FILES"

  return 1
}

stop_overmind_services() {
  if overmind_available && [ -e "$OVERMIND_SOCKET" ]; then
    if ! overmind_running; then
      log "Detected stale Overmind socket."
      remove_stale_overmind_socket
    else
      log "Stopping Overmind (detached)..."
      # Use setsid to run overmind quit in a new session so that stopping
      # Overmind does not kill this script (which may be a child of Overmind).
      local quit_output
      if ! quit_output="$(setsid env \
        -u BUNDLE_BIN_PATH \
        -u BUNDLE_GEMFILE \
        -u BUNDLER_SETUP \
        -u BUNDLER_VERSION \
        -u RUBYLIB \
        -u RUBYOPT \
        -u RUBYGEMS_GEMDEPS \
        overmind quit 2>&1)"; then
        log "Warning: overmind quit returned a non-zero exit status."
      fi
      log_command_output "overmind quit" "$quit_output"
      STOPPED_OVERMIND=1

      # Give Overmind a moment to shut down gracefully and release its socket.
      for ((i = 0; i < OVERMIND_STOP_POLL_COUNT; i += 1)); do
        if [ ! -e "$OVERMIND_SOCKET" ]; then
          log "Overmind socket removed."
          return
        fi

        if ! overmind_running; then
          log "Overmind stopped; cleaning up socket if needed."
          break
        fi

        sleep "$OVERMIND_POLL_INTERVAL"
      done

      remove_stale_overmind_socket
      return
    fi
  fi

  if ! dev_supervisor_stop_workspace_tmux_sessions; then
    dev_supervisor_snapshot_state "dev-update-orphaned-tmux-stop-failed"
    fail "Cannot safely stop orphaned Overmind tmux session ($(dev_supervisor_workspace_tmux_identities 'unknown identity')). Inspect tmux socket/session above and stop it before rerunning bin/dev-update."
  fi

  if [ -n "$(dev_supervisor_workspace_tmux_identities)" ]; then
    log "Stopped orphaned Overmind tmux session: $(dev_supervisor_workspace_tmux_identities)."
    STOPPED_OVERMIND=1
  else
    log "Overmind not running, skipping stop."
  fi
}

# @spec DEVELOPMENT-ENVIRONMENT-UPDATE-006
stop_overmind() {
  local deadline
  [ "$STOPPED_OVERMIND" -eq 0 ] || return 0
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ]; then
    worker_admission_before_stop || fail "Worker cohort changed before stop; adoption deferred."
    deadline="$(python3 -c 'import sys,time; print(time.monotonic()+float(sys.argv[1])*float(sys.argv[2]))' "$OVERMIND_STOP_POLL_COUNT" "$OVERMIND_POLL_INTERVAL")" || return 1
  fi
  stop_overmind_services
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ]; then
    worker_admission_wait_originals "$deadline" || fail "Original worker exit could not be verified; no setup or admission resume is authorized."
    worker_admission_checkpoint stopped || fail "Stopped phase was not recorded; recover the owned generation."
  fi
}

# Drop databases left behind by removed git worktrees. bin/setup creates a
# worktree's databases via bin/ensure-worktree-databases but nothing reaps them
# when the worktree goes away, so they accumulate and exhaust Postgres
# connection slots. Best-effort: a prune failure must never abort an auto-update,
# so it runs inside an `if` (which the ERR trap ignores) and only logs warnings.
prune_worktree_databases() {
  log "Pruning orphaned worktree databases..."
  local output
  if output="$(bin/prune-worktree-databases --force 2>&1)"; then
    log_command_output "prune-worktree-databases" "$output"
  else
    log "Warning: prune-worktree-databases failed; continuing with update."
    log_command_output "prune-worktree-databases" "$output"
  fi
}

run_setup() {
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ]; then
    worker_admission_checkpoint setup || return 1
  fi
  local setup_args=(--skip-server)
  if migrations_changed; then
    setup_args+=(--skip-database)
  fi

  log "Running bin/setup ${setup_args[*]}..."
  local status=0
  # @spec POSTGRESQL-PERSISTENCE-011
  PAID_SKIP_AUTO_SCHEMA_DUMP=1 STARTUP_CLEANUP_KILL_ALL="$STARTUP_CLEANUP_KILL_ALL" \
    dev_supervisor_run_clean bin/setup "${setup_args[@]}" || status=$?
  # Mirror bin/setup's worktree-database creation by reaping orphans, but only
  # after a clean setup — the DB is in a known-good state and Ruby is available.
  [ "$status" -eq 0 ] && ! migrations_changed && prune_worktree_databases
  return "$status"
}

run_migrations_if_needed() {
  migrations_changed || return 0

  log "Migration files changed; running bin/rails db:migrate before restart..."
  local output
  if output="$(dev_supervisor_run_clean bin/ensure-worktree-databases 2>&1)"; then
    log_command_output "ensure-worktree-databases" "$output"
  else
    log_command_output "ensure-worktree-databases" "$output"
    fail "bin/ensure-worktree-databases failed. Fix database setup and rerun bin/dev-update --full."
  fi

  # @spec POSTGRESQL-PERSISTENCE-011
  if output="$(PAID_SKIP_AUTO_SCHEMA_DUMP=1 dev_supervisor_run_clean bin/rails db:migrate 2>&1)"; then
    log_command_output "db:migrate" "$output"
    log "Database migrations are current."
  else
    log_command_output "db:migrate" "$output"
    fail "bin/rails db:migrate failed. Fix the migration and rerun bin/dev-update --full."
  fi

  prune_worktree_databases
}

run_prompt_default_sync() {
  log "Synchronizing prompt defaults..."
  local output
  if output="$(dev_supervisor_run_clean bin/rails prompts:sync_defaults 2>&1)"; then
    log_command_output "prompts:sync_defaults" "$output"
  else
    log_command_output "prompts:sync_defaults" "$output"
    return 1
  fi
}

run_prompt_default_sync_or_fail() {
  run_prompt_default_sync && return 0

  recover_dev_if_needed
  fail "bin/rails prompts:sync_defaults failed. Fix the prompt definitions and rerun bin/dev-update."
}

wait_for_overmind_health() {
  local healthy_polls=0
  for ((i = 0; i < OVERMIND_START_POLL_COUNT; i += 1)); do
    if overmind_healthy; then
      healthy_polls=$((healthy_polls + 1))
    else
      healthy_polls=0
    fi

    if [ "$healthy_polls" -ge "$OVERMIND_HEALTHY_CONFIRM_COUNT" ]; then
      log "Overmind is healthy after restart."
      return 0
    fi

    sleep "$OVERMIND_POLL_INTERVAL"
  done

  if [ -e "$OVERMIND_SOCKET" ]; then
    log "Warning: Overmind restart did not become healthy before timeout. Socket still exists at $OVERMIND_SOCKET."
  else
    log "Warning: Overmind restart did not become healthy before timeout. No socket present."
  fi

  dev_supervisor_snapshot_state "dev-update-start-timeout"
  log "Inspect $START_DEV_LOG for detached bin/dev output."
  return 1
}

worker_readiness_file() {
  local mode="$1"
  if [ "$mode" = legacy_both ]; then
    printf '%s/paid-worker-ready-temporal_worker' "${TMPDIR:-/tmp}"
  else
    printf '%s/paid-worker-ready-temporal_worker-%s' "${TMPDIR:-/tmp}" "$mode"
  fi
}

# Extract the revision identity from a worker readiness JSON payload. The
# payload carries commit identity only (pid, ready_at, revision) — never
# secrets or credential data — so parsing it here is safe to log.
worker_readiness_revision() {
  local file="$1"
  [ -f "$file" ] || return 1
  sed -n 's/.*"revision"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | tail -n 1
}

worker_reports_revision() {
  local mode="$1"
  local expected_revision="$2"
  local revision
  revision="$(worker_readiness_revision "$(worker_readiness_file "$mode")")" || return 1
  [ -n "$revision" ] && [ "$revision" = "$expected_revision" ]
}

# Whether the supervisor state verifies that stopping it cannot interrupt a
# Temporal worker. An absent configured Unix control socket means no running
# Overmind can be quit gracefully, but stop_overmind still force-kills any
# same-workspace orphaned Overmind tmux session, so an absent socket is safe
# only when no such session positively hosts a Temporal worker (see
# workspace_tmux_hosts_temporal_worker). A refused present socket follows the
# same stop path after stale-socket cleanup, so it has the same qualifier. A
# successful `overmind status` with no Temporal worker process is also safe;
# every other command failure is unknown, not proof of absence.
# Readiness metadata missing against any other state is not evidence of safety
# — a worker that failed before mark_ready! (or whose flag was removed) still
# owns or has reserved work under a running supervisor.
# @spec TEMPORAL-ORCHESTRATION-019
overmind_control_socket_has_no_listener() {
  ruby -rsocket -e '
    begin
      UNIXSocket.new(ARGV.fetch(0)).close
    rescue Errno::ECONNREFUSED, Errno::ENOENT
      exit 0
    rescue SystemCallError
      exit 1
    end
    exit 1
  ' "$OVERMIND_SOCKET"
}

# Whether a same-workspace orphaned Overmind tmux session that stop_overmind
# would kill still hosts a Temporal worker. When the control socket is absent,
# stop_overmind force-kills such sessions (dev_supervisor_stop_workspace_tmux_sessions),
# and Overmind keeps each worker in a tmux window named after its Procfile
# process, so a worker_poll/worker_agent window identifies a live Temporal
# worker. awk is the terminal pipeline stage and consumes all input, so its
# exit status is deterministic under pipefail (an early-exiting reader could
# otherwise race the producer into SIGPIPE).
# @spec TEMPORAL-ORCHESTRATION-019
workspace_tmux_hosts_temporal_worker() {
  dev_supervisor_workspace_tmux_window_names |
    awk '$0 == "worker_poll" || $0 == "worker_agent" { found = 1 } END { exit(found ? 0 : 1) }'
}

# @spec TEMPORAL-ORCHESTRATION-019
verified_no_temporal_worker() {
  local status_output
  if [ ! -S "$OVERMIND_SOCKET" ]; then
    # A missing socket cannot be quit gracefully; stop_overmind force-kills any
    # same-workspace orphaned session. Defer only when such a session positively
    # hosts a Temporal worker. An uninspectable or stop-failing session is not
    # assumed worker-free here, but it is never killed either: the stop path
    # fails before setup on it (RAILS-CONTROL-PLANE-019) rather than draining.
    if workspace_tmux_hosts_temporal_worker; then
      return 1
    fi
    return 0
  fi

  if ! status_output="$(dev_supervisor_overmind_status_output)"; then
    if ! overmind_control_socket_has_no_listener || workspace_tmux_hosts_temporal_worker; then
      return 1
    fi
    return 0
  fi

  # A zero exit status does not prove the output parsed as status rows: a
  # malformed successful response finds no "worker_poll"/"worker_agent" row
  # not because none exists, but because nothing is being parsed correctly.
  # Only a recognizably valid response can stand in for verified absence.
  if ! dev_supervisor_overmind_status_well_formed "$status_output"; then
    log "ERROR: overmind status output did not match the expected PROCESS/PID/STATUS format; treating worker presence as unverified."
    return 1
  fi

  # awk is the terminal pipeline stage and consumes all input, so its exit
  # status is deterministic under pipefail (an early-exiting grep reader
  # could otherwise race a writer into SIGPIPE).
  if printf '%s\n' "$status_output" | awk 'NR > 1 && ($1 == "worker_poll" || $1 == "worker_agent") { found = 1 } END { exit(found ? 0 : 1) }'; then
    return 1
  fi
  return 0
}

# @spec TEMPORAL-ORCHESTRATION-021, DEVELOPMENT-ENVIRONMENT-UPDATE-006
wait_for_workers_to_drain() {
  local target
  [ "$WORKER_ADMISSION_ACTIVE" -eq 0 ] || return 0
  if [ ! -f "$(worker_readiness_file poll)" ] && [ ! -f "$(worker_readiness_file agent)" ] && [ ! -f "$(worker_readiness_file both)" ] && [ ! -f "$(worker_readiness_file legacy_both)" ]; then
    if verified_no_temporal_worker; then
      log "No Temporal worker readiness metadata found and no Temporal worker is running; no Temporal worker quiescence is required."
      return 0
    fi
    log "ERROR: Temporal worker readiness metadata is missing and no safe no-worker supervisor state was verified; deferring worker adoption before stopping Overmind."
    log "Inspect the configured Overmind socket and any orphaned Overmind tmux session; a failed inspection is unknown, not proof of absence."
    return 1
  fi
  if [ "${1:-}" = "before-pull" ]; then
    # Fetch does not change loaded code. Pin this exact target before a
    # migration-sensitive stop; a moving main cannot retarget the generation.
    git fetch --no-tags origin main || return 1
    target="$(git rev-parse --verify FETCH_HEAD)" || return 1
  else
    target="$(git rev-parse HEAD)" || return 1
  fi
  if ! worker_admission_begin "$target"; then
    log "ERROR: Worker does not support task-safe worker quiescence; deferring worker adoption before stopping Overmind. Complete capability and supervisor identity must both be verified."
    log "Legacy workers require the separately authorized maintenance path in TEMPORAL-ORCHESTRATION-021; readiness or activity counts are not acknowledgement."
    return 1
  fi
}

# Effective worker adoption verification: Overmind health alone cannot
# distinguish an on-disk checkout from the code the running workers actually
# loaded. Each Temporal worker publishes its booted checkout revision in its
# readiness flag payload (see lib/paid/worker_readiness.rb); a completed
# restart requires both the poll and agent workers to report the post-update
# HEAD revision within a bounded poll budget. When the expected revision
# itself cannot be resolved, verification fails closed — an unverifiable
# adoption is not a successful one. This rides the existing graceful
# Overmind stop/start path — it never force-restarts active
# workflow/activity owners or resets failed runs.
# @spec DEVELOPMENT-ENVIRONMENT-UPDATE-003
verify_worker_adoption() {
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ]; then
    worker_admission_resume "$WORKER_ADMISSION_TARGET"
    return
  fi
  local expected_revision
  expected_revision="$(git rev-parse HEAD 2>/dev/null || true)"
  if [ -z "$expected_revision" ]; then
    log "Warning: git rev-parse HEAD failed; the expected worker revision is unknown."
    log "ERROR: Worker adoption cannot be verified without the checkout revision; update cannot be considered complete. Resolve the Git checkout state and rerun bin/dev-update --full."
    return 1
  fi

  local mode
  for mode in poll agent; do
    local adopted=0
    local i
    for ((i = 0; i < WORKER_ADOPTION_POLL_COUNT; i += 1)); do
      if worker_reports_revision "$mode" "$expected_revision"; then
        log "Worker (${mode}) adopted revision ${expected_revision}."
        adopted=1
        break
      fi
      sleep "$OVERMIND_POLL_INTERVAL"
    done

    if [ "$adopted" -ne 1 ]; then
      local file
      file="$(worker_readiness_file "$mode")"
      log "Warning: ${mode} worker readiness at ${file} did not report revision ${expected_revision} within ${WORKER_ADOPTION_POLL_COUNT} polls."
      log "ERROR: Workers did not adopt the updated checkout; update cannot be considered complete."
      return 1
    fi
  done

  log "Worker adoption verified: poll and agent workers report revision ${expected_revision}."
}

start_dev() {
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ]; then
    worker_admission_checkpoint starting || return 1
    if overmind_running; then
      log "Unexpected running supervisor after a verified stop; admission remains closed."
      return 1
    fi
  fi
  mkdir -p "$(dirname "$START_DEV_LOG")"
  remove_stale_overmind_socket
  dev_supervisor_cleanup_stale_tmux_sockets

  if overmind_running; then
    log "Overmind is already running, restarting processes."
    local restart_output
    restart_output="$(dev_supervisor_run_overmind overmind restart 2>&1)"
    log_command_output "overmind restart" "$restart_output"
    log "Overmind process restart requested."
    # @spec DEVELOPMENT-ENVIRONMENT-UPDATE-003
    wait_for_overmind_health || return 1
    verify_worker_adoption
    return
  fi

  log "Starting dev environment..."
  log "Streaming detached bin/dev output to $START_DEV_LOG"
  dev_supervisor_snapshot_state "dev-update-before-start"
  # Start bin/dev detached so this script can exit cleanly.
  # Unset PORT so bin/dev applies its own default (3000) instead of
  # inheriting a per-process port assigned by the previous Overmind session.
  dev_supervisor_run_clean env -u PORT -u TMUX \
    STARTUP_CLEANUP_KILL_ALL="$STARTUP_CLEANUP_KILL_ALL" \
    nohup bin/dev >>"$START_DEV_LOG" 2>&1 &
  # `disown` is best-effort here: the detached start has already been launched,
  # and fast stubbed/failed `bin/dev` processes can disappear before Bash
  # resolves the jobspec in CI.
  disown || true
  log "Dev environment start command launched (PID $!)."

  # @spec DEVELOPMENT-ENVIRONMENT-UPDATE-003
  wait_for_overmind_health || return 1
  verify_worker_adoption
}

recover_dev_if_needed() {
  if [ "$WORKER_ADMISSION_ACTIVE" -eq 1 ] && [ "$WORKER_ADMISSION_STOPPING" -eq 1 ]; then
    log "Acknowledged update requires phase-aware recovery; no automatic restart after failed setup."
    return 0
  fi
  if [ "$STOPPED_OVERMIND" -eq 1 ] && ! overmind_healthy; then
    log "Attempting recovery start because Overmind was stopped during this update."
    if start_dev; then
      log "Recovery start succeeded."
    else
      log "Recovery start failed. Inspect $START_DEV_LOG for detached bin/dev output."
    fi
  fi
}

setup_and_start_dev() {
  if ! run_setup; then
    log "Setup failed after Overmind stop."
    recover_dev_if_needed
    fail "Full restart aborted because bin/setup --skip-server failed."
  fi
  run_migrations_if_needed
  # @spec PROMPT-DEFAULT-SYNC-007
  run_prompt_default_sync_or_fail

  if ! start_dev; then
    fail "Full restart completed setup but failed to restore a healthy Overmind session."
  fi

}

run_full_restart() {
  log "Starting full restart update..."
  if migrations_changed_in_trigger_context; then
    log "Migration files are in the trigger context; stopping Overmind before pulling to avoid Rails pending-migration errors."
    wait_for_workers_to_drain before-pull || fail "Temporal worker state was not safe to stop; the update was deferred before stopping Overmind. Resolve the reported worker state and rerun bin/dev-update --full."
    stop_overmind
  fi

  if ! ensure_on_main; then
    recover_dev_if_needed
    fail "Cannot update while the current branch has uncommitted changes."
  fi
  if ! pull_latest; then
    recover_dev_if_needed
    fail "git pull --ff-only failed. Check for diverged history or upstream issues."
  fi
  wait_for_workers_to_drain || fail "Temporal worker state was not safe to stop; the update was deferred before stopping Overmind. Resolve the reported worker state and rerun bin/dev-update --full."
  stop_overmind

  setup_and_start_dev

  log "Full restart update complete."
}

# @spec DEVELOPMENT-ENVIRONMENT-UPDATE-006
run_admission_recovery() {
  local target cohort phase stopped="" checkout
  worker_admission_load_context || fail "No valid recorded admission generation is available; inspect the workspace before requesting another update."
  target="$WORKER_ADMISSION_TARGET"
  if ! worker_admission_discover >/dev/null; then
    timeout 5 python3 "$APP_ROOT/bin/lib/worker_admission_cohort.py" --workspace "$APP_ROOT" --absent >/dev/null ||
      fail "Recovery cannot identify the complete live cohort or prove it stopped. Admission remains closed."
    stopped=stopped
  fi
  worker_admission_begin "$target" recover "$stopped" || fail "Recorded admission could not be recovered; no stop or restart is authorized."
  cohort="$(worker_admission_recovery_cohort)"
  phase="$(worker_admission_recovery_phase)"
  checkout="$(git rev-parse HEAD)" || fail "Checkout identity is unknown; admission remains closed."
  if [ "$cohort" = target ]; then
    [ "$checkout" = "$target" ] || fail "Recorded target boots disagree with the checkout; restore the pinned revision before recovery."
    worker_admission_resume "$target" || fail "Target generation could not be verified; no new restart was attempted."
    log "Recorded target generation verified; recovery required no restart."
    return
  fi
  if [ "$cohort" = stopped ]; then
    timeout 5 python3 "$APP_ROOT/bin/lib/worker_admission_cohort.py" --workspace "$APP_ROOT" --absent >/dev/null ||
      fail "Worker presence changed during stopped recovery; no stop is authorized."
    # The complete SDK cohort is already absent and all launch paths are
    # fenced. Finish stopping other supervisor processes before setup.
    stop_overmind_services
    STOPPED_OVERMIND=1
    if [ "$phase" = draining ] || [ "$phase" = stopping ]; then
      worker_admission_checkpoint stopped || fail "Stopped phase could not be recorded."
    fi
  else
    stop_overmind
  fi
  if [ "$checkout" != "$target" ]; then
    [ "$phase" != starting ] || fail "Checkout changed after setup completed; restore the pinned target before starting."
    check_failure_lock
    ensure_on_main || fail "Cannot restore the pinned target from this working tree."
    pull_latest || fail "Pinned target pull failed; admission remains closed."
  fi
  if [ "$phase" = starting ]; then
    start_dev || fail "Recorded setup completed, but target workers did not start safely."
  else
    setup_and_start_dev
  fi
  log "Recorded worker update recovery complete."
}

case "$MODE" in
  --lightweight)
    configure_logging
    log_trigger_context
    check_failure_lock
    enforce_safe_mode
    if [ "$MODE" = "--full" ]; then
      run_full_restart
      exit 0
    fi
    log "Starting lightweight update..."
    if ! ensure_on_main; then
      fail "Cannot update while the current branch has uncommitted changes."
    fi
    if ! pull_latest; then
      fail "git pull --ff-only failed. Check for diverged history or upstream issues."
    fi
    if restart_required_from_pull; then
      log "Pull included restart-worthy files outside the trigger context; upgrading to full restart."
      wait_for_workers_to_drain || fail "Temporal worker state was not safe to stop; the update was deferred before stopping Overmind. Resolve the reported worker state and rerun bin/dev-update --full."
      stop_overmind
      setup_and_start_dev

      log "Full restart update complete."
    else
      # @spec PROMPT-DEFAULT-SYNC-007
      run_prompt_default_sync_or_fail
      log "Lightweight update complete. Rails will autoload changes."
    fi
    ;;
  --recover)
    configure_logging
    log_trigger_context
    run_admission_recovery
    ;;
  --full)
    configure_logging
    log_trigger_context
    check_failure_lock
    run_full_restart
    ;;
  *)
    echo "Usage: bin/dev-update [--lightweight|--full|--recover]" >&2
    exit 1
    ;;
esac
