#!/usr/bin/env bash
#
# Dev environment auto-updater.
#
# Pulls the latest changes from main and optionally performs a full restart
# of the dev environment (Overmind stop + bin/setup).
#
# This script is intentionally standalone (no Ruby/Rails dependency) so it
# can run even when Rails cannot boot (e.g., pending migrations).
#
# Usage:
#   bin/dev-update --lightweight   # git pull only
#   bin/dev-update --full          # git pull + overmind stop + bin/setup
#
# Safety:
#   - Must be run from the repository root.
#   - The full-restart path uses setsid to detach the overmind stop command,
#     so stopping Overmind does not kill this script even when invoked from
#     an Overmind-managed process.

set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_ROOT"

MODE="${1:---lightweight}"
LOG_PREFIX="[dev-update]"
OVERMIND_SOCKET="${OVERMIND_SOCKET:-.overmind.sock}"
SCRIPT_LOG="log/dev-update/dev-update.log"
START_DEV_LOG="log/dev-update/dev-start.log"
STOPPED_OVERMIND=0
OVERMIND_STOP_POLL_COUNT="${DEV_UPDATE_OVERMIND_STOP_POLL_COUNT:-10}"
OVERMIND_START_POLL_COUNT="${DEV_UPDATE_OVERMIND_START_POLL_COUNT:-15}"
OVERMIND_POLL_INTERVAL="${DEV_UPDATE_OVERMIND_POLL_INTERVAL:-1}"

log() {
  echo "$LOG_PREFIX $(date '+%Y-%m-%d %H:%M:%S') $*"
}

configure_logging() {
  mkdir -p "$(dirname "$SCRIPT_LOG")"

  if [ -t 1 ]; then
    exec > >(tee -a "$SCRIPT_LOG") 2>&1
  else
    exec >>"$SCRIPT_LOG" 2>&1
  fi
}

log_command_output() {
  local label="$1"
  local output="$2"
  [ -z "$output" ] && return

  while IFS= read -r line; do
    log "${label}: ${line}"
  done <<< "$output"
}

fail() {
  log "ERROR: $*"
  exit 1
}

on_error() {
  local exit_code=$?
  local line_number="${1:-unknown}"
  local command="${2:-unknown}"
  log "ERROR: command failed at line ${line_number}: ${command} (exit ${exit_code})"
  exit "$exit_code"
}

trap 'on_error "${LINENO}" "${BASH_COMMAND}"' ERR

overmind_available() {
  command -v overmind &> /dev/null
}

overmind_running() {
  overmind_available && overmind status &>/dev/null
}

remove_stale_overmind_socket() {
  if [ -S "$OVERMIND_SOCKET" ] && ! overmind_running; then
    log "Removing stale Overmind socket..."
    rm -f "$OVERMIND_SOCKET"
  fi
}

ensure_on_main() {
  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"

  if [ "$current_branch" != "main" ]; then
    log "Switching to main branch (currently on $current_branch)..."
    git checkout main
  fi
}

pull_latest() {
  log "Pulling latest changes from main..."
  git pull --ff-only origin main
}

stop_overmind() {
  if overmind_available && [ -e "$OVERMIND_SOCKET" ]; then
    if ! overmind_running; then
      log "Detected stale Overmind socket."
      remove_stale_overmind_socket
      return
    fi

    log "Stopping Overmind (detached)..."
    # Use setsid to run overmind quit in a new session so that stopping
    # Overmind does not kill this script (which may be a child of Overmind).
    local quit_output
    if ! quit_output="$(setsid overmind quit 2>&1)"; then
      log "Warning: overmind quit returned a non-zero exit status."
    fi
    log_command_output "overmind quit" "$quit_output"
    STOPPED_OVERMIND=1

    # Give Overmind a moment to shut down gracefully and release its socket.
    for ((i = 0; i < OVERMIND_STOP_POLL_COUNT; i += 1)); do
      if [ ! -e "$OVERMIND_SOCKET" ]; then
        log "Overmind socket removed."
        return
      fi

      if ! overmind_running; then
        log "Overmind stopped; cleaning up socket if needed."
        break
      fi

      sleep "$OVERMIND_POLL_INTERVAL"
    done

    remove_stale_overmind_socket
  else
    log "Overmind not running, skipping stop."
  fi
}

run_setup() {
  log "Running bin/setup --skip-server..."
  bin/setup --skip-server
}

start_dev() {
  mkdir -p "$(dirname "$START_DEV_LOG")"
  remove_stale_overmind_socket

  if overmind_running; then
    log "Overmind is already running, restarting processes."
    local restart_output
    restart_output="$(overmind restart 2>&1)"
    log_command_output "overmind restart" "$restart_output"
    log "Overmind process restart requested."
    return 0
  fi

  log "Starting dev environment..."
  log "Streaming detached bin/dev output to $START_DEV_LOG"
  # Start bin/dev detached so this script can exit cleanly.
  nohup bin/dev >>"$START_DEV_LOG" 2>&1 &
  disown
  log "Dev environment start command launched (PID $!)."

  for ((i = 0; i < OVERMIND_START_POLL_COUNT; i += 1)); do
    if overmind_running; then
      log "Overmind is healthy after restart."
      return 0
    fi

    sleep "$OVERMIND_POLL_INTERVAL"
  done

  if [ -e "$OVERMIND_SOCKET" ]; then
    log "Warning: Overmind restart did not become healthy before timeout. Socket still exists at $OVERMIND_SOCKET."
  else
    log "Warning: Overmind restart did not become healthy before timeout. No socket present."
  fi

  log "Inspect $START_DEV_LOG for detached bin/dev output."
  return 1
}

recover_dev_if_needed() {
  if [ "$STOPPED_OVERMIND" -eq 1 ] && ! overmind_running; then
    log "Attempting recovery start because Overmind was stopped during this update."
    if start_dev; then
      log "Recovery start succeeded."
    else
      log "Recovery start failed. Inspect $START_DEV_LOG for detached bin/dev output."
    fi
  fi
}

run_full_restart() {
  configure_logging
  log "Starting full restart update..."
  ensure_on_main
  pull_latest
  stop_overmind

  if ! run_setup; then
    log "Setup failed after Overmind stop."
    recover_dev_if_needed
    fail "Full restart aborted because bin/setup --skip-server failed."
  fi

  if ! start_dev; then
    fail "Full restart completed setup but failed to restore a healthy Overmind session."
  fi

  log "Full restart update complete."
}

case "$MODE" in
  --lightweight)
    configure_logging
    log "Starting lightweight update..."
    ensure_on_main
    pull_latest
    log "Lightweight update complete. Rails will autoload changes."
    ;;
  --full)
    run_full_restart
    ;;
  *)
    echo "Usage: bin/dev-update [--lightweight|--full]" >&2
    exit 1
    ;;
esac
