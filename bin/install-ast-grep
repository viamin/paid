#!/usr/bin/env bash
# @spec TEST-SUITE-024, TEST-SUITE-031
set -euo pipefail

AST_GREP_VERSION="${AST_GREP_VERSION:-0.45.1}"
INSTALL_DIR="${INSTALL_DIR:-/usr/local/bin}"
AST_GREP_CACHE_DIR="${AST_GREP_CACHE_DIR:-}"

case "$(uname -s)" in
  Linux) ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac

case "$(dpkg --print-architecture)" in
  amd64)
    RUST_TRIPLE="x86_64-unknown-linux-gnu"
    case "${AST_GREP_VERSION}" in
      0.45.1) EXPECTED_CHECKSUM="76fb6555be6734fb5057dba8d2fb756430f374bb9e1af694cf1ce00e13238d63" ;;
      0.41.0) EXPECTED_CHECKSUM="e71afdcbb2e79f7710a56d2f89662bdd0a6e9d639c4abecd5d5f129d80a38bac" ;;
      *) echo "No checksum configured for ast-grep ${AST_GREP_VERSION} on amd64" >&2; exit 1 ;;
    esac
    ;;
  arm64)
    RUST_TRIPLE="aarch64-unknown-linux-gnu"
    case "${AST_GREP_VERSION}" in
      0.45.1) EXPECTED_CHECKSUM="9ee7ec49aada3dc05135d21977af089a33fc3154ada25bab102daca90b5098f2" ;;
      0.41.0) EXPECTED_CHECKSUM="6f089d014d5fda8fed2e63e5095acf8ebec4c4cd2e721bd663f2284ace42b623" ;;
      *) echo "No checksum configured for ast-grep ${AST_GREP_VERSION} on arm64" >&2; exit 1 ;;
    esac
    ;;
  *)
    echo "Unsupported architecture: $(dpkg --print-architecture)" >&2
    exit 1
    ;;
esac

ZIPFILE="app-${RUST_TRIPLE}.zip"
URL="https://github.com/ast-grep/ast-grep/releases/download/${AST_GREP_VERSION}/${ZIPFILE}"
TMPDIR="$(mktemp -d)"
trap 'rm -rf "${TMPDIR}"' EXIT

cache_entry() {
  printf '%s/ast-grep-%s-%s\n' "${AST_GREP_CACHE_DIR}" "${AST_GREP_VERSION}" "${RUST_TRIPLE}"
}

# A cached entry is trusted only after it executes on this OS and
# architecture and reports the pinned version, so a stale or foreign entry
# cannot bypass the pin even if a cache key collides. A rejected entry falls
# through to the checksum-verified release download below.
restore_cached_binary() {
  [ -n "${AST_GREP_CACHE_DIR}" ] || return 1
  local entry
  entry="$(cache_entry)"
  [ -f "${entry}" ] && [ -x "${entry}" ] || return 1
  if ! "${entry}" --version 2>/dev/null | grep -Eq "ast-grep ${AST_GREP_VERSION//./\\.}([^0-9]|\$)"; then
    return 1
  fi
  install -m 0755 "${entry}" "${INSTALL_DIR}/ast-grep"
  ln -sf "${INSTALL_DIR}/ast-grep" "${INSTALL_DIR}/sg"
  echo "Restored ast-grep ${AST_GREP_VERSION} for ${RUST_TRIPLE} from ${entry}"
}

store_cached_binary() {
  [ -n "${AST_GREP_CACHE_DIR}" ] || return 0
  mkdir -p "${AST_GREP_CACHE_DIR}"
  install -m 0755 "${INSTALL_DIR}/ast-grep" "$(cache_entry)"
  echo "Cached ast-grep ${AST_GREP_VERSION} for ${RUST_TRIPLE} at $(cache_entry)"
}

if restore_cached_binary; then
  exit 0
fi

echo "Installing ast-grep ${AST_GREP_VERSION} from ${URL}..."
curl -fsSL --retry 2 --retry-delay 2 --retry-connrefused --retry-all-errors \
  --connect-timeout "${AST_GREP_DOWNLOAD_CONNECT_TIMEOUT:-15}" \
  --max-time "${AST_GREP_DOWNLOAD_MAX_TIME:-300}" \
  -o "${TMPDIR}/${ZIPFILE}" "${URL}"
echo "${EXPECTED_CHECKSUM}  ${TMPDIR}/${ZIPFILE}" | sha256sum -c -
unzip -j -o "${TMPDIR}/${ZIPFILE}" ast-grep -d "${TMPDIR}"
install -m 0755 "${TMPDIR}/ast-grep" "${INSTALL_DIR}/ast-grep"
ln -sf "${INSTALL_DIR}/ast-grep" "${INSTALL_DIR}/sg"
store_cached_binary
