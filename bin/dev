#!/usr/bin/env bash

export OVERMIND_SOCKET="${OVERMIND_SOCKET:-.overmind.sock}"

if ! command -v overmind &> /dev/null
then
  echo "Installing overmind..."
  gem install overmind
fi

if [ -S "$OVERMIND_SOCKET" ] && ! overmind status &>/dev/null; then
  echo "Removing stale Overmind socket..."
  rm -f "$OVERMIND_SOCKET"
fi

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Clean up stale containers and volumes from previous runs.
# Runs inline (takes <2s when no stale resources exist).
# Skip with SKIP_DEV_CLEANUP=1 if you want a faster start.
if [ "${SKIP_DEV_CLEANUP:-0}" != "1" ]; then
  echo "Cleaning up stale Docker resources..."
  bin/rake dev:cleanup 2>/dev/null || true
fi

overmind start -f Procfile.dev "$@"
