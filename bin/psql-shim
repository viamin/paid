#!/usr/bin/env ruby
# frozen_string_literal: true

# Minimal psql shim that loads SQL files via the pg gem.
# Only supports the flags used by Rails: psql --set ON_ERROR_STOP=1 --quiet --no-psqlrc --output /dev/null --file FILE DB
require "pg"

file = nil
db = nil
args = ARGV.dup

while args.any?
  arg = args.shift
  case arg
  when "--file", "-f" then file = args.shift
  when "--set", "--output", "-o" then args.shift # skip value
  when "--quiet", "-q", "--no-psqlrc" then next
  else db = arg unless arg.start_with?("-")
  end
end

abort "No SQL file specified" unless file
abort "SQL file not found: #{file}" unless File.exist?(file)

url = ENV["DATABASE_URL"]
conn = if db && url
  url.sub(/\/[^\/]+$/, "/#{db}")
elsif url
  url
else
  "postgres:///#{db}"
end

pg = PG.connect(conn)
sql = File.read(file)
pg.exec(sql)
pg.close
