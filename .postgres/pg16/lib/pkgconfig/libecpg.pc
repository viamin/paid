prefix=/workspace/.postgres/pg16
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg
Description: PostgreSQL libecpg library
URL: https://www.postgresql.org/
Version: 16.8
Requires: 
Requires.private: libpq, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg
Libs.private: -L/lib/aarch64-linux-gnu -L/workspace/.postgres/devlibs/usr/lib/aarch64-linux-gnu -lpgcommon -lpgport -lpq -lm
