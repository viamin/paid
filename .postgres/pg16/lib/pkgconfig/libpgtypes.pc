prefix=/workspace/.postgres/pg16
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libpgtypes
Description: PostgreSQL libpgtypes library
URL: https://www.postgresql.org/
Version: 16.8
Requires: 
Requires.private: 
Cflags: -I${includedir}
Libs: -L${libdir} -lpgtypes
Libs.private: -L/lib/aarch64-linux-gnu -L/workspace/.postgres/devlibs/usr/lib/aarch64-linux-gnu -lpgcommon -lpgport -lm
