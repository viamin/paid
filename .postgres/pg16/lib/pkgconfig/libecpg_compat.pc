prefix=/workspace/.postgres/pg16
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg_compat
Description: PostgreSQL libecpg_compat library
URL: https://www.postgresql.org/
Version: 16.8
Requires: 
Requires.private: libecpg, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg_compat
Libs.private: -L/lib/aarch64-linux-gnu -L/workspace/.postgres/devlibs/usr/lib/aarch64-linux-gnu -lecpg -lpgcommon -lpgport -lpq -lm
