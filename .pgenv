#!/usr/bin/env bash
# Local PostgreSQL environment for this workspace.
export PGBIN=/workspace/.pg-install/usr/lib/postgresql/16/bin
export PGLIB=/workspace/.pg-install/usr/lib/aarch64-linux-gnu
export LD_LIBRARY_PATH="$PGLIB:/workspace/.pg-install/usr/lib/postgresql/16/lib"
export PGDATA=/workspace/.pgdata
export PATH="$PGBIN:$PATH"
# database.yml: when DB_HOST is set it becomes the host/username. A directory
# path is treated by libpq as the unix-socket directory.
export DB_HOST=/tmp
export PAID_TEST_DATABASE=paid_test
export PAID_DEVELOPMENT_DATABASE=paid_development
export PAID_DEVELOPMENT_CABLE_DATABASE=paid_development_cable
