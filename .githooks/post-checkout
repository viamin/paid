#!/usr/bin/env bash
set -euo pipefail

# Post-checkout hook: automatically rolls back orphaned migrations and runs
# pending ones when switching branches. Prevents DB/code schema mismatches.
#
# Never runs for new-worktree/initial checkouts (Git's null previous ref) or
# when a comparison ref cannot be resolved or read; those checkouts may be
# candidate code under inspection and must not execute host database setup.
#
# Receives three args from git:
#   $1 = previous HEAD ref
#   $2 = new HEAD ref
#   $3 = flag (1 = branch checkout, 0 = file checkout)
#
# Override:
#   SKIP_MIGRATION_GUARD=1 git checkout <branch>

# @spec DEVELOPER-MIGRATION-GUARD-005
[ "${SKIP_MIGRATION_GUARD:-0}" = "1" ] && exit 0

prev_head=$1
new_head=$2
branch_checkout=$3

[ "$branch_checkout" -eq 1 ] || exit 0

# Git passes its null ref (all zeros) as the previous HEAD for new-worktree
# and initial checkouts. There is no previous migration tree to compare, and
# these checkouts are frequently candidate code staged only for inspection,
# so never run Rails or host database setup from here.
# @spec DEVELOPER-MIGRATION-GUARD-002
if [[ -z "$prev_head" || "$prev_head" =~ ^0+$ ]]; then
  echo "  Migration guard: new-worktree/initial checkout — nothing to compare."
  exit 0
fi

# A ref that does not resolve has no readable migration tree. Skipping is the
# only safe comparison: diffing against an apparent empty tree would report
# every migration as added and run host database setup (#5292).
# @spec DEVELOPER-MIGRATION-GUARD-003
for ref in "$prev_head" "$new_head"; do
  if ! git rev-parse --verify --quiet "${ref}^{commit}" >/dev/null; then
    echo "  Migration guard: ref ${ref} does not resolve — skipping."
    exit 0
  fi
done

if ! command -v bin/rails &>/dev/null; then
  exit 0
fi

migration_tree() {
  local tree
  tree=$(git ls-tree --name-only -r "$1" -- db/migrate/ 2>/dev/null) || return 1
  [ -n "$tree" ] || return 0
  printf '%s\n' "$tree"
}

if ! prev_tree=$(migration_tree "$prev_head"); then
  # @spec DEVELOPER-MIGRATION-GUARD-004
  echo "  Migration guard: migration tree for ${prev_head} unavailable — skipping."
  exit 0
fi

if ! new_tree=$(migration_tree "$new_head"); then
  # @spec DEVELOPER-MIGRATION-GUARD-004
  echo "  Migration guard: migration tree for ${new_head} unavailable — skipping."
  exit 0
fi

print_lines() {
  [[ -n "$1" ]] && printf '%s\n' "$1"
  true
}

removed=$(comm -23 \
  <(print_lines "$prev_tree" | sort) \
  <(print_lines "$new_tree" | sort))

added=$(comm -13 \
  <(print_lines "$prev_tree" | sort) \
  <(print_lines "$new_tree" | sort))

if [ -z "$removed" ] && [ -z "$added" ]; then
  exit 0
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Migration changes detected on branch switch"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

worktree_database_suffix() {
  ruby <<'RUBY'
require File.expand_path("config/worktree_database_names", Dir.pwd)

puts Paid::WorktreeDatabaseNames.suffix.to_s
RUBY
}

if command -v bin/ensure-worktree-databases &>/dev/null && [ -n "$(worktree_database_suffix)" ]; then
  echo "  Ensuring worktree databases..."
  if ! bin/ensure-worktree-databases 2>&1; then
    echo "  ⚠  Could not ensure worktree databases. Migration guard skipped."
    exit 0
  fi
fi

restored_files=()

cleanup() {
  for f in "${restored_files[@]}"; do
    rm -f "$f" 2>/dev/null || true
  done
}
trap cleanup EXIT

if [ -n "$removed" ]; then
  echo ""
  echo "  Migrations REMOVED (were in previous branch):"
  echo "$removed" | sed 's|db/migrate/||' | sed 's/^/    /'
  echo ""

  restored_count=0
  rollback_count=0
  failed_count=0

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! git show "$prev_head:$f" > "$f" 2>/dev/null; then
      echo "  ⚠  Could not restore $(basename "$f") from previous ref"
      continue
    fi
    restored_files+=("$f")
    restored_count=$((restored_count + 1))
  done <<< "$removed"

  if [ "$restored_count" -eq 0 ]; then
    echo "  ⚠  Could not restore any migration files. Rollback skipped."
    echo "  Roll back manually from the previous branch:"
    echo "$removed" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      version=$(basename "$f" | grep -oE '^[0-9]+' || true)
      [ -n "$version" ] && echo "    bin/rails db:migrate:down:primary VERSION=$version"
    done
  else
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      version=$(basename "$f" | grep -oE '^[0-9]+' || true)
      [ -n "$version" ] || continue
      if bin/rails db:migrate:down:primary VERSION="$version" 2>&1; then
        rollback_count=$((rollback_count + 1))
      else
        failed_count=$((failed_count + 1))
        echo "  ⚠  Rollback failed for $version"
      fi
    done <<< "$(echo "$removed" | tac)"

    if [ "$rollback_count" -gt 0 ]; then
      echo "  Rolled back $rollback_count migration(s)."
    fi
    if [ "$failed_count" -gt 0 ]; then
      echo "  ⚠  $failed_count rollback(s) failed (migration may not have been run)."
    fi

    for f in "${restored_files[@]}"; do
      rm -f "$f" 2>/dev/null || true
    done
    restored_files=()
  fi
fi

if [ -n "$added" ]; then
  echo ""
  echo "  Migrations ADDED (new in this branch):"
  echo "$added" | sed 's|db/migrate/||' | sed 's/^/    /'
  echo ""
  echo "  Running pending migrations..."
  # @spec DEVELOPER-MIGRATION-GUARD-001
  if bin/rails db:migrate 2>&1; then
    echo "  Migrations complete."
  else
    echo "  ⚠  db:migrate failed. Run manually to investigate."
  fi
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
