#!/bin/bash
# Minimal psql stub that reads a SQL file and pipes it to PG via ruby
# Parse arguments to find --file and database name
FILE=""
DB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file) shift; FILE="$1" ;;
    --set|--output) shift ;; # skip value for flags with args
    --quiet|--no-psqlrc) ;; # skip boolean flags
    -*) ;; # skip other flags
    *) DB="$1" ;; # positional arg = database name
  esac
  shift
done

if [ -n "$FILE" ] && [ -f "$FILE" ] && [ -s "$FILE" ]; then
  # Use the pg gem through bundle to execute the SQL
  BUNDLE_PATH=vendor/bundle bundle exec ruby -e "
    require 'pg'
    uri = ENV['DATABASE_URL']
    conn = PG.connect(uri)
    sql = File.read('$FILE')
    conn.exec(sql)
    conn.close
  " 2>&1
  exit $?
fi
